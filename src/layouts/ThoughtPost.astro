---
import PlatePaint from '../components/PlatePaint.astro';
interface Props {
  title: string;
  date: string;
  description: string;
}

const { title, date, description } = Astro.props;

import Layout from './Layout.astro';
import { existsSync } from 'node:fs';
import { relatedTo, posts } from '../lib/thoughts-data';

const siteUrl = 'https://arshad-kazi.com';
const articleUrl = new URL(Astro.url.pathname, siteUrl).href;

/* Share the essay's own image rather than the site's card. Each post's
   source is read at build time and its first Cloudinary image is asked for
   at the size chat apps want, as a jpeg because some of them will not
   render webp. Nothing is copied into this repository. */
const sources = import.meta.glob('../pages/thoughts/*.astro', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop();
const related = slug ? relatedTo(slug, 3) : [];

/* The essay's own EXIF: what a camera would write into the file, but for
   a piece of writing. Its number in the body of work counts from the
   oldest, so it says how many came before it. */
const at = posts.findIndex(p => p.slug === slug);
const self = at >= 0 ? posts[at] : undefined;
const exif = self ? [
  { k: 'No.', v: `${String(posts.length - at).padStart(2, '0')} / ${posts.length}` },
  { k: 'Words', v: self.words.toLocaleString('en-US') },
  { k: 'Read', v: `${Math.max(1, Math.round(self.words / 230))} min` },
] : [];

let shareImage = '/images/share-thoughts.jpg';
for (const [path, raw] of Object.entries(sources)) {
  if (path.split('/').pop()!.replace('.astro', '') !== slug) continue;
  const found = raw.match(/https:\/\/res\.cloudinary\.com\/[^"']+/);
  if (found) {
    shareImage = found[0].replace('/upload/', '/upload/w_1200,h_630,c_fill,g_auto,q_auto,f_jpg/');
  }
}

// Each essay's plate lives at /images/thoughts/<slug>.jpg: shown under the
// title, and the picture its shared link carries.
const figure = slug && existsSync(`public/images/thoughts/${slug}.jpg`) ? `/images/thoughts/${slug}.jpg` : null;
if (figure) shareImage = figure;

function formatDate(dateStr: string): string {
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title={`${title} — Arshad Kazi`} activeNav="/thoughts" description={description} ogImage={shareImage}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "datePublished": date,
    "url": articleUrl,
    "author": {
      "@type": "Person",
      "name": "Arshad Kazi",
      "url": siteUrl
    }
  })} />
  <article class="blog-post">
    <div class="article-rule">
      <a href="/thoughts" aria-label="Back to thoughts">
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <circle class="ab-ring" cx="24" cy="24" r="17" />
          <g class="ab-ticks"><path d="M24 1.5v4.5" /><path d="M24 42v4.5" /><path d="M1.5 24h4.5" /><path d="M42 24h4.5" /></g>
          <path class="ab-arrow" d="M30 24H18M23.5 18.5 18 24l5.5 5.5" />
        </svg>
        <span class="ab-label">Thoughts</span>
      </a>
      <span class="rule-line"></span>
      <span class="kind">Note</span>
    </div>

    <header class={`blog-post-header ${figure ? 'has-figure' : ''}`}>
      {figure && (
        <figure class="post-cover" aria-hidden="true">
          <img src={figure} alt="" width="1600" height="840" decoding="async" fetchpriority="high" />
        </figure>
      )}
      {figure && <PlatePaint />}
      <div class="blog-post-meta">
        <time>{formatDate(date)}</time>
      </div>
      <h1>{title}</h1>
      {exif.length > 0 && (
        <dl class="exif">
          {exif.map(e => (
            <div>
              <dt>{e.k}</dt>
              <dd>{e.v}</dd>
            </div>
          ))}
        </dl>
      )}
    </header>


    <div class="blog-post-content">
      <slot />
    </div>

    {related.length > 0 && (
      <aside class="kin">
        <p class="kin-head">
          <span class="kin-name">Read next</span>
          <span class="kin-line"></span>
        </p>
        <ul class="kin-list">
          {related.map(r => (
            <li>
              <a href={`/thoughts/${r.slug}`}>
                <span class="kin-title">{r.title}</span>
                {/* Labelled, because a bare percentage next to a title
                    reads as how much of it you have read. */}
                <span class="kin-sim" style={`--fill:${(r.sim * 100).toFixed(0)}%`}>
                  {Math.round(r.sim * 100)}% match
                </span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <div id="disqus_thread" class="disqus-section"></div>

    <footer class="blog-post-footer">
      <a href="/thoughts" class="back-link">&larr; Back to thoughts</a>
    </footer>
  </article>
</Layout>

<!-- This has to stay above the Disqus script below it. The compiler
     drops the closing </noscript> tag down there, so anything after
     that element is swallowed into it as dead text: with the styles
     last, none of them applied at all. -->
<style>
  /* The header's figure runs edge to edge across the screen as a band at
     the top, and fades into the paper where the title begins, so it never
     sits under the words. */
  /* The plate runs up behind the site header, so header and drawing are
     one picture: the drawing begins under the nav and fades to bare paper
     exactly where the nav's words sit, then the title starts where the
     drawing ends. Its height never exceeds the plate's own proportions, so
     the whole drawing always fits. */
  .blog-post-header.has-figure {
    --plate-h: min(clamp(17rem, 62vh, 40rem), calc(min(100vw, 2400px) / 1.905));
    position: relative;
    padding-top: calc(var(--plate-h) * 0.92 - var(--head-h, 4.5rem) - var(--main-pt));
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .blog-post-header.has-figure > :not(.post-cover) {
    position: relative;
  }

  .post-cover {
    position: absolute;
    top: calc(-1 * (var(--main-pt) + var(--head-h, 4.5rem)));
    left: calc(50% - min(50vw, 1200px));
    width: min(100vw, 2400px);
    height: var(--plate-h);
    margin: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .post-cover img {
    /* The whole plate, never a crop of it: the drawing is ink on the
       page's own paper, so shown entire it has no edge to show; a soft
       ellipse lets its outermost edges thin into the paper, and a band keeps the plate's own small title and credit,
       which belong to the shared card, out of the header. */
    --iris: 100%;
    --veil: var(--head-h, 4.5rem);
    --side: linear-gradient(#000, #000);
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    -webkit-mask-image: radial-gradient(ellipse calc(var(--iris) * 0.55) calc(var(--iris) * 0.9) at 50% 50%, #000 0%, #000 70%, transparent 100%), linear-gradient(180deg, transparent 0%, transparent 10.5%, #000 12.2%, #000 87.8%, transparent 89.5%), linear-gradient(180deg, transparent calc(var(--veil) * 0.5), #000 calc(var(--veil) * 1.65)), var(--side);
    -webkit-mask-composite: source-in, source-in, source-in;
    mask-image: radial-gradient(ellipse calc(var(--iris) * 0.55) calc(var(--iris) * 0.9) at 50% 50%, #000 0%, #000 70%, transparent 100%), linear-gradient(180deg, transparent 0%, transparent 10.5%, #000 12.2%, #000 87.8%, transparent 89.5%), linear-gradient(180deg, transparent calc(var(--veil) * 0.5), #000 calc(var(--veil) * 1.65)), var(--side);
    mask-composite: intersect;
    mix-blend-mode: multiply;
    filter: grayscale(1) contrast(1.35);
  }


  :global(html.dark) .post-cover img {
    mix-blend-mode: screen;
    opacity: 0.4;
    filter: grayscale(1) invert(1) contrast(1.5) brightness(0.9);
  }

  /* On a wide screen the header is a full-bleed hero composed on thirds.
     The plate is the whole first screen, whatever the window, up behind the
     nav; it is drawn wider than the screen, sized from the window's height,
     so its centre of interest sits on the right third and it bleeds off the
     right edge, the way a photograph crops its subject, reaching back left
     to thin into paper.
     The title stands on the left third, on the paper where the plate fades
     out, with the date above and the readout below; the essay begins in its
     column just past the fold. */
  @media (min-width: 1200px) {
    .blog-post-header.has-figure {
      --hero-h: max(34rem, 100vh);
      --img-w: max(calc(min(100vw, 2400px) * 1.05), calc(var(--hero-h) * 2.25));
      --band-w: min(1240px, calc(100vw - 2 * var(--gutter)));
      /* The title block sits in the optical middle of the screen below the
         nav, a touch above true centre, whatever the window's height. */
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 0;
      padding-bottom: 9vh;
      min-height: calc(var(--hero-h) - var(--head-h, 4.5rem) - var(--main-pt));
      margin-bottom: var(--space-xl);
    }

    .blog-post-header.has-figure > :not(.post-cover) {
      width: calc(var(--band-w) * 0.42);
      max-width: none;
      margin-left: calc(50% - var(--band-w) / 2);
    }

    .blog-post-header.has-figure h1 {
      font-size: clamp(3.4rem, 4.9vw, 6.4rem);
      line-height: 0.98;
      letter-spacing: -0.03em;
    }

    .post-cover {
      left: calc(50% - min(50vw, 1200px));
      width: min(100vw, 2400px);
      height: var(--hero-h);
    }

    .post-cover img {
      --veil: calc(var(--head-h, 4.5rem) * 1.4);
      position: absolute;
      top: 0;
      left: calc(min(100vw, 2400px) * 0.64 - var(--img-w) / 2);
      width: var(--img-w);
      height: 100%;
      object-fit: cover;
      object-position: center 30%;
      -webkit-mask-image: radial-gradient(ellipse calc(var(--iris) * 0.6) calc(var(--iris) * 0.95) at 50% 46%, #000 0%, #000 72%, transparent 100%), linear-gradient(180deg, transparent calc(var(--veil) * 0.5), #000 calc(var(--veil) * 1.65)), linear-gradient(180deg, #000 0%, #000 62%, transparent 98%), linear-gradient(90deg, transparent 0%, transparent 30%, #000 46%);
      -webkit-mask-composite: source-in, source-in, source-in;
      mask-image: radial-gradient(ellipse calc(var(--iris) * 0.6) calc(var(--iris) * 0.95) at 50% 46%, #000 0%, #000 72%, transparent 100%), linear-gradient(180deg, transparent calc(var(--veil) * 0.5), #000 calc(var(--veil) * 1.65)), linear-gradient(180deg, #000 0%, #000 62%, transparent 98%), linear-gradient(90deg, transparent 0%, transparent 30%, #000 46%);
      mask-composite: intersect;
    }

  }

  /* On a phone the header stands two rows tall, so the plate waits just
     below it instead of running underneath, at its own proportions. */
  @media (max-width: 760px) {
    .blog-post-header.has-figure {
      --plate-h: 52.5vw;
      padding-top: calc(var(--plate-h) * 0.92 - var(--main-pt));
    }

    .post-cover {
      top: calc(-1 * var(--main-pt));
    }

    .post-cover img {
      --veil: 0px;
    }
  }

  /* The reveal, at every size, all in one short beat: a sheet of
     the page's paper over the plate is wiped away in brush strokes (PlatePaint
     does that), as the ink develops from pale to its full black and the
     title rises into place. */
  @media (prefers-reduced-motion: no-preference) {
    .post-cover img {
      animation: plate-develop 1.3s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    }

    /* In the dark the plate is inverted by its filter, so it is painted
       in without the developing, which would flash it light. */
    :global(html.dark) .post-cover img {
      animation: none;
    }

    .blog-post-header.has-figure > :not(.post-cover) {
      animation: hero-rise 0.9s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    }
  }

  /* Reading on, the plate falls back: it drifts down behind the title and
     pales, rather than scrolling away like a banner. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .post-cover {
        animation: plate-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 70vh;
      }
    }
  }





  /* ── Closest to this one ───────────────────────────────────────
     Not "related posts". These are the three nearest essays in the same
     latent space the index is searched in, and each one says how close it
     actually is, so a weak neighbour is visibly a weak neighbour. */
  /* ── EXIF ────────────────────────────────────────────
     Set like the information panel of a photo viewer: three fields in a
     row, the name small above, the value in the instrument face. */
  .exif {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: var(--space-md) var(--space-xl);
    margin: 0;
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .exif div {
    min-width: 0;
  }

  .exif dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.2rem;
  }

  .exif dd {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .exif div:first-child dd {
    color: var(--color-accent);
  }

  @media (max-width: 560px) {
    .exif {
      gap: var(--space-sm) var(--space-lg);
    }
  }

  .kin {
    margin: var(--space-3xl) 0 var(--space-xl);
  }

  .kin-head {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin: 0 0 var(--space-md);
  }

  .kin-name {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .kin-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .kin-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .kin-list li {
    margin: 0;
    border-top: 1px solid var(--color-border-light);
  }

  .kin-list li:first-child {
    border-top: none;
  }

  .kin-list a {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding: 0.75rem 0;
    text-decoration: none;
    color: inherit;
  }

  .kin-title {
    flex: 1;
    font-family: var(--font-serif);
    font-size: 1.18rem;
    line-height: 1.35;
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .kin-list a:hover .kin-title {
    color: var(--color-accent);
  }

  .kin-sim {
    position: relative;
    padding-left: 3.2rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .kin-sim::before,
  .kin-sim::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0.42em;
    height: 2px;
    border-radius: 1px;
  }

  .kin-sim::before {
    width: 2.7rem;
    background: var(--color-border);
  }

  .kin-sim::after {
    width: calc(2.7rem * var(--fill, 0%) / 100%);
    background: var(--color-accent);
  }

  @media (max-width: 600px) {
      .kin-title {
      font-size: 1.06rem;
    }
  }

  .disqus-section {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }
</style>

<script is:inline>
  var disqus_config = function () {
    this.page.url = window.location.href;
    this.page.identifier = window.location.pathname;
  };
  function loadDisqus() {
    var d = document, s = d.createElement('script');
    s.src = 'https://arshad-kazi-blog.disqus.com/embed.js';
    s.setAttribute('data-timestamp', +new Date());
    (d.head || d.body).appendChild(s);
  }
  function syncDisqusTheme() {
    var isDark = document.documentElement.classList.contains('dark');
    var thread = document.getElementById('disqus_thread');
    if (thread) {
      thread.setAttribute('data-color-scheme', isDark ? 'dark' : 'light');
    }
    if (window.DISQUS) {
      window.DISQUS.reset({ reload: true, config: disqus_config });
    }
  }
  loadDisqus();
  var observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(m) {
      if (m.attributeName === 'class') syncDisqusTheme();
    });
  });
  observer.observe(document.documentElement, { attributes: true });
</script>
<noscript>Please enable JavaScript to view the <a href="https://disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>
