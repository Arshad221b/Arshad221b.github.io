---
interface Props {
  title: string;
  date: string;
  description: string;
  tags?: string[];
}

const { title, date, description, tags = [] } = Astro.props;

import Layout from './Layout.astro';
import { existsSync } from 'node:fs';

const siteUrl = 'https://arshad-kazi.com';
const articleUrl = new URL(Astro.url.pathname, siteUrl).href;

/* Each essay's figure lives at /images/blog/<slug>.jpg: shown at the head
   of the essay, and the picture a shared link carries. */
const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop();
const figure = existsSync(`public/images/blog/${slug}.jpg`) ? `/images/blog/${slug}.jpg` : null;

function formatDate(dateStr: string): string {
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title={`${title} — Arshad Kazi`} activeNav="/blog" description={description} ogImage={figure ?? "/images/share-blog.jpg"}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "datePublished": date,
    "url": articleUrl,
    "author": {
      "@type": "Person",
      "name": "Arshad Kazi",
      "url": siteUrl
    }
  })} />
  <article class="blog-post">
    <div class="article-rule">
      <a href="/blog">&larr; Blogs</a>
      <span class="rule-line"></span>
      <span class="kind">Essay</span>
    </div>

    <header class={`blog-post-header ${figure ? 'has-figure' : ''}`}>
      {figure && (
        <figure class="post-cover" aria-hidden="true">
          <img src={figure} alt="" width="1600" height="840" decoding="async" fetchpriority="high" />
        </figure>
      )}
      <div class="blog-post-meta">
        <time>{formatDate(date)}</time>
      </div>
      <h1>{title}</h1>
      <p class="blog-post-description">{description}</p>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>


    <div class="blog-post-content">
      <slot />
    </div>

    <div id="disqus_thread" class="disqus-section"></div>

    <footer class="blog-post-footer">
      <a href="/blog" class="back-link">&larr; Back to all posts</a>
    </footer>
  </article>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
  <script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
  <script is:inline>
    document.addEventListener("DOMContentLoaded", function() {
      renderMathInElement(document.querySelector(".blog-post-content"), {
        delimiters: [
          { left: "$$", right: "$$", display: true },
          { left: "$", right: "$", display: false }
        ],
        throwOnError: false
      });
    });
  </script>
</Layout>

<!-- Above the Disqus script: the compiler drops the closing </noscript>
     below, and anything after it would be swallowed as dead text. -->
<style>
  /* The figure is drawn on the page's own paper, so it sits on it as a
     plate; on the dark page it is a print laid down on the desk. */
  /* The header's figure runs edge to edge across the screen as a band at
     the top, and fades into the paper where the title begins, so it never
     sits under the words. */
  .blog-post-header.has-figure {
    position: relative;
    padding-top: clamp(11rem, 40vh, 26rem);
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .blog-post-header.has-figure > :not(.post-cover) {
    position: relative;
  }

  .post-cover {
    position: absolute;
    top: calc(-1 * var(--main-pt));
    left: calc(50% - min(50vw, 1200px));
    width: min(100vw, 2400px);
    height: clamp(13rem, 46vh, 30rem);
    margin: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .post-cover img {
    width: 100%;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 62%, transparent 100%), linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(180deg, #000 0%, #000 62%, transparent 100%), linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-composite: intersect;
    height: 100%;
    object-fit: cover;
    object-position: center;
    mix-blend-mode: darken;
    filter: brightness(1.05);
    opacity: 1;
  }

  :global(html.dark) .post-cover img {
    mix-blend-mode: normal;
    opacity: 0.6;
  }

  @media (max-width: 760px) {
    .blog-post-header.has-figure {
      padding-top: calc(52vw + 0.5rem);
    }

    .post-cover {
      top: calc(-1 * var(--main-pt));
      height: 58vw;
    }
  }



  .disqus-section {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }
</style>


<script is:inline>
  var disqus_config = function () {
    this.page.url = window.location.href;
    this.page.identifier = window.location.pathname;
  };
  function loadDisqus() {
    var d = document, s = d.createElement('script');
    s.src = 'https://arshad-kazi-blog.disqus.com/embed.js';
    s.setAttribute('data-timestamp', +new Date());
    (d.head || d.body).appendChild(s);
  }
  function syncDisqusTheme() {
    var isDark = document.documentElement.classList.contains('dark');
    var thread = document.getElementById('disqus_thread');
    if (thread) {
      thread.setAttribute('data-color-scheme', isDark ? 'dark' : 'light');
    }
    if (window.DISQUS) {
      window.DISQUS.reset({ reload: true, config: disqus_config });
    }
  }
  loadDisqus();
  var observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(m) {
      if (m.attributeName === 'class') syncDisqusTheme();
    });
  });
  observer.observe(document.documentElement, { attributes: true });
</script>
<noscript>Please enable JavaScript to view the <a href="https://disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>


