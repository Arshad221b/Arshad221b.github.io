---
import { share } from '../lib/media';
import InkPlates from '../components/InkPlates.astro';
interface Props {
  title: string;
  activeNav?: string;
  description?: string;
  ogImage?: string;
}

const { title, activeNav = '', description = '', ogImage = '' } = Astro.props;
const siteUrl = 'https://arshad-kazi.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const defaultDescription = 'Arshad Kazi — CV/ML engineer building things to understand how they work. Computer vision, 3D geometry, representation learning.';
const metaDescription = description || defaultDescription;
/* An ogImage may be a path on this site or a full URL somewhere else, so
   only the local ones get the site prefixed onto them. */
const metaImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`)
  : share('/images/share-about.jpg');

const navItems = [
  { label: 'About', href: '/' },
  { label: 'Blogs', href: '/blog' },
  { label: 'Thoughts', href: '/thoughts' },
  { label: 'Contact', href: '/contact' },
];

const elsewhere = [
  { label: 'GitHub', href: 'https://github.com/Arshad221b' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/arshad221b/' },
  { label: 'Substack', href: 'https://substack.com/@arshadkazi' },
  { label: 'Medium', href: 'https://medium.com/@arshad_221b' },
  { label: 'Email', href: 'mailto:arshadkaziblog@gmail.com' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta name="theme-color" content="#f0e9de" />
    <script is:inline>
      (function() {
        // Light unless the visitor has chosen dark with the toggle.
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        }
        // The phone browser's bar takes this colour; it has to match the
        // paper, and the paper depends on the theme.
        const bar = document.querySelector('meta[name="theme-color"]');
        if (bar) bar.content = theme === 'dark' ? '#000000' : '#f0e9de';
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- The ?v= tells browsers that cached the old mark to fetch these afresh. -->
    <link rel="icon" href="/favicon.ico?v=3" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="alternate" type="application/rss+xml" title="Arshad Kazi" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..700;1,6..72,200..700&family=IBM+Plex+Mono:wght@400;500&family=Great+Vibes&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:image:secure_url" content={metaImage} />
    {/* Every card this site serves is 1200 by 630. Chat apps use these to
        decide between a large preview and a small thumbnail. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arshad Kazi" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={metaImage} />
    <slot name="head" />
    <!-- The next page is ready before the click: prepared as the pointer
         rests on a link (or a finger touches it), so moving between pages
         is instant. -->
    <script type="speculationrules" is:inline>
      {"prerender": [{"where": {"href_matches": "/*"}, "eagerness": "moderate"}]}
    </script>
  </head>
  <body>
    <div class="viewfinder" aria-hidden="true">
      <span class="vf-corner tl"></span><span class="vf-corner tr"></span>
      <span class="vf-corner bl"></span><span class="vf-corner br"></span>
      <span class="vf-readout" id="vf-xy">x <b>0.500</b> &nbsp;y <b>0.500</b></span>
      <span class="vf-readout vf-depth" id="vf-z">z <b>0.00</b></span>
    </div>

    <header>
      <div class="site-head">
        <a href="/" class="brand" aria-label="Arshad Kazi, home">
          <svg class="brand-mark" viewBox="22 2 56 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path class="ink" d="M50 52 C46 40 60 36 56 26 C52 16 40 20 44 30 C47 37 58 32 60 22 C62 12 54 6 48 8" stroke-width="3.4"/>
            <path class="pot" d="M39.2 94 C29.6 94 28.4 79.6 36.8 72.4 C40.4 69.4 41.6 67.6 41.6 64 L58.4 64 C58.4 67.6 59.6 69.4 63.2 72.4 C71.6 79.6 70.4 94 60.8 94 Z" stroke-width="3"/>
            <path d="M42.8 64 L42.8 59.2 L57.2 59.2 L57.2 64 Z" fill="currentColor" stroke-width="1.5"/>
            <path d="M33.2 82 C40.4 78.4 59.6 78.4 66.8 82" stroke-width="1.6"/>
            <g fill="currentColor" stroke="none"><ellipse cx="38.0" cy="88" rx="1.5" ry="2.4"/><ellipse cx="42.8" cy="88" rx="1.5" ry="2.4"/><ellipse cx="47.6" cy="88" rx="1.5" ry="2.4"/><ellipse cx="52.4" cy="88" rx="1.5" ry="2.4"/><ellipse cx="57.2" cy="88" rx="1.5" ry="2.4"/><ellipse cx="62.0" cy="88" rx="1.5" ry="2.4"/></g>
          </svg>
          <span class="brand-name">Journey of <em>Curiosity</em></span>
          <span class="brand-role">Arshad Kazi</span>
        </a>
        <nav aria-label="Site" id="site-nav">
          <div class="nav-links">
            {navItems.map(item => (
              <a
                href={item.href}
                class:list={['nav-link', { active: activeNav === item.href }]}
                aria-current={activeNav === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
            <span class="nav-separator"></span>
            <button class="theme-toggle" id="theme-toggle" title="Toggle dark mode" aria-label="Toggle dark mode">
              <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
              <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            </button>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <script is:inline>
      // The round back key steps aside while reading on, returns on the way back.
      (function () {
        var r = document.querySelector('.article-rule');
        if (!r) return;
        var last = scrollY;
        addEventListener('scroll', function () {
          var y = scrollY, d = y - last;
          if (Math.abs(d) < 6) return;
          r.classList.toggle('away', d > 0 && y > 120);
          last = y;
        }, { passive: true });
      })();
    </script>
    <!-- Contents of the piece, listed in the margin -->
    <nav class="margin-toc" id="margin-toc" aria-label="Sections"></nav>
    <script is:inline>
      // The margin contents wait until the header's figure has scrolled by,
      // so they never sit over the drawing.
      (function () {
        var cover = document.querySelector('.post-cover'), toc = document.getElementById('margin-toc');
        if (!cover || !toc) return;
        // Measured only when the page changes size; a scroll just compares.
        var queued = false, bottom = 0;
        function measure() { bottom = cover.getBoundingClientRect().bottom + scrollY; check(); }
        function check() { queued = false; toc.classList.toggle('under-cover', bottom - scrollY > innerHeight * 0.3); }
        addEventListener('scroll', function () { if (!queued) { queued = true; requestAnimationFrame(check); } }, { passive: true });
        new ResizeObserver(measure).observe(document.body);
      })();
    </script>

    <script is:inline>
      (function () {
        var toc = document.getElementById('margin-toc');
        var headings = [].slice.call(
          document.querySelectorAll('.blog-post-content h2, .day-section .section-heading')
        ).filter(function (h) { return h.textContent.trim(); });

        if (!toc || headings.length < 2) return;

        // The head of the list: its name, and on a phone or tablet where it
        // opens as a sheet, a grip, where you are (03 of 09) and Close.
        var head = document.createElement('div');
        head.className = 'toc-head';
        head.innerHTML = '<span class="toc-grip" aria-hidden="true"></span><span class="toc-title">Contents</span>' +
          '<span class="toc-count"></span><button type="button" class="toc-close">Close</button>';
        toc.appendChild(head);
        var count = head.querySelector('.toc-count'), close = head.querySelector('.toc-close');

        var list = document.createElement('ol');
        var items = [];

        headings.forEach(function (h, i) {
          if (!h.id) h.id = 'section-' + (i + 1);
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = '#' + h.id;
          a.innerHTML = '<span class="toc-num">' + String(i + 1).padStart(2, '0') +
                        '</span><span class="toc-text"></span>';
          a.querySelector('.toc-text').textContent = h.textContent.trim();
          a.addEventListener('click', function (e) {
            e.preventDefault();
            setOpen(false);
            h.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.replaceState(null, '', '#' + h.id);
          });
          li.appendChild(a);
          list.appendChild(li);
          items.push({ h: h, li: li });
        });

        toc.appendChild(list);
        toc.classList.add('ready');

        // Where the margin cannot hold the list (a phone, a tablet), a chip
        // at the foot of the screen names the section being read, with a
        // hairline of how far through the piece you are; touched, it opens
        // the whole list as a sheet from the bottom edge.
        var chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'toc-chip';
        chip.setAttribute('aria-label', 'Contents');
        chip.setAttribute('aria-expanded', 'false');
        chip.innerHTML = '<svg class="toc-chip-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h8"/></svg>' +
          '<span class="toc-num"></span><span class="toc-chip-text"></span><span class="toc-chip-progress" aria-hidden="true"></span>';
        // A veil behind the open sheet: touching it closes the sheet.
        var veil = document.createElement('div');
        veil.className = 'toc-veil';
        toc.after(chip, veil);
        var chipNum = chip.querySelector('.toc-num'), chipText = chip.querySelector('.toc-chip-text');
        function setOpen(open) {
          toc.classList.toggle('toc-open', open);
          document.documentElement.classList.toggle('toc-locked', open);
          chip.setAttribute('aria-expanded', String(open));
          toc.style.transform = '';
          if (!open) return;
          // The section being read, in view in the list.
          var on = list.querySelector('li.active');
          if (on) list.scrollTop = on.offsetTop - list.clientHeight / 2 + on.offsetHeight / 2;
          close.focus({ preventScroll: true });
        }
        chip.addEventListener('click', function () { setOpen(!toc.classList.contains('toc-open')); });
        close.addEventListener('click', function () { setOpen(false); });
        veil.addEventListener('click', function () { setOpen(false); });
        addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
        // The sheet follows a finger pulling its head down, and closes if
        // pulled far enough; otherwise it springs back.
        var y0 = null;
        head.addEventListener('touchstart', function (e) { y0 = e.touches[0].clientY; toc.classList.add('toc-drag'); }, { passive: true });
        head.addEventListener('touchmove', function (e) {
          if (y0 === null) return;
          toc.style.transform = 'translateY(' + Math.max(0, e.touches[0].clientY - y0) + 'px)';
        }, { passive: true });
        head.addEventListener('touchend', function (e) {
          if (y0 === null) return;
          var d = e.changedTouches[0].clientY - y0;
          y0 = null;
          toc.classList.remove('toc-drag');
          if (d > 70) setOpen(false); else toc.style.transform = '';
        });

        // whichever section heading was last passed; the headings are
        // measured whenever the page changes size, so a scroll only compares
        var ticking = false, shown = -1;
        function measure() {
          items.forEach(function (it) { it.top = it.h.getBoundingClientRect().top + scrollY; });
          shown = -1;
          mark();
        }
        function mark() {
          ticking = false;
          var current = 0;
          for (var i = 0; i < items.length; i++) {
            if (items[i].top - scrollY <= 140) current = i;
          }
          if (current === shown) return;
          shown = current;
          items.forEach(function (it, i) {
            it.li.classList.toggle('active', i === current);
          });
          chipNum.textContent = String(current + 1).padStart(2, '0');
          chipText.textContent = items[current].h.textContent.trim();
          count.textContent = String(current + 1).padStart(2, '0') + ' of ' + String(items.length).padStart(2, '0');
          // Keep the marked entry in view in the margin, where the list is
          // seen while reading; the sheet places it when it opens.
          var active = items[current].li;
          if (!toc.classList.contains('toc-open') && toc.scrollHeight > toc.clientHeight) {
            toc.scrollTo({ top: active.offsetTop - toc.clientHeight / 2 + active.offsetHeight / 2, behavior: 'smooth' });
          }
        }
        // How far through the piece, for the chip's hairline.
        function progress() {
          var max = document.documentElement.scrollHeight - innerHeight;
          chip.style.setProperty('--read', max > 0 ? Math.min(1, scrollY / max).toFixed(3) : 0);
        }
        function onScroll() {
          if (!ticking) { ticking = true; requestAnimationFrame(function () { mark(); progress(); }); }
        }

        addEventListener('scroll', onScroll, { passive: true });
        new ResizeObserver(measure).observe(document.body);
      })();
    </script>

    <div class="read-progress" id="read-progress" hidden></div>

    <footer>
      <div class="foot" data-nosnippet>
        <div class="foot-cols">
          <div class="foot-col">
            <p class="label">Index</p>
            <ul>
              {navItems.map(item => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
          </div>
          <div class="foot-col">
            <p class="label">Elsewhere</p>
            <ul>
              {elsewhere.map(l => (
                <li><a href={l.href} target={l.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener">{l.label}</a></li>
              ))}
              <li><a href="/rss/">RSS</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-meta">
          <span class="label">&copy; {new Date().getFullYear()} Arshad Kazi</span>
          <span class="label">End of frame <span class="sig">&#9632;</span></span>
        </div>
      </div>
    </footer>
    <!-- Back to the top: a focus reticle whose arc is how far you have read. -->
    <button class="to-top" id="to-top" type="button" aria-label="Back to top" tabindex="-1">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <circle class="tt-ring" cx="24" cy="24" r="17" />
        <circle class="tt-arc" id="tt-arc" cx="24" cy="24" r="17" pathLength="100" />
        <g class="tt-ticks">
          <path d="M24 1.5v4.5" /><path d="M24 42v4.5" /><path d="M1.5 24h4.5" /><path d="M42 24h4.5" />
        </g>
        <path class="tt-arrow" d="M24 30V18M18.5 23.5 24 18l5.5 5.5" />
      </svg>
      <span class="tt-label">Top</span>
    </button>
    <script is:inline>
      (function () {
        var b = document.getElementById('to-top'), arc = document.getElementById('tt-arc');
        if (!b) return;
        var queued = false, max = 0, was = null;
        function measure() { max = document.documentElement.scrollHeight - innerHeight; update(); }
        function update() {
          queued = false;
          var y = scrollY, p = max > 0 ? Math.min(1, y / max) : 0;
          arc.style.strokeDashoffset = (100 - p * 100).toFixed(1);
          var on = y > innerHeight * 0.6;
          if (on === was) return;
          was = on;
          b.classList.toggle('on', on);
          b.tabIndex = on ? 0 : -1;
        }
        addEventListener('scroll', function () { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
        new ResizeObserver(measure).observe(document.body);
        b.addEventListener('click', function () {
          var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
          scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' });
          b.blur();
        });
        update();
      })();
    </script>
    <script is:inline>
      // A long equation or a wide diagram is scaled to fit its column, so
      // nothing ever needs scrolling sideways. Equations are typeset by a
      // script after the page loads, so each is fitted as it appears, and
      // again whenever a font, a stylesheet or the window changes its size.
      (function () {
        var sel = '.katex-display, .mini-diagram, .arch-diagram, [class*="table-wrap"], .blog-post-content table';
        var seen = window.WeakSet ? new WeakSet() : null, t = 0;
        var ro = window.ResizeObserver ? new ResizeObserver(soon) : null;
        function soon() { clearTimeout(t); t = setTimeout(fit, 60); }
        function fit() {
          document.querySelectorAll(sel).forEach(function (el) {
            if (ro && seen && !seen.has(el) && el.firstElementChild) { seen.add(el); ro.observe(el.firstElementChild); }
            el.style.zoom = '';
            // Too wide for itself, or (a table) too wide for its column.
            var room = el.tagName === 'TABLE' ? el.parentElement.clientWidth : el.clientWidth;
            var over = (el.tagName === 'TABLE' ? el.offsetWidth : el.scrollWidth) / Math.max(1, room);
            if (over > 1.01) el.style.zoom = (1 / over).toFixed(3);
          });
        }
        fit();
        addEventListener('load', fit);
        if (document.fonts) document.fonts.ready.then(fit);
        addEventListener('resize', soon);
        if (window.MutationObserver) new MutationObserver(soon).observe(document.body, { childList: true, subtree: true });
      })();
    </script>
    <script is:inline>
      // "Why I write these" unfolds: the note grows from nothing to its
      // height and fades in, and folds back the same way, instead of
      // appearing or vanishing at once.
      (function () {
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.querySelectorAll('details.why').forEach(function (d) {
          var body = d.querySelector('.why-body'), run = null;
          if (!body || reduce || !body.animate) return;
          d.querySelector('summary').addEventListener('click', function (e) {
            e.preventDefault();
            if (run) run.cancel();
            var closing = d.open;
            if (!closing) d.open = true;
            var h = body.scrollHeight + 'px';
            run = body.animate(
              closing ? [{ height: h, opacity: 1 }, { height: '0px', opacity: 0 }] : [{ height: '0px', opacity: 0 }, { height: h, opacity: 1 }],
              { duration: 420, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)' }
            );
            run.onfinish = function () { run = null; if (closing) d.open = false; };
          });
        });
      })();
    </script>
    <InkPlates />
  </body>
</html>

<script is:inline>
  // How far through the article you are, as a hairline across the top.
  (function () {
    var article = document.querySelector('.blog-post-content');
    var bar = document.getElementById('read-progress');
    if (!article || !bar) return;
    bar.hidden = false;
    // The article is measured when the page changes size, not per scroll.
    var ticking = false, top = 0, height = 0;
    function measure() {
      var r = article.getBoundingClientRect();
      top = r.top + scrollY; height = r.height;
      update();
    }
    function update() {
      ticking = false;
      var total = height - innerHeight * 0.6;
      var done = total > 0 ? (scrollY - top + innerHeight * 0.2) / total : 1;
      bar.style.setProperty('--read', Math.min(1, Math.max(0, done)).toFixed(4));
    }
    function onScroll() {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }
    addEventListener('scroll', onScroll, { passive: true });
    new ResizeObserver(measure).observe(document.body);
  })();

  // The header frosts over once the page has moved, and the viewfinder
  // reads out where the pointer is and how deep into the page you are.
  (function () {
    var head = document.querySelector('body > header');
    var xy = document.getElementById('vf-xy');
    var z = document.getElementById('vf-z');
    // Only the numbers change, and only their text is written.
    z.innerHTML = 'z <b></b>';
    xy.innerHTML = 'x <b></b> &nbsp;y <b></b>';
    var zb = z.firstElementChild, xb = xy.children[0], yb = xy.children[1];
    var ticking = false, max = 0, frosted = null;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        var f = scrollY > 8;
        if (f !== frosted) { frosted = f; head.classList.toggle('scrolled', f); }
        zb.textContent = (max > 0 ? scrollY / max : 0).toFixed(2);
      });
    }
    addEventListener('scroll', onScroll, { passive: true });
    new ResizeObserver(function () { max = document.documentElement.scrollHeight - innerHeight; onScroll(); }).observe(document.body);

    // The header's real height, for anything that has to fill exactly the
    // rest of the screen. It changes when the nav wraps on a phone.
    function measureHead() {
      document.documentElement.style.setProperty('--head-h', head.offsetHeight + 'px');
    }
    measureHead();
    if (window.ResizeObserver) new ResizeObserver(measureHead).observe(head);
    else addEventListener('resize', measureHead);
    if (matchMedia('(hover: hover)').matches) {
      var px = 0, py = 0, moved = false;
      addEventListener('pointermove', function (e) {
        px = e.clientX; py = e.clientY;
        if (moved) return;
        moved = true;
        requestAnimationFrame(function () {
          moved = false;
          xb.textContent = (px / innerWidth).toFixed(3);
          yb.textContent = (py / innerHeight).toFixed(3);
        });
      }, { passive: true });
    }
  })();

  document.getElementById('theme-toggle').addEventListener('click', function (event) {
    const html = document.documentElement;
    const toDark = !html.classList.contains('dark');
    const applyTheme = function () {
      html.classList.toggle('dark', toDark);
      try {
        localStorage.setItem('theme', toDark ? 'dark' : 'light');
        localStorage.removeItem('theme-until');
      } catch (e) {}
    };

    // Ink spreading across the page from wherever the toggle was pressed,
    // rather than the theme just snapping. Falls back to an instant swap
    // where the View Transitions API or motion isn't available.
    var reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.startViewTransition || reduceMotion) {
      applyTheme();
      return;
    }

    var x = event.clientX;
    var y = event.clientY;
    var endRadius = Math.hypot(
      Math.max(x, innerWidth - x),
      Math.max(y, innerHeight - y)
    );

    // The header leaves its own transition group so the whole page is one
    // picture under the circle; the theme and the freeze on transitions go
    // in together, in one style pass.
    var header = document.querySelector('body > header');
    if (header) header.style.viewTransitionName = 'none';
    var transition = document.startViewTransition(function () {
      html.classList.add('theme-swap');
      applyTheme();
    });
    transition.finished.finally(function () {
      html.classList.remove('theme-swap');
      if (header) header.style.viewTransitionName = '';
    });
    transition.ready.then(function () {
      html.animate(
        {
          clipPath: [
            'circle(0px at ' + x + 'px ' + y + 'px)',
            'circle(' + endRadius + 'px at ' + x + 'px ' + y + 'px)',
          ],
        },
        {
          duration: 700,
          easing: 'cubic-bezier(0.65, 0, 0.35, 1)',
          pseudoElement: '::view-transition-new(root)',
        }
      );
    });
  });
</script>

<style is:global>
  @import '../styles/global.css';
</style>
