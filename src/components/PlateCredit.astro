---
/* The credit under a drawing at the head of an index page: which drawing
   this is out of how many, what it is, and who drew it. The whole credit is
   a quiet button: pressing it moves on to the next drawing. The page's
   drawing script fills it in. */
interface Props { credits: { title: string; by: string }[] }
const { credits } = Astro.props;
---

<button type="button" class="plate-meta" aria-label="Next drawing">
  <span class="plate-count"><span class="plate-n">01</span><span class="plate-of"> / {String(credits.length).padStart(2, '0')}</span></span>
  <span class="plate-title"></span>
  <span class="plate-by"></span>
</button>

<style is:global>
  /* The credit, centred under the drawing: a row of ink dots, one for each
     drawing, the current one drawn out into a line that fills as it holds;
     then what it is, and who drew it. */
  .plate-meta {
    position: absolute;
    top: calc(var(--head-h, 4.5rem) + 1.5svh + 46svh + var(--space-2));
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1-5);
    text-align: center;
    white-space: nowrap;
  }
  .plate-meta {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
    pointer-events: auto;
  }
  .plate-count {
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    color: var(--color-text-muted);
    text-shadow: 0 0 4px var(--color-bg), 0 0 8px var(--color-bg);
  }
  .plate-n { color: var(--color-accent); }
  .plate-meta:hover .plate-title { color: var(--color-accent); }
  .plate-title, .plate-by { display: block; }
  .plate-title {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-small);
    line-height: var(--lh-snug);
    color: var(--color-text);
  }
  .plate-by {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    color: var(--color-text-muted);
  }
  /* Each line keeps its height while empty, so the credit is measured at full size. */
  .plate-title,
  .plate-by {
    min-height: 1.35em;
    transition: opacity 0.5s ease;
    /* A soft halo of paper, so the credit reads over the ink behind it. */
    text-shadow: 0 0 4px var(--color-bg), 0 0 8px var(--color-bg), 0 0 14px var(--color-bg);
  }
  .swap .plate-title,
  .swap .plate-by { opacity: 0; }

  /* A short screen: the drawing is shorter, and the credit follows it up. */
  @media (min-width: 760px) and (max-height: 900px) {
    .plate-meta { top: calc(var(--head-h, 4.5rem) + 1.5svh + 32svh + var(--space-2)); }
  }
  @media (min-width: 760px) and (max-height: 700px) {
    .plate-meta { top: calc(var(--head-h, 4.5rem) + 1.5svh + 27svh + var(--space-2)); }
  }
  @media (max-width: 759px) {
    .plate-meta { top: calc(var(--head-h, 5.4rem) + 30svh); gap: 2px; width: max-content; max-width: calc(100vw - 2rem); white-space: normal; }
    .plate-title { text-wrap: balance; }
  }
</style>
