---
/* The credit under a drawing at the head of an index page: a row of
   dots, one for each drawing, the current one drawn out into a line that
   fills as it holds (each can be clicked to go to that drawing); then
   what it is, and who drew it. The page's drawing script fills it in. */
interface Props { credits: { title: string; by: string }[] }
const { credits } = Astro.props;
---

<div class="plate-meta">
  <ol class="plate-dots" aria-label="Drawings">
    {credits.map((c, i) => <li><button type="button" data-i={i} aria-label={`${c.title}, ${c.by}`}></button></li>)}
  </ol>
  <p class="plate-title"></p>
  <p class="plate-by"></p>
</div>

<style is:global>
  /* The credit, centred under the drawing: a row of ink dots, one for each
     drawing, the current one drawn out into a line that fills as it holds;
     then what it is, and who drew it. */
  .plate-meta {
    position: absolute;
    top: calc(var(--head-h, 4.5rem) + 1.5svh + 46svh + var(--space-2));
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1-5);
    text-align: center;
    white-space: nowrap;
  }
  .plate-dots { display: flex; align-items: center; gap: 10px; margin: 0 0 var(--space-1); padding: 0; list-style: none; pointer-events: auto; }
  .plate-dots button {
    position: relative;
    display: block;
    width: 5px;
    height: 5px;
    padding: 0;
    border: 0;
    border-radius: 3px;
    background: var(--color-text-muted);
    opacity: 0.45;
    overflow: hidden;
    cursor: pointer;
    transition: width 0.6s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.4s ease;
  }
  .plate-dots button::before { content: ""; position: absolute; inset: -8px; }
  .plate-dots button:hover { opacity: 0.9; }
  .plate-dots button.on { width: 34px; opacity: 1; background: color-mix(in srgb, var(--color-text-muted) 35%, transparent); }
  .plate-dots button.on::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-accent);
    transform-origin: left;
    animation: plate-fill var(--cycle) linear forwards;
  }
  @keyframes plate-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .plate-title {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-small);
    line-height: var(--lh-snug);
    color: var(--color-text);
  }
  .plate-by {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    color: var(--color-text-muted);
  }
  /* Each line keeps its height while empty, so the credit is measured at full size. */
  .plate-title,
  .plate-by {
    min-height: 1.35em;
    transition: opacity 0.5s ease;
    /* A soft halo of paper, so the credit reads over the ink behind it. */
    text-shadow: 0 0 4px var(--color-bg), 0 0 8px var(--color-bg), 0 0 14px var(--color-bg);
  }
  .plate-dots { filter: drop-shadow(0 0 3px var(--color-bg)) drop-shadow(0 0 6px var(--color-bg)); }
  .swap .plate-title,
  .swap .plate-by { opacity: 0; }

  /* A short screen: the drawing is shorter, and the credit follows it up. */
  @media (min-width: 760px) and (max-height: 900px) {
    .plate-meta { top: calc(var(--head-h, 4.5rem) + 1.5svh + 32svh + var(--space-2)); }
  }
  @media (min-width: 760px) and (max-height: 700px) {
    .plate-meta { top: calc(var(--head-h, 4.5rem) + 1.5svh + 27svh + var(--space-2)); }
  }
  @media (max-width: 759px) {
    .plate-meta { top: calc(var(--head-h, 5.4rem) + 30svh); gap: 2px; width: max-content; max-width: calc(100vw - 2rem); white-space: normal; }
    .plate-title { text-wrap: balance; }
  }
  @media (prefers-reduced-motion: reduce) {
    .plate-dots button.on::after { animation: none; transform: none; }
  }
</style>
