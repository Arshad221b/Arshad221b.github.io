---
/* The header plate's reveal. A sheet of the page's own
   paper is laid over the plate and wiped away in brush strokes, laid down
   from the drawing's centre outward, overlapping, each a moment after the
   last, so the engraving comes through as if someone were painting it in.
   It sits straight after the plate in the markup so the paper is down
   before the plate can show, at every size. Reduced motion gets the
   finished page. */
---
<script is:inline>
  (function () {
    var cover = document.currentScript.previousElementSibling;
    if (!cover || !cover.classList.contains('post-cover')) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var img = cover.querySelector('img');
    var c = document.createElement('canvas');
    c.setAttribute('aria-hidden', 'true');
    c.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;z-index:1;pointer-events:none;transition:opacity .2s ease';
    cover.appendChild(c);

    var W = cover.clientWidth, H = cover.clientHeight, S = 0.5;
    c.width = Math.ceil(W * S);
    c.height = Math.ceil(H * S);
    var g = c.getContext('2d');
    g.fillStyle = getComputedStyle(document.body).backgroundColor;
    g.fillRect(0, 0, c.width, c.height);
    g.scale(S, S);
    g.globalCompositeOperation = 'destination-out';

    // The strokes, ordered from the drawing's centre outward, so the picture
    // is painted from its heart to its edges. On a wide screen that centre
    // sits on the right third; elsewhere the plate is centred.
    var wide = matchMedia('(min-width: 1200px)').matches;
    var cx = W * (wide ? 0.64 : 0.5), cy = H * (wide ? 0.45 : 0.5), strokes = [];
    for (var i = 0; i < 44; i++) {
      var a = (Math.random() - 0.5) * 1.1 + (Math.random() < 0.5 ? 0 : Math.PI);
      strokes.push({
        x: W * (0.18 + Math.random() * 0.84),
        y: H * (0.04 + Math.random() * 0.92),
        dx: Math.cos(a), dy: Math.sin(a),
        len: W * (0.16 + Math.random() * 0.2),
        bend: (Math.random() - 0.5) * 0.8,
        r: H * (0.07 + Math.random() * 0.06),
        done: 0
      });
    }
    strokes.sort(function (p, q) {
      return Math.hypot(p.x - cx, p.y - cy) - Math.hypot(q.x - cx, q.y - cy);
    });
    var T = 650;
    strokes.forEach(function (s, k) {
      s.t0 = (k / strokes.length) * T * 0.6 + Math.random() * 40;
      s.dur = 150 + Math.random() * 110;
    });

    function at(s, u) {
      var o = s.bend * s.len * u * (1 - u) * 2;
      return [s.x + s.dx * s.len * u - s.dy * o, s.y + s.dy * s.len * u + s.dx * o];
    }

    // A round brush with soft edges and a few faint bristles beside it.
    function dab(x, y, r) {
      var grad = g.createRadialGradient(x, y, 0, x, y, r);
      grad.addColorStop(0, 'rgba(0,0,0,0.9)');
      grad.addColorStop(0.6, 'rgba(0,0,0,0.55)');
      grad.addColorStop(1, 'rgba(0,0,0,0)');
      g.fillStyle = grad;
      g.beginPath();
      g.arc(x, y, r, 0, Math.PI * 2);
      g.fill();
      for (var b = 0; b < 2; b++) {
        var br = r * (0.18 + Math.random() * 0.16);
        g.fillStyle = 'rgba(0,0,0,0.22)';
        g.beginPath();
        g.arc(x + (Math.random() - 0.5) * r * 1.3, y + (Math.random() - 0.5) * r * 1.3, br, 0, Math.PI * 2);
        g.fill();
      }
    }

    var start;
    function frame(now) {
      if (start === undefined) start = now;
      var t = now - start;
      strokes.forEach(function (s) {
        var p = Math.min(1, Math.max(0, (t - s.t0) / s.dur));
        p = 1 - Math.pow(1 - p, 2);
        if (p <= s.done) return;
        var steps = Math.max(1, Math.ceil(((p - s.done) * s.len) / (s.r * 0.3)));
        for (var j = 1; j <= steps; j++) {
          var u = s.done + ((p - s.done) * j) / steps;
          var pt = at(s, u);
          dab(pt[0], pt[1], s.r * (0.65 + 0.35 * Math.sin(Math.PI * u)));
        }
        s.done = p;
      });
      if (t < T) requestAnimationFrame(frame);
      else finish();
    }

    var finished = false;
    function finish() {
      if (finished) return;
      finished = true;
      c.style.opacity = '0';
      setTimeout(function () { c.remove(); }, 250);
    }

    // The ink develops with the brush, from the moment it touches.
    function go() {
      if (img && img.getAnimations) {
        img.getAnimations().forEach(function (a) { a.currentTime = 0; a.play(); });
      }
      requestAnimationFrame(frame);
    }
    if (img && !img.complete) {
      img.addEventListener('load', go, { once: true });
      img.addEventListener('error', finish, { once: true });
    } else {
      go();
    }
    setTimeout(finish, 4000);
  })();
</script>
