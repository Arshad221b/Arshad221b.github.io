---
/* Sketches behind a page, one at a time, each drawing itself the way a
   sketch is built: the darkest strokes first, then the lighter lines and
   the shading. It holds, fades, and the next begins. It fills about half
   the screen on the right and dissolves at its edges into the paper. */
interface Props {
  sketches: string[];
  /* 'top': behind the head of the page only, scrolling away with it, so a
     long list below reads on clean paper. */
  place?: 'fixed' | 'top';
}
const { sketches, place = 'fixed' } = Astro.props;
---

<canvas class={`sketch-bg ${place === 'top' ? 'at-top' : ''}`} aria-hidden="true" data-sketches={JSON.stringify(sketches)}></canvas>

<style is:global>
  .sketch-bg {
    position: fixed;
    top: 0;
    right: 0;
    width: 54vw;
    height: 100vh;
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
    /* No frame: the drawing fades out on every side into the paper. */
    -webkit-mask-image: radial-gradient(ellipse 62% 58% at 58% 50%, #000 45%, transparent 100%);
    mask-image: radial-gradient(ellipse 62% 58% at 58% 50%, #000 45%, transparent 100%);
    animation: sketch-drift 16s ease-in-out infinite alternate;
  }

  .sketch-bg.at-top {
    position: absolute;
    height: 100vh;
    -webkit-mask-image: radial-gradient(ellipse 62% 52% at 58% 42%, #000 40%, transparent 100%);
    mask-image: radial-gradient(ellipse 62% 52% at 58% 42%, #000 40%, transparent 100%);
  }

  /* A slow breath, so the page never sits quite still. */
  @keyframes sketch-drift {
    from { transform: scale(1) translate(0, 0); }
    to   { transform: scale(1.05) translate(-1.2vw, 0.8vh); }
  }

  html.dark .sketch-bg {
    filter: invert(1);
    opacity: 0.32;
  }

  @media (max-width: 760px) {
    .sketch-bg {
      width: 100vw;
      opacity: 0.24;
    }

    html.dark .sketch-bg {
      opacity: 0.16;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sketch-bg { animation: none; }
  }
</style>

<script is:inline>
/* The sketches draw themselves. Each pixel's ink is how dark it is; a
   threshold sweeps from dark to light, so the strongest strokes appear
   first and the faint shading last, softly, as a drawing is built up. */
(function () {
  var c = document.querySelector('.sketch-bg');
  if (!c) return;
  var list = JSON.parse(c.dataset.sketches), x = c.getContext('2d');
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var DRAW = 5000, HOLD = 2500, FADE = 1000, GAP = 300;
  var seen = true, observing = false;
  var W = 0, H = 0, dpr = 1, cur = null, idx = 0, t0 = 0, stopped = false;

  function size() {
    var r = c.getBoundingClientRect();
    // A faint background: drawn at half a pixel per CSS pixel and scaled
    // up, which no one can see at its strength and costs a quarter of the
    // work, so nothing else on the page stutters while it draws.
    dpr = 0.5;
    W = r.width; H = r.height;
    c.width = Math.round(W * dpr); c.height = Math.round(H * dpr);
    if (cur) prepare(cur.img);
  }

  // Fit the sketch, and keep its ink (1 - lightness) for every pixel.
  function prepare(img) {
    var k = Math.min(c.width / img.width, c.height / img.height);
    var w = Math.round(img.width * k), h = Math.round(img.height * k);
    var off = document.createElement('canvas'); off.width = w; off.height = h;
    var o = off.getContext('2d');
    // Trim the scan's edges, where the old paper darkens into a frame.
    var m = 0.07, sx = img.width * m, sy = img.height * m;
    o.drawImage(img, sx, sy, img.width - 2 * sx, img.height - 2 * sy, 0, 0, w, h);
    var d = o.getImageData(0, 0, w, h), p = d.data, ink = new Uint8Array(w * h);
    // The paper's tone is the common one (the median), not the lightest
    // speck; ink is anything clearly darker than it.
    var lums = [];
    for (var i = 0; i < p.length; i += 64) lums.push(0.299 * p[i] + 0.587 * p[i + 1] + 0.114 * p[i + 2]);
    lums.sort(function (a, b) { return a - b; });
    var hi = lums[Math.floor(lums.length * 0.6)];
    var count = new Uint32Array(257);
    for (var j = 0, q = 0; j < p.length; j += 4, q++) {
      var lum = (0.299 * p[j] + 0.587 * p[j + 1] + 0.114 * p[j + 2]) / Math.max(1, hi);
      var v = Math.round(255 * Math.max(0, Math.min(1, (0.86 - lum) / 0.55)));
      ink[q] = v; count[v + 1]++;
    }
    // Every inked pixel, sorted by how dark it is, once: each frame then
    // touches only the pixels whose ink is changing, never the paper.
    for (var b = 1; b < 257; b++) count[b] += count[b - 1];
    var start = count.slice(0, 256), order = new Uint32Array(w * h), at = start.slice();
    for (var r = 0; r < ink.length; r++) order[at[ink[r]]++] = r;
    var data = o.createImageData(w, h), out = data.data;
    for (var k = 0; k < out.length; k += 4) { out[k] = 40; out[k + 1] = 30; out[k + 2] = 20; }
    cur = { img: img, w: w, h: h, ink: ink, order: order, start: start, data: data, off: off, oc: o, prev: 1,
            ox: Math.round((c.width - w) / 2), oy: Math.round((c.height - h) / 2) };
  }

  function paint(t) {
    if (!cur) return;
    var a = t < DRAW ? t / DRAW : 1, fade = t > DRAW + HOLD ? Math.max(0, 1 - (t - DRAW - HOLD) / FADE) : 1;
    var th = 1 - Math.pow(a, 0.8) * 1.05;
    if (th < cur.prev) {
      // Only the ink between this threshold and the last one's soft edge
      // changes; darker ink is already whole, lighter not yet begun.
      var out = cur.data.data, order = cur.order, start = cur.start;
      var lo = Math.max(1, Math.floor(th * 255)), hi = Math.min(255, Math.ceil((cur.prev + 0.12) * 255));
      for (var b = lo; b <= hi; b++) {
        var v = b / 255, s = Math.max(0, Math.min(1, (v - th) / 0.12)), al = v * s * 255;
        for (var k = start[b], e = b < 255 ? start[b + 1] : order.length; k < e; k++) out[order[k] * 4 + 3] = al;
      }
      cur.prev = th;
      cur.oc.putImageData(cur.data, 0, 0);
    }
    // The fade is one draw at lower strength, not a pass over the pixels.
    x.clearRect(0, 0, c.width, c.height);
    x.globalAlpha = fade;
    x.drawImage(cur.off, cur.ox, cur.oy);
  }

  function load(n, done) {
    var img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = function () { prepare(img); done(); };
    img.onerror = function () { idx = (idx + 1) % list.length; load(idx, done); };
    img.src = list[n];
  }

  size();
  addEventListener('resize', size);
  load(0, function start() {
    if (reduce) { paint(DRAW); return; }
    if (!observing) {
      observing = true;
      new IntersectionObserver(function (es) { seen = es[0].isIntersecting; }).observe(c);
    }
    t0 = performance.now();
    var last = 0, held = false;
    (function frame(now) {
      var t = now - t0;
      if (t > DRAW + HOLD + FADE + GAP) {
        idx = (idx + 1) % list.length;
        cur = null; x.clearRect(0, 0, c.width, c.height);
        load(idx, start);
        return;
      }
      // About thirty frames a second; nothing at all while the drawing
      // holds still, or while it is scrolled out of sight.
      var holding = t > DRAW && t < DRAW + HOLD;
      if (seen && now - last >= 32 && !(holding && held)) {
        paint(t);
        last = now;
        held = holding;
      }
      requestAnimationFrame(frame);
    })(t0);
  });
})();
</script>
