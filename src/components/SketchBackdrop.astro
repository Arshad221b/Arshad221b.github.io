---
/* Sketches behind a page, one at a time, each drawing itself the way a
   sketch is built: the darkest strokes first, then the lighter lines and
   the shading. It holds, fades, and the next begins. It fills about three
   quarters of the screen from the right and dissolves at its edges into the paper.

   Each sketch is split once, when it loads, into a few sheets by how dark
   its ink is, darkest first, with the soft edge already drawn in. The
   drawing-in is those sheets fading up one after another, and the fade
   out is the stack fading: only opacity and transform ever change, so the
   graphics card does all of it and no frame is painted by script. */
interface Props {
  sketches: string[];
  /* 'top': behind the head of the page only, scrolling away with it, so a
     long list below reads on clean paper. */
  place?: 'fixed' | 'top';
}
const { sketches, place = 'fixed' } = Astro.props;
---

<div class={`sketch-bg ${place === 'top' ? 'at-top' : ''}`} aria-hidden="true" data-sketches={JSON.stringify(sketches)}></div>

<style is:global>
  .sketch-bg {
    position: fixed;
    top: 0;
    right: 0;
    width: 72vw;
    height: 100vh;
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
    will-change: transform;
    animation: sketch-drift 16s ease-in-out infinite alternate;
  }

  .sketch-bg.at-top {
    position: absolute;
  }

  .sketch-bg > div,
  .sketch-bg canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sketch-bg canvas {
    opacity: 0;
  }

  /* A slow breath, so the page never sits quite still. */
  @keyframes sketch-drift {
    from { transform: scale(1) translate(0, 0); }
    to   { transform: scale(1.05) translate(-1.2vw, 0.8vh); }
  }

  html.dark .sketch-bg {
    opacity: 0.32;
  }

  @media (max-width: 760px) {
    .sketch-bg {
      width: 100vw;
      opacity: 0.24;
    }

    html.dark .sketch-bg {
      opacity: 0.16;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sketch-bg { animation: none; }
  }
</style>

<script is:inline>
(function () {
  var box = document.querySelector('.sketch-bg');
  if (!box) return;
  var list = JSON.parse(box.dataset.sketches), top = box.classList.contains('at-top');
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var DRAW = 5000, HOLD = 2500, FADE = 1000, GAP = 300;
  // The sheets, by ink, darkest first; each fades up as the sweep through
  // the darkness of the drawing reaches it.
  var BANDS = [1.01, 0.8, 0.62, 0.46, 0.32, 0.18, 0.04];
  // The soft ellipse it fades into the paper through.
  var E = top ? [0.78, 0.7, 0.55, 0.45, 0.55] : [0.62, 0.58, 0.58, 0.5, 0.45];
  var idx = 0, img = null, stack = null, timer = 0;

  // Half a pixel per CSS pixel: a faint background, scaled up, no one can
  // tell, and a quarter of the work.
  function build(im) {
    var W = Math.round(box.offsetWidth * 0.5), H = Math.round(box.offsetHeight * 0.5);
    if (!W || !H) return null;
    var k = Math.min(W / im.width, H / im.height);
    var w = Math.round(im.width * k), h = Math.round(im.height * k);
    var ox = Math.round((W - w) / 2), oy = Math.round((H - h) / 2);
    var o = document.createElement('canvas'); o.width = w; o.height = h;
    var g = o.getContext('2d', { willReadFrequently: true });
    // Trim the scan's edges, where the old paper darkens into a frame.
    var m = 0.07, sx = im.width * m, sy = im.height * m;
    g.drawImage(im, sx, sy, im.width - 2 * sx, im.height - 2 * sy, 0, 0, w, h);
    var p = g.getImageData(0, 0, w, h).data;
    // The paper's tone is the common one (the median), not the lightest
    // speck; ink is anything clearly darker than it.
    var lums = [];
    for (var i = 0; i < p.length; i += 64) lums.push(0.299 * p[i] + 0.587 * p[i + 1] + 0.114 * p[i + 2]);
    lums.sort(function (a, b) { return a - b; });
    var hi = Math.max(1, lums[Math.floor(lums.length * 0.6)]);
    // The ink is drawn in the theme's own colour, so nothing is filtered.
    var ink = document.documentElement.classList.contains('dark') ? [215, 225, 235] : [40, 30, 20];
    var sheets = BANDS.slice(1).map(function () { return g.createImageData(w, h); });
    for (var y = 0, q = 0; y < h; y++) {
      var ny = ((oy + y) / H - E[3]) / E[1];
      for (var x = 0; x < w; x++, q += 4) {
        var v = (0.86 - (0.299 * p[q] + 0.587 * p[q + 1] + 0.114 * p[q + 2]) / hi) / 0.55;
        if (v <= BANDS[BANDS.length - 1]) continue;
        if (v > 1) v = 1;
        var nx = ((ox + x) / W - E[2]) / E[0], r = Math.sqrt(nx * nx + ny * ny);
        var fade = r <= E[4] ? 1 : r >= 1 ? 0 : 1 - (r - E[4]) / (1 - E[4]);
        if (!fade) continue;
        var b = 1;
        while (v <= BANDS[b]) b++;
        var d = sheets[b - 1].data;
        d[q] = ink[0]; d[q + 1] = ink[1]; d[q + 2] = ink[2]; d[q + 3] = v * fade * 255;
      }
    }
    var s = document.createElement('div');
    sheets.forEach(function (d) {
      var c = document.createElement('canvas'); c.width = W; c.height = H;
      c.getContext('2d').putImageData(d, ox, oy);
      s.appendChild(c);
    });
    return s;
  }

  // When the sweep through the darkness reaches a given ink: the same pace
  // the drawing always had.
  function at(v) { return DRAW * Math.pow(Math.max(0, (1 - v) / 1.05), 1.25); }

  function play(s) {
    if (stack) stack.remove();
    stack = s;
    box.appendChild(s);
    var cs = s.children;
    if (reduce) { for (var j = 0; j < cs.length; j++) cs[j].style.opacity = 1; return; }
    for (var i = 0; i < cs.length; i++) {
      var t0 = at(Math.min(1, BANDS[i])), t1 = at(Math.max(0, BANDS[i + 1] - 0.12));
      cs[i].animate([{ opacity: 0 }, { opacity: 1 }], { delay: t0, duration: Math.max(300, t1 - t0), easing: 'ease-out', fill: 'forwards' });
    }
    s.animate([{ opacity: 1 }, { opacity: 0 }], { delay: DRAW + HOLD, duration: FADE, easing: 'ease-in', fill: 'forwards' });
    timer = setTimeout(next, DRAW + HOLD + FADE + GAP);
  }

  function show(im) {
    img = im;
    var s = build(im);
    if (s) play(s);
  }

  function next() {
    idx = (idx + 1) % list.length;
    load(idx);
  }

  function load(n) {
    var im = new Image();
    im.crossOrigin = 'anonymous';
    im.onload = function () { show(im); };
    im.onerror = function () { setTimeout(next, GAP); };
    im.src = list[n];
  }

  // A new size or theme draws the current sketch again, from the start.
  function redo() { clearTimeout(timer); if (img) show(img); }
  var rt = 0, size = box.offsetWidth + 'x' + box.offsetHeight;
  addEventListener('resize', function () {
    clearTimeout(rt);
    rt = setTimeout(function () {
      // A phone's bar sliding away is not a new size for the sketch.
      var now = box.offsetWidth + 'x' + box.offsetHeight;
      if (now !== size) { size = now; redo(); }
    }, 250);
  });
  new MutationObserver(function (ms) {
    var dark = document.documentElement.classList.contains('dark');
    if (ms.some(function (m) { return (m.oldValue || '').indexOf('dark') !== -1 !== dark; })) redo();
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'], attributeOldValue: true });

  load(0);
})();
</script>
