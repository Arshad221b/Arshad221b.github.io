    for (var yy = 0; yy < DS; yy++) for (var xx = 0, q = (iy + yy) * BW + ix; xx < DS; xx++, q++) if ((p32[q] >>> 24) < a) p32[q] = v;
  }

  // One dot, darkest wins where two land on the same pixel.
  function plot(x, y, A) {
    var ix = (x * dpr) | 0, iy = (y * dpr) | 0;
    if (ix < 0 || iy < 0 || ix >= BW || iy >= BH) return;
    var q = iy * BW + ix, a = A | 0;
    if ((p32[q] >>> 24) < a) p32[q] = ((a << 24) | RGB) >>> 0;
  }

  // Still, for those who'd rather not have motion: the drawing, in dots.
  function still() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(' + INK.join(',') + ',0.6)';
    for (var i = 0; i < N; i++) if (ta[i] > 0) ctx.fillRect(tx[i], ty[i], 1.25, 1.25);
  }

  function load(n, done) {
    var im = new Image();
    im.crossOrigin = 'anonymous';
    im.open = !!(credits[n] && credits[n].open);
    im.onload = function () { images[n] = im; done && done(); };
    // A drawing that won't load leaves the cycle instead of stalling it.
    im.onerror = function () { if (list.length < 2) return; list.splice(n, 1); credits.splice(n, 1); images.splice(n, 1); targets.splice(n, 1); if (n <= idx) idx--; load(n % list.length, done); };
    im.src = list[n];
  }

  layout(); ink(); size();
  // Start only once the page has given the drawing a real size: an image
  // that arrives before the layout would be sampled at zero and stall.
  load(0, function start() {
    layout(); size();
    if (!W || !H || (!roving && !document.querySelector('.first-screen .page-statement'))) { setTimeout(start, 60); return; }
    targets = [];
    begin(performance.now());
    if (curT && !curT.ink) inkOf(curT);   // before the first frame, not at the first settle
    if (reduce) { still(); return; }
    requestAnimationFrame(frame);
  });

  // The drawing is the control: pressing it (or its credit) scatters the ink
  // into the next one.
  function next() {
    var n = (idx + 1) % list.length;
    var go = function () { idx = n; begin(performance.now()); if (reduce) still(); };
    plate.classList.remove('settled');
    images[n] ? go() : load(n, go);
  }
  nextBtn.addEventListener('click', next);

  // The index: every drawing in the pool. Choosing one makes it the next to
  // form, whether or not it was among this visit's draw.
  var dlg = plate.querySelector('.plate-index');
  plate.querySelector('.plate-all').addEventListener('click', function () { dlg.showModal(); });
  dlg.querySelector('.pi-close').addEventListener('click', function () { dlg.close(); });
  dlg.addEventListener('click', function (ev) {
    if (ev.target === dlg) { dlg.close(); return; }
    var b = ev.target.closest('button[data-i]'); if (!b) return;
    var u = allList[+b.dataset.i], c = allCredits[+b.dataset.i], at = list.indexOf(u);
    dlg.close();
    if (at === idx) return;
    var im = null, tg = null;
    if (at >= 0) { im = images[at]; tg = targets[at]; list.splice(at, 1); credits.splice(at, 1); images.splice(at, 1); targets.splice(at, 1); if (at < idx) idx--; }
    list.splice(idx + 1, 0, u); credits.splice(idx + 1, 0, c); images.splice(idx + 1, 0, im || undefined); targets.splice(idx + 1, 0, tg || undefined);
    next();
  });
  art.addEventListener('click', next);

  var rt = 0;
  addEventListener('resize', function () {
    clearTimeout(rt);
    rt = setTimeout(function () {
      if (canvas.offsetWidth === W && canvas.offsetHeight === H) return;  // a phone's bar sliding away
      layout(); size(); if (images[idx]) { aim(); if (reduce) still(); }
    }, 250);
  });
  new MutationObserver(function () { ink(); targets.forEach(function (T) { if (T) T.ink = null; }); if (reduce && tx) still(); })
    .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  addEventListener('pointermove', function (e) {
    var r = canvas.getBoundingClientRect();
    mx = e.clientX - r.left; my = e.clientY - r.top; moved = performance.now();
  }, { passive: true });
  addEventListener('pointerleave', function () { mx = my = -1e4; });

  // The page can say which place to form in: plate:slot with the element.
  plate.addEventListener('plate:slot', function (e) { if (e.detail && tx) switchTo(e.detail); });


  var ticking = false;
  addEventListener('scroll', function () {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () {
      ticking = false;
      if (roving) { follow(); return; }
      var s = Math.min(1, scrollY / (innerHeight * 0.8));
      plate.style.setProperty('--scroll', s.toFixed(3));
      visible = s < 1;
    });
  }, { passive: true });
});
</script>
