---
/* The head of an index page: each drawing rebuilt from thousands of
   particles of ink. They drift in as scattered dust and settle into the
   strokes, denser where the ink is darker; the drawing holds and
   breathes; then it lets go into a slow current, and the same particles
   gather into the next drawing. A pointer moving through parts the ink,
   and it closes again behind it. A small index names the drawing, with a
   row of segments for where it sits in the set. On a phone it has a band
   of its own above the words; scrolling away lifts it and lets it fade.

   Each scan is read once: its paper dropped, and points sampled from its
   ink in proportion to how dark it is. Drawn on one canvas, in the
   theme's ink, and paused whenever it is out of sight. */
interface Props { sketches: string[]; credits: { title: string; by: string; india?: boolean; note?: string; open?: boolean }[] }
const { sketches, credits } = Astro.props;
import PlateCredit from './PlateCredit.astro';
---

<div class="plate" data-sketches={JSON.stringify(sketches)} data-credits={JSON.stringify(credits)}>
  <canvas class="plate-canvas" aria-hidden="true"></canvas>
  <div class="plate-art" aria-hidden="true"></div>
  <PlateCredit credits={credits} />
  <button type="button" class="plate-all" aria-label="All drawings" title="All drawings"><svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">{[3, 9, 15].flatMap(y => [3, 9, 15].map(x => <circle cx={x} cy={y} r="1.6" />))}</svg></button>
  <dialog class="plate-index" aria-label="All drawings">
    <div class="pi-bar"><button type="button" class="pi-close" aria-label="Close"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" /></svg></button></div>
    <div class="pi-body">
    {[['India', true], ['Elsewhere', false]].map(([name, ind]) => (
      <section>
        <h2>{name}</h2>
        <ol>
          {credits.map((c, i) => !!c.india === ind && (
            <li><button type="button" data-i={i}>
              <span class="pi-t">{c.title}</span>
              <span class="pi-by">{c.by}</span>
              {c.note && <span class="pi-note">{c.note}</span>}
            </button></li>
          ))}
        </ol>
      </section>
    ))}
    </div>
  </dialog>
</div>

<style is:global>
  /* The way into the whole collection: small, quiet, out of the drawing's way. */
  .plate-all {
    position: absolute;
    top: calc(var(--head-h, 4.5rem) + 0.25rem);
    right: max(24px, 2vw);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text-muted);
    opacity: 0.7;
    cursor: pointer;
    pointer-events: auto;
    transition: opacity 0.3s ease, color 0.3s ease;
  }
  .plate-all svg { fill: currentColor; }
  .plate-all:hover, .plate-all:focus-visible { opacity: 1; color: var(--color-accent); }
  @media (max-width: 759px) { .plate-all { right: 6px; } }

  .plate-index {
    width: min(760px, calc(100vw - 32px));
    max-height: min(82svh, 900px);
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent);
    border-radius: 8px;
    background: var(--color-bg);
    color: var(--color-text);
    overflow: hidden;
    pointer-events: auto;   /* the page's head lets clicks through to the drawing; the index must not */
  }
  .plate-index[open] { display: flex; flex-direction: column; }
  .plate-index::backdrop { background: color-mix(in srgb, var(--color-bg) 55%, transparent); backdrop-filter: blur(6px); }
  /* Only the list scrolls; the page behind stays where it was. */
  html:has(.plate-index[open]) { overflow: hidden; }
  .plate-index .pi-bar { flex: none; display: flex; justify-content: flex-end; padding: 10px 10px 0; }
  .plate-index .pi-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: auto;
    padding: 0 var(--space-6, 2rem) var(--space-6, 2rem);
  }
  .plate-index .pi-close {
    display: grid; place-items: center;
    width: 36px; height: 36px; padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-text) 16%, transparent);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .plate-index .pi-close svg { stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; fill: none; }
  .plate-index .pi-close:hover, .plate-index .pi-close:focus-visible { color: var(--color-accent); border-color: var(--color-accent); transform: rotate(90deg); }
  @media (max-width: 759px) { .plate-index .pi-body { padding: 0 18px 24px; } }
  .plate-index h2 {
    margin: 0 0 var(--space-2, 0.5rem);
    font-family: var(--font-sans); font-size: var(--fs-label); font-weight: 500;
    text-transform: uppercase; letter-spacing: var(--track-label); color: var(--color-text-muted);
  }
  .plate-index section + section { margin-top: var(--space-6, 2rem); }
  .plate-index ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 0 var(--space-6, 2rem); }
  .plate-index li { border-top: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent); }
  .plate-index li button {
    display: grid; gap: 2px; width: 100%; padding: 0.7rem 0; border: 0; background: none;
    color: inherit; font: inherit; text-align: left; cursor: pointer;
  }
  .plate-index .pi-t { font-family: var(--font-serif); font-style: italic; font-size: var(--fs-small); line-height: var(--lh-snug); }
  .plate-index .pi-by { font-family: var(--font-sans); font-size: var(--fs-label); text-transform: uppercase; letter-spacing: var(--track-label); color: var(--color-text-muted); }
  .plate-index .pi-note { margin-top: 2px; font-size: var(--fs-small); line-height: var(--lh-snug); color: var(--color-text-muted); }
  .plate-index li button:hover .pi-t { color: var(--color-accent); }
</style>

<style is:global>
  .plate {
    --scroll: 0;
    --cycle: 9s;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    /* The whole window, free of the reading column's measure. */
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    height: 100svh;
    pointer-events: none;
    z-index: 0;
    opacity: calc(1 - var(--scroll));
    transform: translateY(calc(var(--scroll) * -6svh));
  }
  .plate .plate-canvas { position: absolute; inset: 0; width: 100% !important; height: 100% !important; max-width: none !important; }

  /* Where the drawing forms: the open middle, between the name and the sentence. */
  .plate-art {
    pointer-events: auto;
    cursor: pointer;
    position: absolute;
    top: calc(var(--head-h, 4.5rem) + 1.5svh);
    left: 50%;
    width: min(70vw, 110svh);
    height: 46svh;
    transform: translateX(-50%);
  }

  /* Roving: the drawing's place is in the page, so the plate is part of
     the page and scrolls with it natively; nothing chases the scroll. */
  .plate.roving {
    position: absolute;
    height: 100svh;
    opacity: 1 !important;
    transform: none !important;
  }
  .plate.roving .plate-art { pointer-events: none; }
  .plate.roving .plate-all { display: none; }

  /* While the note is open, the drawing steps back for the reading. */
  body:has(.first-screen .why[open]) .plate { opacity: 0.1; transition: opacity var(--dur-base) ease; }

  @media (min-width: 760px) and (max-height: 900px) {
    .plate-art { height: 32svh; }
  }
  @media (min-width: 760px) and (max-height: 700px) {
    .plate-art { height: 27svh; }
  }

  @media (max-width: 759px) {
    .plate-art { top: calc(var(--head-h, 5.4rem) + 0.5rem); width: calc(100% - 2rem); height: 29svh; }
  }

  @media (prefers-reduced-motion: reduce) {
    .plate { transform: none; }
  }
</style>

<script is:inline>
// Started once the page is read, so a page's places for the drawing exist.
(function (run) { if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run(); })(function () {
  var plate = document.querySelector('.plate');
  if (!plate) return;
  var canvas = plate.querySelector('canvas'), ctx = canvas.getContext('2d');
  var art = plate.querySelector('.plate-art');
  var list = JSON.parse(plate.dataset.sketches), credits = JSON.parse(plate.dataset.credits);
  // Ask for each drawing at the width this screen needs, not the largest.
  (function () {
    var need = Math.min(1600, Math.ceil(Math.max(innerWidth * 0.95, innerHeight * 0.6) * Math.min(innerWidth < 760 ? 3 : 2, devicePixelRatio || 1) / 200) * 200);
    list = list.map(function (u) { return u.replace('w_1600', 'w_' + need); });
  })();
  var allList = list.slice(), allCredits = credits.slice();
  // Roving: a page may give each of its parts a place for the drawing
  // (.plate-slot, holding in data-set the drawings that belong there). The
  // drawing then forms in the part being read, moves with it as the page
  // scrolls, and pours into the next part's place when you reach it.
  var slots = [].slice.call(document.querySelectorAll('.plate-slot[data-set]'));
  var roving = slots.length > 0, base = 0, dy = 0, switchToken = 0;
  // Start in the place that is on show (a page may hide all but one).
  var slot = roving ? (slots.filter(function (el) { return el.offsetParent; })[0] || slots[0]) : null;
  // A place's drawings, in a new order every time it is shown.
  function setOf(el) {
    var a = []; try { a = JSON.parse(el.dataset.set); } catch (e) {}
    for (var i = a.length - 1; i > 0; i--) { var r = (Math.random() * (i + 1)) | 0, t = a[i]; a[i] = a[r]; a[r] = t; }
    return a;
  }
  if (roving) plate.classList.add('roving');
  // A different set and order on every visit, alternating one Indian drawing and
  // one from elsewhere: each group shuffled, then interleaved, starting
  // with either.
  if (roving) {
    var set0 = setOf(slot);
    list = set0.map(function (i) { return allList[i]; });
    credits = set0.map(function (i) { return allCredits[i]; });
  } else (function () {
    function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var r = (Math.random() * (i + 1)) | 0, t = a[i]; a[i] = a[r]; a[r] = t; } return a; }
    var ind = [], oth = [];
    credits.forEach(function (c, i) { (c.india ? ind : oth).push(i); });
    // Each page keeps a larger pool; a visit draws seven of each from it.
    shuffle(ind); shuffle(oth); ind = ind.slice(0, 7); oth = oth.slice(0, 7);
    var first = Math.random() < 0.5 ? ind : oth, second = first === ind ? oth : ind, o = [];
    for (var k = 0; k < Math.max(ind.length, oth.length); k++) { if (k < first.length) o.push(first[k]); if (k < second.length) o.push(second[k]); }
    list = o.map(function (i) { return list[i]; }); credits = o.map(function (i) { return credits[i]; });
  })();
  var nextBtn = plate.querySelector('.plate-meta');
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var FORM = 3400, HOLD = 4200, LET = 3600;
  plate.style.setProperty('--cycle', (FORM + HOLD + LET) / 1000 + 's');

  var W = 0, H = 0, dpr = 1, N = 0;
  var px, py, vx, vy, tx, ty, ta;                // position, drift, target
  var sx, sy, dl, sw, ar, ph, ca, oa, fx, fy;     // start, delay, swirl, arc, phase, alpha, pointer offset
  var e1x, e1y, e2x, e2y, e3x, e3y;               // where each particle's three echoes sit, relative to it
  var nox, noy, mul, gl;   // gl: when each particle answers the gather, 0 to ~0.5 of the way in                              // each particle's own offset into the current, and its own drift strength
  // A table of random numbers, read in a shifting order: tremor without
  // calling the random generator for every particle on every frame.
  var RT = new Float32Array(8192); for (var ri = 0; ri < RT.length; ri++) RT[ri] = Math.random() * 2 - 1;
  var tick = 0;
  var images = [], targets = [], idx = 0, phase = 'form', t0 = 0;
  var mx = -1e4, my = -1e4, INK = [34, 28, 22], RGB = 0;
  var buf, bctx, pix, p32, BW = 0, BH = 0, mgx = 1, mgy = 1;

  function size() {
    // Phones draw at their full density (up to 3×): the drawing is small there,
    // so it costs little, and anything less is visibly soft.
    dpr = Math.min(innerWidth < 760 ? 3 : 2, devicePixelRatio || 1);
    W = canvas.offsetWidth; H = canvas.offsetHeight;
    canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.imageSmoothingEnabled = false;
    // Particles are plotted straight into a pixel buffer and drawn up in one
    // call: the cost hardly grows with the number of dots.
    // At the screen's own density (up to 2x), so a phone's dots stay fine.
    BW = Math.round(W * dpr); BH = Math.round(H * dpr);
    DS = dpr >= 2.5 ? 4 : dpr > 1 ? 3 : 2;   // about the same dot size on every screen
    buf = document.createElement('canvas'); buf.width = BW; buf.height = BH;
    bctx = buf.getContext('2d'); pix = bctx.createImageData(BW, BH); p32 = new Uint32Array(pix.data.buffer);
    var n = W < 760 ? 24000 : W < 1500 ? 22000 : 28000;
    // A drawing in a small place takes fewer particles, or it clogs into a blot.
    if (roving) { var ar0 = art.getBoundingClientRect(); n = Math.round(Math.max(4000, Math.min(n, ar0.width * ar0.height * 0.075))); }
    if (n !== N) {
      N = n;
      var F = function () { return new Float32Array(N); };
      px = F(); py = F(); vx = F(); vy = F(); tx = F(); ty = F(); ta = F();
      sx = F(); sy = F(); dl = F(); sw = F(); ar = F(); ph = F(); ca = F(); oa = F(); fx = F(); fy = F();
      e1x = F(); e1y = F(); e2x = F(); e2y = F(); e3x = F(); e3y = F(); nox = F(); noy = F(); mul = F(); gl = F();
      // The first arrival: a soft cloud of dust around where the drawing will form.
      var a = art.getBoundingClientRect(), c = canvas.getBoundingClientRect();
      var cx = a.left - c.left + a.width / 2, cy = a.top - c.top + a.height / 2;
      for (var i = 0; i < N; i++) {
        var g1 = Math.sqrt(-2 * Math.log(Math.random() + 1e-9)), g2 = Math.random() * 6.283;
        px[i] = cx + Math.cos(g2) * g1 * a.width * 0.45;
        py[i] = cy + Math.sin(g2) * g1 * a.height * 0.6;
        dl[i] = Math.random() * 0.4;
        sw[i] = Math.random() * 6.283;
        ar[i] = 20 + Math.random() * 70;
        ph[i] = Math.random() * 6.283;
        // Two echoes at fixed random offsets, mostly near, a few far.
        var r1 = Math.pow(Math.random(), 1.6), a1 = Math.random() * 6.283, r2 = Math.pow(Math.random(), 1.6), a2 = Math.random() * 6.283;
        e1x[i] = Math.cos(a1) * r1; e1y[i] = Math.sin(a1) * r1; e2x[i] = Math.cos(a2) * r2; e2y[i] = Math.sin(a2) * r2;
        var r3 = Math.pow(Math.random(), 1.3), a3 = Math.random() * 6.283;
        e3x[i] = Math.cos(a3) * r3 * 1.3; e3y[i] = Math.sin(a3) * r3 * 1.3;
        nox[i] = (Math.random() - 0.5) * 160; noy[i] = (Math.random() - 0.5) * 160;
        mul[i] = 0.5 + Math.pow(Math.random(), 1.5) * 1.2;
      }
    }
    targets = [];
  }
  // Fit the drawing to the free space of the opening: from under the
  // header to just above the words (the sentence on a wide screen, the
  // page's name on a phone). The credit sits at the foot of that space and
  // the drawing takes everything above it. CSS places them until this runs.
  var meta = plate.querySelector('.plate-meta'), fitted = '';
  function layout() {
    if (roving) return place();
    var head = document.querySelector('header'), below = document.querySelector('.first-screen .page-statement');
    if (!head || !below) return false;
    var top0 = plate.getBoundingClientRect().top;
    var from = head.getBoundingClientRect().bottom - top0 + 12;
    var to = below.getBoundingClientRect().top - top0 - (innerWidth < 760 ? 14 : 22);
    var ch = meta.offsetHeight, h = Math.round(to - from - ch - 10);
    if (h < 120) return false;                                      // too little room: keep the CSS layout
    var key = from + ':' + h + ':' + to + ':' + innerWidth;
    if (key === fitted) return false;
    fitted = key;
    art.style.top = Math.round(from) + 'px';
    art.style.height = h + 'px';
    // Nearly the whole width: a wide drawing spreads across the screen, a
    // tall one takes the full height; each keeps its own proportions.
    art.style.width = Math.round(innerWidth - (innerWidth < 760 ? 32 : Math.max(48, innerWidth * 0.04))) + 'px';
    meta.style.top = Math.round(to - ch) + 'px';
    return true;
  }
  // The drawing's area: the slot, where it is now on the screen.
  // Where the slot sits relative to the plate. On a wide screen the plate is
  // fixed to the screen (its top is 0); on a phone it is part of the page
  // and scrolls with it natively, so nothing has to follow at all.
  function plateTop() { return plate.getBoundingClientRect().top; }
  // Nowhere to draw (the place is folded away or not shown): clear the ink.
  function hide() {
    visible = false;
    if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);
    meta.style.opacity = '0';
  }
  function place() {
    var r = slot.getBoundingClientRect(), mh = meta.offsetHeight, pt = plateTop();
    if (r.width < 60 || r.height < 120) { hide(); return false; }
    // A place found again (after a layout pass saw none): draw again.
    visible = true; meta.style.opacity = '';
    // The ink stays within its place (a little margin to breathe), never
    // spraying across the rest of the page.
    var pr = plate.getBoundingClientRect(), mg = 28;
    canvas.style.clipPath = 'inset(' + Math.max(0, r.top - pr.top - mg) + 'px ' + Math.max(0, pr.right - r.right - mg) + 'px ' +
      Math.max(0, pr.bottom - r.bottom - mg) + 'px ' + Math.max(0, r.left - pr.left - mg) + 'px)';
    base = r.top - pt; shift = 0; bakeDue = false; clearTimeout(bakeT);
    canvas.style.transform = ''; meta.style.transform = 'translateX(-50%)';
    art.style.transform = 'none';
    art.style.left = Math.round(r.left) + 'px';
    art.style.top = Math.round(r.top - pt) + 'px';
    art.style.width = Math.round(r.width) + 'px';
    art.style.height = Math.round(r.height - mh - 14) + 'px';
    meta.style.top = Math.round(r.bottom - pt - mh) + 'px';
    meta.style.left = Math.round(r.left + r.width / 2) + 'px';
    fitted = '';
    return true;
  }
  // Follow the slot as the page scrolls. While the page moves, the canvas
  // and its credit move with it by transform alone, which every device does
  // smoothly, even mid-fling on a phone. Once it rests, the shift is folded
  // into the ink itself (in a frame that also redraws, so nothing jumps),
  // but only while the place is on screen, so the drawing never ends up
  // outside the canvas.
  var scrolledAt = 0, shift = 0, bakeT = 0, bakeDue = false;
  function follow() {
    var r = slot.getBoundingClientRect();
    if (!r.width) { if (visible) hide(); return; }
    meta.style.opacity = '';
    visible = r.bottom > -innerHeight * 0.6 && r.top < innerHeight * 1.6;
    shift = r.top - plateTop() - base;
    if (!shift) { if (canvas.style.transform) { canvas.style.transform = ''; meta.style.transform = 'translateX(-50%)'; } return; }
    canvas.style.transform = shift ? 'translate3d(0,' + shift.toFixed(1) + 'px,0)' : '';
    meta.style.transform = 'translate(-50%,' + shift.toFixed(1) + 'px)';
    scrolledAt = performance.now();
    clearTimeout(bakeT);
    bakeT = setTimeout(function () { bakeDue = true; }, 160);
  }
  function bake() {
    bakeDue = false;
    var r = slot.getBoundingClientRect(), pt = plateTop(), d = r.top - pt - base;
    if (!d || r.bottom < 0 || r.top > innerHeight) return;
    if (py) for (var i = 0; i < N; i++) { py[i] += d; ty[i] += d; }
    targets.forEach(function (T) { if (!T) return; for (var j = 0; j < T.y.length; j++) T.y[j] += d; if (T.ink) T.iy += d; });
    art.style.top = Math.round(r.top - pt) + 'px';
    meta.style.top = Math.round(r.bottom - pt - meta.offsetHeight) + 'px';
    base = r.top - pt; shift = 0;
    canvas.style.transform = ''; meta.style.transform = 'translateX(-50%)';
  }
  // Reaching another part: its drawings, poured in from where the ink is.
  function switchTo(el) {
    // The same place, already drawn in: nothing to do. (Shown again after
    // being hidden, it is drawn afresh.)
    if (el === slot && visible) return;
    var token = ++switchToken;
    slot = el;
    var set1 = setOf(el);
    list = set1.map(function (i) { return allList[i]; });
    credits = set1.map(function (i) { return allCredits[i]; });
    images = []; targets = []; idx = 0;
    if (!place()) return;
    size(); visible = true; meta.style.opacity = '';
    plate.classList.remove('settled');
    load(0, function () { if (token !== switchToken) return; begin(performance.now()); if (reduce) still(); });
  }

  // The words come after this script in the page, so fit once they exist,
  // again when the fonts settle, and whenever the opening changes size.
  function refit() { if (layout() && images[idx]) { targets = []; size(); aim(); if (reduce) still(); } }
  function watch() {
    refit();
    if (document.fonts) document.fonts.ready.then(refit);
    var fs = document.querySelector('.first-screen');
    if (fs && window.ResizeObserver) new ResizeObserver(refit).observe(fs);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', watch); else watch();

  function ink() {
    INK = document.documentElement.classList.contains('dark') ? [225, 228, 232] : [34, 28, 22];
    RGB = (INK[2] << 16) | (INK[1] << 8) | INK[0];
  }

  // Points of ink from a scan, sampled in proportion to how dark it is,
  // placed in the drawing's area and fading out towards its edge.
  // The fade at a picture's edge: a thin soft margin for an open drawing,
  // an oval for a picture that fills its frame.
  function edgeFade(nx, ny, open) {
    if (open) { var ex = (1 - Math.abs(nx)) / 0.04, ey = (1 - Math.abs(ny)) / 0.04; return (ex < 1 ? ex : 1) * (ey < 1 ? ey : 1); }
    var r = Math.sqrt(nx * nx + ny * ny);
    return r <= 0.62 ? 1 : r >= 1 ? 0 : 1 - (r - 0.62) / 0.38;
  }
  function sample(im) {
    var a = art.getBoundingClientRect(), c = canvas.getBoundingClientRect();
    var k = Math.min(a.width / im.width, a.height / im.height) * (W < 760 ? 1 : 0.5);   // small screens read at full size
    var w = Math.max(1, Math.round(im.width * k)), h = Math.max(1, Math.round(im.height * k));
