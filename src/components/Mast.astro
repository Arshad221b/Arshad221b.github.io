---
/* The head of an index page, in the About page's hand: the running head,
   the title at the hero's weight with its last word in the accent, written
   settling in as the page opens, a lede, and the figures of the collection. Anything else (a folded note) goes in the slot. */
interface Props {
  label: string;
  aside: string;
  title: string;
  accent: string;
  lede: string;
  figures?: { k: string; v: string | number }[];
}
const { label, aside, title, accent, lede, figures = [] } = Astro.props;
---

<header class="mast">
  <div class="mast-rule">
    <span>{label}</span>
    <span class="mast-line"></span>
    <span>{aside}</span>
  </div>

  <h1 class="mast-title">{title} <em>{accent}</em></h1>

  <p class="mast-lede">{lede}</p>

  {figures.length > 0 && (
    <dl class="mast-figures">
      {figures.map(f => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
    </dl>
  )}

  <slot />
</header>

<style>
  .mast {
    margin-bottom: var(--space-2xl);
  }

  .mast-rule {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* On a narrow phone the two labels share the line by wrapping, not by
     running off it. */
  @media (max-width: 480px) {
    .mast-rule {
      flex-wrap: wrap;
      row-gap: var(--space-1);
    }
  }

  .mast-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .mast-title {
    font-size: var(--fs-display);
    font-weight: var(--fw-display);
    line-height: var(--lh-display);
    letter-spacing: var(--track-tight);
    margin: var(--space-xl) 0 var(--space-md);
  }

  .mast-title em {
    font-style: italic;
    font-weight: var(--fw-light);
    color: var(--color-accent);
  }

  .mast-lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-body);
    line-height: var(--lh-ui);
    color: var(--color-text-secondary);
    max-width: 54ch;
    margin: 0;
  }

  .mast-figures {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    margin: var(--space-xl) 0 0;
    padding: var(--space-md) 0 0;
    border-top: 1px solid var(--color-border);
  }

  .mast-figures > div {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-1);
  }

  .mast-figures > div:nth-child(1) { animation-delay: 0.35s; }
  .mast-figures > div:nth-child(2) { animation-delay: 0.4s; }
  .mast-figures > div:nth-child(3) { animation-delay: 0.45s; }
  .mast-figures > div:nth-child(4) { animation-delay: 0.5s; }

  .mast-figures dt {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .mast-figures dd {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: var(--fw-display);
    letter-spacing: var(--track-tight);
    line-height: var(--lh-none);
    color: var(--color-text);
    margin: 0;
  }


  @media (max-width: 600px) {
    .mast-figures {
      grid-template-columns: repeat(2, 1fr);
      row-gap: var(--space-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mast-title, .mast-lede, .mast-figures > div { animation: none; }
  }
</style>
