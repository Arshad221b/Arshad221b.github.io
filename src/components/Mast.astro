---
/* The head of an index page, said as one sentence rather than shown as a
   title and a table of numbers: the page's name small above, then what
   the collection is, its counts in the accent, at a reading-display size.
   On Blogs and Thoughts the sentence runs on into the search below it
   ("Find the one about …"). Anything else (a folded note) goes in the
   slot. The statement may carry <em> for the counts. */
interface Props {
  name: string;
  statement: string;
}
const { name, statement } = Astro.props;
---

<header class="mast">
  <h1 class="page-name">{name}</h1>
  <p class="page-statement" set:html={statement} />
  <slot />
</header>

<style>
  .mast {
    margin-bottom: var(--space-2xl);
  }
</style>
