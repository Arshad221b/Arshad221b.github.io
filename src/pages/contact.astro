---
/* Contact: a plain form that lands in my inbox, set in three numbered
   parts under the same hairline headings as the rest of the site.

   The site is static, so the message is posted to FormSubmit, which mails
   it on to the address below. It is sent without leaving the page; if
   that fails for any reason, the page says so and offers plain email. */

import Layout from '../layouts/Layout.astro';
import Mast from '../components/Mast.astro';

const title = 'Contact — Arshad Kazi';
const inbox = 'arshadkaziblog@gmail.com';
const endpoint = `https://formsubmit.co/ajax/${inbox}`;
const reasons = ['a job', 'a collaboration', 'something you wrote', 'nothing in particular'];
---

<Layout title={title} activeNav="/contact" description="Write to Arshad Kazi about a job, a collaboration, or something he wrote.">
  <div class="contact-page">
    <Mast
      label="Contact"
      aside="Replies within days"
      title="Write"
      accent="to me"
      lede="About a job, a collaboration, something I wrote, or just to say hello. I read every message."
    />

    <form class="form" id="contact-form" action={`https://formsubmit.co/${inbox}`} method="POST" data-endpoint={endpoint} novalidate>
      <input type="hidden" name="_subject" value="New message from arshad-kazi.com" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <!-- Left empty by people; bots fill it in, and FormSubmit drops those. -->
      <input type="text" name="_honey" class="honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <section class="part">
        <h2 class="part-head"><span class="n">01</span><span>You</span><span class="rule"></span></h2>
        <div class="field">
          <label for="f-name">Name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="120" placeholder="Your name" />
        </div>
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="200" placeholder="you@example.com" />
        </div>
      </section>

      <fieldset class="part">
        <legend class="part-head"><span class="n">02</span><span>About</span><span class="rule"></span></legend>
        <div class="reasons">
          {reasons.map((r, i) => (
            <label class="reason"><input type="radio" name="about" value={r} checked={i === 0} /><span>{r}</span></label>
          ))}
        </div>
      </fieldset>

      <section class="part">
        <h2 class="part-head"><span class="n">03</span><span>Message</span><span class="rule"></span></h2>
        <div class="field">
          <label for="f-message" class="sr">Message</label>
          <textarea id="f-message" name="message" rows="8" required maxlength="5000" placeholder="Write here…"></textarea>
        </div>
      </section>

      <div class="actions">
        <button type="submit" class="send" id="send">Send <span aria-hidden="true">&rarr;</span></button>
        <p class="status" id="status" role="status" aria-live="polite"></p>
      </div>
    </form>

    <p class="direct"><span>Or write directly</span><a href={`mailto:${inbox}`}>{inbox}</a></p>
  </div>
</Layout>

<style>
  .contact-page {
    max-width: 640px;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .part {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    border: none;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  /* The same hairline headings as the timeline's years. */
  .part-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    padding: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .part-head .n {
    display: inline-grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    color: #fff;
    background: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .part-head .rule {
    flex: 1;
    height: 1px;
    background: var(--color-text-muted);
    opacity: 0.5;
  }

  fieldset.part .part-head {
    margin-bottom: var(--space-lg);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .field label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
  }

  .field:focus-within label {
    color: var(--color-accent);
  }

  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1.4;
    color: var(--color-text);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-text-muted);
    border-radius: 0;
    padding: 0.3rem 0 0.55rem;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  textarea {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.65;
    min-height: 11rem;
    resize: vertical;
    border: 1px solid var(--color-text-muted);
    border-radius: 2px;
    padding: 0.9rem 1rem;
    background: var(--color-code-bg);
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--color-text-muted);
    opacity: 0.8;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  input:focus {
    border-bottom-width: 2px;
    padding-bottom: calc(0.55rem - 1px);
  }

  textarea:focus {
    box-shadow: 0 0 0 1px var(--color-accent);
    background: var(--color-bg);
  }

  .field.invalid input,
  .field.invalid textarea {
    border-color: var(--color-accent);
  }

  .field.invalid label {
    color: var(--color-accent);
  }

  /* Clear buttons: outlined at rest, filled when chosen. */
  .reasons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .reason {
    position: relative;
    cursor: pointer;
  }

  .reason input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .reason span {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--color-text-muted);
    border-radius: 999px;
    background: var(--color-code-bg);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .reason span::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px currentColor;
  }

  .reason:hover span {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .reason input:checked + span {
    color: #fff;
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 6px 16px -8px var(--color-accent);
  }

  .reason input:checked + span::before {
    background: #fff;
    box-shadow: none;
  }

  .reason input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-text-muted);
  }

  .send {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #fff;
    background: var(--color-accent);
    border: none;
    border-radius: 999px;
    padding: 1rem 1.6rem;
    box-shadow: 0 10px 24px -12px var(--color-accent);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
  }

  .send:hover {
    background: var(--color-accent-hover);
  }

  .send:hover span {
    transform: translateX(3px);
  }

  .send span {
    transition: transform 0.2s ease;
  }

  .send[disabled] {
    opacity: 0.55;
    cursor: wait;
  }

  .status {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-text-secondary);
  }

  .status.ok {
    color: var(--color-accent);
  }

  .direct {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    align-items: baseline;
    margin: var(--space-2xl) 0 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .direct span {
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .direct a {
    color: var(--color-text-secondary);
  }

  .direct a:hover {
    color: var(--color-accent);
  }
</style>

<script is:inline>
(function () {
  var form = document.getElementById('contact-form');
  if (!form) return;
  var send = document.getElementById('send');
  var status = document.getElementById('status');

  function check() {
    var ok = true;
    ['f-name', 'f-email', 'f-message'].forEach(function (id) {
      var el = document.getElementById(id);
      var bad = !el.value.trim() || (el.type === 'email' && !el.checkValidity());
      el.closest('.field').classList.toggle('invalid', bad);
      if (bad && ok) { el.focus(); ok = false; }
    });
    return ok;
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    status.classList.remove('ok');
    if (!check()) { status.textContent = 'A name, an email and a message, please.'; return; }
    send.disabled = true;
    status.textContent = 'Sending…';
    var data = Object.fromEntries(new FormData(form).entries());
    fetch(form.dataset.endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(data),
    })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        if (!res.ok || String(res.j.success) !== 'true') throw new Error(res.j.message || 'failed');
        form.reset();
        status.classList.add('ok');
        status.textContent = 'Sent. Thank you, I will write back soon.';
      })
      .catch(function () {
        status.innerHTML = 'That did not go through. Please write to <a href="mailto:arshadkaziblog@gmail.com">arshadkaziblog@gmail.com</a> instead.';
      })
      .finally(function () { send.disabled = false; });
  });

  form.addEventListener('input', function (e) {
    var f = e.target.closest('.field');
    if (f) f.classList.remove('invalid');
  });
})();
</script>
