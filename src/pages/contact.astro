---
/* Contact: a plain form that lands in my inbox.

   The site is static, so the message is posted to FormSubmit, which mails
   it on to the address below. It is sent without leaving the page; if
   that fails for any reason, the page says so and offers plain email. */

import Layout from '../layouts/Layout.astro';
import Mast from '../components/Mast.astro';

const title = 'Contact — Arshad Kazi';
const inbox = 'arshadkaziblog@gmail.com';
const endpoint = `https://formsubmit.co/ajax/${inbox}`;
const reasons = ['a job', 'a collaboration', 'something you wrote', 'nothing in particular'];
---

<Layout title={title} activeNav="/contact" description="Write to Arshad Kazi about something he wrote, work, or anything else.">
  <div class="contact-page">
    <Mast
      label="Contact"
      aside="Replies within days"
      title="Write"
      accent="to me"
      lede="About a job, a collaboration, something I wrote, or just to say hello. I read every message."
    />

    <form class="form" id="contact-form" action={`https://formsubmit.co/${inbox}`} method="POST" data-endpoint={endpoint} novalidate>
      <input type="hidden" name="_subject" value="New message from arshad-kazi.com" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <!-- Left empty by people; bots fill it in, and FormSubmit drops those. -->
      <input type="text" name="_honey" class="honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <!-- Written as a letter: the blanks are the fields. -->
      <div class="letter">
        <p class="salute">Dear Arshad,</p>

        <p class="line">
          My name is
          <span class="field blank"><label for="f-name" class="sr">Your name</label><input id="f-name" name="name" type="text" autocomplete="name" required maxlength="120" placeholder="your name" size="14" /></span>
          and you can write back to me at
          <span class="field blank"><label for="f-email" class="sr">Your email</label><input id="f-email" name="email" type="email" autocomplete="email" required maxlength="200" placeholder="you@example.com" size="20" /></span>.
        </p>

        <fieldset class="line about">
          <legend class="sr">What it is about</legend>
          <span>I am writing about</span>
          {reasons.map((r, i) => (
            <><span class="choice"><label class="reason"><input type="radio" name="about" value={r} checked={i === 0} /><span>{r}</span></label><span class="sep">{i < reasons.length - 2 ? ',' : i === reasons.length - 2 ? ', or' : '.'}</span></span>{' '}</>
          ))}
        </fieldset>

        <div class="field body">
          <label for="f-message" class="sr">Your message</label>
          <textarea id="f-message" name="message" rows="8" required maxlength="5000" placeholder="Write here…"></textarea>
        </div>
      </div>

      <div class="actions">
        <button type="submit" class="send" id="send">Send the letter <span aria-hidden="true">&rarr;</span></button>
        <p class="status" id="status" role="status" aria-live="polite"></p>
      </div>
    </form>

    <p class="direct">Or write directly: <a href={`mailto:${inbox}`}>{inbox}</a></p>
  </div>
</Layout>

<style>
  .contact-page {
    max-width: 640px;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* The letter: large serif text, the blanks underlined in the line. */
  .letter {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.6vw, 1.55rem);
    line-height: 2;
    color: var(--color-text);
  }

  .salute {
    font-family: 'Great Vibes', var(--font-serif);
    font-size: 2.4em;
    line-height: 1;
    color: var(--color-accent);
    margin: 0 0 0.4em;
  }

  .line {
    margin: 0 0 0.6em;
  }

  .blank {
    display: inline-block;
    max-width: 100%;
  }

  .blank input {
    font: inherit;
    font-style: italic;
    color: var(--color-accent);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-text-muted);
    border-radius: 0;
    padding: 0 0.15em;
    max-width: 100%;
    transition: border-color 0.2s ease;
  }

  .blank input::placeholder,
  .body textarea::placeholder {
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  .blank input:focus {
    outline: none;
    border-bottom-color: var(--color-accent);
  }

  .field.invalid input,
  .field.invalid textarea {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .about {
    border: none;
    padding: 0;
    margin: 0 0 0.9em;
    min-width: 0;
  }

  .about > span {
    margin-right: 0.3em;
  }

  .reason {
    position: relative;
    display: inline-block;
    cursor: pointer;
  }

  .reason input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .reason span {
    font-style: italic;
    color: var(--color-text-muted);
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-size: 0% 1px;
    background-position: 0 92%;
    background-repeat: no-repeat;
    transition: color 0.2s ease, background-size 0.35s var(--ease-out);
  }

  /* A choice keeps its comma; lines break only between choices. */
  .choice {
    white-space: nowrap;
  }

  .sep {
    color: var(--color-text-muted);
  }

  .reason:hover span {
    color: var(--color-text);
  }

  .reason input:checked + span {
    color: var(--color-accent);
    background-size: 100% 1px;
  }

  .reason input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Ruled like a notebook page, the text sitting on the lines. */
  .body textarea {
    width: 100%;
    min-height: 16em;
    font: inherit;
    font-size: 0.82em;
    line-height: 2.2em;
    color: var(--color-text);
    background: transparent;
    background-image: repeating-linear-gradient(transparent 0 calc(2.2em - 1px), var(--color-border) calc(2.2em - 1px) 2.2em);
    background-attachment: local;
    border: none;
    border-left: 2px solid var(--color-accent-soft);
    border-radius: 0;
    padding: 0 0 0 0.8em;
    resize: vertical;
  }

  .body textarea:focus {
    outline: none;
    border-left-color: var(--color-accent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .send {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    background: var(--color-text);
    border: none;
    border-radius: 2px;
    padding: 0.95rem 1.4rem;
    cursor: pointer;
    transition: background 0.2s ease, opacity 0.2s ease;
  }

  .send:hover {
    background: var(--color-accent);
  }

  :global(html.dark) .send {
    color: var(--color-bg);
  }

  :global(html.dark) .send:hover {
    color: #fff;
  }

  .send[disabled] {
    opacity: 0.55;
    cursor: wait;
  }

  .status {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-text-secondary);
  }

  .status.ok {
    color: var(--color-accent);
  }

  .direct {
    margin: var(--space-2xl) 0 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border-light);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .direct a {
    color: var(--color-text-secondary);
  }
</style>

<script is:inline>
(function () {
  var form = document.getElementById('contact-form');
  if (!form) return;
  var send = document.getElementById('send');
  var status = document.getElementById('status');

  function check() {
    var ok = true;
    ['f-name', 'f-email', 'f-message'].forEach(function (id) {
      var el = document.getElementById(id);
      var bad = !el.value.trim() || (el.type === 'email' && !el.checkValidity());
      el.closest('.field').classList.toggle('invalid', bad);
      if (bad && ok) { el.focus(); ok = false; }
    });
    return ok;
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    status.classList.remove('ok');
    if (!check()) { status.textContent = 'A name, an email and a message, please.'; return; }
    send.disabled = true;
    status.textContent = 'Sending…';
    var data = Object.fromEntries(new FormData(form).entries());
    fetch(form.dataset.endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(data),
    })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        if (!res.ok || String(res.j.success) !== 'true') throw new Error(res.j.message || 'failed');
        form.reset();
        status.classList.add('ok');
        status.textContent = 'Sent. Thank you, I will write back soon.';
      })
      .catch(function () {
        status.innerHTML = 'That did not go through. Please write to <a href="mailto:arshadkaziblog@gmail.com">arshadkaziblog@gmail.com</a> instead.';
      })
      .finally(function () { send.disabled = false; });
  });

  form.addEventListener('input', function (e) {
    var f = e.target.closest('.field');
    if (f) f.classList.remove('invalid');
  });
})();
</script>
