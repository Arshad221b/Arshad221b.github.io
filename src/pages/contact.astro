---
/* Contact: a plain form that lands in my inbox, set in three numbered
   parts under the same hairline headings as the rest of the site.

   The site is static, so the message is posted to FormSubmit, which mails
   it on to the address below. It is sent without leaving the page; if
   that fails for any reason, the page says so and offers plain email. */

import Layout from '../layouts/Layout.astro';
import Mast from '../components/Mast.astro';

const title = 'Contact — Arshad Kazi';
const inbox = 'arshadkaziblog@gmail.com';
const endpoint = `https://formsubmit.co/ajax/${inbox}`;
const reasons = ['a job', 'a collaboration', 'something you wrote', 'nothing in particular'];
---

<Layout title={title} activeNav="/contact" quietFoot description="Write to Arshad Kazi about a job, a collaboration, or something he wrote.">
  <!-- Behind the page: drops of ink landing on the paper and spreading,
       slowly, all the time; and as you write, each key drops one of its
       own from the field you are writing in. -->
  <canvas class="ink-bg" id="ink-bg" aria-hidden="true"></canvas>

  <div class="contact-page">
    <Mast
      label="Contact"
      aside="Replies within days"
      title="Write"
      accent="to me"
      lede="About a job, a collaboration, something I wrote, or just to say hello. I read every message."
    />

    <form class="form" id="contact-form" action={`https://formsubmit.co/${inbox}`} method="POST" data-endpoint={endpoint} novalidate>
      <input type="hidden" name="_subject" value="New message from arshad-kazi.com" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <!-- Left empty by people; bots fill it in, and FormSubmit drops those. -->
      <input type="text" name="_honey" class="honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <section class="part">
        <h2 class="part-head"><span class="n">01</span><span>You</span></h2>
        <div class="field">
          <label for="f-name">Name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="120" placeholder="Your name" />
        </div>
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="200" placeholder="you@example.com" />
        </div>
      </section>

      <fieldset class="part">
        <legend class="part-head"><span class="n">02</span><span>About</span></legend>
        <div class="reasons">
          {reasons.map((r, i) => (
            <label class="reason"><input type="radio" name="about" value={r} checked={i === 0} /><span>{r}</span></label>
          ))}
        </div>
      </fieldset>

      <section class="part">
        <h2 class="part-head"><span class="n">03</span><span>Message</span></h2>
        <div class="field">
          <label for="f-message" class="sr">Message</label>
          <textarea id="f-message" name="message" rows="8" required maxlength="5000" placeholder="Write here…"></textarea>
        </div>
      </section>

      <div class="actions">
        <button type="submit" class="send" id="send">Send <span aria-hidden="true">&rarr;</span></button>
        <p class="status" id="status" role="status" aria-live="polite"></p>
      </div>
    </form>

    <p class="direct"><span>Or write directly</span><a href={`mailto:${inbox}`}>{inbox}</a></p>
  </div>
</Layout>

<style>
  .contact-page {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }

  .ink-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .part {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    border: none;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  /* The same hairline headings as the timeline's years. */
  /* The three parts, said plainly and large. */
  .part-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    padding: 0;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.1rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-text);
  }

  .part-head .n {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 400;
    color: #fff;
    background: var(--color-accent);
    letter-spacing: 0.04em;
  }

  fieldset.part .part-head {
    margin-bottom: var(--space-lg);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .field label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
  }

  .field:focus-within label {
    color: var(--color-accent);
  }

  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1.4;
    color: var(--color-text);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-text-muted);
    border-radius: 0;
    padding: 0.3rem 0 0.55rem;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  textarea {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.65;
    min-height: 11rem;
    resize: vertical;
    border: 1px solid var(--color-text-muted);
    border-radius: 2px;
    padding: 0.9rem 1rem;
    background: var(--color-code-bg);
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--color-text-muted);
    opacity: 0.8;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  input:focus {
    border-bottom-width: 2px;
    padding-bottom: calc(0.55rem - 1px);
  }

  textarea:focus {
    box-shadow: 0 0 0 1px var(--color-accent);
    background: var(--color-bg);
  }

  .field.invalid input,
  .field.invalid textarea {
    border-color: var(--color-accent);
  }

  .field.invalid label {
    color: var(--color-accent);
  }

  /* Clear buttons: outlined at rest, filled when chosen. */
  .reasons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .reason {
    position: relative;
    cursor: pointer;
  }

  .reason input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .reason span {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--color-text-muted);
    border-radius: 999px;
    background: var(--color-code-bg);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .reason span::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px currentColor;
  }

  .reason:hover span {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .reason input:checked + span {
    color: #fff;
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 6px 16px -8px var(--color-accent);
  }

  .reason input:checked + span::before {
    background: #fff;
    box-shadow: none;
  }

  .reason input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-text-muted);
  }

  .send {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #fff;
    background: var(--color-accent);
    border: none;
    border-radius: 999px;
    padding: 1rem 1.6rem;
    box-shadow: 0 10px 24px -12px var(--color-accent);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
  }

  .send:hover {
    background: var(--color-accent-hover);
  }

  .send:hover span {
    transform: translateX(3px);
  }

  .send span {
    transition: transform 0.2s ease;
  }

  .send[disabled] {
    opacity: 0.55;
    cursor: wait;
  }

  .status {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-text-secondary);
  }

  .status.ok {
    color: var(--color-accent);
  }

  .direct {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    align-items: baseline;
    margin: var(--space-2xl) 0 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .direct span {
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .direct a {
    color: var(--color-text-secondary);
  }

  .direct a:hover {
    color: var(--color-accent);
  }
</style>

<script is:inline>
/* The ink. Each drop is a small dark blot that spreads into two or three
   rings and fades; ambient drops are faint and fall mostly to the side of
   the form, typed ones are orange and fall from the field. */
(function () {
  var c = document.getElementById('ink-bg');
  if (!c) return;
  var x = c.getContext('2d'), drops = [], W = 0, H = 0, dpr = 1, running = false;
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  function size() {
    dpr = Math.min(devicePixelRatio || 1, 2);
    W = innerWidth; H = innerHeight;
    c.width = W * dpr; c.height = H * dpr;
    x.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  size();
  addEventListener('resize', size);
  function colour(v) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }

  function drop(px, py, accent, scale) {
    drops.push({ x: px, y: py, t0: performance.now(), life: 4200 + Math.random() * 1800, r: (60 + Math.random() * 110) * scale, accent: accent, rings: accent ? 2 : 3 });
    if (!running) { running = true; requestAnimationFrame(frame); }
  }

  function frame(now) {
    x.clearRect(0, 0, W, H);
    var ink = colour('--color-text'), acc = colour('--color-accent');
    drops = drops.filter(function (d) { return now - d.t0 < d.life; });
    drops.forEach(function (d) {
      var k = (now - d.t0) / d.life, e = 1 - Math.pow(1 - k, 3);
      // The blot where it landed, soaking in.
      x.globalAlpha = (d.accent ? 0.45 : 0.32) * Math.pow(1 - k, 2);
      x.fillStyle = d.accent ? acc : ink;
      x.beginPath(); x.arc(d.x, d.y, 2 + 5 * Math.min(1, k * 4), 0, Math.PI * 2); x.fill();
      // Its rings, one after another.
      for (var i = 0; i < d.rings; i++) {
        var ki = k - i * 0.12; if (ki <= 0) continue;
        var ei = 1 - Math.pow(1 - Math.min(1, ki / (1 - i * 0.12)), 3);
        x.globalAlpha = (d.accent ? 0.6 : 0.34) * Math.pow(1 - ki, 1.4) * (1 - i * 0.22);
        x.strokeStyle = d.accent ? acc : ink;
        x.lineWidth = d.accent ? 1.4 : 1.2;
        x.beginPath(); x.arc(d.x, d.y, d.r * ei * (1 - i * 0.18), 0, Math.PI * 2); x.stroke();
      }
    });
    x.globalAlpha = 1;
    if (drops.length) requestAnimationFrame(frame); else { running = false; x.clearRect(0, 0, W, H); }
  }

  if (reduce) return;
  // Ambient drops, now and then, mostly in the open paper beside the form.
  (function rain() {
    var form = document.getElementById('contact-form');
    var r = form ? form.getBoundingClientRect() : { left: 0, right: 0 };
    var side = W > 900 && Math.random() < 0.8;
    var px = side ? r.right + 60 + Math.random() * Math.max(80, W - r.right - 120) : Math.random() * W;
    drop(px, 60 + Math.random() * (H - 120), false, W > 900 ? 1.3 : 0.75);
    setTimeout(rain, 700 + Math.random() * 1100);
  })();

  // Typing drops ink from the field being written in.
  document.addEventListener('input', function (e) {
    var f = e.target;
    if (!f.matches || !f.matches('#contact-form input, #contact-form textarea')) return;
    var b = f.getBoundingClientRect();
    drop(b.left + Math.min(b.width - 10, 20 + (f.value.length % 40) * (b.width / 44)), b.top + Math.min(b.height - 8, 26), true, 0.5);
  });
  document.addEventListener('change', function (e) {
    if (!e.target.matches || !e.target.matches('#contact-form input[type=radio]')) return;
    var b = e.target.parentElement.getBoundingClientRect();
    drop(b.left + b.width / 2, b.top + b.height / 2, true, 0.9);
  });
})();

(function () {
  var form = document.getElementById('contact-form');
  if (!form) return;
  var send = document.getElementById('send');
  var status = document.getElementById('status');

  function check() {
    var ok = true;
    ['f-name', 'f-email', 'f-message'].forEach(function (id) {
      var el = document.getElementById(id);
      var bad = !el.value.trim() || (el.type === 'email' && !el.checkValidity());
      el.closest('.field').classList.toggle('invalid', bad);
      if (bad && ok) { el.focus(); ok = false; }
    });
    return ok;
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    status.classList.remove('ok');
    if (!check()) { status.textContent = 'A name, an email and a message, please.'; return; }
    send.disabled = true;
    status.textContent = 'Sending…';
    var data = Object.fromEntries(new FormData(form).entries());
    fetch(form.dataset.endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(data),
    })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        if (!res.ok || String(res.j.success) !== 'true') throw new Error(res.j.message || 'failed');
        form.reset();
        status.classList.add('ok');
        status.textContent = 'Sent. Thank you, I will write back soon.';
      })
      .catch(function () {
        status.innerHTML = 'That did not go through. Please write to <a href="mailto:arshadkaziblog@gmail.com">arshadkaziblog@gmail.com</a> instead.';
      })
      .finally(function () { send.disabled = false; });
  });

  form.addEventListener('input', function (e) {
    var f = e.target.closest('.field');
    if (f) f.classList.remove('invalid');
  });
})();
</script>
