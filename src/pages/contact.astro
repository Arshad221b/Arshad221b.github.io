---
/* Contact: a plain form that lands in my inbox, set in three numbered
   parts under the same hairline headings as the rest of the site.

   The site is static, so the message is posted to FormSubmit, which mails
   it on to the address below. It is sent without leaving the page; if
   that fails for any reason, the page says so and offers plain email. */

import Layout from '../layouts/Layout.astro';
import Mast from '../components/Mast.astro';

const title = 'Contact — Arshad Kazi';
const inbox = 'arshadkaziblog@gmail.com';
const endpoint = `https://formsubmit.co/ajax/${inbox}`;
// The sketches behind the form, in the order they are drawn.
const sketches = ['vitruvian', 'sibyl', 'flying', 'nude', 'water', 'horse'].map(n => `/images/contact/${n}.jpg`);
// Elsewhere, the same places the About page lists.
const elsewhere = [
  { label: 'Email', href: `mailto:${inbox}`, icon: 'M3 6h18v12H3z M3 6l9 7 9-7' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/arshad221b/', icon: 'M4 9h3v11H4z M5.5 4.5a1.6 1.6 0 1 1 0 3.2 1.6 1.6 0 0 1 0-3.2z M10 9h3v1.6c.5-1 1.7-1.9 3.4-1.9 3 0 3.6 2 3.6 4.6V20h-3v-5.8c0-1.4 0-3-1.9-3s-2.1 1.4-2.1 2.9V20h-3z', fill: true },
  { label: 'Substack', href: 'https://substack.com/@arshadkazi', icon: 'M5 4h14v2.2H5z M5 8.2h14v2.2H5z M5 12.4h14V21l-7-3.9L5 21z', fill: true },
  { label: 'GitHub', href: 'https://github.com/Arshad221b', icon: 'M12 3a9 9 0 0 0-2.85 17.54c.45.08.62-.2.62-.44v-1.55c-2.5.54-3.03-1.2-3.03-1.2-.41-1.04-1-1.32-1-1.32-.82-.56.06-.55.06-.55.9.06 1.38.93 1.38.93.8 1.38 2.11.98 2.62.75.08-.58.31-.98.57-1.2-2-.23-4.1-1-4.1-4.45 0-.98.35-1.79.93-2.42-.1-.23-.4-1.15.08-2.39 0 0 .76-.24 2.48.92a8.6 8.6 0 0 1 4.5 0c1.72-1.16 2.48-.92 2.48-.92.49 1.24.18 2.16.09 2.39.58.63.92 1.44.92 2.42 0 3.46-2.1 4.22-4.11 4.44.32.28.61.83.61 1.67v2.48c0 .24.16.53.62.44A9 9 0 0 0 12 3z', fill: true },
  { label: 'Medium', href: 'https://medium.com/@arshad_221b', icon: 'M7.5 7.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9z M16.5 8c1.1 0 2 1.8 2 4s-.9 4-2 4-2-1.8-2-4 .9-4 2-4z M21 8.5c.4 0 .7 1.6.7 3.5s-.3 3.5-.7 3.5-.7-1.6-.7-3.5.3-3.5.7-3.5z', fill: true },
];
const reasons = ['a job', 'a collaboration', 'something you wrote', 'just saying hello'];
---

<Layout title={title} activeNav="/contact" description="Write to Arshad Kazi about a job, a collaboration, or something he wrote.">
  <!-- Behind the page: sketches by Leonardo and Michelangelo, one at a
       time, each drawing itself in the way a sketch is built: the darkest
       strokes first, then the lighter lines and the shading. It holds,
       fades, and the next begins. -->
  <canvas class="codex" id="codex" aria-hidden="true" data-sketches={JSON.stringify(sketches)}></canvas>

  <div class="contact-page">
    <Mast
      label="Contact"
      aside="Replies within days"
      title="Write"
      accent="to me"
      lede="About a job, a collaboration, something I wrote, or just to say hello. I read every message."
    />

    <form class="form" id="contact-form" action={`https://formsubmit.co/${inbox}`} method="POST" data-endpoint={endpoint} novalidate>
      <input type="hidden" name="_subject" value="New message from arshad-kazi.com" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <!-- Left empty by people; bots fill it in, and FormSubmit drops those. -->
      <input type="text" name="_honey" class="honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <section class="part">
        <h2 class="part-head"><span>You</span></h2>
        <div class="field">
          <label for="f-name">Name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="120" placeholder="Your name" />
        </div>
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="200" placeholder="you@example.com" />
        </div>
      </section>

      <section class="part" role="radiogroup" aria-labelledby="about-head">
        <h2 class="part-head" id="about-head"><span>About</span></h2>
        <div class="reasons">
          {reasons.map((r, i) => (
            <label class="reason"><input type="radio" name="about" value={r} checked={i === 0} /><span>{r}</span></label>
          ))}
        </div>
      </section>

      <section class="part">
        <h2 class="part-head"><span>Message</span></h2>
        <div class="field">
          <label for="f-message" class="sr">Message</label>
          <textarea id="f-message" name="message" rows="8" required maxlength="5000" placeholder="Write here…"></textarea>
        </div>
      </section>

      <div class="actions">
        <button type="submit" class="send" id="send">
          <svg class="envelope" viewBox="0 0 28 20" aria-hidden="true"><rect x="1" y="1" width="26" height="18" rx="1.5" /><path class="flap" d="M1.5 2 14 11.5 26.5 2" /></svg>
          <span class="send-label">Send message</span>
          <span class="send-arrow" aria-hidden="true">&rarr;</span>
        </button>
        <p class="status" id="status" role="status" aria-live="polite"></p>
      </div>
    </form>

    <section class="elsewhere">
      <h2 class="part-head">Or find me</h2>
      <ul class="places">
        {elsewhere.map(l => (
          <li>
            <a href={l.href} target={l.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true" class={l.fill ? 'fill' : 'line'}><path d={l.icon} /></svg>
              <span>{l.label}</span>
              <span class="mark" aria-hidden="true">{l.href.startsWith('mailto') ? '→' : '↗'}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>

<style>
  .contact-page {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }

  .codex {
    position: fixed;
    top: 5vh;
    right: -4vw;
    width: min(58vw, 820px);
    height: 90vh;
    opacity: 0.34;
    transform: rotate(-3deg);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 18%, #000 48%, #000 90%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, transparent 18%, #000 48%, #000 90%, transparent 100%);
    pointer-events: none;
    z-index: 0;
  }

  /* On the dark page the ink turns to light. */
  :global(html.dark) .codex {
    filter: invert(1);
    opacity: 0.22;
  }

  @media (max-width: 760px) {
    .codex {
      right: -35vw;
      width: 115vw;
      opacity: 0.2;
    }

    :global(html.dark) .codex {
      opacity: 0.12;
    }
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .part {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    border: none;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  /* The same hairline headings as the timeline's years. */
  /* The three parts, said plainly and large. */
  .part-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    padding: 0;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.1rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-text);
  }

  /* Each part is marked by a short stroke of the accent, not a number. */
  .part-head::before {
    content: '';
    flex: none;
    width: 22px;
    height: 3px;
    border-radius: 3px;
    background: var(--color-accent);
  }

  /* And the parts are set apart by a soft line between them. */
  .part + .part {
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .field label {
    padding-left: 1.3rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
  }

  .field:focus-within label {
    color: var(--color-accent);
  }

  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1.4;
    color: var(--color-text);
    background: var(--color-code-bg);
    border: 1px solid var(--color-text-muted);
    border-radius: 999px;
    padding: 0.75rem 1.3rem;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  textarea {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.65;
    min-height: 11rem;
    resize: vertical;
    border: 1px solid var(--color-text-muted);
    border-radius: 24px;
    padding: 1.1rem 1.3rem;
    background: var(--color-code-bg);
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--color-text-muted);
    opacity: 0.8;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  input:focus,
  textarea:focus {
    box-shadow: 0 0 0 1px var(--color-accent);
    background: var(--color-bg);
  }

  .field.invalid input,
  .field.invalid textarea {
    border-color: var(--color-accent);
  }

  .field.invalid label {
    color: var(--color-accent);
  }

  /* Clear buttons: outlined at rest, filled when chosen. */
  .reasons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .reason {
    position: relative;
    cursor: pointer;
  }

  .reason input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .reason span {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text);
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--color-text-muted);
    border-radius: 999px;
    background: var(--color-code-bg);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .reason span::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px currentColor;
  }

  .reason:hover span {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .reason input:checked + span {
    color: #fff;
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .reason input:checked + span::before {
    background: #fff;
    box-shadow: none;
  }

  .reason input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }

  /* Sending a letter: a large pill like the page's other buttons, an
     envelope that moves on when you reach for it and flies off as it goes. */
  .send {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.15rem 1.8rem 1.15rem 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.6rem);
    font-weight: 300;
    letter-spacing: -0.01em;
    color: #fff;
    background: var(--color-accent);
    border: none;
    border-radius: 999px;
    overflow: hidden;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.2s ease;
  }

  .send:hover {
    background: var(--color-accent-hover);
  }

  .send:active {
    transform: translateY(1px);
  }

  .envelope {
    width: 30px;
    height: 22px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
    transition: transform 0.35s var(--ease-out);
  }

  .send:hover .envelope {
    transform: translateX(4px) rotate(-6deg);
  }

  .send-label {
    white-space: nowrap;
  }

  .send-arrow {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    transition: transform 0.3s var(--ease-out);
  }

  .send:hover .send-arrow {
    transform: translateX(6px);
  }

  /* While it goes: the envelope flies out to the right. */
  .send.sending .envelope {
    animation: fly-off 0.9s cubic-bezier(0.5, 0, 0.75, 0) forwards;
  }

  @keyframes fly-off {
    to { transform: translate(220px, -30px) rotate(-18deg); opacity: 0; }
  }

  .send[disabled] {
    cursor: wait;
  }

  .actions .status {
    width: 100%;
  }

  .status {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-text-secondary);
  }

  .status.ok {
    color: var(--color-accent);
  }

  /* Elsewhere: clear buttons, each with the place's own mark. */
  .elsewhere {
    margin-top: var(--space-3xl);
  }

  .places {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    margin: var(--space-lg) 0 0;
  }

  .places a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.8rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-code-bg);
    border: 1px solid var(--color-text-muted);
    border-radius: 999px;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .places svg {
    width: 16px;
    height: 16px;
    flex: none;
  }

  .places svg.fill path {
    fill: currentColor;
  }

  .places svg.line path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .places .mark {
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .places a:hover {
    color: #fff;
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .places a:hover .mark {
    color: #fff;
  }
</style>

<script is:inline>
/* The sketches draw themselves. Each pixel's ink is how dark it is; a
   threshold sweeps from dark to light, so the strongest strokes appear
   first and the faint shading last, softly, as a drawing is built up. */
(function () {
  var c = document.getElementById('codex');
  if (!c) return;
  var list = JSON.parse(c.dataset.sketches), x = c.getContext('2d');
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var DRAW = 9000, HOLD = 5000, FADE = 1600, GAP = 500;
  var W = 0, H = 0, dpr = 1, cur = null, idx = 0, t0 = 0, stopped = false;

  function size() {
    var r = c.getBoundingClientRect();
    // A faint background: drawn at one pixel per CSS pixel, to stay light.
    dpr = 1;
    W = r.width; H = r.height;
    c.width = Math.round(W * dpr); c.height = Math.round(H * dpr);
    if (cur) prepare(cur.img);
  }

  // Fit the sketch, and keep its ink (1 - lightness) for every pixel.
  function prepare(img) {
    var k = Math.min(c.width / img.width, c.height / img.height);
    var w = Math.round(img.width * k), h = Math.round(img.height * k);
    var off = document.createElement('canvas'); off.width = w; off.height = h;
    var o = off.getContext('2d');
    // Trim the scan's edges, where the old paper darkens into a frame.
    var m = 0.07, sx = img.width * m, sy = img.height * m;
    o.drawImage(img, sx, sy, img.width - 2 * sx, img.height - 2 * sy, 0, 0, w, h);
    var d = o.getImageData(0, 0, w, h), p = d.data, ink = new Float32Array(w * h);
    // The paper's tone is the common one (the median), not the lightest
    // speck; ink is anything clearly darker than it.
    var lums = [];
    for (var i = 0; i < p.length; i += 64) lums.push(0.299 * p[i] + 0.587 * p[i + 1] + 0.114 * p[i + 2]);
    lums.sort(function (a, b) { return a - b; });
    var hi = lums[Math.floor(lums.length * 0.6)];
    for (var j = 0, q = 0; j < p.length; j += 4, q++) {
      var lum = (0.299 * p[j] + 0.587 * p[j + 1] + 0.114 * p[j + 2]) / Math.max(1, hi);
      ink[q] = Math.max(0, Math.min(1, (0.86 - lum) / 0.55));
    }
    cur = { img: img, w: w, h: h, ink: ink, data: o.createImageData(w, h), ox: Math.round((c.width - w) / 2), oy: Math.round((c.height - h) / 2) };
  }

  function paint(t) {
    if (!cur) return;
    var a = t < DRAW ? t / DRAW : 1, fade = t > DRAW + HOLD ? Math.max(0, 1 - (t - DRAW - HOLD) / FADE) : 1;
    var th = 1 - Math.pow(a, 0.8) * 1.05, ink = cur.ink, out = cur.data.data;
    for (var q = 0, o = 0; q < ink.length; q++, o += 4) {
      var v = ink[q], s = Math.max(0, Math.min(1, (v - th) / 0.12));
      out[o] = 40; out[o + 1] = 30; out[o + 2] = 20; out[o + 3] = v * s * fade * 255;
    }
    x.clearRect(0, 0, c.width, c.height);
    x.putImageData(cur.data, cur.ox, cur.oy);
  }

  function load(n, done) {
    var img = new Image();
    img.onload = function () { prepare(img); done(); };
    img.onerror = function () { idx = (idx + 1) % list.length; load(idx, done); };
    img.src = list[n];
  }

  size();
  addEventListener('resize', size);
  load(0, function start() {
    if (reduce) { paint(DRAW); return; }
    t0 = performance.now();
    (function frame(now) {
      var t = now - t0;
      if (t > DRAW + HOLD + FADE + GAP) {
        idx = (idx + 1) % list.length;
        cur = null; x.clearRect(0, 0, c.width, c.height);
        load(idx, start);
        return;
      }
      paint(t);
      requestAnimationFrame(frame);
    })(t0);
  });
})();

(function () {
  var form = document.getElementById('contact-form');
  if (!form) return;
  var send = document.getElementById('send');
  var status = document.getElementById('status');

  function check() {
    var ok = true;
    ['f-name', 'f-email', 'f-message'].forEach(function (id) {
      var el = document.getElementById(id);
      var bad = !el.value.trim() || (el.type === 'email' && !el.checkValidity());
      el.closest('.field').classList.toggle('invalid', bad);
      if (bad && ok) { el.focus(); ok = false; }
    });
    return ok;
  }

  var label = send.querySelector('.send-label');

  // Back from the plain-form route: FormSubmit returns people here.
  if (/[?&]sent=1/.test(location.search)) {
    status.classList.add('ok');
    status.textContent = 'Sent. Thank you, I will write back soon.';
    history.replaceState(null, '', location.pathname);
  }

  function finish() {
    send.disabled = false;
    send.classList.remove('sending');
    label.textContent = 'Send message';
  }

  /* FormSubmit can be slow. Send in the background first; if it has not
     answered in 25 seconds, or the request fails outright, post the form
     the ordinary way, which FormSubmit always accepts, and come back here. */
  function plainSubmit() {
    label.textContent = 'Sending…';
    var next = document.createElement('input');
    next.type = 'hidden'; next.name = '_next';
    next.value = location.origin + location.pathname + '?sent=1';
    form.appendChild(next);
    HTMLFormElement.prototype.submit.call(form);
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    status.classList.remove('ok');
    if (!check()) { status.textContent = 'A name, an email and a message, please.'; return; }
    send.disabled = true;
    send.classList.add('sending');
    label.textContent = 'Sending…';
    status.textContent = '';
    var data = Object.fromEntries(new FormData(form).entries());
    var ctrl = window.AbortController ? new AbortController() : null;
    var slow = setTimeout(function () { label.textContent = 'Still sending…'; }, 6000);
    var giveUp = setTimeout(function () { if (ctrl) ctrl.abort(); }, 25000);
    fetch(form.dataset.endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(data),
      signal: ctrl ? ctrl.signal : undefined,
    })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        clearTimeout(slow); clearTimeout(giveUp);
        if (!res.ok || String(res.j.success) !== 'true') throw Object.assign(new Error(res.j.message || 'failed'), { answered: true });
        form.reset();
        finish();
        status.classList.add('ok');
        status.textContent = 'Sent. Thank you, I will write back soon.';
      })
      .catch(function (err) {
        clearTimeout(slow); clearTimeout(giveUp);
        // No answer, or the request never got through: take the plain route.
        if (!err || !err.answered) { plainSubmit(); return; }
        finish();
        status.innerHTML = 'That did not go through. Please write to <a href="mailto:arshadkaziblog@gmail.com">arshadkaziblog@gmail.com</a> instead.';
      });
  });

  form.addEventListener('input', function (e) {
    var f = e.target.closest('.field');
    if (f) f.classList.remove('invalid');
  });
})();
</script>
