    font-variant: small-caps;
    font-style: normal;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    text-transform: none;

    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .folio-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  /* The longer reasoning stays folded until asked for. */
  .why {
    margin-top: var(--space-md);
  }

  .why summary {
    font-family: var(--font-serif);
    font-variant: small-caps;
    font-style: normal;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    text-transform: none;

    color: var(--color-text-muted);
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0;
    user-select: none;
  }

  .why summary::-webkit-details-marker {
    display: none;
  }

  .why summary::before {
    content: '+';
    font-size: 0.85rem;
    line-height: 1;
  }

  .why[open] summary::before {
    content: '−';
  }

  .why summary:hover {
    color: var(--color-accent);
  }

  .why-body {
    padding-top: var(--space-md);
    max-width: 66ch;
  }

  .why-body p {
    font-size: 1.12rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-md);
  }

  .substack-line {
    font-family: var(--font-mono);
    font-size: 0.7rem !important;
    letter-spacing: 0.04em;
    color: var(--color-text-muted) !important;
    margin-bottom: 0 !important;
  }

  /* ── The map ───────────────────────────────────────── */
  .cortex {
    width: min(1140px, 94vw);
    margin-left: 50%;
    transform: translateX(-50%);
    margin-bottom: var(--space-xl);
    padding: 0;
  }

  .cortex svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .axons path {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 0.7;
    stroke-linecap: round;
  }

  .somas .soma {
    fill: var(--color-text-muted);
    opacity: 0.72;
  }

  .charge circle {
    fill: var(--color-accent);
  }

  .somas .hit {
    fill: transparent;
  }

  .somas a {
    cursor: crosshair;
  }

  .signals circle {
    fill: var(--color-accent);
  }

  .cluster-names text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 16px;
    fill: var(--color-text-muted);
    opacity: 0.62;
    text-anchor: middle;
    pointer-events: none;
    user-select: none;
  }

  /* Stimulating one cell quietens the rest of the tissue. */
  .cortex svg.lit .axons path {
    stroke-opacity: 0.3;
  }

  .cortex svg.lit .somas .soma {
    opacity: 0.22;
  }

  .cortex svg.lit .cluster-names text {
    opacity: 0.16;
  }

  /* The title rides on the node you are pointing at. */
  .hover-label {
    opacity: 0;
    transition: opacity 0.16s ease;
