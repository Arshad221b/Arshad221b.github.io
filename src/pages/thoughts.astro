---
/* The Thoughts index.

   Nothing on this page is a list I maintain. The essays are read out of
   src/pages/thoughts at build time, and the themes, the map and the search
   all come from a model fitted over their full text in src/lib. Publishing
   is dropping a file in that folder. */

import Layout from '../layouts/Layout.astro';
import Mast from '../components/Mast.astro';
import SketchBackdrop from '../components/SketchBackdrop.astro';
import { posts, pageModel, topicName } from '../lib/thoughts-data';

const title = "Thoughts — Arshad Kazi";

// Behind the page: Michelangelo, Piranesi and Palladio's architect drawing themselves in.
const sketches = ['sangiovanni1', 'carceri-title', 'rotonda', 'carceri-xiv', 'sangiovanni2'].map(n => `/images/thoughts-bg/${n}.jpg`);
const { topics, theta, edges, stats, projection } = pageModel;

// Every essay carries its number in the body of work, counted from the
// oldest, so the figure is a tally of what has been written rather than a
// position in a list.
const numbered = posts.map((p, i) => ({ ...p, no: String(posts.length - i).padStart(2, '0') }));

const years = [...new Set(posts.map(p => p.date.slice(0, 4)))];
const grouped = years.map(year => ({
  year,
  items: numbered.filter(p => p.date.slice(0, 4) === year),
}));

const firstYear = posts[posts.length - 1].date.slice(0, 4);
const lastYear = posts[0].date.slice(0, 4);
const totalWords = posts.reduce((sum, p) => sum + p.words, 0);
/* The middle essay, not the average one: two or three long book pieces
   pull a mean upwards and stop it describing anything. */
const lengths = posts.map(p => p.words).sort((a, b) => a - b);
const medianWords = lengths[Math.floor(lengths.length / 2)];

/* The essay's own first words, as a pull quote: the first sentence long
   enough to say something, cut gently if it runs on. */
function opening(text: string): string {
  const sentences = text.replace(/\s+/g, ' ').match(/[^.!?]+[.!?]+/g) ?? [text];
  const s = (sentences.find(x => x.trim().length > 50) ?? sentences[0] ?? '').trim();
  return s.length > 170 ? s.slice(0, 165).replace(/\s+\S*$/, '') + '…' : s;
}

function shortDate(dateStr: string): string {
  return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

/* An essay is "about" a topic when that topic is one of its strongest two
   and carries real mass. Everything on the page that filters or sorts by
   theme uses these, and the probability behind them, rather than a label. */
const MEMBERSHIP = 0.1;
const membership = theta.map(row => {
  const ranked = row.map((p, k) => ({ k, p })).sort((a, b) => b.p - a.p);
  return ranked.slice(0, 2).filter(t => t.p >= MEMBERSHIP);
});
const topTopic = theta.map(row => {
  let best = 0;
  row.forEach((p, k) => { if (p > row[best]) best = k; });
  return { k: best, p: row[best] };
});
const byIndex = new Map(posts.map((p, i) => [p.slug, i]));

---

<Layout title={title} activeNav="/thoughts" description="Personal writing by Arshad Kazi. Things I am confused about, excited by, or trying to put into words. Published on Substack." ogImage="/images/share-thoughts.jpg">
  <SketchBackdrop sketches={sketches} place="top" />
  <div class="thoughts-page wide free">

    <!-- ── Masthead ───────────────────────────────────────
         Set like the front of a specimen sheet: the running head, the
         title at full size, and the figures of the collection stated
         plainly rather than hidden in prose. -->
    <Mast
      label="Thoughts"
      aside="Personal essays"
      title="Personal"
      accent="Thoughts"
      lede="Personal writing. Things I am confused about, excited by, or trying to put into words."
      figures={[
        { k: 'Essays', v: posts.length },
        { k: 'Hours of reading', v: (totalWords / 230 / 60).toFixed(1) },
        { k: 'Words', v: `${Math.round(totalWords / 1000)}k` },
        { k: 'Median essay', v: `${(medianWords / 1000).toFixed(1)}k` },
      ]}
    >
      <details class="why">
        <summary>Why I write these</summary>
        <div class="why-body">
          <p>Most of the time I don't know what I think about something until I write it down and read it back, which is probably the most honest reason I do this at all. Writing is the only place where I can hold a thought long enough to actually examine it, because in conversation the thought moves too fast or the other person needs a response before I've finished figuring out what I'm trying to say.</p>
          <p>A lot of what I write about is things I find genuinely confusing, which includes most of human behaviour, my own reactions to things, and the gap between what people say and what they seem to actually mean. I don't have answers to most of this. I just try to describe the problem clearly enough that maybe someone reading it can see what I'm missing.</p>
          <p>Some of it is about being autistic, not the internet version where it's a personality trait you put in your bio, but the actual daily experience of being simultaneously too much for some people and not enough for others. And some of it is just me being excited about an idea, a paper, a connection between two things that nobody told me were connected.</p>
          <p class="substack-line">These are also published on <a href="https://substack.com/@arshadkazi" target="_blank" rel="noopener">Substack</a>.</p>
        </div>
      </details>
    </Mast>

    <!-- ── The console ────────────────────────────────────
         Searching and narrowing, kept on one strip so the index below
         it never has to move over to make room. -->
    <div class="console">
      <div class="seek">
        <input type="text" id="search-input" placeholder={`Search ${posts.length} essays by meaning`} autocomplete="off" />
        <span class="seek-key" aria-hidden="true">/</span>
        <button type="button" class="seek-clear" id="seek-clear" aria-label="Clear search">Clear</button>
      </div>

      <p class="console-note" id="results-count"></p>

      <div class="themes">
        <span class="themes-name">Topics</span>
        <div class="theme-strip" id="theme-strip">
          {topics.map((t, k) => (
            <button class="idx" data-topic={k} type="button" title={t.words.join(', ')}>
              <span class="idx-name">{topicName(t.words)}</span><span class="idx-n"></span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- ── The ledger ─────────────────────────────────────
         The journey line: every essay a drop of ink on it, every year a
         station, the pictures set like plates in a notebook. -->
    <ol class="ledger" id="post-index">
      {grouped.map(group => [
        <li class="year-band" data-year={group.year}>
          <span class="year-num">{group.year}</span>
          <span class="year-line"></span>
          <span class="year-count">{group.items.length} {group.items.length === 1 ? 'essay' : 'essays'}</span>
        </li>,
        ...group.items.map(post => {
          const i = byIndex.get(post.slug)!;
          return (
            <li class="entry" data-month={post.date.slice(0, 7)} data-year={group.year} data-i={i}
                data-title={post.title.toLowerCase()}
                data-description={post.description.toLowerCase()}
                data-topics={membership[i].map(t => t.k).join(',')}
                data-p={membership[i].map(t => t.p.toFixed(4)).join(',')}>
              <a href={`/thoughts/${post.slug}`} class="entry-link" data-peek="" data-no={post.no}>
                <time class="entry-date" datetime={post.date}><span class="dd">{new Date(post.date + 'T00:00:00').toLocaleDateString('en-US', { month: 'short' })}</span><span class="mm">{post.date.slice(0, 4)}</span></time>
                <span class="entry-body">
                  <span class="entry-fig"><img src={`/images/thoughts/${post.slug}.jpg`} alt="" width="1600" height="840" loading="lazy" decoding="async" /></span>
                  <span class="entry-meta">
                    <span class="k">Essay {post.no}</span>
                    <span>{Math.max(1, Math.round(post.words / 230))} min read</span>
                    <span class="entry-topic">{topicName(topics[topTopic[i].k].words)}</span>
                    <span class="entry-score" hidden></span>
                  </span>
                  <h3>{post.title}</h3>
                  <p>{post.description}</p>
                  <span class="entry-quote">{opening(post.text)}</span>
                </span>
              </a>
            </li>
          );
        }),
      ])}
    </ol>

    <p class="no-results" id="no-results">Nothing here matches that. Try a shorter word.</p>

    <!-- The picture, lifted off the line you are pointing at. -->
    <div class="peek" id="peek" aria-hidden="true"><img alt="" /><span class="peek-no"></span></div>
  </div>
</Layout>

<style>
  /* The page takes a wider canvas than the reading column, because the map
     and the ledger both want room. No transform is used to do it: a fixed
     child (the picture that lifts off a line) has to stay fixed. */
  .thoughts-page {
    width: min(1060px, 92vw);
    margin-left: calc(50% - min(530px, 46vw));
  }

  /* The longer reasoning stays folded until asked for. */
  .why {
    margin-top: var(--space-lg);
  }

  .why summary {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-text-muted);
    border-radius: 999px;
    user-select: none;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .why summary::-webkit-details-marker {
    display: none;
  }

  .why summary::before {
    content: '+';
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1;
    color: var(--color-accent);
  }

  .why[open] summary::before {
    content: '−';
  }

  .why summary:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .why-body {
    padding-top: var(--space-md);
    max-width: 66ch;
    border-left: 1px solid var(--color-border-light);
    padding-left: var(--space-md);
  }

  .why-body p {
    font-size: 1.12rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-md);
  }

  .substack-line {
    font-family: var(--font-mono);
    font-size: 0.7rem !important;
    letter-spacing: 0.04em;
    color: var(--color-text-muted) !important;
    margin-bottom: 0 !important;
  }

  /* ── The console ───────────────────────────────────
     One line to type on and one index of themes. Nothing here is a
     widget: it is a ruled line and a page of set words. */
  .console {
    margin: 0 0 var(--space-2xl);
  }

  .seek {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    border-bottom: 1px solid var(--color-text);
    padding: 0.35rem 0 0.5rem;
    transition: border-color 0.2s ease;
  }

  .seek:focus-within {
    border-color: var(--color-accent);
  }

  #search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    outline: none;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3.4vw, 1.85rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--color-text);
    padding: 0;
  }

  #search-input::placeholder {
    font-style: italic;
    color: var(--color-text-muted);
    opacity: 0.75;
  }

  /* The one control on the right is the slash key while the line is empty
     and the way out of the search once it is not. */
  .seek-key {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 0.05rem 0.4rem;
    user-select: none;
    white-space: nowrap;
  }

  .seek-clear {
    display: none;
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    padding: 0;
    white-space: nowrap;
  }

  .seek-clear:hover {
    color: var(--color-accent);
  }

  .seek.has-value .seek-key {
    display: none;
  }

  .seek.has-value .seek-clear {
    display: block;
  }

  /* Say what is on screen in words. This page is not a dashboard. */
  .console-note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin: var(--space-sm) 0 0;
    min-height: 1.6em;
  }

  /* One strip, on one or two lines, that recounts itself against what is
     on screen. Nothing here is a list of everything that exists. */
  .themes {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .themes-name {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    white-space: nowrap;
    padding-top: 0.1rem;
  }

  .theme-strip {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1.3rem;
  }

  .idx {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 1.04rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    transition: color 0.14s ease, text-decoration-color 0.14s ease;
  }

  /* The figure rides above the word, the way a footnote mark does. It is
     the live count, so it moves while you type. */
  .idx-n {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
    opacity: 0.7;
    transform: translateY(-0.5em);
  }

  .idx:hover,
  .idx:focus-visible {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
    outline: none;
  }

  .idx:hover .idx-n,
  .idx:focus-visible .idx-n {
    color: var(--color-accent);
    opacity: 1;
  }

  .idx.active {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }

  .idx.active .idx-n {
    color: var(--color-accent);
    opacity: 1;
  }

  .idx.gone {
    display: none;
  }

  .idx-more {
    border: none;
    background: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    white-space: nowrap;
    transition: color 0.14s ease;
  }

  .idx-more:hover {
    color: var(--color-accent);
  }

  .idx-more:empty {
    display: none;
  }

  /* ── The ledger ────────────────────────────────────── */
  /* The same timeline as Blogs: one flat list, newest first, under year
     headings that step aside when a search ranks the essays instead. */
  /* The same column as Blogs and as wide as the essays' figures, centred. */
  .thoughts-page {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  /* As on Blogs: on a wide screen each essay's words keep to the left at a
     reading width, and its figure is shown whole in all the room to their
     right, melting into the paper at its edges. */
  @media (min-width: 900px) {
    .entry-body {
      position: relative;
      display: block;
      min-height: clamp(22rem, 30vw, 36rem);
      padding: var(--space-lg) 0;
    }

    .entry-body > .entry-fig {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: calc(100% - min(46%, 38rem) - var(--space-2xl));
      margin: 0;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 7%, #000 93%, transparent 100%), linear-gradient(180deg, transparent 0%, #000 7%, #000 93%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 7%, #000 93%, transparent 100%), linear-gradient(180deg, transparent 0%, #000 7%, #000 93%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
    }

    .entry-body > .entry-fig img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: 0;
      box-shadow: none !important;
      mix-blend-mode: multiply;
      transition: transform 1.4s cubic-bezier(0.22, 0.8, 0.24, 1);
    }

    :global(html.dark) .entry-body > .entry-fig img {
      mix-blend-mode: normal;
      opacity: 0.85;
    }

    .entry-link:hover .entry-fig img {
      transform: scale(1.03);
    }

    .entry-body > :not(.entry-fig) {
      position: relative;
      display: block;
      max-width: min(46%, 38rem);
    }

    .entry-body > .entry-meta {
      display: flex;
    }
  }

  /* The essay's opening line, in its own voice. */
  .entry-quote {
    display: block;
    position: relative;
    margin-top: var(--space-md);
    padding-left: 1.1rem;
    border-left: 2px solid var(--color-accent);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .entry-quote::before {
    content: '“';
    position: absolute;
    left: 1.1rem;
    top: -0.55em;
    font-size: 2.6em;
    line-height: 1;
    color: var(--color-accent);
    opacity: 0.25;
    pointer-events: none;
  }

  @media (max-width: 760px) {
    .entry-quote {
      font-size: 1.08rem;
    }
  }

  .ledger {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .year-band {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: var(--space-2xl) 0 var(--space-sm);
  }

  .year-band:first-child {
    padding-top: 0;
  }

  .year-num {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 200;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-text);
  }

  .year-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
    align-self: center;
  }

  .year-count {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .ledger.ranked .year-band {
    display: none;
  }

  .entry {
    margin: 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .entry-link {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
    padding: var(--space-xl) 0;
    text-decoration: none;
    color: inherit;
  }

  .entry-link:hover {
    text-decoration: none;
  }

  .entry-date {
    position: sticky;
    top: 6.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding-top: 0.1rem;
    color: var(--color-text);
  }

  /* The month large and light in the margin, the year small beneath it;
     it rides along with its piece as you read, and lights up as you
     reach for it. */
  /* The rider carries the month; each piece's own label is kept only
     for a ranked search, where order is not by date. */
  .entry-date {
    visibility: hidden;
  }

  .ledger.ranked .entry-date {
    visibility: visible;
    position: static;
  }

  /* The month marker that rides down the margin (built by the script). */
  :global(.month-rider) {
    position: sticky;
    top: 6.5rem;
    z-index: 2;
    width: 5.5rem;
    height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  :global(.month-rider.on) {
    opacity: 1;
  }

  :global(.month-rider .dd) {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  :global(.month-rider .mm) {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-left: 0.15rem;
  }

  :global(.month-rider.turn .dd),
  :global(.month-rider.turn .mm) {
    animation: month-turn 0.45s cubic-bezier(0.22, 0.8, 0.24, 1);
  }

  @keyframes month-turn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 760px) {
    :global(.month-rider) { display: none; }
  }

  .dd {
    font-family: var(--font-display);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text);
    font-variant-numeric: lining-nums;
    transition: color 0.3s ease, transform 0.4s cubic-bezier(0.34, 1.5, 0.5, 1);
  }

  .mm {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-left: 0.15rem;
  }

  .mm::after {
    content: '';
    display: block;
    width: 14px;
    height: 2px;
    margin-top: 0.45rem;
    border-radius: 2px;
    background: var(--color-accent);
    transform-origin: left;
    transform: scaleX(0.4);
    transition: transform 0.4s cubic-bezier(0.34, 1.5, 0.5, 1);
  }

  .entry-link:hover .dd {
    color: var(--color-accent);
    transform: translateY(-3px);
  }

  .entry-link:hover .mm::after {
    transform: scaleX(1.6);
  }

  .entry-body {
    display: block;
    min-width: 0;
  }

  .entry-fig {
    display: block;
    margin-bottom: var(--space-md);
  }

  .entry-fig img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
    box-shadow: 0 0 0 1px var(--color-border-light);
    transition: box-shadow 0.3s ease;
  }

  :global(html.dark) .entry-fig img {
    box-shadow: none;
    filter: brightness(0.9);
  }

  .entry-link:hover .entry-fig img {
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .entry-meta .k {
    color: var(--color-accent);
  }

  .entry h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0.4rem 0 0.35rem;
    transition: color 0.25s ease;
  }

  .entry-link:hover h3 {
    color: var(--color-accent);
  }

  .entry p {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    max-width: 58ch;
    margin: 0;
  }

  /* The bar is the number, drawn: relevance while searching, the share of
     the essay while a topic is chosen. */
  .entry-score[hidden] {
    display: none;
  }

  .entry-score {
    position: relative;
    padding-left: 3.1rem;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .entry-score::before,
  .entry-score::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0.42em;
    height: 2px;
    border-radius: 1px;
  }

  .entry-score::before {
    width: 2.6rem;
    background: var(--color-border);
  }

  .entry-score::after {
    width: calc(2.6rem * var(--fill, 0%) / 100%);
    background: var(--color-accent);
    transition: width 0.22s ease;
  }

  .no-results {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    padding: var(--space-2xl) 0;
    margin: 0;
    display: none;
  }

  .peek {
    display: none !important;
  }

  @media (max-width: 760px) {
    .entry-link {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    /* On a phone the year headings carry the time; no margin date. */
    .entry-date {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .themes {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .idx {
      font-size: 0.98rem;
    }
  }
</style>

<style is:global>
  .entry.hidden,
  .year-group.hidden {
    display: none !important;
  }
</style>

<script is:inline>

/* One month marker rides down the margin beside the whole list, and turns
   to the next month as you cross into it, so a month's label stays with
   all of its pieces, not just the first. */
(function () {
  var list = document.getElementById('post-index');
  if (!list || matchMedia('(max-width: 760px)').matches) return;
  var rider = document.createElement('div');
  rider.className = 'month-rider';
  rider.setAttribute('aria-hidden', 'true');
  rider.innerHTML = '<span class="dd"></span><span class="mm"></span>';
  list.parentNode.insertBefore(rider, list);
  var dd = rider.querySelector('.dd'), mm = rider.querySelector('.mm'), shown = '', off = 0;
  var LINE = 140;
  function update() {
    var ranked = list.classList.contains('ranked');
    var rows = [].slice.call(list.querySelectorAll('[data-month]')).filter(function (r) {
      return !r.classList.contains('hidden') && r.offsetParent !== null;
    });
    // Sit level with the first piece (below the year heading) until it is
    // reached, then hold at the top: an offset on the marker's own content,
    // so no margin of the page around it is touched.
    if (rows.length) {
      off = Math.max(0, Math.round(rows[0].getBoundingClientRect().top + 28 - (rider.getBoundingClientRect().top - off)));
      rider.style.transform = 'translateY(' + off + 'px)';
    }
    var cur = null;
    for (var i = 0; i < rows.length; i++) {
      var b = rows[i].getBoundingClientRect();
      if (b.top <= LINE + 40) cur = rows[i];
      if (b.top > LINE + 40) break;
    }
    if (!cur && rows.length && rows[0].getBoundingClientRect().top < innerHeight) cur = rows[0];
    var first = rows.length ? rows[0].getBoundingClientRect().top : Infinity;
    rider.classList.toggle('on', !ranked && !!cur && first < innerHeight * 0.8);
    if (!cur) return;
    var label = cur.querySelector('time');
    var key = cur.dataset.month;
    if (key !== shown) {
      shown = key;
      rider.classList.remove('turn'); void rider.offsetWidth; rider.classList.add('turn');
      dd.textContent = label.querySelector('.dd').textContent;
      mm.textContent = label.querySelector('.mm').textContent;
    }
  }
  var queued = false;
  function queue() { if (!queued) { queued = true; requestAnimationFrame(function () { queued = false; update(); }); } }
  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', queue);
  new MutationObserver(queue).observe(list, { subtree: true, attributes: true, attributeFilter: ['class'], childList: true });
  update();
})();
(function() {
  /* The site's bar is sticky and sits above everything, so the year has to
     know how tall it is to come to rest just underneath it rather than
     disappear behind it. Measured, because the bar changes height with the
     screen. */
  const bar = document.querySelector('body > header');
  if (!bar) return;
  const measure = () => document.documentElement.style.setProperty(
    '--nav-h', Math.round(bar.getBoundingClientRect().height) + 'px');
  measure();
  if (window.ResizeObserver) new ResizeObserver(measure).observe(bar);
  else window.addEventListener('resize', measure);
})();

(function() {
  /* ── Searching ────────────────────────────────────────────────
     Typing here is not a string comparison. The query is tokenised and
     stemmed the same way the corpus was, projected into the latent space
     the model was fitted in, and scored by cosine against every essay, so
     "burnout at work" reaches an essay that never uses either word. A
     small exact-term boost sits on top, because a rare word someone
     actually typed should still pull its own essay up.

     The model is ~100KB over the wire and nobody who is only reading the
     page needs it, so it is fetched the first time the box is touched.
     Until it lands, the box falls back to matching letters.          */

  const input = document.getElementById('search-input');
  const seek = input.closest('.seek');
  const clearBtn = document.getElementById('seek-clear');
  const index = document.getElementById('post-index');
  const entries = Array.from(index.querySelectorAll('.entry'));
  const bands = Array.from(index.querySelectorAll('.year-band'));
  const chips = Array.from(document.querySelectorAll('.idx'));
  const counter = document.getElementById('results-count');
  const empty = document.getElementById('no-results');
  const strip = document.getElementById('theme-strip');

  let activeTopic = null;
  let model = null;
  let loading = null;

  /* Every essay's topic memberships, as probabilities. */
  const member = entries.map(e => {
    const ks = e.dataset.topics ? e.dataset.topics.split(',').map(Number) : [];
    const ps = e.dataset.p ? e.dataset.p.split(',').map(Number) : [];
    return new Map(ks.map((k, i) => [k, ps[i] ?? 0]));
  });

  /* ── The same tokeniser the corpus was built with ─────────────────
     If this drifts from src/lib/text.ts, a query stops landing on the
     terms the model actually holds. */
  const STOP = new Set(('a about above after again against all am an and any are as at be because been before being below ' +
    'between both but by can cannot could did do does doing down during each few for from further had has have having he ' +
    'her here hers herself him himself his how i if in into is it its itself me more most my myself no nor not of off on ' +
    'once only or other ought our ours ourselves out over own same she should so some such than that the their theirs them ' +
    'themselves then there these they this those through to too under until up very was we were what when where which while ' +
    'who whom why with would you your yours yourself yourselves just like get got also even still much many really thing ' +
    'things way ways lot lots maybe perhaps actually basically literally bit quite rather pretty another every something ' +
    'someone anything nothing everything always never often sometimes around almost already instead however therefore ' +
    'though although yet within without upon toward towards etc okay yeah thus hence per via able enough make makes made ' +
    'making take takes took taking come comes came coming go goes going went put puts let lets doesn isn wasn aren couldn ' +
    'wouldn shouldn didn don won hasn haven ain shan mustn').split(' '));

  function undouble(base) {
    if (base.length < 3) return base;
    const a = base[base.length - 1], b = base[base.length - 2];
    if (a === b && !'aeiou'.includes(a)) base = base.slice(0, -1);
    if (base.length >= 3 && !/[aeiou]/.test(base.slice(-3))) return base + 'e';
    return base;
  }

  function stem(w) {
    if (w.length <= 4) return w;
    if (w.endsWith('iness') && w.length >= 7) return w.slice(0, -5) + 'y';
    if (w.endsWith('ies') && w.length >= 5) return w.slice(0, -3) + 'y';
    if (w.endsWith('ness') && w.length >= 7) return w.slice(0, -4);
    if (w.endsWith('ement') && w.length >= 8) return w.slice(0, -5);
    if (w.endsWith('ing') && w.length >= 6) return undouble(w.slice(0, -3));
    if (w.endsWith('ed') && w.length >= 5) return undouble(w.slice(0, -2));
    if (w.endsWith('es') && w.length >= 5 && /(s|x|z|ch|sh)es$/.test(w)) return w.slice(0, -2);
    if (w.endsWith('s') && !w.endsWith('ss') && !w.endsWith('us') && w.length >= 5) return w.slice(0, -1);
    return w;
  }

  function tokenize(text) {
    const norm = text.toLowerCase()
      .replace(/[‘’ʼ′]/g, "'")
      .replace(/[–—]/g, ' ')
      .replace(/'(s|t|re|ve|ll|d|m)\b/g, '');
    const out = [];
    for (const raw of norm.match(/[a-z][a-z'-]{2,21}/g) || []) {
      const w = raw.replace(/[^a-z]/g, '');
      if (w.length < 3 || STOP.has(w)) continue;
      const st = stem(w);
      if (st.length < 3 || STOP.has(st)) continue;
      out.push(st);
    }
    return out;
  }

  function loadModel() {
    if (loading) return loading;
    loading = fetch('/thoughts-search.json')
      .then(r => (r.ok ? r.json() : Promise.reject(new Error(r.status))))
      .then(m => {
        const bin = atob(m.termVectors);
        const bytes = new Int8Array(bin.length);
        for (let i = 0; i < bin.length; i++) bytes[i] = (bin.charCodeAt(i) << 24) >> 24;
        const words = m.vocab.split('\n');
        model = {
          dims: m.dims,
          termId: new Map(words.map((w, i) => [w, i])),
          U: bytes,
          scale: m.termScale,
          docs: m.docVectors,
          postings: m.postings,
          rareIdf: m.rareIdf,
        };
        seek.classList.add('is-semantic');
        return model;
      })
      .catch(() => { model = null; return null; });
    return loading;
  }

  /* Cosine against every essay, plus a nudge for exact rare terms and for
     a literal hit in the title. Returns null when the query reached no
     term the model holds, so the caller can fall back. */
  function semanticScores(q) {
    if (!model) return null;
    const toks = tokenize(q);
    const tf = new Map();
    for (const t of toks) {
      const i = model.termId.get(t);
      if (i !== undefined) tf.set(i, (tf.get(i) || 0) + 1);
    }
    if (!tf.size) return null;

    const K = model.dims;
    const qv = new Float64Array(K);
    tf.forEach((n, i) => {
      const w = 1 + Math.log(n);
      for (let j = 0; j < K; j++) qv[j] += w * model.U[i * K + j] * model.scale;
    });
    let norm = 0;
    for (let j = 0; j < K; j++) norm += qv[j] * qv[j];
    norm = Math.sqrt(norm);
    if (norm < 1e-9) return null;
    for (let j = 0; j < K; j++) qv[j] /= norm;

    const lower = q.toLowerCase();
    return entries.map(entry => {
      const d = Number(entry.dataset.i);
      const dv = model.docs[d];
      let cos = 0;
      for (let j = 0; j < K; j++) cos += qv[j] * dv[j];
      let lex = 0;
      tf.forEach((_, i) => {
        const list = model.postings[i];
        if (list && list.indexOf(d) !== -1) lex += model.rareIdf[i] || 1;
      });
      const literal = entry.dataset.title.indexOf(lower) !== -1 ? 1 : 0;
      const sim = Math.max(0, Math.min(1, cos));
      return { score: sim + 0.14 * Math.min(lex, 4) + 0.25 * literal, sim };
    });
  }

  // Before the model lands, and for queries it cannot reach, match letters.
  function literalScores(q) {
    const lower = q.toLowerCase();
    return entries.map(entry => {
      const sim = entry.dataset.title.indexOf(lower) !== -1 ? 1
        : entry.dataset.description.indexOf(lower) !== -1 ? 0.6 : 0;
      return { score: sim, sim };
    });
  }

  /* Where to cut a ranking off. A fixed threshold either buries a good
     answer under forty weak ones or throws away a whole weak-but-real
     result set, because the scores a query produces depend on the query.
     So the cut is relative to the best hit it found, with a floor. */
  const CUT_RATIO = 0.42;
  const CUT_FLOOR = 0.14;
  const MOST = 24;

  function render() {
    const q = input.value.trim();
    const ranking = q ? (semanticScores(q) || literalScores(q)) : null;
    const semantic = !!(q && model && semanticScores(q));
    let top = 0;
    if (ranking) {
      entries.forEach((entry, idx) => {
        if (activeTopic !== null && !member[idx].has(activeTopic)) return;
        top = Math.max(top, ranking[idx].score);
      });
    }
    const cut = Math.max(CUT_FLOOR, top * CUT_RATIO);

    const order = [];
    entries.forEach((entry, idx) => {
      const inTopic = activeTopic === null || member[idx].has(activeTopic);
      const score = ranking ? ranking[idx].score : 0;
      const show = inTopic && (!ranking || score >= cut);
      entry.classList.toggle('hidden', !show);
      if (!show) return;
      order.push({ idx, entry, score, sim: ranking ? ranking[idx].sim : 0,
                   p: member[idx].get(activeTopic) || 0 });
    });

    /* How the surviving essays are put in order. A query ranks by
       relevance; a topic on its own ranks by how much of the essay that
       topic actually accounts for; otherwise it is the archive, newest
       first, under its years. */
    const ranked = !!ranking || activeTopic !== null;
    index.classList.toggle('ranked', ranked);
    if (ranked) {
      order.sort((a, b) => (ranking ? b.score - a.score : b.p - a.p));
      // A long tail of weak answers is not a result, it is an apology.
      if (ranking) {
        order.splice(MOST).forEach(o => o.entry.classList.add('hidden'));
      }
      order.forEach((o, rank) => { o.entry.style.order = String(rank); });
    } else {
      entries.forEach(e => { e.style.order = ''; });
    }
    const visible = order.length;

    // The bar on each line: relevance when searching, share of the essay
    // when a topic is chosen. Hidden when neither applies.
    order.forEach(o => {
      const mark = o.entry.querySelector('.entry-score');
      if (!ranked) { mark.hidden = true; return; }
      const v = ranking ? o.sim : Math.min(o.p / 0.6, 1);
      mark.hidden = false;
      mark.style.setProperty('--fill', (v * 100).toFixed(1) + '%');
      // Never a bare percentage: on its own it reads as how much of the
      // essay you have read, which is not what this is.
      mark.textContent = Math.round((ranking ? o.sim : o.p) * 100) + '% match';
    });

    // Year headings belong to the archive. A ranking is not in year order,
    // so they come out rather than lie about what follows them.
    bands.forEach(band => {
      if (ranked) { band.classList.add('hidden'); return; }
      const year = band.dataset.year;
      const any = entries.some(e => !e.classList.contains('hidden') && e.dataset.year === year);
      band.classList.toggle('hidden', !any);
      const count = band.querySelector('.year-count');
      if (count && any) {
        const n = entries.filter(e => !e.classList.contains('hidden') && e.dataset.year === year).length;
        count.textContent = n + (n === 1 ? ' essay' : ' essays');
      }
    });

    seek.classList.toggle('has-value', q.length > 0);
    updateStrip(q, visible);

    // Say what is on screen in words. This page is not a dashboard.
    const topicName = activeTopic !== null
      ? chips[activeTopic].querySelector('.idx-name').textContent : '';
    const n = visible + (visible === 1 ? ' essay' : ' essays');
    if (activeTopic !== null && q) {
      counter.textContent = n + ' on ' + topicName + ', closest to “' + q + '” first.';
    } else if (activeTopic !== null) {
      counter.textContent = n + ' on ' + topicName + ', the most about it first.';
    } else if (q) {
      counter.textContent = semantic
        ? n + ' closest in meaning to “' + q + '”.'
        : n + ' mentioning “' + q + '”.';
    } else {
      counter.textContent = '';
    }
    empty.style.display = visible === 0 ? 'block' : 'none';
  }

  /* The strip recounts itself against what is on screen: a topic that
     nothing visible is about drops out, so it only ever offers narrowings
     that lead somewhere. */
  function updateStrip(q, visible) {
    const live = new Map();
    entries.forEach((entry, idx) => {
      if (entry.classList.contains('hidden')) return;
      member[idx].forEach((_, k) => live.set(k, (live.get(k) || 0) + 1));
    });
    const ranked = [...live.entries()]
      .filter(([k]) => k !== activeTopic)
      .sort((a, b) => b[1] - a[1] || a[0] - b[0]);
    const rank = new Map(ranked.map(([k], i) => [k, i]));

    chips.forEach((chip, k) => {
      if (k === activeTopic) {
        chip.classList.remove('gone');
        chip.style.order = '-1';
        chip.querySelector('.idx-n').textContent = String(visible);
        return;
      }
      const r = rank.get(k);
      chip.classList.toggle('gone', r === undefined);
      if (r !== undefined) {
        chip.style.order = String(r);
        chip.querySelector('.idx-n').textContent = String(live.get(k));
      }
    });
  }

  input.addEventListener('input', () => {
    if (!model) loadModel().then(() => render());
    render();
  });
  // Warm the model on the first sign of intent, so the first keystroke is
  // usually already semantic.
  ['focus', 'pointerenter'].forEach(ev => seek.addEventListener(ev, loadModel, { once: true }));

  clearBtn.addEventListener('click', () => { input.value = ''; render(); input.focus(); });

  document.addEventListener('keydown', e => {
    const typing = /^(INPUT|TEXTAREA)$/.test(document.activeElement.tagName)
      || document.activeElement.isContentEditable;
    if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) {
      e.preventDefault();
      loadModel();
      input.focus();
    } else if (e.key === 'Escape' && document.activeElement === input) {
      input.value = '';
      render();
      input.blur();
    }
  });

  chips.forEach((chip, k) => {
    chip.addEventListener('click', () => {
      if (activeTopic === k) {
        activeTopic = null;
        chip.classList.remove('active');
      } else {
        chips.forEach(c => c.classList.remove('active'));
        activeTopic = k;
        chip.classList.add('active');
      }
      render();
    });
  });

  render();
})();

(function() {
  /* ── The picture, lifted off the line ──────────────────────────
     The ledger is a column of type. The photograph an essay carries
     is not printed into that column at size, it is picked up off the
     line you are pointing at and held next to the cursor, so the list
     stays a list and the picture still gets to be a picture.
     Pointer only: on a touch screen the thumbnail on the line is it. */

  const peek = document.getElementById('peek');
  if (!peek) return;
  if (!window.matchMedia('(min-width: 1100px) and (hover: hover) and (pointer: fine)').matches) return;

  const img = peek.querySelector('img');
  const cap = peek.querySelector('.peek-no');
  const PW = 300, PH = 240, GAP = 26;
  let shown = false;
  let x = 0, y = 0;

  function place(ev) {
    // Flip to the other side of the cursor rather than run off the screen.
    const right = ev.clientX + GAP;
    x = right + PW > window.innerWidth - 12 ? ev.clientX - GAP - PW : right;
    y = Math.min(Math.max(ev.clientY - PH / 2, 12), window.innerHeight - PH - 12);
    peek.style.left = x.toFixed(0) + 'px';
    peek.style.top = y.toFixed(0) + 'px';
  }

  document.querySelectorAll('.entry-link').forEach(link => {
    const src = link.dataset.peek;
    if (!src) return;

    link.addEventListener('mouseenter', ev => {
      img.src = src;
      cap.textContent = 'No. ' + link.dataset.no;
      peek.style.display = 'block';
      place(ev);
      // One frame with it placed but transparent, so it fades in where it
      // belongs instead of sliding over from wherever it was last.
      requestAnimationFrame(() => { peek.classList.add('on'); shown = true; });
    });

    link.addEventListener('mousemove', ev => { if (shown) place(ev); });

    link.addEventListener('mouseleave', () => {
      shown = false;
      peek.classList.remove('on');
      setTimeout(() => { if (!shown) peek.style.display = 'none'; }, 200);
    });
  });
})();

</script>
