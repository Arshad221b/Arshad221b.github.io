    border-radius: 12px;
    color: white;
    box-shadow: 0 4px 16px rgba(196, 116, 63, 0.3);
  }

  .icon-ripple {
    position: absolute;
    inset: -3px;
    border: 2px solid var(--color-accent);
    border-radius: 14px;
    opacity: 0.3;
    animation: ripple 2s infinite;
  }

  @keyframes ripple {
    0% { transform: scale(1); opacity: 0.3; }
    100% { transform: scale(1.1); opacity: 0; }
  }

  .substack-details {
    position: relative;
  }

  .substack-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
