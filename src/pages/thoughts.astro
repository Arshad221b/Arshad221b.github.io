<script is:inline>

/* One month marker rides down the margin beside the whole list, and turns
   to the next month as you cross into it, so a month's label stays with
   all of its pieces, not just the first. */
(function () {
  var list = document.getElementById('post-index');
  // The river carries the dates now; the old margin rider is not built, so
  // nothing measures the rows on every scroll.
  return;
  var rider = document.createElement('div');
  rider.className = 'month-rider';
  rider.setAttribute('aria-hidden', 'true');
  rider.innerHTML = '<span class="dd"></span><span class="mm"></span>';
  list.parentNode.insertBefore(rider, list);
  var dd = rider.querySelector('.dd'), mm = rider.querySelector('.mm'), shown = '', off = 0;
  var LINE = 140;
  function update() {
    var ranked = list.classList.contains('ranked');
    var rows = [].slice.call(list.querySelectorAll('[data-month]')).filter(function (r) {
      return !r.classList.contains('hidden') && r.offsetParent !== null;
    });
    // Sit level with the first piece (below the year heading) until it is
    // reached, then hold at the top: an offset on the marker's own content,
    // so no margin of the page around it is touched.
    if (rows.length) {
      off = Math.max(0, Math.round(rows[0].getBoundingClientRect().top + 28 - (rider.getBoundingClientRect().top - off)));
      rider.style.transform = 'translateY(' + off + 'px)';
    }
    var cur = null;
    for (var i = 0; i < rows.length; i++) {
      var b = rows[i].getBoundingClientRect();
      if (b.top <= LINE + 40) cur = rows[i];
      if (b.top > LINE + 40) break;
    }
    if (!cur && rows.length && rows[0].getBoundingClientRect().top < innerHeight) cur = rows[0];
    var first = rows.length ? rows[0].getBoundingClientRect().top : Infinity;
    rider.classList.toggle('on', !ranked && !!cur && first < innerHeight * 0.8);
    if (!cur) return;
    var label = cur.querySelector('time');
    var key = cur.dataset.month;
    if (key !== shown) {
      shown = key;
      rider.classList.remove('turn'); void rider.offsetWidth; rider.classList.add('turn');
      dd.textContent = label.querySelector('.dd').textContent;
      mm.textContent = label.querySelector('.mm').textContent;
    }
  }
  var queued = false;
  function queue() { if (!queued) { queued = true; requestAnimationFrame(function () { queued = false; update(); }); } }
  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', queue);
  new MutationObserver(queue).observe(list, { subtree: true, attributes: true, attributeFilter: ['class'], childList: true });
  update();
})();
(function() {
  /* The site's bar is sticky and sits above everything, so the year has to
     know how tall it is to come to rest just underneath it rather than
     disappear behind it. Measured, because the bar changes height with the
     screen. */
  const bar = document.querySelector('body > header');
  if (!bar) return;
  const measure = () => document.documentElement.style.setProperty(
    '--nav-h', Math.round(bar.getBoundingClientRect().height) + 'px');
  measure();
  if (window.ResizeObserver) new ResizeObserver(measure).observe(bar);
  else window.addEventListener('resize', measure);
})();

(function() {
  /* ── Searching ────────────────────────────────────────────────
     Typing here is not a string comparison. The query is tokenised and
     stemmed the same way the corpus was, projected into the latent space
     the model was fitted in, and scored by cosine against every essay, so
     "burnout at work" reaches an essay that never uses either word. A
     small exact-term boost sits on top, because a rare word someone
     actually typed should still pull its own essay up.

     The model is ~100KB over the wire and nobody who is only reading the
     page needs it, so it is fetched the first time the box is touched.
     Until it lands, the box falls back to matching letters.          */

  const input = document.getElementById('search-input');
  const seek = input.closest('.seek');
  const clearBtn = document.getElementById('seek-clear');
  const index = document.getElementById('post-index');
  const entries = Array.from(index.querySelectorAll('.entry'));
  const bands = Array.from(index.querySelectorAll('.year-band'));
  const chips = Array.from(document.querySelectorAll('.idx'));
  const counter = document.getElementById('results-count');
  const empty = document.getElementById('no-results');
  const strip = document.getElementById('theme-strip');

  let activeTopic = null;
  let model = null;
  let loading = null;

  /* Every essay's topic memberships, as probabilities. */
  const member = entries.map(e => {
    const ks = e.dataset.topics ? e.dataset.topics.split(',').map(Number) : [];
    const ps = e.dataset.p ? e.dataset.p.split(',').map(Number) : [];
    return new Map(ks.map((k, i) => [k, ps[i] ?? 0]));
  });

  /* ── The same tokeniser the corpus was built with ─────────────────
     If this drifts from src/lib/text.ts, a query stops landing on the
     terms the model actually holds. */
  const STOP = new Set(('a about above after again against all am an and any are as at be because been before being below ' +
    'between both but by can cannot could did do does doing down during each few for from further had has have having he ' +
    'her here hers herself him himself his how i if in into is it its itself me more most my myself no nor not of off on ' +
    'once only or other ought our ours ourselves out over own same she should so some such than that the their theirs them ' +
    'themselves then there these they this those through to too under until up very was we were what when where which while ' +
    'who whom why with would you your yours yourself yourselves just like get got also even still much many really thing ' +
    'things way ways lot lots maybe perhaps actually basically literally bit quite rather pretty another every something ' +
    'someone anything nothing everything always never often sometimes around almost already instead however therefore ' +
    'though although yet within without upon toward towards etc okay yeah thus hence per via able enough make makes made ' +
    'making take takes took taking come comes came coming go goes going went put puts let lets doesn isn wasn aren couldn ' +
    'wouldn shouldn didn don won hasn haven ain shan mustn').split(' '));

  function undouble(base) {
    if (base.length < 3) return base;
    const a = base[base.length - 1], b = base[base.length - 2];
    if (a === b && !'aeiou'.includes(a)) base = base.slice(0, -1);
    if (base.length >= 3 && !/[aeiou]/.test(base.slice(-3))) return base + 'e';
    return base;
  }

  function stem(w) {
    if (w.length <= 4) return w;
    if (w.endsWith('iness') && w.length >= 7) return w.slice(0, -5) + 'y';
    if (w.endsWith('ies') && w.length >= 5) return w.slice(0, -3) + 'y';
    if (w.endsWith('ness') && w.length >= 7) return w.slice(0, -4);
    if (w.endsWith('ement') && w.length >= 8) return w.slice(0, -5);
    if (w.endsWith('ing') && w.length >= 6) return undouble(w.slice(0, -3));
    if (w.endsWith('ed') && w.length >= 5) return undouble(w.slice(0, -2));
    if (w.endsWith('es') && w.length >= 5 && /(s|x|z|ch|sh)es$/.test(w)) return w.slice(0, -2);
    if (w.endsWith('s') && !w.endsWith('ss') && !w.endsWith('us') && w.length >= 5) return w.slice(0, -1);
    return w;
  }

  function tokenize(text) {
    const norm = text.toLowerCase()
      .replace(/[‘’ʼ′]/g, "'")
      .replace(/[–—]/g, ' ')
      .replace(/'(s|t|re|ve|ll|d|m)\b/g, '');
    const out = [];
    for (const raw of norm.match(/[a-z][a-z'-]{2,21}/g) || []) {
      const w = raw.replace(/[^a-z]/g, '');
      if (w.length < 3 || STOP.has(w)) continue;
      const st = stem(w);
      if (st.length < 3 || STOP.has(st)) continue;
      out.push(st);
    }
    return out;
  }

  function loadModel() {
    if (loading) return loading;
    loading = fetch('/thoughts-search.json')
      .then(r => (r.ok ? r.json() : Promise.reject(new Error(r.status))))
      .then(m => {
        const bin = atob(m.termVectors);
        const bytes = new Int8Array(bin.length);
        for (let i = 0; i < bin.length; i++) bytes[i] = (bin.charCodeAt(i) << 24) >> 24;
        const words = m.vocab.split('\n');
        model = {
          dims: m.dims,
          termId: new Map(words.map((w, i) => [w, i])),
          U: bytes,
          scale: m.termScale,
          docs: m.docVectors,
          postings: m.postings,
          rareIdf: m.rareIdf,
        };
        seek.classList.add('is-semantic');
        return model;
      })
      .catch(() => { model = null; return null; });
    return loading;
  }

  /* Cosine against every essay, plus a nudge for exact rare terms and for
     a literal hit in the title. Returns null when the query reached no
     term the model holds, so the caller can fall back. */
  function semanticScores(q) {
    if (!model) return null;
    const toks = tokenize(q);
    const tf = new Map();
    for (const t of toks) {
      const i = model.termId.get(t);
      if (i !== undefined) tf.set(i, (tf.get(i) || 0) + 1);
    }
    if (!tf.size) return null;

    const K = model.dims;
    const qv = new Float64Array(K);
    tf.forEach((n, i) => {
      const w = 1 + Math.log(n);
      for (let j = 0; j < K; j++) qv[j] += w * model.U[i * K + j] * model.scale;
    });
    let norm = 0;
    for (let j = 0; j < K; j++) norm += qv[j] * qv[j];
    norm = Math.sqrt(norm);
    if (norm < 1e-9) return null;
    for (let j = 0; j < K; j++) qv[j] /= norm;

    const lower = q.toLowerCase();
    return entries.map(entry => {
      const d = Number(entry.dataset.i);
      const dv = model.docs[d];
      let cos = 0;
      for (let j = 0; j < K; j++) cos += qv[j] * dv[j];
      let lex = 0;
      tf.forEach((_, i) => {
        const list = model.postings[i];
        if (list && list.indexOf(d) !== -1) lex += model.rareIdf[i] || 1;
      });
      const literal = entry.dataset.title.indexOf(lower) !== -1 ? 1 : 0;
      const sim = Math.max(0, Math.min(1, cos));
      return { score: sim + 0.14 * Math.min(lex, 4) + 0.25 * literal, sim };
    });
  }

  // Before the model lands, and for queries it cannot reach, match letters.
  function literalScores(q) {
    const lower = q.toLowerCase();
    return entries.map(entry => {
      const sim = entry.dataset.title.indexOf(lower) !== -1 ? 1
        : entry.dataset.description.indexOf(lower) !== -1 ? 0.6 : 0;
      return { score: sim, sim };
    });
  }

  /* Where to cut a ranking off. A fixed threshold either buries a good
     answer under forty weak ones or throws away a whole weak-but-real
     result set, because the scores a query produces depend on the query.
     So the cut is relative to the best hit it found, with a floor. */
  const CUT_RATIO = 0.42;
  const CUT_FLOOR = 0.14;
  const MOST = 24;

  function render() {
    const q = input.value.trim();
    const ranking = q ? (semanticScores(q) || literalScores(q)) : null;
    const semantic = !!(q && model && semanticScores(q));
    let top = 0;
    if (ranking) {
      entries.forEach((entry, idx) => {
        if (activeTopic !== null && !member[idx].has(activeTopic)) return;
        top = Math.max(top, ranking[idx].score);
      });
    }
    const cut = Math.max(CUT_FLOOR, top * CUT_RATIO);

    const order = [];
    entries.forEach((entry, idx) => {
      const inTopic = activeTopic === null || member[idx].has(activeTopic);
      const score = ranking ? ranking[idx].score : 0;
      const show = inTopic && (!ranking || score >= cut);
      entry.classList.toggle('hidden', !show);
      if (!show) return;
      order.push({ idx, entry, score, sim: ranking ? ranking[idx].sim : 0,
                   p: member[idx].get(activeTopic) || 0 });
    });

    /* How the surviving essays are put in order. A query ranks by
       relevance; a topic on its own ranks by how much of the essay that
       topic actually accounts for; otherwise it is the archive, newest
       first, under its years. */
    const ranked = !!ranking || activeTopic !== null;
    index.classList.toggle('ranked', ranked);
    if (ranked) {
      order.sort((a, b) => (ranking ? b.score - a.score : b.p - a.p));
      // A long tail of weak answers is not a result, it is an apology.
      if (ranking) {
        order.splice(MOST).forEach(o => o.entry.classList.add('hidden'));
      }
      order.forEach((o, rank) => { o.entry.style.order = String(rank); });
    } else {
      entries.forEach(e => { e.style.order = ''; });
    }
    const visible = order.length;

    // The bar on each line: relevance when searching, share of the essay
    // when a topic is chosen. Hidden when neither applies.
    order.forEach(o => {
      const mark = o.entry.querySelector('.entry-score');
      if (!ranked) { mark.hidden = true; return; }
      const v = ranking ? o.sim : Math.min(o.p / 0.6, 1);
      mark.hidden = false;
      mark.style.setProperty('--fill', (v * 100).toFixed(1) + '%');
      // Never a bare percentage: on its own it reads as how much of the
      // essay you have read, which is not what this is.
      mark.textContent = Math.round((ranking ? o.sim : o.p) * 100) + '% match';
    });

    // Year headings belong to the archive. A ranking is not in year order,
    // so they come out rather than lie about what follows them.
    bands.forEach(band => {
      if (ranked) { band.classList.add('hidden'); return; }
      const year = band.dataset.year;
      const any = entries.some(e => !e.classList.contains('hidden') && e.dataset.year === year);
      band.classList.toggle('hidden', !any);
      const count = band.querySelector('.year-count');
      if (count && any) {
        const n = entries.filter(e => !e.classList.contains('hidden') && e.dataset.year === year).length;
        count.textContent = n + (n === 1 ? ' essay' : ' essays');
      }
    });

    seek.classList.toggle('has-value', q.length > 0);
    updateStrip(q, visible);

    // Say what is on screen in words. This page is not a dashboard.
    const topicName = activeTopic !== null
      ? chips[activeTopic].querySelector('.idx-name').textContent : '';
    const n = visible + (visible === 1 ? ' essay' : ' essays');
    if (activeTopic !== null && q) {
      counter.textContent = n + ' on ' + topicName + ', closest to “' + q + '” first.';
    } else if (activeTopic !== null) {
      counter.textContent = n + ' on ' + topicName + ', the most about it first.';
    } else if (q) {
      counter.textContent = semantic
        ? n + ' closest in meaning to “' + q + '”.'
        : n + ' mentioning “' + q + '”.';
    } else {
      counter.textContent = '';
    }
    empty.style.display = visible === 0 ? 'block' : 'none';
  }

  /* The strip recounts itself against what is on screen: a topic that
     nothing visible is about drops out, so it only ever offers narrowings
     that lead somewhere. */
  function updateStrip(q, visible) {
    const live = new Map();
    entries.forEach((entry, idx) => {
      if (entry.classList.contains('hidden')) return;
      member[idx].forEach((_, k) => live.set(k, (live.get(k) || 0) + 1));
    });
    const ranked = [...live.entries()]
      .filter(([k]) => k !== activeTopic)
      .sort((a, b) => b[1] - a[1] || a[0] - b[0]);
    const rank = new Map(ranked.map(([k], i) => [k, i]));

    chips.forEach((chip, k) => {
      if (k === activeTopic) {
        chip.classList.remove('gone');
        chip.style.order = '-1';
        chip.querySelector('.idx-n').textContent = String(visible);
        return;
      }
      const r = rank.get(k);
      chip.classList.toggle('gone', r === undefined);
      if (r !== undefined) {
        chip.style.order = String(r);
        chip.querySelector('.idx-n').textContent = String(live.get(k));
      }
    });
  }

  input.addEventListener('input', () => {
    if (!model) loadModel().then(() => render());
    render();
  });
  // Warm the model on the first sign of intent, so the first keystroke is
  // usually already semantic.
  ['focus', 'pointerenter'].forEach(ev => seek.addEventListener(ev, loadModel, { once: true }));

  clearBtn.addEventListener('click', () => { input.value = ''; render(); input.focus(); });

  document.addEventListener('keydown', e => {
    const typing = /^(INPUT|TEXTAREA)$/.test(document.activeElement.tagName)
      || document.activeElement.isContentEditable;
    if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) {
      e.preventDefault();
      loadModel();
      input.focus();
    } else if (e.key === 'Escape' && document.activeElement === input) {
      input.value = '';
      render();
      input.blur();
    }
  });

  chips.forEach((chip, k) => {
    chip.addEventListener('click', () => {
      if (activeTopic === k) {
        activeTopic = null;
        chip.classList.remove('active');
      } else {
        chips.forEach(c => c.classList.remove('active'));
        activeTopic = k;
        chip.classList.add('active');
      }
      render();
    });
  });

  render();
})();

(function() {
  /* ── The picture, lifted off the line ──────────────────────────
     The ledger is a column of type. The photograph an essay carries
     is not printed into that column at size, it is picked up off the
     line you are pointing at and held next to the cursor, so the list
     stays a list and the picture still gets to be a picture.
     Pointer only: on a touch screen the thumbnail on the line is it. */

  const peek = document.getElementById('peek');
  if (!peek) return;
  if (!window.matchMedia('(min-width: 1100px) and (hover: hover) and (pointer: fine)').matches) return;

  const img = peek.querySelector('img');
  const cap = peek.querySelector('.peek-no');
  const PW = 300, PH = 240, GAP = 26;
  let shown = false;
  let x = 0, y = 0;

  function place(ev) {
    // Flip to the other side of the cursor rather than run off the screen.
    const right = ev.clientX + GAP;
    x = right + PW > window.innerWidth - 12 ? ev.clientX - GAP - PW : right;
    y = Math.min(Math.max(ev.clientY - PH / 2, 12), window.innerHeight - PH - 12);
    peek.style.left = x.toFixed(0) + 'px';
    peek.style.top = y.toFixed(0) + 'px';
  }

  document.querySelectorAll('.entry-link').forEach(link => {
    const src = link.dataset.peek;
    if (!src) return;

    link.addEventListener('mouseenter', ev => {
      img.src = src;
      cap.textContent = 'No. ' + link.dataset.no;
      peek.style.display = 'block';
      place(ev);
      // One frame with it placed but transparent, so it fades in where it
      // belongs instead of sliding over from wherever it was last.
      requestAnimationFrame(() => { peek.classList.add('on'); shown = true; });
    });

    link.addEventListener('mousemove', ev => { if (shown) place(ev); });

    link.addEventListener('mouseleave', () => {
      shown = false;
      peek.classList.remove('on');
      setTimeout(() => { if (!shown) peek.style.display = 'none'; }, 200);
    });
  });
})();

</script>

<script is:inline>
  /* The river: one smooth curve through every visible essay's landing
     point and every year's station, in order down the page. It is redrawn
     whenever the layout moves or a search changes what is shown, and it is
     inked on as the reader scrolls down to it. */
  (function () {
    var wrap = document.querySelector('.river-wrap');
    if (!wrap) return;
    var svg = wrap.querySelector('.river');
    var line = svg.querySelector('.river-line');
    var wash = svg.querySelector('.river-wash');
    var bank = svg.querySelector('.river-bank');
    var water = svg.querySelector('.river-water');
    var flowers = svg.querySelector('.river-flowers'), blooms = [];
    var ledger = wrap.querySelector('.ledger');
    var clip = svg.querySelector('#river-inked rect');
    var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // On a phone the river simply follows the finger: no steps, no
    // arrivals, nothing moving but the ink.
    var phone = matchMedia('(max-width: 719px)');
    var length = 0, height = 0, queued = false, samples = [], stops = [], landings = [], lastY = -1;

    function centre(el, box) {
      var r = el.getBoundingClientRect();
      return [r.left + r.width / 2 - box.left, r.top + r.height / 2 - box.top];
    }

    function draw() {
      queued = false;
      var box = wrap.getBoundingClientRect();
      height = wrap.offsetHeight;
      var pts = [];
      landings = [];
      lastY = -1;
      ledger.querySelectorAll('.year-band .year-num, .entry .node-dot').forEach(function (el) {
        if (!el.offsetParent) return;
        var c = centre(el, box), e = el.closest('.entry');
        if (e) landings.push([e, c[1]]);
        // Half the water's width at this landing: a few pixels for a year,
        // more for a longer essay.
        c.push(e ? 3 + Math.sqrt(+e.dataset.words || 0) / 5 : 3);
        pts.push(c);
      });
      if (pts.length < 2) { line.setAttribute('d', ''); wash.setAttribute('d', ''); return; }
      pts.sort(function (a, b) { return a[1] - b[1]; });
      pts.unshift([pts[0][0], 0, 2]);
      pts.push([pts[pts.length - 1][0], height, 2]);

      // Catmull-Rom through the points, as cubic Béziers: a curve that
      // passes through every landing and never kinks.
      var d = 'M' + pts[0][0].toFixed(1) + ' ' + pts[0][1].toFixed(1);
      for (var i = 0; i < pts.length - 1; i++) {
        var p0 = pts[i - 1] || pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] || p2;
        d += ' C' + (p1[0] + (p2[0] - p0[0]) / 6).toFixed(1) + ' ' + (p1[1] + (p2[1] - p0[1]) / 6).toFixed(1) +
             ' ' + (p2[0] - (p3[0] - p1[0]) / 6).toFixed(1) + ' ' + (p2[1] - (p3[1] - p1[1]) / 6).toFixed(1) +
             ' ' + p2[0].toFixed(1) + ' ' + p2[1].toFixed(1);
      }
      svg.setAttribute('viewBox', '0 0 ' + box.width.toFixed(0) + ' ' + height);
      line.setAttribute('d', d);
      length = line.getTotalLength();
      svg.querySelector('.river-inlay').setAttribute('d', d);
      [line, bank, water].forEach(function (el) {
        el.setAttribute('d', d);
        el.style.strokeDasharray = length + ' ' + length;
      });

      // Fountains along the channel, kept clear of the landings.
      flowers.innerHTML = '';
      blooms = [];
      for (var f = 90; f < length - 60; f += 170) {
        var fp = line.getPointAtLength(f);
        if (pts.some(function (p) { return Math.abs(p[1] - fp.y) < 46; })) continue;
        var use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
        use.setAttribute('href', '#mughal-rosette');
        use.setAttribute('x', (fp.x - 8).toFixed(1));
        use.setAttribute('y', (fp.y - 8).toFixed(1));
        use.setAttribute('width', '16');
        use.setAttribute('height', '16');
        flowers.appendChild(use);
        blooms.push([use, fp.y]);
      }
      samples = [];
      stops = pts.slice(1, -1).map(function (p) { return p[1]; });

      // The water: a ribbon either side of the line, its half-width eased
      // between the landings by height down the page.
      var left = [], right = [], k = 0;
      function halfAt(y) {
        while (k < pts.length - 2 && pts[k + 1][1] < y) k++;
        var a = pts[k], b = pts[k + 1], t = Math.min(1, Math.max(0, (y - a[1]) / Math.max(1, b[1] - a[1])));
        t = t * t * (3 - 2 * t);
        return a[2] + (b[2] - a[2]) * t;
      }
      for (var s = 0; s <= length; s += 6) {
        var p = line.getPointAtLength(s), q = line.getPointAtLength(Math.min(length, s + 1));
        var dx = q.x - p.x, dy = q.y - p.y, n = Math.hypot(dx, dy) || 1, h = halfAt(p.y);
        samples.push([s, p.y]);
        left.push((p.x - dy / n * h).toFixed(1) + ' ' + (p.y + dx / n * h).toFixed(1));
        right.push((p.x + dy / n * h).toFixed(1) + ' ' + (p.y - dx / n * h).toFixed(1));
      }
      wash.setAttribute('d', 'M' + left.join(' L') + ' L' + right.reverse().join(' L') + ' Z');
      place(Math.min(cur, length));
      ink();
    }

    // The drops are all there from the start; the river runs on from one
    // to the next as each essay comes into view, joining them up.
    // Where the river has got to, in length along the curve, and where it
    // is going: on a wide screen it runs on from landing to landing; on a
    // phone it follows the finger directly.
    var cur = 0, goal = 0, from = 0, began = 0, running = false;

    function place(len) {
      [line, bank, water].forEach(function (el) { el.style.strokeDashoffset = (length - len).toFixed(1); });
      var pt = line.getPointAtLength(Math.max(0, Math.min(length, len)));
      clip.style.height = pt.y.toFixed(0) + 'px';
      blooms.forEach(function (b) { b[0].classList.toggle('on', b[1] <= pt.y); });
    }

    function step(now) {
      var k = Math.min(1, (now - began) / 900);
      k = 1 - Math.pow(1 - k, 3);
      cur = from + (goal - from) * k;
      place(cur);
      if (k < 1) requestAnimationFrame(step); else running = false;
    }

    function ink() {
      var top = wrap.getBoundingClientRect().top, reach = innerHeight * 0.72 - top, y = 0;
      if (still || innerHeight + scrollY >= document.documentElement.scrollHeight - 4) reach = Infinity;
      if (phone.matches) y = Math.min(height, Math.max(0, innerHeight * 0.85 - top));
      else stops.forEach(function (s) { if (s <= reach) y = s; });
      if (reach === Infinity) y = height;
      var drawn = length;
      for (var i = 0; i < samples.length; i++) if (samples[i][1] >= y) { drawn = samples[i][0]; break; }
      // Positions were measured when the river was drawn; here nothing is
      // measured again, and classes change only when the river moves on.
      if (y !== lastY) {
        landings.forEach(function (l) { l[0].classList.toggle('reached', l[1] <= y + 1); });
        lastY = y;
      }
      if (still || phone.matches) { cur = goal = drawn; place(cur); return; }
      if (Math.abs(drawn - goal) < 0.5) return;
      from = cur; goal = drawn; began = performance.now();
      if (!running) { running = true; requestAnimationFrame(step); }
    }

    function later() {
      if (!queued) { queued = true; requestAnimationFrame(draw); }
    }

    new ResizeObserver(later).observe(ledger);
    new MutationObserver(function (list) {
      // Our own 'reached' marks are not a change of layout.
      if (list.some(function (m) { return m.attributeName !== 'class' || !m.target.classList.contains('entry') || m.target.classList.contains('hidden') !== (m.oldValue || '').includes('hidden'); })) later();
    }).observe(ledger, { subtree: true, attributes: true, attributeOldValue: true, attributeFilter: ['class', 'style', 'hidden'] });
    function flow() { ledger.classList.toggle('flowing', !still && !phone.matches); }
    flow();
    phone.addEventListener('change', function () { flow(); later(); });
    var inkQueued = false;
    addEventListener('scroll', function () {
      if (inkQueued) return;
      inkQueued = true;
      requestAnimationFrame(function () { inkQueued = false; ink(); });
    }, { passive: true });
    addEventListener('load', later);
    later();
  })();
</script>
