    text-decoration: none;
  }

  .entry time {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin-bottom: 0.35rem;
  }

  /* The title is the one thing that should catch the eye. */
  .entry h3 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text);
    margin: 0 0 0.35rem 0;
    transition: color 0.15s ease;
  }

  .entry a:hover h3 {
    color: var(--color-accent);
  }

  .entry p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.12rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 62ch;
    /* Three lines, not two. Enough for the voice to come through. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .entry-tags {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    opacity: 0.6;
    margin-top: 0.5rem;
  }

  .results-count {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-md) 0;
  }

  .results-count:empty {
    display: none;
  }

  .no-results {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--color-text-muted);
    padding: var(--space-xl) 0;
    margin: 0;
    display: none;
  }

  @media (max-width: 600px) {
    .year-group {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .year-label {
      padding-top: 0;
    }

    .entry h3 {
      font-size: 1.2rem;
    }
  }
</style>

<style is:global>
  .entry.hidden,
  .year-group.hidden {
    display: none !important;
  }
</style>

<script is:inline>
(function() {
  /* ── The tissue ────────────────────────────────────────────────
     This is not a diagram that moves. It is a small nervous system.
     Aliveness comes from conduction, not from displacement: cells
     fire, the charge runs down the axon, and whatever it reaches
     fires in turn. Nothing is ever jostled out of position, which is
     why there is no wobble to speak of. Brains do not wobble.
     Pointing at a cell stimulates it. The cascade you see spreading
     is the real shape of what that essay is tied to.            */

  const svg = document.getElementById('cortex-svg');
  if (svg) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const field = document.getElementById('cortex-field');
    const label = document.getElementById('cortex-label');
    const labelText = label.querySelector('text');
    const labYear = label.querySelector('.lab-year');
    const labTitle = label.querySelector('.lab-title');
    const signalLayer = svg.querySelector('.signals');
    const NS = 'http://www.w3.org/2000/svg';

    const anchors = Array.from(svg.querySelectorAll('.somas a'));
    const somas = Array.from(svg.querySelectorAll('.somas .soma'));
    const charges = Array.from(svg.querySelectorAll('.charge circle'));
    const paths = Array.from(svg.querySelectorAll('.axons path'));

    const cells = anchors.map(function (a, i) {
      return {
        x: parseFloat(a.dataset.x),
        y: parseFloat(a.dataset.y),
        rest: parseFloat(somas[i].getAttribute('r')),
        charge: 0,      // how lit the cell body is, 0 to 1
        refractory: 0,  // a cell that just fired cannot fire again yet
        out: []         // the axons leaving it
      };
    });

    // Every axon knows its curve, so a signal can be placed anywhere along it.
    const axons = paths.map(function (el) {
      const a = Number(el.dataset.a), b = Number(el.dataset.b);
      const d = el.getAttribute('d');
      const nums = d.match(/-?\d+(\.\d+)?/g).map(Number);
      const ax = { el: el, a: a, b: b,
        x0: nums[0], y0: nums[1], cx: nums[2], cy: nums[3], x1: nums[4], y1: nums[5],
        heat: 0 };
      ax.len = Math.hypot(ax.x1 - ax.x0, ax.y1 - ax.y0) * 1.06;
      cells[a].out.push(ax);
      cells[b].out.push(ax);
      return ax;
    });

    function pointOn(ax, t, fromA) {
      const u = fromA ? t : 1 - t, v = 1 - u;
      return {
        x: v * v * ax.x0 + 2 * v * u * ax.cx + u * u * ax.x1,
        y: v * v * ax.y0 + 2 * v * u * ax.cy + u * u * ax.y1
      };
    }

    // A fixed pool of signal dots, so firing never allocates mid-flight.
    const POOL = 140;
    const pool = [];
    for (let i = 0; i < POOL; i++) {
      const c = document.createElementNS(NS, 'circle');
      c.setAttribute('r', '2.1');
      c.setAttribute('opacity', '0');
      signalLayer.appendChild(c);
      pool.push({ el: c, live: false, ax: null, fromA: true, t: 0, speed: 0, depth: 0, strength: 1 });
    }

    const SPEED = 235;        // how fast charge travels, units per second
    const DECAY = 3.6;        // how fast a lit cell body fades
    const REFRACTORY = 0.42;  // silence after firing, in seconds

    function fire(i, depth, strength) {
      const cell = cells[i];
      if (cell.refractory > 0 || depth <= 0) return;
      cell.charge = Math.min(1, cell.charge + strength);
      cell.refractory = REFRACTORY;
      for (let k = 0; k < cell.out.length; k++) {
        const ax = cell.out[k];
        const slot = pool.find(function (s) { return !s.live; });
        if (!slot) return;
        slot.live = true;
        slot.ax = ax;
        slot.fromA = ax.a === i;
        slot.t = 0;
        slot.speed = SPEED / ax.len;
        slot.depth = depth - 1;
        slot.strength = strength * 0.6;
      }
    }

    /* ── Pointing at a cell stimulates it ─────────────────────── */
    let hovered = -1;
    let stimTimer = 0;

    function placeLabel(x, y) {
      labelText.setAttribute('text-anchor', x < 250 ? 'start' : x > 750 ? 'end' : 'middle');
      labelText.setAttribute('x', x.toFixed(1));
      labelText.setAttribute('y', (y - 18).toFixed(1));
    }

    function touch(anchor) {
      hovered = Number(anchor.dataset.i);
      svg.classList.add('lit');
      labYear.textContent = anchor.dataset.year;
      labTitle.textContent = anchor.dataset.title;
      placeLabel(cells[hovered].x, cells[hovered].y);
      label.classList.add('show');
      cells[hovered].refractory = 0;
      fire(hovered, 4, 1);
      stimTimer = 0.95;
    }

    function release() {
      hovered = -1;
      svg.classList.remove('lit');
      label.classList.remove('show');
    }

    anchors.forEach(function (a) {
      a.addEventListener('mouseenter', function () { touch(a); });
      a.addEventListener('focus', function () { touch(a); });
      a.addEventListener('touchstart', function () { touch(a); }, { passive: true });
    });
    svg.addEventListener('mouseleave', release);

    if (still) {
      // No animation wanted: keep the stimulation readable, statically.
      anchors.forEach(function (a, i) {
        a.addEventListener('mouseenter', function () {
          charges[i].setAttribute('opacity', '1');
          cells[i].out.forEach(function (ax) { ax.el.style.stroke = 'var(--color-accent)'; });
        });
        a.addEventListener('mouseleave', function () {
          charges[i].setAttribute('opacity', '0');
          cells[i].out.forEach(function (ax) { ax.el.style.stroke = ''; });
        });
      });
      return;
    }

    /* ── The loop ─────────────────────────────────────────────── */
    const BREATH = 0.016;      // how far the tissue swells
    const BREATH_PERIOD = 6.4; // one full breath, in seconds
    const RESTING_RATE = 1.15; // spontaneous fires per second when left alone

    let clock = 0;
    let last = performance.now();
    let onScreen = true;
    if (window.IntersectionObserver) {
      new IntersectionObserver(function (e) { onScreen = e[0].isIntersecting; },
        { rootMargin: '140px' }).observe(svg);
    }

    function frame(now) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;

      if (!document.hidden && onScreen) {
        clock += dt;

        /* The breath: one uniform scale about the centre. Every distance
           changes by the same factor, so the drawing cannot shimmer. It
           fills, holds, empties slower than it filled, and rests. */
        const cycle = (clock % BREATH_PERIOD) / BREATH_PERIOD;
        let fill;
        if (cycle < 0.34) fill = 0.5 - 0.5 * Math.cos(Math.PI * (cycle / 0.34));
        else if (cycle < 0.46) fill = 1;
        else if (cycle < 0.86) fill = 0.5 + 0.5 * Math.cos(Math.PI * ((cycle - 0.46) / 0.40));
        else fill = 0;
        const swell = 1 + fill * BREATH;
        field.setAttribute('transform',
          'translate(500,310) scale(' + swell.toFixed(5) + ') translate(-500,-310)');

        // Resting activity. A brain left alone is not a brain switched off.
        if (hovered < 0 && Math.random() < RESTING_RATE * dt) {
          fire(Math.floor(Math.random() * cells.length), 3, 0.85);
        }

        // Holding the pointer on a cell keeps stimulating it.
        if (hovered >= 0) {
          stimTimer -= dt;
          if (stimTimer <= 0) {
            cells[hovered].refractory = 0;
            fire(hovered, 4, 1);
            stimTimer = 0.95;
          }
          placeLabel(cells[hovered].x, cells[hovered].y);
        }

        for (let i = 0; i < cells.length; i++) {
          const c = cells[i];
          if (c.refractory > 0) c.refractory -= dt;
          if (c.charge > 0.001) {
            c.charge -= c.charge * DECAY * dt;
            charges[i].setAttribute('opacity', c.charge.toFixed(3));
            charges[i].setAttribute('r', (c.rest + c.charge * 5.5).toFixed(2));
          } else if (c.charge !== 0) {
            c.charge = 0;
            charges[i].setAttribute('opacity', '0');
          }
        }

        for (let s = 0; s < pool.length; s++) {
          const sig = pool[s];
          if (!sig.live) continue;
          sig.t += sig.speed * dt;
          if (sig.t >= 1) {
            sig.live = false;
            sig.el.setAttribute('opacity', '0');
            const target = sig.fromA ? sig.ax.b : sig.ax.a;
            sig.ax.heat = Math.max(sig.ax.heat, sig.strength);
            if (sig.depth > 0 && sig.strength > 0.18) fire(target, sig.depth, sig.strength);
            continue;
          }
          const p = pointOn(sig.ax, sig.t, sig.fromA);
          sig.el.setAttribute('cx', p.x.toFixed(1));
          sig.el.setAttribute('cy', p.y.toFixed(1));
          sig.el.setAttribute('opacity', (0.35 + sig.strength * 0.65).toFixed(2));
          sig.ax.heat = Math.max(sig.ax.heat, sig.strength * 0.85);
        }

        for (let k = 0; k < axons.length; k++) {
          const ax = axons[k];
          if (ax.heat > 0.004) {
            ax.heat -= ax.heat * 2.6 * dt;
            ax.el.style.stroke = 'var(--color-accent)';
            ax.el.style.strokeOpacity = ax.heat.toFixed(3);
            ax.el.style.strokeWidth = (0.7 + ax.heat * 0.9).toFixed(2);
          } else if (ax.heat !== 0) {
            ax.heat = 0;
            ax.el.style.stroke = '';
            ax.el.style.strokeOpacity = '';
            ax.el.style.strokeWidth = '';
          }
        }
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }
})();

(function() {
  const input = document.getElementById('search-input');
  const index = document.getElementById('post-index');
  const entries = index.querySelectorAll('.entry');
  const groups = index.querySelectorAll('.year-group');
  const chips = document.querySelectorAll('.tag-chip');
  const counter = document.getElementById('results-count');
  const empty = document.getElementById('no-results');
  let activeTag = null;

  function filter() {
    const q = input.value.toLowerCase().trim();
    let visible = 0;

    entries.forEach(entry => {
      const matchesText = !q
        || entry.dataset.title.includes(q)
        || entry.dataset.description.includes(q)
        || entry.dataset.tags.includes(q);
      const matchesTag = !activeTag || entry.dataset.tags.split(',').includes(activeTag);
      const show = matchesText && matchesTag;
      entry.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    // Drop a year heading entirely when nothing under it survived.
    groups.forEach(group => {
      const anyVisible = group.querySelector('.entry:not(.hidden)');
      group.classList.toggle('hidden', !anyVisible);
    });

    // Say what is on screen in words. This page is not a dashboard.
    if (activeTag && q) {
      counter.textContent = 'Everything about ' + activeTag + ' that mentions "' + q + '".';
    } else if (activeTag) {
      counter.textContent = 'Everything I have written about ' + activeTag + '.';
    } else if (q) {
      counter.textContent = 'Everything that mentions "' + q + '".';
    } else {
      counter.textContent = '';
    }
    empty.style.display = visible === 0 ? 'block' : 'none';
  }

  input.addEventListener('input', filter);

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const tag = chip.dataset.tag;
      if (activeTag === tag) {
        activeTag = null;
        chip.classList.remove('active');
      } else {
        chips.forEach(c => c.classList.remove('active'));
        activeTag = tag;
        chip.classList.add('active');
      }
      filter();
    });
  });
})();
</script>
