  { title: 'You Are Not Einstein. Neither Was He.', date: '2026-03-10', description: 'Einstein\'s genius wasn\'t about being smarter. It was about staring at the gap between expectation and reality until it revealed something new.', tags: ['curiosity', 'personal growth'], slug: 'you-are-not-einstein' },
  { title: 'Your Laziness has its reason and you can fix it', date: '2023-12-08', description: 'Every child is unique; we often hear this sentiment. Yet, despite celebrating individual differences, children are often funneled into a uniform educational structure, where they find themselves en...', tags: ['psychology', 'motivation'], slug: 'your-laziness-has-its-reason-and-you-can-fix-it' },
]).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const allTags = [...new Set(posts.flatMap(p => p.tags))].sort();

// The themes I return to most, ordered by how often I come back to them.
// Counts are used to order this list, never shown.
const tagWeight = new Map<string, number>();
posts.forEach(p => p.tags.forEach(t => tagWeight.set(t, (tagWeight.get(t) ?? 0) + 1)));
const recurring = [...tagWeight.entries()]
  .filter(([, n]) => n >= 3)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag]) => tag);
const otherTags = allTags.filter(t => !recurring.includes(t));

// Group posts by year so a long archive stays scannable.
const years = [...new Set(posts.map(p => p.date.slice(0, 4)))];
const grouped = years.map(year => ({
  year,
  items: posts.filter(p => p.date.slice(0, 4) === year),
}));

function shortDate(dateStr: string): string {
  const date = new Date(dateStr + 'T00:00:00');
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

/* ── The map ──────────────────────────────────────────────
   Every essay is a node. Two essays are joined when they share
   a theme, which means the clusters draw themselves: the things
   I keep circling end up dense, the one-offs sit out on the edge.
   The layout is solved here at build time, so the drawing is
   identical on every visit and needs no JavaScript to appear. */

const MAP_W = 1000;
const MAP_H = 620;

type MapNode = { i: number; title: string; slug: string; year: string; deg: number; x: number; y: number };

const mapNodes: MapNode[] = posts.map((p, i) => ({
  i,
  title: p.title,
  slug: p.slug,
  year: p.date.slice(0, 4),
  deg: 0,
  x: 0,
  y: 0,
}));

// Chain the essays inside each theme in the order they were written,
// rather than joining every pair. A thread, not a mesh.
const edges: { a: number; b: number }[] = [];
allTags.forEach(tag => {
  const members = posts
    .map((p, i) => ({ p, i }))
    .filter(({ p }) => p.tags.includes(tag))
    .sort((m, n) => new Date(m.p.date).getTime() - new Date(n.p.date).getTime());
  for (let k = 1; k < members.length; k++) {
    edges.push({ a: members[k - 1].i, b: members[k].i });
  }
});
edges.forEach(e => { mapNodes[e.a].deg++; mapNodes[e.b].deg++; });

// Deterministic pseudo-random start, so the drawing never shifts.
function mulberry32(seed: number) {
  return function () {
    seed |= 0; seed = (seed + 0x6D2B79F5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(20260817);

mapNodes.forEach((n, i) => {
  const angle = (i / mapNodes.length) * Math.PI * 2;
  const radius = 150 + rand() * 120;
  n.x = MAP_W / 2 + Math.cos(angle) * radius;
  n.y = MAP_H / 2 + Math.sin(angle) * radius * 0.62;
});

// Fruchterman-Reingold: edges pull, every node pushes, heat cools.
const area = MAP_W * MAP_H;
const kForce = Math.sqrt(area / mapNodes.length) * 1.15;
// Repulsion is local. Without a cutoff an essay that shares a theme with
// nothing gets pushed off the page by all 78 others at once.
const REPEL_RANGE = kForce * 2.6;
const ITER = 520;

for (let step = 0; step < ITER; step++) {
  const temp = (1 - step / ITER) ** 1.5 * (MAP_W / 9);
  const dx = new Array(mapNodes.length).fill(0);
  const dy = new Array(mapNodes.length).fill(0);

  for (let a = 0; a < mapNodes.length; a++) {
    for (let b = a + 1; b < mapNodes.length; b++) {
      let vx = mapNodes[a].x - mapNodes[b].x;
      let vy = mapNodes[a].y - mapNodes[b].y;
      let dist = Math.hypot(vx, vy) || 0.01;
      if (dist < 0.05) { vx = rand() - 0.5; vy = rand() - 0.5; dist = 0.05; }
      if (dist > REPEL_RANGE) continue;
      const push = (kForce * kForce) / dist;
      dx[a] += (vx / dist) * push; dy[a] += (vy / dist) * push;
      dx[b] -= (vx / dist) * push; dy[b] -= (vy / dist) * push;
    }
  }

  edges.forEach(e => {
    const vx = mapNodes[e.a].x - mapNodes[e.b].x;
    const vy = mapNodes[e.a].y - mapNodes[e.b].y;
    const dist = Math.hypot(vx, vy) || 0.01;
    const pull = (dist * dist) / kForce;
    dx[e.a] -= (vx / dist) * pull; dy[e.a] -= (vy / dist) * pull;
    dx[e.b] += (vx / dist) * pull; dy[e.b] += (vy / dist) * pull;
  });

  mapNodes.forEach((n, i) => {
    // A little gravity, so unconnected essays do not drift off the page.
    dx[i] += (MAP_W / 2 - n.x) * 0.035;
    dy[i] += (MAP_H / 2 - n.y) * 0.05;
    const disp = Math.hypot(dx[i], dy[i]) || 0.01;
    n.x += (dx[i] / disp) * Math.min(disp, temp);
    n.y += (dy[i] / disp) * Math.min(disp, temp);
  });
}

// Normalise into the viewBox with room for the theme labels.
const pad = 46;
const xs = mapNodes.map(n => n.x);
const ys = mapNodes.map(n => n.y);
const minX = Math.min(...xs), maxX = Math.max(...xs);
const minY = Math.min(...ys), maxY = Math.max(...ys);
const scaleX = (MAP_W - pad * 2) / (maxX - minX);
const scaleY = (MAP_H - pad * 2) / (maxY - minY);
mapNodes.forEach(n => {
  n.x = pad + (n.x - minX) * scaleX;
  n.y = pad + (n.y - minY) * scaleY;
});

const mapEdges = edges.map(e => ({
  a: e.a,
  b: e.b,
  x1: mapNodes[e.a].x, y1: mapNodes[e.a].y,
  x2: mapNodes[e.b].x, y2: mapNodes[e.b].y,
}));

// Name only the heaviest clusters, at the centre of mass of their essays,
// then nudge the names apart so they stay readable where clusters overlap.
const clusterLabels = recurring.slice(0, 7).map(tag => {
  const members = posts
    .map((p, i) => ({ p, i }))
    .filter(({ p }) => p.tags.includes(tag));
  const cx = members.reduce((s, m) => s + mapNodes[m.i].x, 0) / members.length;
  const cy = members.reduce((s, m) => s + mapNodes[m.i].y, 0) / members.length;
  return { tag, x: cx, y: cy, w: tag.length * 7 + 16 };
});

for (let pass = 0; pass < 240; pass++) {
  for (let a = 0; a < clusterLabels.length; a++) {
    for (let b = a + 1; b < clusterLabels.length; b++) {
      const A = clusterLabels[a], B = clusterLabels[b];
      const overlapX = (A.w + B.w) / 2 - Math.abs(A.x - B.x);
      const overlapY = 21 - Math.abs(A.y - B.y);
      if (overlapX > 0 && overlapY > 0) {
        const shove = Math.min(overlapY, 4) / 2 + 0.6;
        const dir = A.y <= B.y ? -1 : 1;
        A.y += shove * dir;
        B.y -= shove * dir;
        A.x += (A.x <= B.x ? -1 : 1) * Math.min(overlapX, 3) * 0.35;
        B.x += (A.x <= B.x ? 1 : -1) * Math.min(overlapX, 3) * 0.35;
      }
    }
  }
}

const nodeRadius = (deg: number) => 2.6 + Math.min(deg, 9) * 0.42;

// Axons bow rather than run straight. Nothing in a head is a ruled line.
const axons = mapEdges.map((e, i) => {
  const dx = e.x2 - e.x1, dy = e.y2 - e.y1;
  const len = Math.hypot(dx, dy) || 1;
  const bow = (i % 2 ? 1 : -1) * len * (0.07 + ((i * 37) % 11) / 190);
  const cx = (e.x1 + e.x2) / 2 + (-dy / len) * bow;
  const cy = (e.y1 + e.y2) / 2 + (dx / len) * bow;
  return {
    a: e.a, b: e.b,
    cx, cy,
    d: `M${e.x1.toFixed(1)} ${e.y1.toFixed(1)} Q${cx.toFixed(1)} ${cy.toFixed(1)} ${e.x2.toFixed(1)} ${e.y2.toFixed(1)}`,
  };
});
