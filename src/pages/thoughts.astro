---
import { img, share, has } from '../lib/media';
/* The Thoughts index.

   Nothing on this page is a list I maintain. The essays are read out of
   src/pages/thoughts at build time, and the themes, the map and the search
   all come from a model fitted over their full text in src/lib. Publishing
   is dropping a file in that folder. */

import Layout from '../layouts/Layout.astro';
import SketchPlate from '../components/SketchPlate.astro';
import Mast from '../components/Mast.astro';
import { posts, pageModel, topicName } from '../lib/thoughts-data';

const title = "Thoughts — Arshad Kazi";

// At the head of the page, in particles of ink: thought, reason, grief, anxiety and the self,
// as Dürer, Goya, Van Gogh, Munch and Schiele drew them.
const sketches = ['thoughts-bg/melencolia', 'india/nataraja', 'thoughts-bg/sleep-of-reason', 'thoughts-bg/the-scream', 'india/ajanta', 'thoughts-bg/schiele-self-portrait', 'india/shivaji', 'india/inayat-khan', 'thoughts-bg/school-of-athens', 'thoughts-bg/rembrandt', 'india/sarnath-buddha', 'thoughts-bg/kollwitz', 'india/mahavira', 'india/bahubali', 'india/sanchi', 'india/gandhara-buddha', 'india/meenakshi', 'thoughts-bg/wanderer', 'india/pashupati', 'india/priest-king', 'india/yakshi', 'india/bhimbetka', 'india/warli', 'india/kerala-mural', 'india/kabir', 'india/nanak', 'india/kalighat', 'india/phule', 'india/ambedkar', 'india/sher-gil']
  .map(n => img(`/images/${n}.jpg`, 1600));
const credits = [{"title": "Melencolia I, 1514", "by": "Albrecht Dürer · Nuremberg", "india": false}, {"title": "Shiva as the Lord of Dance, c. 950–1000", "by": "Chola bronze · Tamil Nadu", "india": true}, {"title": "The Sleep of Reason Produces Monsters, 1799", "by": "Francisco Goya · Madrid", "india": false}, {"title": "The Scream, 1895", "by": "Edvard Munch · Berlin", "india": false}, {"title": "Ajanta Cave 1, wall painting, c. 480 (copied 1880)", "by": "Ajanta painters · Ajanta", "india": true}, {"title": "Self-Portrait, 1912", "by": "Egon Schiele · Vienna", "india": false}, {"title": "Chhatrapati Shivaji Maharaj, c. 1680s", "by": "Deccani painter · Golconda", "india": true}, {"title": "The Dying Inayat Khan, 1618", "by": "Govardhan · Agra", "india": true}, {"title": "The School of Athens, 1511", "by": "Raphael · Rome", "india": false}, {"title": "Self-Portrait, 1659", "by": "Rembrandt van Rijn · Amsterdam", "india": false}, {"title": "Buddha Preaching the First Sermon, 5th century", "by": "Gupta sculptor · Sarnath", "india": true}, {"title": "Woman with Dead Child, 1903", "by": "Käthe Kollwitz · Berlin", "india": false}, {"title": "The Renunciation of Mahavira, c. 1500", "by": "Kalpasutra painter · Gujarat", "india": true}, {"title": "Bahubali, 983", "by": "Chamundaraya's sculptors · Shravanabelagola", "india": true}, {"title": "Western Gateway of the Sanchi Stupa, 1st century BCE", "by": "Satavahana carvers · Sanchi", "india": true}, {"title": "Standing Buddha, 2nd century", "by": "Gandhara sculptor · Gandhara", "india": true}, {"title": "Meenakshi Temple, Madurai, 1797", "by": "Thomas Daniell · Madurai", "india": true}, {"title": "Wanderer above the Sea of Fog, 1818", "by": "Caspar David Friedrich · Dresden", "india": false}, {"title": "Pashupati seal, c. 2500 BCE", "by": "Indus seal-cutter · Mohenjo-daro", "india": true}, {"title": "Priest-King, c. 2000 BCE", "by": "Indus sculptor · Mohenjo-daro", "india": true}, {"title": "Didarganj Yakshi, c. 3rd century BCE", "by": "Mauryan sculptor · Pataliputra", "india": true}, {"title": "Rock painting, Bhimbetka rock shelters", "by": "Early painters · Bhimbetka", "india": true}, {"title": "Warli painting", "by": "Warli artists · Mumbai", "india": true}, {"title": "Mattancherry Palace mural, 16th century", "by": "Kerala muralists · Kochi", "india": true}, {"title": "Kabir and Loi at the loom, mural", "by": "Punjab muralist · Sangrur", "india": true}, {"title": "Guru Nanak, mural", "by": "Gurdwara Baba Atal Rai · Amritsar", "india": true}, {"title": "Kali, c. 1880", "by": "Kalighat painter · Calcutta", "india": true}, {"title": "Jyotirao and Savitribai Phule, teaching", "by": "Memorial sculpture · Pune", "india": true}, {"title": "B. R. Ambedkar", "by": "Photograph · Bombay", "india": true}, {"title": "Three Girls, 1935", "by": "Amrita Sher-Gil · Shimla", "india": true}];
const { topics, theta, edges, stats, projection } = pageModel;

// Every essay carries its number in the body of work, counted from the
// oldest, so the figure is a tally of what has been written rather than a
// position in a list.
const numbered = posts.map((p, i) => ({ ...p, no: String(posts.length - i).padStart(2, '0') }));

const years = [...new Set(posts.map(p => p.date.slice(0, 4)))];
const grouped = years.map(year => ({
  year,
  items: numbered.filter(p => p.date.slice(0, 4) === year),
}));

const totalWords = posts.reduce((sum, p) => sum + p.words, 0);
/* The middle essay, not the average one: two or three long book pieces
   pull a mean upwards and stop it describing anything. */

/* The essay's own first words, as a pull quote: the first sentence long
   enough to say something, cut gently if it runs on. */
function opening(text: string): string {
  const sentences = text.replace(/\s+/g, ' ').match(/[^.!?]+[.!?]+/g) ?? [text];
  const s = (sentences.find(x => x.trim().length > 50) ?? sentences[0] ?? '').trim();
  return s.length > 170 ? s.slice(0, 165).replace(/\s+\S*$/, '') + '…' : s;
}

function shortDate(dateStr: string): string {
  return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

/* An essay is "about" a topic when that topic is one of its strongest two
   and carries real mass. Everything on the page that filters or sorts by
   theme uses these, and the probability behind them, rather than a label. */
const MEMBERSHIP = 0.1;
const membership = theta.map(row => {
  const ranked = row.map((p, k) => ({ k, p })).sort((a, b) => b.p - a.p);
  return ranked.slice(0, 2).filter(t => t.p >= MEMBERSHIP);
});
const topTopic = theta.map(row => {
  let best = 0;
  row.forEach((p, k) => { if (p > row[best]) best = k; });
  return { k: best, p: row[best] };
});
const byIndex = new Map(posts.map((p, i) => [p.slug, i]));

---

<Layout title={title} activeNav="/thoughts" description="Personal writing by Arshad Kazi. Things I am confused about, excited by, or trying to put into words. Published on Substack." ogImage={share("/images/share-thoughts.jpg")}>
  <SketchPlate sketches={sketches} credits={credits} />
  <div class="thoughts-page wide free">

    <!-- ── The opening ────────────────────────────────────
         The title large, a line of what this is, and the collection's
         figures standing to the right like a book's colophon. -->
    <div class="first-screen">
    <Mast
      name="Personal Thoughts"
      statement={`<em>${posts.length} essays</em>, ${Math.round(totalWords / 1000)}k words, on things I am confused about, excited by, or trying to put into words.`}
    >
        <details class="why">
        <summary>Why I write these</summary>
        <div class="why-body">
          <p>The technical notes are about how things work. These are about how I work, and how the people around me do, which I understand far less.</p>
          <p>I grew up with a lot of answers handed to me: what a good son does, what a respectable career looks like, what to believe, who to love and how. Some of them hold up when I look at them closely. Many don't. Writing is where I take one apart and check what it's actually made of, instead of carrying it around because everyone else does.</p>
          <p>Being autistic is part of why. A lot of social life runs on rules nobody states, and I've had to work most of them out deliberately, often after getting them wrong. That makes me notice things other people never question, and it makes me slow at things they find easy. Both end up here.</p>
          <p>Some essays are about people: family, someone I loved, the people I grew up around, the gap between how I meant something and how it landed. Some are about a book or a film that changed how I see something. Some are just a question I got stuck on long enough that I had to write it out.</p>
          <p>I don't write these to sound wise. Most of them end with me less sure than when I started, and that's usually the honest place to stop. If you've thought about the same thing and landed somewhere else, I'd like to know.</p>
          <p class="substack-line">These are also published on <a href="https://substack.com/@arshadkazi" target="_blank" rel="noopener">Substack</a>.</p>
        </div>
        </details>
    </Mast>

    <!-- ── Finding one ────────────────────────────────────
         One quiet line to search by meaning, and the themes running on
         after it as words rather than boxes. -->
    <div class="console">
      <div class="seek">
        <span class="seek-lead">Find the one about</span>
        <input type="text" id="search-input" placeholder="anything" autocomplete="off" />
        <span class="seek-key" aria-hidden="true">/</span>
        <button type="button" class="seek-clear" id="seek-clear" aria-label="Clear search">Clear</button>
      </div>
      <p class="console-note" id="results-count"></p>
      <div class="themes">
        <span class="themes-name">Topics</span>
        <div class="theme-strip" id="theme-strip">
          {topics.map((t, k) => (
            <button class="idx" data-topic={k} type="button" title={t.words.join(', ')}>
              <span class="idx-name">{topicName(t.words)}</span><span class="idx-n"></span>
            </button>
          ))}
        </div>
      </div>
    </div>
    </div>

    <!-- ── The river ──────────────────────────────────────
         A line of thought runs down the page (drawn by the script below).
         Each essay comes ashore on alternating banks with its plate set
         further up the bank, and its opening line drifts in the river
         beside the point where it lands. -->
    <div class="river-wrap">
    <svg class="river" aria-hidden="true"><path class="river-wash" /><path class="river-bank" /><path class="river-inlay" /><path class="river-line" /></svg>
    <ol class="ledger" id="post-index">
      {grouped.map(group => [
        <li class="year-band" data-year={group.year}>
          <span class="year-num">{group.year}</span>
          <span class="year-count">{group.items.length} {group.items.length === 1 ? 'essay' : 'essays'}</span>
        </li>,
        ...group.items.map(post => {
          const i = byIndex.get(post.slug)!;
          return (
            <li class="entry" data-month={post.date.slice(0, 7)} data-year={group.year} data-i={i} data-words={post.words}
                data-title={post.title.toLowerCase()}
                data-description={post.description.toLowerCase()}
                data-topics={membership[i].map(t => t.k).join(',')}
                data-p={membership[i].map(t => t.p.toFixed(4)).join(',')}>
              <a href={`/thoughts/${post.slug}`} class="entry-link" data-no={post.no}>
                <span class="entry-river">
                  <span class="entry-node"><span class="node-dot"></span><span class="node-date">{shortDate(post.date)}</span></span>
                  <span class="entry-quote">{opening(post.text)}</span>
                </span>
                <span class="entry-body">
                  <span class="entry-meta">
                    <span class="k">No. {post.no}</span>
                    <time class="entry-date" datetime={post.date}><span class="dd">{new Date(post.date + 'T00:00:00').toLocaleDateString('en-US', { month: 'short' })}</span> <span class="mm">{post.date.slice(0, 4)}</span></time>
                    <span>{Math.max(1, Math.round(post.words / 230))} min</span>
                    <span class="entry-score" hidden></span>
                  </span>
                  <h3>{post.title}</h3>
                  <p>{post.description}</p>
                  <span class="entry-topic">{topicName(topics[topTopic[i].k].words)}</span>
                </span>
                <span class="entry-fig"><span class="fig-ink"><img src={img(`/images/thoughts/${post.slug}.jpg`, 800)} data-ink="gray feather-88@719" crossorigin="anonymous" alt="" width="1600" height="840" loading="lazy" decoding="async" /></span></span>
              </a>
            </li>
          );
        }),
      ])}
    </ol>
    </div>

    <p class="no-results" id="no-results">Nothing here matches that. Try a shorter word.</p>

  </div>
</Layout>

<style>
  /* ── The Thoughts page ───────────────────────────────────
     Quiet and typographic, like the front of a well-made book: a large
     title, a colophon of figures, a single line to search, and the essays
     set as a contents page with their plates beside them. Space does the
     separating; there are no rules and no boxes. */
  .thoughts-page {
    position: relative;
    width: 100%;
    max-width: 1640px;
    margin: 0 auto;
  }


  /* ── Finding one ─────────────────────────────────────── */


  .idx:hover,
  .idx.active {
    color: var(--color-accent);
  }

  .idx.active .idx-name {
    font-style: italic;
  }


  /* ── The river ───────────────────────────────────────────
     The essays come ashore on alternating banks of a line of thought that
     meanders down the page. The line itself is an SVG drawn by the script
     through each essay's landing point; everything else is laid out here. */
  .river-wrap {
    position: relative;
    --river: 9rem;
    --bend: 2.2rem;
  }

  /* The river is simply drawn, whole; nothing about it moves. */
  .river {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }

  .river path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The river is drawn as an engraver draws water: two hairlines that
     gather to a point at every essay and open between them into a slender
     lens, a breath of tone inside, and a fainter pair of lines outside
     like the ripples at its edge. The lens is wider before a longer
     essay: its width is the length of the thinking. */
  .river .river-wash {
    fill: color-mix(in srgb, var(--color-text) 4%, transparent);
    stroke: none;
  }

  .river .river-bank {
    stroke: color-mix(in srgb, var(--color-text) 55%, transparent);
    stroke-width: 0.8;
  }

  .river .river-inlay {
    stroke: color-mix(in srgb, var(--color-text) 22%, transparent);
    stroke-width: 0.5;
  }

  .river .river-line {
    stroke: none;
  }

  .ledger {
    position: relative;
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-3xl);
  }

  /* A year is a station on the river: its numeral sits on the water, the
     line passing behind it. */
  .year-band {
    align-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    margin: var(--space-3xl) 0 var(--space-xl);
    padding: var(--space-2) var(--space-6);
    background: var(--color-bg);
    border-radius: var(--radius-pill);
  }

  .year-band:first-child {
    margin-top: 0;
  }

  .year-num {
    font-family: var(--font-display);
    font-weight: var(--fw-light);
    font-size: var(--fs-h1);
    line-height: var(--lh-none);
    letter-spacing: var(--track-tight);
    color: var(--color-text);
  }

  .year-count {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .ledger.ranked .year-band {
    display: none;
  }

  .entry {
    margin: 0;
  }

  .entry-link {
    display: grid;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .entry-link:hover {
    text-decoration: none;
  }

  /* Where the essay touches the river: an ink drop and its date. */
  .entry-node {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Each landing is an eight-pointed star, the Mughal tile's khatam, set
     on a small disc of paper that parts the channel around it. */
  .node-dot {
    flex: none;
    position: relative;
    width: 11px;
    height: 11px;
    box-sizing: border-box;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-bg);
    box-shadow: 0 0 0 4px var(--color-bg);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .node-dot::after {
    content: '';
    position: absolute;
    inset: 2.5px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .entry-link:hover .node-dot {
    transform: scale(1.5);
  }


  .node-date {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* The essay's opening line, drifting in the river. */
  .entry-quote {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-ui);
    line-height: var(--lh-ui);
    color: var(--color-text-secondary);
  }

  .entry-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .entry-meta .k {
    color: var(--color-accent);
  }

  .entry h3 {
    margin: var(--space-0-5) 0 0;
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--fs-h2);
    line-height: var(--lh-tight);
    letter-spacing: var(--track-snug);
    transition: color var(--dur-base) ease;
  }

  .entry-link:hover h3 {
    color: var(--color-accent);
  }

  .entry p {
    margin: 0;
    font-size: var(--fs-ui);
    line-height: var(--lh-body);
    color: var(--color-text-secondary);
  }

  .entry-topic {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-ui);
    color: var(--color-text-muted);
  }

  .entry-topic::before {
    content: 'on ';
  }

  /* Each plate lies large and faint behind its essay, washed into the
     bank like an engraving in the paper. No box, no layer of its own: the
     fade is on the image, so the blend still reaches the page. */
  .entry-link {
    position: relative;
  }

  .entry-body,
  .entry-river {
    position: relative;
  }

  .entry-fig {
    position: absolute;
    top: 50%;
    display: block;
    width: var(--fw);
    /* Centred by margin, not transform: a transform would give the plate
       a layer of its own and cut its blend off from the page. */
    margin: calc(var(--fy) - var(--fw) * 0.2625) 0 0;
    pointer-events: none;
    isolation: auto;
    background: none;
  }

  /* The plate's paper is lifted out by InkPlates, so nothing blends. */
  .fig-ink {
    display: block;
  }

  .entry-fig img {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(1) contrast(1.35);
    opacity: 0.36;
    /* Feathered on every side, so no plate, whatever its paper, ever
       shows its rectangle. */
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 52%, transparent 100%);
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 52%, transparent 100%);
    transition: transform 0.8s var(--ease-out), opacity 0.6s ease;
  }

  /* Once inked, the grey, the contrast and the phone's feather are in the
     image itself, so the browser has nothing to filter or mask. */
  .entry .entry-fig img.inked,
  .entry .entry-link:hover .entry-fig img.inked {
    filter: none;
    -webkit-mask-image: none;
    mask-image: none;
  }

  /* On the dark page a plate is gold ink on black lacquer: every line
     takes one warm gold, its depth from how dense the ink was, so the
     drawing is never turned into its negative. */
  :global(html.dark) .entry .entry-fig img.inked,
  :global(html.dark) .entry .entry-link:hover .entry-fig img.inked {
    filter: brightness(0) invert(0.72) sepia(1) saturate(1.5);
  }

  /* A photograph stays a photograph: the right way round, toned warm and
     low, as an old print seen in a dark room. */
  :global(html.dark) .entry .entry-fig img.inked.photo,
  :global(html.dark) .entry .entry-link:hover .entry-fig img.inked.photo {
    filter: grayscale(1) sepia(0.6) brightness(0.75) contrast(1.1);
  }

  :global(html.dark) .entry-fig img {
    filter: grayscale(1) invert(1) contrast(1.4) brightness(0.8) sepia(1) saturate(1.5);
    opacity: 0.32;
  }

  .entry-link:hover .entry-fig img {
    transform: scale(1.03);
    opacity: 0.55;
  }

  /* Each plate takes its own size and height up the bank, so no two
     landings look alike. */
  .entry { --fw: 34rem; --fy: 0rem; --fx: -5rem; }
  .entry:nth-child(3n of .entry) { --fw: 28rem; --fy: -3rem; --fx: -1rem; }
  .entry:nth-child(3n + 2 of .entry) { --fw: 40rem; --fy: 2.5rem; --fx: -9rem; }
  .entry:nth-child(5n of .entry) { --fw: 24rem; --fy: -1rem; --fx: 1rem; }

  /* ── Wide screens and iPads: both banks ─────────────── */
  @media (min-width: 760px) {
    .entry-link {
      grid-template-columns:
        [lside] minmax(0, 1fr) [lbody] minmax(0, 22rem)
        [river] var(--river)
        [rbody] minmax(0, 22rem) [rside] minmax(0, 1fr);
      column-gap: var(--space-10);
    }

    .entry-link > * {
      grid-row: 1;
    }

    .entry-river {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    /* The left bank; its plate lies across the river. */
    .entry:nth-child(odd of .entry) .entry-river { grid-column: river / span 2; }
    .entry:nth-child(odd of .entry) .entry-body { grid-column: lbody; }
    .entry:nth-child(odd of .entry) .entry-fig { right: var(--fx); }
    .entry:nth-child(odd of .entry) .entry-node { transform: translateX(calc(var(--river) / 2 - var(--bend) - 9.5px)); }
    .entry:nth-child(odd of .entry) .entry-quote { padding-left: calc(var(--river) / 2 - var(--bend) + var(--space-5) + var(--space-0-5)); }

    /* The right bank, the river bending towards it; its plate lies across
       the river. */
    .entry:nth-child(even of .entry) .entry-river { grid-column: lbody / span 2; }
    .entry:nth-child(even of .entry) .entry-body { grid-column: rbody; }
    .entry:nth-child(even of .entry) .entry-fig { left: var(--fx); }
    .entry:nth-child(even of .entry) .entry-river { align-items: flex-end; text-align: right; }
    .entry:nth-child(even of .entry) .entry-node { flex-direction: row-reverse; transform: translateX(calc(var(--bend) - var(--river) / 2 + 9.5px)); }
    .entry:nth-child(even of .entry) .entry-quote { padding-right: calc(var(--river) / 2 - var(--bend) + var(--space-5) + var(--space-0-5)); }

    /* The banks interleave rather than stepping like a ladder. */
    .entry-quote {
      max-width: 19rem;
    }

    /* Across the river the plates stand clear of the words, so they are
       shown crisp: no fade, no feathering. */
    .entry-fig img {
      opacity: 0.9;
      -webkit-mask-image: none;
      mask-image: none;
      /* Trimmed of the plate's own printed title and credit. */
      clip-path: inset(11.5% 3% 11.5% 3%);
    }

    /* Room between essays, so each landing stands on its own. */
    .entry + .entry {
      margin-top: var(--space-xl);
    }

    .entry {
      padding: var(--space-lg) 0;
    }
  }

  /* An iPad: the same two banks, cut closer. A narrower channel, the
     essays taking most of each bank, the plates smaller and fainter. */
  @media (min-width: 760px) and (max-width: 1099px) {
    .river-wrap {
      --river: 6rem;
      --bend: 1.4rem;
    }

    .entry-link {
      grid-template-columns:
        [lside] minmax(0, 0.12fr) [lbody] minmax(0, 1fr)
        [river] var(--river)
        [rbody] minmax(0, 1fr) [rside] minmax(0, 0.12fr);
      column-gap: var(--space-6);
    }

    .entry-quote {
      max-width: 15rem;
    }

    .entry { --fw: 22rem; --fx: -3rem; }
    .entry:nth-child(3n of .entry) { --fw: 18rem; --fx: -1rem; }
    .entry:nth-child(3n + 2 of .entry) { --fw: 25rem; --fx: -5rem; }
    .entry:nth-child(5n of .entry) { --fw: 16rem; --fx: 0rem; }

    .entry-fig img {
      opacity: 0.75;
    }
  }

  /* ── Phones: one bank, the river down the left ───────── */
  @media (max-width: 759px) {
    .river-wrap {
      --river: 2.2rem;
      --bend: 0.35rem;
    }

    .entry-link {
      grid-template-columns: var(--river) minmax(0, 1fr);
      column-gap: var(--space-md);
      row-gap: var(--space-sm);
      align-items: start;
      padding: var(--space-lg) 0;
    }

    .entry-river {
      display: contents;
    }

    .entry-node {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
      justify-self: center;
      margin-top: var(--space-2);
    }

    .entry:nth-child(even of .entry) .entry-node { transform: translateX(var(--bend)); }
    .entry:nth-child(odd of .entry) .entry-node { transform: translateX(calc(-1 * var(--bend))); }

    .node-date {
      display: none;
    }

    /* Here the plate leads its essay, in the flow and large, never under
       the words. */
    .entry-fig {
      position: static;
      grid-column: 2;
      grid-row: 1;
      width: min(100%, 32rem);
      margin: 0 0 var(--space-xs);
      overflow: hidden;
      /* The plate is drawn larger than its box; the box clips it for good,
         so Safari never counts the excess as page to scroll to. */
      contain: paint;
    }

    /* Drawn in past the plate's blank margins and caption, so the drawing
       itself fills the column. */
    .entry-fig img,
    .entry-link:hover .entry-fig img {
      transform: scale(1.42);
      opacity: 0.9;
      -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 88%, transparent 100%);
      mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 88%, transparent 100%);
    }

    .entry-body {
      grid-column: 2;
      grid-row: 2;
    }

    .entry-quote {
      grid-column: 2;
      grid-row: 3;
      padding-left: var(--space-md);
    }

    .year-band {
      align-self: flex-start;
      align-items: flex-start;
      margin-left: calc(var(--river) / 2 - var(--space-5) - var(--space-0-5));
    }
  }

  .entry-score {
    position: relative;
    width: 3rem;
    height: 2px;
    align-self: center;
    background: var(--color-border);
  }

  .entry-score::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--fill, 0%);
    background: var(--color-accent);
  }

  .no-results {
    display: none;
    padding: var(--space-xl) 0;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-lead);
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .entry-fig img,
    .entry h3,
    .node-dot {
      transition: none;
    }
  }
</style>

<style is:global>
  .entry.hidden,
  .year-group.hidden {
    display: none !important;
  }
</style>

<script is:inline>

(function() {
  /* The site's bar is sticky and sits above everything, so the year has to
     know how tall it is to come to rest just underneath it rather than
     disappear behind it. Measured, because the bar changes height with the
     screen. */
  const bar = document.querySelector('body > header');
  if (!bar) return;
  const measure = () => document.documentElement.style.setProperty(
    '--nav-h', Math.round(bar.getBoundingClientRect().height) + 'px');
  measure();
  if (window.ResizeObserver) new ResizeObserver(measure).observe(bar);
  else window.addEventListener('resize', measure);
})();

(function() {
  /* ── Searching ────────────────────────────────────────────────
     Typing here is not a string comparison. The query is tokenised and
     stemmed the same way the corpus was, projected into the latent space
     the model was fitted in, and scored by cosine against every essay, so
     "burnout at work" reaches an essay that never uses either word. A
     small exact-term boost sits on top, because a rare word someone
     actually typed should still pull its own essay up.

     The model is ~100KB over the wire and nobody who is only reading the
     page needs it, so it is fetched the first time the box is touched.
     Until it lands, the box falls back to matching letters.          */

  const input = document.getElementById('search-input');
  const seek = input.closest('.seek');
  const clearBtn = document.getElementById('seek-clear');
  const index = document.getElementById('post-index');
  const entries = Array.from(index.querySelectorAll('.entry'));
  const bands = Array.from(index.querySelectorAll('.year-band'));
  const chips = Array.from(document.querySelectorAll('.idx'));
  const counter = document.getElementById('results-count');
  const empty = document.getElementById('no-results');
  const strip = document.getElementById('theme-strip');

  let activeTopic = null;
  let model = null;
  let loading = null;

  /* Every essay's topic memberships, as probabilities. */
  const member = entries.map(e => {
    const ks = e.dataset.topics ? e.dataset.topics.split(',').map(Number) : [];
    const ps = e.dataset.p ? e.dataset.p.split(',').map(Number) : [];
    return new Map(ks.map((k, i) => [k, ps[i] ?? 0]));
  });

  /* ── The same tokeniser the corpus was built with ─────────────────
     If this drifts from src/lib/text.ts, a query stops landing on the
     terms the model actually holds. */
  const STOP = new Set(('a about above after again against all am an and any are as at be because been before being below ' +
    'between both but by can cannot could did do does doing down during each few for from further had has have having he ' +
    'her here hers herself him himself his how i if in into is it its itself me more most my myself no nor not of off on ' +
    'once only or other ought our ours ourselves out over own same she should so some such than that the their theirs them ' +
    'themselves then there these they this those through to too under until up very was we were what when where which while ' +
    'who whom why with would you your yours yourself yourselves just like get got also even still much many really thing ' +
    'things way ways lot lots maybe perhaps actually basically literally bit quite rather pretty another every something ' +
    'someone anything nothing everything always never often sometimes around almost already instead however therefore ' +
    'though although yet within without upon toward towards etc okay yeah thus hence per via able enough make makes made ' +
    'making take takes took taking come comes came coming go goes going went put puts let lets doesn isn wasn aren couldn ' +
    'wouldn shouldn didn don won hasn haven ain shan mustn').split(' '));

  function undouble(base) {
    if (base.length < 3) return base;
    const a = base[base.length - 1], b = base[base.length - 2];
    if (a === b && !'aeiou'.includes(a)) base = base.slice(0, -1);
    if (base.length >= 3 && !/[aeiou]/.test(base.slice(-3))) return base + 'e';
    return base;
  }

  function stem(w) {
    if (w.length <= 4) return w;
    if (w.endsWith('iness') && w.length >= 7) return w.slice(0, -5) + 'y';
    if (w.endsWith('ies') && w.length >= 5) return w.slice(0, -3) + 'y';
    if (w.endsWith('ness') && w.length >= 7) return w.slice(0, -4);
    if (w.endsWith('ement') && w.length >= 8) return w.slice(0, -5);
    if (w.endsWith('ing') && w.length >= 6) return undouble(w.slice(0, -3));
    if (w.endsWith('ed') && w.length >= 5) return undouble(w.slice(0, -2));
    if (w.endsWith('es') && w.length >= 5 && /(s|x|z|ch|sh)es$/.test(w)) return w.slice(0, -2);
    if (w.endsWith('s') && !w.endsWith('ss') && !w.endsWith('us') && w.length >= 5) return w.slice(0, -1);
    return w;
  }

  function tokenize(text) {
    const norm = text.toLowerCase()
      .replace(/[‘’ʼ′]/g, "'")
      .replace(/[–—]/g, ' ')
      .replace(/'(s|t|re|ve|ll|d|m)\b/g, '');
    const out = [];
    for (const raw of norm.match(/[a-z][a-z'-]{2,21}/g) || []) {
      const w = raw.replace(/[^a-z]/g, '');
      if (w.length < 3 || STOP.has(w)) continue;
      const st = stem(w);
      if (st.length < 3 || STOP.has(st)) continue;
      out.push(st);
    }
    return out;
  }

  function loadModel() {
    if (loading) return loading;
    loading = fetch('/thoughts-search.json')
      .then(r => (r.ok ? r.json() : Promise.reject(new Error(r.status))))
      .then(m => {
        const bin = atob(m.termVectors);
        const bytes = new Int8Array(bin.length);
        for (let i = 0; i < bin.length; i++) bytes[i] = (bin.charCodeAt(i) << 24) >> 24;
        const words = m.vocab.split('\n');
        model = {
          dims: m.dims,
          termId: new Map(words.map((w, i) => [w, i])),
          U: bytes,
          scale: m.termScale,
          docs: m.docVectors,
          postings: m.postings,
          rareIdf: m.rareIdf,
        };
        seek.classList.add('is-semantic');
        return model;
      })
      .catch(() => { model = null; return null; });
    return loading;
  }

  /* Cosine against every essay, plus a nudge for exact rare terms and for
     a literal hit in the title. Returns null when the query reached no
     term the model holds, so the caller can fall back. */
  function semanticScores(q) {
    if (!model) return null;
    const toks = tokenize(q);
    const tf = new Map();
    for (const t of toks) {
      const i = model.termId.get(t);
      if (i !== undefined) tf.set(i, (tf.get(i) || 0) + 1);
    }
    if (!tf.size) return null;

    const K = model.dims;
    const qv = new Float64Array(K);
    tf.forEach((n, i) => {
      const w = 1 + Math.log(n);
      for (let j = 0; j < K; j++) qv[j] += w * model.U[i * K + j] * model.scale;
    });
    let norm = 0;
    for (let j = 0; j < K; j++) norm += qv[j] * qv[j];
    norm = Math.sqrt(norm);
    if (norm < 1e-9) return null;
    for (let j = 0; j < K; j++) qv[j] /= norm;

    const lower = q.toLowerCase();
    return entries.map(entry => {
      const d = Number(entry.dataset.i);
      const dv = model.docs[d];
      let cos = 0;
      for (let j = 0; j < K; j++) cos += qv[j] * dv[j];
      let lex = 0;
      tf.forEach((_, i) => {
        const list = model.postings[i];
        if (list && list.indexOf(d) !== -1) lex += model.rareIdf[i] || 1;
      });
      const literal = entry.dataset.title.indexOf(lower) !== -1 ? 1 : 0;
      const sim = Math.max(0, Math.min(1, cos));
      return { score: sim + 0.14 * Math.min(lex, 4) + 0.25 * literal, sim };
    });
  }

  // Before the model lands, and for queries it cannot reach, match letters.
  function literalScores(q) {
    const lower = q.toLowerCase();
    return entries.map(entry => {
      const sim = entry.dataset.title.indexOf(lower) !== -1 ? 1
        : entry.dataset.description.indexOf(lower) !== -1 ? 0.6 : 0;
      return { score: sim, sim };
    });
  }

  /* Where to cut a ranking off. A fixed threshold either buries a good
     answer under forty weak ones or throws away a whole weak-but-real
     result set, because the scores a query produces depend on the query.
     So the cut is relative to the best hit it found, with a floor. */
  const CUT_RATIO = 0.42;
  const CUT_FLOOR = 0.14;
  const MOST = 24;

  function render() {
    const q = input.value.trim();
    const ranking = q ? (semanticScores(q) || literalScores(q)) : null;
    const semantic = !!(q && model && semanticScores(q));
    let top = 0;
    if (ranking) {
      entries.forEach((entry, idx) => {
        if (activeTopic !== null && !member[idx].has(activeTopic)) return;
        top = Math.max(top, ranking[idx].score);
      });
    }
    const cut = Math.max(CUT_FLOOR, top * CUT_RATIO);

    const order = [];
    entries.forEach((entry, idx) => {
      const inTopic = activeTopic === null || member[idx].has(activeTopic);
      const score = ranking ? ranking[idx].score : 0;
      const show = inTopic && (!ranking || score >= cut);
      entry.classList.toggle('hidden', !show);
      if (!show) return;
      order.push({ idx, entry, score, sim: ranking ? ranking[idx].sim : 0,
                   p: member[idx].get(activeTopic) || 0 });
    });

    /* How the surviving essays are put in order. A query ranks by
       relevance; a topic on its own ranks by how much of the essay that
       topic actually accounts for; otherwise it is the archive, newest
       first, under its years. */
    const ranked = !!ranking || activeTopic !== null;
    index.classList.toggle('ranked', ranked);
    if (ranked) {
      order.sort((a, b) => (ranking ? b.score - a.score : b.p - a.p));
      // A long tail of weak answers is not a result, it is an apology.
      if (ranking) {
        order.splice(MOST).forEach(o => o.entry.classList.add('hidden'));
      }
      order.forEach((o, rank) => { o.entry.style.order = String(rank); });
    } else {
      entries.forEach(e => { e.style.order = ''; });
    }
    const visible = order.length;

    // The bar on each line: relevance when searching, share of the essay
    // when a topic is chosen. Hidden when neither applies.
    order.forEach(o => {
      const mark = o.entry.querySelector('.entry-score');
      if (!ranked) { mark.hidden = true; return; }
      const v = ranking ? o.sim : Math.min(o.p / 0.6, 1);
      mark.hidden = false;
      mark.style.setProperty('--fill', (v * 100).toFixed(1) + '%');
      // Never a bare percentage: on its own it reads as how much of the
      // essay you have read, which is not what this is.
      mark.textContent = Math.round((ranking ? o.sim : o.p) * 100) + '% match';
    });

    // Year headings belong to the archive. A ranking is not in year order,
    // so they come out rather than lie about what follows them.
    bands.forEach(band => {
      if (ranked) { band.classList.add('hidden'); return; }
      const year = band.dataset.year;
      const any = entries.some(e => !e.classList.contains('hidden') && e.dataset.year === year);
      band.classList.toggle('hidden', !any);
      const count = band.querySelector('.year-count');
      if (count && any) {
        const n = entries.filter(e => !e.classList.contains('hidden') && e.dataset.year === year).length;
        count.textContent = n + (n === 1 ? ' essay' : ' essays');
      }
    });

    seek.classList.toggle('has-value', q.length > 0);
    updateStrip(q, visible);

    // Say what is on screen in words. This page is not a dashboard.
    const topicName = activeTopic !== null
      ? chips[activeTopic].querySelector('.idx-name').textContent : '';
    const n = visible + (visible === 1 ? ' essay' : ' essays');
    if (activeTopic !== null && q) {
      counter.textContent = n + ' on ' + topicName + ', closest to “' + q + '” first.';
    } else if (activeTopic !== null) {
      counter.textContent = n + ' on ' + topicName + ', the most about it first.';
    } else if (q) {
      counter.textContent = semantic
        ? n + ' closest in meaning to “' + q + '”.'
        : n + ' mentioning “' + q + '”.';
    } else {
      counter.textContent = '';
    }
    empty.style.display = visible === 0 ? 'block' : 'none';
  }

  /* The strip recounts itself against what is on screen: a topic that
     nothing visible is about drops out, so it only ever offers narrowings
     that lead somewhere. */
  function updateStrip(q, visible) {
    const live = new Map();
    entries.forEach((entry, idx) => {
      if (entry.classList.contains('hidden')) return;
      member[idx].forEach((_, k) => live.set(k, (live.get(k) || 0) + 1));
    });
    const ranked = [...live.entries()]
      .filter(([k]) => k !== activeTopic)
      .sort((a, b) => b[1] - a[1] || a[0] - b[0]);
    const rank = new Map(ranked.map(([k], i) => [k, i]));

    chips.forEach((chip, k) => {
      if (k === activeTopic) {
        chip.classList.remove('gone');
        chip.style.order = '-1';
        chip.querySelector('.idx-n').textContent = String(visible);
        return;
      }
      const r = rank.get(k);
      chip.classList.toggle('gone', r === undefined);
      if (r !== undefined) {
        chip.style.order = String(r);
        chip.querySelector('.idx-n').textContent = String(live.get(k));
      }
    });
  }

  input.addEventListener('input', () => {
    if (!model) loadModel().then(() => render());
    render();
  });
  // Warm the model on the first sign of intent, so the first keystroke is
  // usually already semantic.
  ['focus', 'pointerenter'].forEach(ev => seek.addEventListener(ev, loadModel, { once: true }));

  clearBtn.addEventListener('click', () => { input.value = ''; render(); input.focus(); });

  document.addEventListener('keydown', e => {
    const typing = /^(INPUT|TEXTAREA)$/.test(document.activeElement.tagName)
      || document.activeElement.isContentEditable;
    if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) {
      e.preventDefault();
      loadModel();
      input.focus();
    } else if (e.key === 'Escape' && document.activeElement === input) {
      input.value = '';
      render();
      input.blur();
    }
  });

  chips.forEach((chip, k) => {
    chip.addEventListener('click', () => {
      if (activeTopic === k) {
        activeTopic = null;
        chip.classList.remove('active');
      } else {
        chips.forEach(c => c.classList.remove('active'));
        activeTopic = k;
        chip.classList.add('active');
      }
      render();
    });
  });

  render();
})();


</script>

<script is:inline>
  /* The river: one smooth curve through every visible essay's landing
     point and every year's station, in order down the page. It is redrawn
     whenever the layout moves or a search changes what is shown. */
  (function () {
    var wrap = document.querySelector('.river-wrap');
    if (!wrap) return;
    var svg = wrap.querySelector('.river');
    var line = svg.querySelector('.river-line');
    var wash = svg.querySelector('.river-wash');
    var bank = svg.querySelector('.river-bank');
    var ledger = wrap.querySelector('.ledger');
    var length = 0, height = 0, queued = false;

    function centre(el, box) {
      var r = el.getBoundingClientRect();
      return [r.left + r.width / 2 - box.left, r.top + r.height / 2 - box.top];
    }

    function draw() {
      queued = false;
      var box = wrap.getBoundingClientRect();
      height = wrap.offsetHeight;
      var pts = [];
      ledger.querySelectorAll('.year-band .year-num, .entry .node-dot').forEach(function (el) {
        if (!el.offsetParent) return;
        var c = centre(el, box), e = el.closest('.entry');
        // Half the water's width at this landing: a few pixels for a year,
        // more for a longer essay.
        c.push(e ? 3 + Math.sqrt(+e.dataset.words || 0) / 5 : 3);
        pts.push(c);
      });
      if (pts.length < 2) { line.setAttribute('d', ''); wash.setAttribute('d', ''); return; }
      pts.sort(function (a, b) { return a[1] - b[1]; });
      pts.unshift([pts[0][0], 0, 2]);
      pts.push([pts[pts.length - 1][0], height, 2]);
      // The course of the water. From each landing it leaves heading
      // straight down, sweeps out in one soft bow towards where it is going,
      // and settles back into the next landing heading straight down again,
      // so the line never kinks: an easing carries it across, and a bow
      // that is zero, and flat, at both ends swells it out between.
      // The hairlines either side gather to nothing at each landing and
      // open into a lens between, wider before a longer essay.
      var c = [], L = [], R = [], LO = [], RO = [];
      function at(x, y, w) {
        c.push([x, y]); L.push([x - w, y]); R.push([x + w, y]); LO.push([x - w * 1.9, y]); RO.push([x + w * 1.9, y]);
      }
      at(pts[0][0], 0, 0);
      for (var m = 1; m < pts.length; m++) {
        var a = pts[m - 1], b = pts[m], dy = b[1] - a[1], dx = b[0] - a[0];
        if (dy <= 0) continue;
        var side = dx ? (dx > 0 ? 1 : -1) : (m % 2 ? 1 : -1);
        // The bow turns towards whichever side has room, never off the page.
        function room(sd) { return sd < 0 ? Math.min(a[0], b[0]) - 14 : box.width - Math.max(a[0], b[0]) - 14; }
        if (room(side) < 20) side = -side;
        var amp = side * Math.max(0, Math.min(34, dy * 0.06, room(side))), n = Math.max(2, Math.ceil(dy / 8));
        var lens = Math.min(8, Math.max(2.5, b[2] * 0.6), dy * 0.03);
        for (var q = 1; q <= n; q++) {
          var t = q / n, ease = t * t * (3 - 2 * t), bow = Math.sin(Math.PI * t);
          at(a[0] + dx * ease + amp * bow * bow, a[1] + dy * t, lens * bow);
        }
      }
      function trace(list) {
        return list.map(function (p, i) { return (i ? 'L' : 'M') + p[0].toFixed(1) + ' ' + p[1].toFixed(1); }).join(' ');
      }
      svg.setAttribute('viewBox', '0 0 ' + box.width.toFixed(0) + ' ' + height);
      line.setAttribute('d', trace(c));
      length = line.getTotalLength();
      bank.setAttribute('d', trace(L) + ' ' + trace(R));
      svg.querySelector('.river-inlay').setAttribute('d', trace(LO) + ' ' + trace(RO));
      wash.setAttribute('d', trace(L) + ' ' + trace(R.slice().reverse()).replace(/^M/, 'L') + ' Z');
    }

    function later() {
      if (!queued) { queued = true; requestAnimationFrame(draw); }
    }

    new ResizeObserver(later).observe(ledger);
    new MutationObserver(function (list) {
      // Our own 'reached' marks are not a change of layout.
      if (list.some(function (m) { return m.attributeName !== 'class' || !m.target.classList.contains('entry') || m.target.classList.contains('hidden') !== (m.oldValue || '').includes('hidden'); })) later();
    }).observe(ledger, { subtree: true, attributes: true, attributeOldValue: true, attributeFilter: ['class', 'style', 'hidden'] });
    addEventListener('load', later);
    later();
  })();
</script>
