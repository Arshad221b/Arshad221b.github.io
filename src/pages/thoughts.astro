    align-items: center;
    gap: var(--space-2xl);
  }

  .thoughts-page .page-subtitle {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.75;
  }

  .substack-showcase {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: var(--space-lg);
