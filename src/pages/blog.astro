---
/* Blogs: the essays and the notebooks, on one page.

   An essay is one piece, read in one sitting. A notebook is a thread of
   short days on one question, each day its own short read. They share a
   single list, newest first, with every reading time stated. */

import Layout from '../layouts/Layout.astro';
import Mast from '../components/Mast.astro';
import { notebooks } from '../lib/notebooks';

const title = "Technical Blogs — Arshad Kazi";

// `contents` mirrors the section headings inside each post, so the index says
// what a post actually covers instead of making you open it to find out.
const posts = ([
  {
    title: "Probability Mass Functions, Expectation, and Variance",
    date: "2023-11-15",
    description: "Relearning probability from a machine learning perspective. What PMFs are, how to compute expectation and variance from first principles, and why any of this matters for ML.",
    tags: ["probability", "statistics", "PMF", "machine learning", "fundamentals"],
    slug: "probability-mass-function",
    minutes: 5,
    contents: [
      "What is Probability?",
      "Probability Distribution",
      "Probability Mass Function",
      "Expected Value (Expectation)",
      "Variance",
      "Why does any of this matter for ML?",
    ],
  },
  {
    title: "ROC Curves and AUC: Picking the Right Threshold for Your Model",
    date: "2024-02-01",
    description: "Why accuracy fails on skewed data, how confusion matrices work, and how to use ROC curves and AUC to evaluate and compare probabilistic classifiers.",
    tags: ["machine learning", "evaluation", "ROC", "AUC", "classification"],
    slug: "roc-curve-auc",
    minutes: 5,
    contents: [
      "Why Accuracy Is Not Enough",
      "True Positive, True Negative, False Positive, False Negative",
      "Confusion Matrix",
      "ROC Curve",
      "AUC (Area Under the Curve)",
    ],
  },
  {
    title: "Building a Sign Language Recognition System with CNNs and OpenCV",
    date: "2024-03-10",
    description: "A practical walkthrough of building a real-time ASL alphabet recogniser. Dataset, CNN architecture with the actual math, and live webcam inference using OpenCV.",
    tags: ["computer vision", "CNN", "sign language", "OpenCV", "keras", "deep learning"],
    slug: "sign-language-recognition-using-cnn-and-opencv",
    href: "/sign-language-recognition-using-cnn-and-opencv",
    minutes: 5,
    contents: [
      "Dataset",
      "Build and Train the Model",
      "OpenCV",
    ],
  },
  {
    title: "Vector Database Management Systems: Architecture and Internals",
    date: "2024-01-15",
    description: "A technical overview of how Vector Database Management Systems work, covering vectorization, indexing, hardware tradeoffs, and the core challenges in building systems that search by meaning rather than exact match.",
    tags: ["vector databases", "VDBMS", "embeddings", "similarity search", "machine learning systems"],
    slug: "vector-databases-vdbms",
    minutes: 6,
    contents: [
      "What is a Vector Database?",
      "Why Not a Regular Database?",
      "General Architecture of a VDBMS",
      "Use Cases",
      "Challenges and Limitations",
    ],
  },
  {
    title: "The Visual Cortex as a Computer Vision Architecture: Dorsal and Ventral Streams",
    date: "2026-04-05",
    description: "How the brain's visual cortex uses two parallel streams, feedback loops, and relative perception to process vision. Everything rewritten for engineers who build vision systems.",
    tags: ["computer vision", "neuroscience", "visual cortex", "CNN", "architecture"],
    slug: "cnns-design-flaw-evolution",
    minutes: 15,
    contents: [
      "The Split You Did Not Know Was in Your Design",
      "The Dorsal Stream: Real-Time Spatial Inference",
      "The Ventral Stream: Hierarchical Object Recognition",
      "Implications for Computer Vision Engineering",
    ],
  },
  {
    title: "Temporal and Spatial Attention for 3D Pose Estimation",
    date: "2026-02-22",
    description: "How temporal and spatial attention mechanisms enable accurate 2D-to-3D human pose estimation, with a deep dive into DSTformer.",
    tags: ["pose estimation", "attention", "3D vision", "transformers"],
    slug: "temporal-spatial-attention-3d-pose",
    minutes: 6,
    contents: [
      "The Ill-Posed Problem: Lifting 2D to 3D",
      "Temporal Attention: Understanding Motion Over Time",
      "Spatial Attention: Maintaining Anatomical Consistency",
      "Fusion of Temporal and Spatial Streams",
    ],
  },
]).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

type Item =
  | { kind: 'essay'; date: string; title: string; description: string; href: string; image: string; minutes: number; tags: string[]; contents: string[] }
  | { kind: 'notebook'; date: string; title: string; description: string; href: string; image: string; minutes: number; tags: string[]; nb: (typeof notebooks)[number] };

const items: Item[] = [
  ...posts.map(p => ({
    kind: 'essay' as const, date: p.date, title: p.title, description: p.description,
    href: p.href || `/blog/${p.slug}`, image: `/images/blog/${p.slug}.jpg`,
    minutes: p.minutes, tags: p.tags, contents: p.contents,
  })),
  ...notebooks.map(nb => ({
    kind: 'notebook' as const, date: nb.endDate, title: nb.title, description: nb.description,
    href: `/notebooks/${nb.slug}`, image: `/images/blog/notebook-${nb.slug}.jpg`,
    minutes: nb.minutes, tags: nb.tags, nb,
  })),
].sort((a, b) => b.date.localeCompare(a.date));

// Topics worth filtering by: the ones that more than one piece shares.
const tagCount = new Map<string, number>();
items.forEach(it => it.tags.forEach(t => tagCount.set(t, (tagCount.get(t) ?? 0) + 1)));
const topics = [...tagCount].filter(([, n]) => n > 1).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([t]) => t);

const totalMinutes = items.reduce((n, it) => n + it.minutes, 0);
const totalDays = notebooks.reduce((n, nb) => n + nb.days.length, 0);

const years = [...new Set(items.map(it => it.date.slice(0, 4)))];
const fmt = (d: string, o: Intl.DateTimeFormatOptions) => new Date(d + 'T00:00:00').toLocaleDateString('en-US', o);
const short = (d: string) => fmt(d, { month: 'short', day: 'numeric' });
---

<Layout title={title} activeNav="/blog" description="Essays and day-by-day notebooks on computer vision, the brain and machine learning. Notes on things I finally understood, not tutorials." ogImage="/images/share-blog.jpg">
  <div class="blog-page">
    <Mast
      label="Technical Blogs"
      aside={`${posts.length} essays · ${notebooks.length} notebooks`}
      title="Technical"
      accent="Blogs"
      lede="Essays, and notebooks kept a day at a time, on computer vision, the brain and how machines learn. Not tutorials, just my notes on things I finally understood."
      figures={[
        { k: 'Essays', v: posts.length },
        { k: 'Notebooks', v: notebooks.length },
        { k: 'Days of notes', v: totalDays },
        { k: 'Hours of reading', v: (totalMinutes / 60).toFixed(1) },
      ]}
    />

    <div class="controls">
      <p class="control-label">Topics</p>
      <div class="tag-filters" id="tag-filters">
        {topics.map(tag => <button type="button" class="tag-chip" data-tag={tag}>{tag}</button>)}
      </div>

      <p class="results-count" id="results-count"></p>
    </div>

    <div class="index" id="post-index">
      {years.map(year => (
        <section class="year-group" data-year={year}>
          <h2 class="year-label"><span>{year}</span><span class="year-rule"></span></h2>
          <ul class="items">
            {items.filter(it => it.date.startsWith(year)).map(it => (
              <li class={`item ${it.kind}`} data-tags={it.tags.join('|')}>
                <a class="item-fig" href={it.href} tabindex="-1" aria-hidden="true">
                  <img src={it.image} alt="" width="1600" height="840" loading="lazy" decoding="async" />
                </a>

                <div class="item-body">
                  <p class="item-kind">
                    {it.kind === 'essay'
                      ? <><span class="k">Essay</span><span>{it.minutes} min</span><time datetime={it.date}>{short(it.date)}</time></>
                      : <><span class="k">Notebook</span><span>{it.nb.days.length} days · {it.minutes} min</span><span>{short(it.nb.startDate)} – {short(it.nb.endDate)}</span></>}
                  </p>
                  <h3><a href={it.href}>{it.title}</a></h3>
                  <p class="item-desc">{it.description}</p>

                  {it.kind === 'essay' ? (
                    <ol class="contents">
                      {it.contents.map((c, i) => <li><span class="n">{String(i + 1).padStart(2, '0')}</span>{c}</li>)}
                    </ol>
                  ) : (
                    <>
                      {/* The thread: every day of the notebook, each its own short read. */}
                      <ol class="thread">
                        {it.nb.days.map(d => (
                          <li>
                            {d.href
                              ? <a href={d.href}><span class="n">Day {d.day}</span><span class="q">{d.title}</span><span class="m">{d.minutes} min</span></a>
                              : <span class="pending"><span class="n">Day {d.day}</span><span class="q">{d.title}</span><span class="m">—</span></span>}
                          </li>
                        ))}
                      </ol>
                      <details class="concl">
                        <summary>Where it ended up</summary>
                        <p>{it.nb.conclusion}</p>
                      </details>
                    </>
                  )}

                  <p class="item-tags">{it.tags.join('  ·  ')}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p class="no-results" id="no-results">Nothing on that topic yet.</p>
  </div>
</Layout>

<style>
  .blog-page {
    display: flex;
    flex-direction: column;
  }

  /* ── Time and topics: set words, not buttons ──────── */
  .controls {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.9rem var(--space-md);
    align-items: baseline;
    margin-bottom: var(--space-2xl);
  }

  .control-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  .tag-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.9rem;
  }

  .tag-chip {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.02rem;
    background: none;
    border: none;
    padding: 0.1rem 0;
    color: var(--color-text-secondary);
    cursor: pointer;
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: color 0.2s ease, background-size 0.35s var(--ease-out);
  }

  .tag-chip:hover,
  .tag-chip.active {
    color: var(--color-accent);
    background-size: 100% 1px;
  }

  .results-count {
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin: 0;
  }

  .results-count:empty {
    display: none;
  }

  /* ── The index ───────────────────────────────────── */
  .index {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .year-label {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    margin: 0 0 var(--space-sm);
  }

  .year-rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .item {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: var(--space-xl);
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--color-border-light);
  }

  .item:first-child {
    border-top: none;
    padding-top: var(--space-md);
  }

  /* The figure, a plate in the margin. */
  .item-fig {
    display: block;
    align-self: start;
  }

  .item-fig img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
    box-shadow: 0 0 0 1px var(--color-border-light);
    transition: box-shadow 0.3s ease;
  }

  :global(html.dark) .item-fig img {
    box-shadow: none;
    filter: brightness(0.9);
  }

  .item:hover .item-fig img {
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .item-kind {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem;
  }

  .item-kind .k {
    color: var(--color-accent);
  }

  .item h3 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: -0.02em;
    max-width: 32ch;
    margin: 0 0 0.45rem;
  }

  .item h3 a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .item h3 a:hover {
    color: var(--color-accent);
  }

  .item-desc {
    font-family: var(--font-serif);
    font-size: 1.04rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 62ch;
    margin: 0;
  }

  /* An essay's sections, so it can be read from here. */
  .contents {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.3rem var(--space-lg);
    max-width: 62ch;
    padding: 0;
    margin: var(--space-md) 0 0;
  }

  .contents li {
    display: flex;
    gap: 0.6rem;
    font-family: var(--font-serif);
    font-size: 0.92rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .n {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    padding-top: 0.22rem;
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  /* A notebook's days, each its own short read. */
  .thread {
    list-style: none;
    max-width: 64ch;
    padding: 0;
    margin: var(--space-md) 0 0;
    border-top: 1px solid var(--color-border-light);
  }

  .thread li {
    border-bottom: 1px solid var(--color-border-light);
    transition: opacity 0.3s ease;
  }

  .thread a,
  .thread .pending {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr) auto;
    gap: var(--space-sm);
    align-items: baseline;
    padding: 0.5rem 0;
    text-decoration: none;
    color: inherit;
  }

  .thread .n {
    padding-top: 0;
    text-transform: uppercase;
  }

  .thread .q {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
  }

  .thread .m {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .thread a:hover .q,
  .thread a:hover .n {
    color: var(--color-accent);
    opacity: 1;
  }

  .thread .pending {
    opacity: 0.5;
  }

  .concl {
    max-width: 62ch;
    margin-top: var(--space-sm);
  }

  .concl summary {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    cursor: pointer;
    list-style: none;
    padding: 0.3rem 0;
  }

  .concl summary::-webkit-details-marker {
    display: none;
  }

  .concl summary::before {
    content: '+ ';
  }

  .concl[open] summary::before {
    content: '− ';
  }

  .concl summary:hover {
    color: var(--color-accent);
  }

  .concl p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0.3rem 0 0;
    padding-left: var(--space-md);
    border-left: 1px solid var(--color-accent);
  }

  .item-tags {
    margin: var(--space-md) 0 0;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: pre-wrap;
    color: var(--color-text-muted);
    opacity: 0.8;
  }

  .no-results {
    display: none;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-muted);
  }

  @media (max-width: 760px) {
    .item {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .contents {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .controls {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .results-count {
      grid-column: 1;
    }
  }
</style>

<style is:global>
  .item.hidden,
  .year-group.hidden {
    display: none !important;
  }
</style>

<script is:inline>
(function () {
  var index = document.getElementById('post-index');
  var items = [].slice.call(index.querySelectorAll('.item'));
  var groups = index.querySelectorAll('.year-group');
  var chips = [].slice.call(document.querySelectorAll('.tag-chip'));
  var counter = document.getElementById('results-count');
  var empty = document.getElementById('no-results');
  var tag = null;

  function apply() {
    var shown = 0;
    items.forEach(function (it) {
      var show = !tag || it.dataset.tags.split('|').indexOf(tag) >= 0;
      it.classList.toggle('hidden', !show);
      if (show) shown++;
    });
    groups.forEach(function (g) { g.classList.toggle('hidden', !g.querySelector('.item:not(.hidden)')); });
    counter.textContent = tag ? shown + ' of ' + items.length + ' on ' + tag : '';
    empty.style.display = shown ? 'none' : 'block';
  }

  chips.forEach(function (c) {
    c.addEventListener('click', function () {
      tag = tag === c.dataset.tag ? null : c.dataset.tag;
      chips.forEach(function (o) { o.classList.toggle('active', o.dataset.tag === tag); });
      apply();
    });
  });
})();
</script>
