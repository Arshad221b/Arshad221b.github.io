---
import Layout from '../layouts/Layout.astro';
import Mast from '../components/Mast.astro';

const title = "Technical Blogs — Arshad Kazi";

// `contents` mirrors the section headings inside each post, so the index says
// what a post actually covers instead of making you open it to find out.
const posts = ([
  {
    title: "Probability Mass Functions, Expectation, and Variance",
    date: "2023-11-15",
    description: "Relearning probability from a machine learning perspective. What PMFs are, how to compute expectation and variance from first principles, and why any of this matters for ML.",
    tags: ["probability", "statistics", "PMF", "machine learning", "fundamentals"],
    slug: "probability-mass-function",
    minutes: 5,
    contents: [
      "What is Probability?",
      "Probability Distribution",
      "Probability Mass Function",
      "Expected Value (Expectation)",
      "Variance",
      "Why does any of this matter for ML?",
    ],
  },
  {
    title: "ROC Curves and AUC: Picking the Right Threshold for Your Model",
    date: "2024-02-01",
    description: "Why accuracy fails on skewed data, how confusion matrices work, and how to use ROC curves and AUC to evaluate and compare probabilistic classifiers.",
    tags: ["machine learning", "evaluation", "ROC", "AUC", "classification"],
    slug: "roc-curve-auc",
    minutes: 5,
    contents: [
      "Why Accuracy Is Not Enough",
      "True Positive, True Negative, False Positive, False Negative",
      "Confusion Matrix",
      "ROC Curve",
      "AUC (Area Under the Curve)",
    ],
  },
  {
    title: "Building a Sign Language Recognition System with CNNs and OpenCV",
    date: "2024-03-10",
    description: "A practical walkthrough of building a real-time ASL alphabet recogniser. Dataset, CNN architecture with the actual math, and live webcam inference using OpenCV.",
    tags: ["computer vision", "CNN", "sign language", "OpenCV", "keras", "deep learning"],
    slug: "sign-language-recognition-using-cnn-and-opencv",
    href: "/sign-language-recognition-using-cnn-and-opencv",
    minutes: 5,
    contents: [
      "Dataset",
      "Build and Train the Model",
      "OpenCV",
    ],
  },
  {
    title: "Vector Database Management Systems: Architecture and Internals",
    date: "2024-01-15",
    description: "A technical overview of how Vector Database Management Systems work, covering vectorization, indexing, hardware tradeoffs, and the core challenges in building systems that search by meaning rather than exact match.",
    tags: ["vector databases", "VDBMS", "embeddings", "similarity search", "machine learning systems"],
    slug: "vector-databases-vdbms",
    minutes: 6,
    contents: [
      "What is a Vector Database?",
      "Why Not a Regular Database?",
      "General Architecture of a VDBMS",
      "Use Cases",
      "Challenges and Limitations",
    ],
  },
  {
    title: "The Visual Cortex as a Computer Vision Architecture: Dorsal and Ventral Streams",
    date: "2026-04-05",
    description: "How the brain's visual cortex uses two parallel streams, feedback loops, and relative perception to process vision. Everything rewritten for engineers who build vision systems.",
    tags: ["computer vision", "neuroscience", "visual cortex", "CNN", "architecture"],
    slug: "cnns-design-flaw-evolution",
    minutes: 15,
    contents: [
      "The Split You Did Not Know Was in Your Design",
      "The Dorsal Stream: Real-Time Spatial Inference",
      "The Ventral Stream: Hierarchical Object Recognition",
      "Implications for Computer Vision Engineering",
    ],
  },
  {
    title: "Temporal and Spatial Attention for 3D Pose Estimation",
    date: "2026-02-22",
    description: "How temporal and spatial attention mechanisms enable accurate 2D-to-3D human pose estimation, with a deep dive into DSTformer.",
    tags: ["pose estimation", "attention", "3D vision", "transformers"],
    slug: "temporal-spatial-attention-3d-pose",
    minutes: 6,
    contents: [
      "The Ill-Posed Problem: Lifting 2D to 3D",
      "Temporal Attention: Understanding Motion Over Time",
      "Spatial Attention: Maintaining Anatomical Consistency",
      "Fusion of Temporal and Spatial Streams",
    ],
  },
]).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Each essay keeps its number in the body of work, counted from the oldest.
posts.forEach((p: any, i) => { p.no = String(posts.length - i).padStart(2, '0'); });

const allTags = [...new Set(posts.flatMap(p => p.tags))].sort();
const totalMinutes = posts.reduce((n, p) => n + p.minutes, 0);
const totalSections = posts.reduce((n, p) => n + p.contents.length, 0);

// Group posts by year so the index is scannable.
const years = [...new Set(posts.map(p => p.date.slice(0, 4)))];
const grouped = years.map(year => ({
  year,
  items: posts.filter(p => p.date.slice(0, 4) === year),
}));

function shortDate(dateStr: string): string {
  const date = new Date(dateStr + 'T00:00:00');
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}
---

<Layout title={title} activeNav="/blog" description="Technical deep dives on computer vision, 3D understanding, and ML. Notes on things I finally understood, not tutorials." ogImage="/images/share-blog.jpg">
  <div class="blog-page">
    <Mast
      label="Technical Blogs"
      aside={`${posts.length} essays, ${totalMinutes} minutes`}
      title="Technical"
      accent="Blogs"
      lede="Deep dives into computer vision, geometry, and 3D understanding. Not tutorials, just my notes on things I finally understood."
      figures={[
        { k: 'Essays', v: posts.length },
        { k: 'Sections', v: totalSections },
        { k: 'Minutes of reading', v: totalMinutes },
        { k: 'Topics', v: allTags.length },
      ]}
    />

    <div class="filters">
      <p class="filter-label">Topics</p>
      <div class="tag-filters" id="tag-filters">
        {allTags.map(tag => (
          <button class="tag-chip" data-tag={tag}>{tag}</button>
        ))}
      </div>
      <p class="results-count" id="results-count"></p>
    </div>

    <!-- The index, like the contents of a book: one row per essay, its
         particulars in the margin, and every section it holds listed out. -->
    <div class="post-index" id="post-index">
      {grouped.map(group => (
        <section class="year-group" data-year={group.year}>
          <h2 class="year-label"><span>{group.year}</span><span class="year-rule"></span><span>{group.items.length} {group.items.length === 1 ? 'essay' : 'essays'}</span></h2>
          <ul class="entry-list">
            {group.items.map(post => (
              <li class="entry" data-title={post.title.toLowerCase()} data-description={post.description.toLowerCase()} data-tags={post.tags.join(',')}>
                <a href={post.href || `/blog/${post.slug}`}>
                  <span class="entry-margin">
                    <span class="entry-no">N&deg; {post.no}</span>
                    <time datetime={post.date}>{shortDate(post.date)}</time>
                    <span>{post.minutes} min read</span>
                  </span>
                  <span class="entry-body">
                    <h3>{post.title}</h3>
                    <p>{post.description}</p>
                    <ol class="contents">
                      {post.contents.map((section, i) => (
                        <li><span class="sec-n">{String(i + 1).padStart(2, '0')}</span><span>{section}</span></li>
                      ))}
                    </ol>
                    <span class="entry-tags">{post.tags.join('  ·  ')}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p class="no-results" id="no-results">No posts match that search.</p>
  </div>
</Layout>

<style>
  .blog-page {
    display: flex;
    flex-direction: column;
  }

  /* ── Topics: set words, not buttons ───────────────── */
  .filters {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.4rem var(--space-md);
    align-items: baseline;
    margin-bottom: var(--space-2xl);
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  .tag-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.9rem;
  }

  .tag-chip {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.02rem;
    background: none;
    border: none;
    padding: 0.1rem 0;
    color: var(--color-text-secondary);
    cursor: pointer;
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: color 0.2s ease, background-size 0.35s var(--ease-out);
  }

  .tag-chip:hover,
  .tag-chip.active {
    color: var(--color-accent);
    background-size: 100% 1px;
  }

  .results-count {
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin: 0.4rem 0 0;
  }

  .results-count:empty {
    display: none;
  }

  /* ── The index ───────────────────────────────────── */
  .post-index {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .year-label {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-sm);
  }

  .year-label span:first-child {
    color: var(--color-accent);
  }

  .year-rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .entry-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .entry {
    margin: 0;
    border-top: 1px solid var(--color-border-light);
  }

  .entry:first-child {
    border-top: none;
  }

  .entry a {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    text-decoration: none;
    color: inherit;
  }

  /* The particulars, in the margin, where they can be found and ignored. */
  .entry-margin {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .entry-no {
    color: var(--color-text-secondary);
    transition: color 0.25s ease;
  }

  .entry a:hover .entry-no {
    color: var(--color-accent);
  }

  .entry h3 {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.8vw, 1.9rem);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: -0.02em;
    color: var(--color-text);
    max-width: 32ch;
    margin: 0 0 0.5rem;
    transition: color 0.25s ease;
  }

  .entry a:hover h3 {
    color: var(--color-accent);
  }

  .entry p {
    font-family: var(--font-serif);
    font-size: 1.06rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 62ch;
    margin: 0;
  }

  /* What the essay holds, section by section, so it can be read from here. */
  .contents {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem var(--space-lg);
    max-width: 62ch;
    padding: 0;
    margin: var(--space-md) 0 0;
  }

  .contents li {
    display: flex;
    gap: 0.6rem;
    font-family: var(--font-serif);
    font-size: 0.92rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .sec-n {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    padding-top: 0.22rem;
    color: var(--color-text-muted);
    opacity: 0.6;
    transition: color 0.25s ease;
  }

  .entry a:hover .sec-n {
    color: var(--color-accent);
  }

  .entry-tags {
    display: block;
    margin-top: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: pre-wrap;
    color: var(--color-text-muted);
    opacity: 0.8;
  }

  .no-results {
    display: none;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-muted);
  }

  @media (max-width: 680px) {
    .entry a {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .entry-margin {
      flex-direction: row;
      gap: 0.9rem;
      padding-top: 0;
    }

    .contents {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .filters {
      grid-template-columns: 1fr;
    }

    .results-count {
      grid-column: 1;
    }
  }
</style>

<style is:global>
  .entry.hidden,
  .year-group.hidden {
    display: none !important;
  }
</style>

<script is:inline>
(function() {
  const index = document.getElementById('post-index');
  const entries = index.querySelectorAll('.entry');
  const groups = index.querySelectorAll('.year-group');
  const chips = document.querySelectorAll('.tag-chip');
  const counter = document.getElementById('results-count');
  const empty = document.getElementById('no-results');
  let activeTag = null;

  function filter() {
    let visible = 0;

    entries.forEach(entry => {
      const show = !activeTag || entry.dataset.tags.split(',').includes(activeTag);
      entry.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    // Drop a year heading entirely when nothing under it survived.
    groups.forEach(group => {
      const anyVisible = group.querySelector('.entry:not(.hidden)');
      group.classList.toggle('hidden', !anyVisible);
    });

    counter.textContent = activeTag
      ? visible + ' of ' + entries.length + ' posts'
      : '';
    empty.style.display = visible === 0 ? 'block' : 'none';
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const tag = chip.dataset.tag;
      if (activeTag === tag) {
        activeTag = null;
        chip.classList.remove('active');
      } else {
        chips.forEach(c => c.classList.remove('active'));
        activeTag = tag;
        chip.classList.add('active');
      }
      filter();
    });
  });
})();
</script>
