---
import { img, share, widths } from '../lib/media';
import SketchPlate from '../components/SketchPlate.astro';
/* Blogs: the essays and the notebooks, on one page.

   One timeline, newest first, under clear year headings. Every piece is the
   same row: its date in the margin, its figure at full width, what it is,
   its title and what it asks.
   The one difference is the honest one: an essay is a single piece, a
   notebook is a run of days, and its row lists them quietly, each a link.

   An essay is one piece, read in one sitting. A notebook is a thread of
   short days on one question, each day its own short read. They share a
   single list, newest first, with every reading time stated. */

import Layout from '../layouts/Layout.astro';
import { wordsIn } from '../lib/text';

import { notebooks } from '../lib/notebooks';

/* Words in each essay, from its own source: markup, code and maths out. */
const essaySources = import.meta.glob(['./blog/*.astro', './sign-language-recognition-using-cnn-and-opencv.astro'], { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const essayWords: Record<string, number> = Object.fromEntries(Object.entries(essaySources).map(([path, raw]) =>
  [path.split('/').pop()!.replace('.astro', ''), wordsIn(raw)]));
const totalWords = Object.values(essayWords).reduce((a, b) => a + b, 0) + notebooks.reduce((a, nb) => a + nb.words, 0);
const wordsLabel = (n: number) => (n > 0 ? `${n.toLocaleString('en-US')} words · ` : '');

// At the head of the page, in particles of ink: Leonardo's flight, water and
// the measured body, Michelangelo's figures and plan, Palladio's villa and
// Piranesi's impossible space.
const sketches = ['contact/flying', 'blog-bg/ramanujan-master-theorem', 'india/kailasa', 'blog-bg/al-sufi-ursa-major', 'blog-bg/lilavati', 'blog-bg/al-jazari-elephant-clock', 'india/bakhshali', 'contact/vitruvian', 'india/lahore-astrolabe', 'india/taj-site-plan', 'blog-bg/hooke-flea', 'india/aryabhata', 'india/dilwara', 'blog-bg/cajal', 'blog-bg/vesalius', 'blog-bg/galileo-moon', 'blog-bg/kepler', 'blog-bg/darwin-tree', 'blog-bg/haeckel', 'blog-bg/wright', 'blog-bg/tulp', 'india/great-bath', 'india/harappan-weights', 'india/dholavira', 'india/iron-pillar', 'india/chand-baori', 'india/konark-wheel', 'india/jantar-mantar', 'india/misra-yantra', 'india/ujjain-observatory', 'blog-bg/durer-lute', 'blog-bg/kircher-camera-obscura', 'blog-bg/newton-opticks', 'blog-bg/cajal-retina', 'blog-bg/golgi-hippocampus', 'blog-bg/descartes-homme', 'blog-bg/willis-cerebri', 'blog-bg/pascaline', 'blog-bg/leibniz-reckoner', 'blog-bg/lovelace-note-g', 'blog-bg/galton-quincunx', 'blog-bg/pascal-triangle']
  .map(n => img(`/images/${n}.jpg`, 1600));
const credits = [{"title": "Design for a flying machine, c. 1488", "by": "Leonardo da Vinci · Milan", "india": false, "note": "Leonardo's ornithopter: a pilot pumping wings, designed from watching birds.", "open": true}, {"title": "The Master Theorem, c. 1913", "by": "Srinivasa Ramanujan · Madras", "india": true, "note": "A page from Ramanujan's notebooks; the master theorem turns a series into an integral."}, {"title": "Kailasa Temple, c. 760 (drawn 1915)", "by": "Rashtrakuta builders · Ellora", "india": true, "note": "Carved downward from a single hill of basalt: the largest monolithic structure ever cut.", "open": true}, {"title": "Book of Fixed Stars: Ursa Major, 964", "by": "Abd al-Rahman al-Sufi · Isfahan", "india": false, "note": "Ptolemy's star catalogue checked against the sky, with the first recorded sighting of Andromeda.", "open": true}, {"title": "Līlāvatī, c. 1150", "by": "Bhāskara II · Ujjain", "india": true, "note": "Bhāskara's arithmetic, posed as problems to a girl named Līlāvatī; taught across India for centuries."}, {"title": "The Elephant Clock, 1206", "by": "Ismail al-Jazari · Diyarbakır", "india": false, "note": "A water clock driven by a sinking float, marking each half hour with automata.", "open": true}, {"title": "Bakhshali manuscript, c. 3rd–4th century", "by": "Unknown mathematicians · Bakhshali", "india": true, "note": "Birch-bark arithmetic with an early written zero and a square-root method still used today."}, {"title": "Vitruvian Man, c. 1490", "by": "Leonardo da Vinci · Milan", "india": false, "note": "The body inscribed in a circle and a square: Vitruvius's proportions tested by measurement.", "open": true}, {"title": "Astrolabe, 1666", "by": "Jamal al-Din ibn Muqim · Lahore", "india": true, "note": "An analog computer for the sky: star positions, time and latitude, from Lahore's instrument makers."}, {"title": "Taj Mahal, site plan, 1632–53", "by": "Ustad Ahmad Lahauri · Agra", "india": true, "note": "The Taj complex as a grid of squares and axes: Mughal geometry laid out at the scale of a city block.", "open": true}, {"title": "Micrographia: the flea, 1665", "by": "Robert Hooke · London", "india": false, "note": "From the first great book of microscopy: a flea drawn at a size nobody had seen before."}, {"title": "Aryabhata, 476–550", "by": "Statue at IUCAA · Pune", "india": true, "note": "Aryabhata gave π to four decimals and said the Earth turns on its axis, in 499 CE."}, {"title": "Dilwara Temples, ceiling, 11th–13th century", "by": "Jain craftsmen · Mount Abu", "india": true, "note": "A marble ceiling carved into concentric rings of near-transparent lace by Jain craftsmen."}, {"title": "Purkinje cell, 1899", "by": "Santiago Ramón y Cajal · Madrid", "india": false, "note": "Cajal saw that the brain is made of separate cells; his neurons are still the textbook drawings.", "open": true}, {"title": "De humani corporis fabrica, 1543", "by": "Andreas Vesalius · Padua", "india": false, "note": "Anatomy from dissection rather than authority: Vesalius corrected Galen by looking.", "open": true}, {"title": "Sidereus Nuncius: the Moon, 1610", "by": "Galileo Galilei · Padua", "india": false, "note": "Through a telescope he built himself, Galileo saw the Moon has mountains and shadows.", "open": true}, {"title": "Mysterium Cosmographicum, 1596", "by": "Johannes Kepler · Graz", "india": false, "note": "Kepler's attempt to fit the planets' orbits between the five Platonic solids: wrong, and productive.", "open": true}, {"title": "I think: the tree of life, 1837", "by": "Charles Darwin · London", "india": false, "note": "'I think', then a branching tree: Darwin's first sketch of common descent, in a notebook.", "open": true}, {"title": "Kunstformen der Natur: Phaeodaria, 1904", "by": "Ernst Haeckel · Jena", "india": false, "note": "Microscopic plankton drawn by Haeckel, whose plates made biology's symmetries visible.", "open": true}, {"title": "First flight, 17 December 1903", "by": "John T. Daniels · Kitty Hawk", "india": false, "note": "Twelve seconds, 37 metres: the first controlled, powered flight, photographed as it lifted."}, {"title": "The Anatomy Lesson of Dr Tulp, 1632", "by": "Rembrandt van Rijn · Amsterdam", "india": false, "note": "A public dissection in Amsterdam: knowledge as something you open up and show."}, {"title": "Mohenjo-daro, c. 2500 BCE", "by": "Harappan builders · Mohenjo-daro", "india": true, "note": "A planned city on a grid, with standard bricks, covered drains and the Great Bath."}, {"title": "Indus weights, c. 2500 BCE", "by": "Harappan craftsmen · Mohenjo-daro", "india": true, "note": "Polished chert cubes in a binary-then-decimal series: one standard of weight across a civilisation."}, {"title": "Dholavira reservoir, c. 2500 BCE", "by": "Harappan engineers · Dholavira", "india": true, "note": "Stone-cut reservoirs that caught every monsoon, in a city built on the edge of a salt desert."}, {"title": "Iron Pillar, c. 400 CE (photographed 1858)", "by": "Gupta metallurgists · Delhi", "india": true, "note": "Six tonnes of wrought iron that has barely rusted in sixteen centuries."}, {"title": "Chand Baori, 9th century", "by": "Nikumbha builders · Abhaneri", "india": true, "note": "3,500 steps in perfect symmetry, thirteen storeys down to groundwater."}, {"title": "Konark wheel, 13th century", "by": "Eastern Ganga sculptors · Konark", "india": true, "note": "One of 24 stone wheels on the Sun Temple; its spokes cast shadows that tell the time."}, {"title": "Jantar Mantar, 1734", "by": "Sawai Jai Singh II · Jaipur", "india": true, "note": "Instruments the size of buildings, so stone could measure the sky to two seconds of time."}, {"title": "Misra Yantra, 1724", "by": "Sawai Jai Singh II · Delhi", "india": true, "note": "Five instruments in one, reading noon at observatories across the world."}, {"title": "Vedh Shala, 1725", "by": "Sawai Jai Singh II · Ujjain", "india": true, "note": "Built on the meridian Indian astronomers used as their prime meridian for over a thousand years."}, {"title": "Man Drawing a Lute, 1525", "by": "Albrecht Dürer · Nuremberg", "india": false, "note": "A machine for perspective: a thread from one fixed point to each point of the lute, marked where it crosses the frame.", "open": true}, {"title": "Camera obscura, 1646", "by": "Athanasius Kircher · Rome", "india": false, "note": "A room-sized pinhole camera: the world outside thrown upside down on the walls inside, as on the back of an eye.", "open": true}, {"title": "Opticks: refraction, 1704", "by": "Isaac Newton · London", "india": false, "note": "Light bent by a prism, from the experiments in which Newton split white light into its colours.", "open": true}, {"title": "Structure of the mammalian retina, 1900", "by": "Santiago Ramón y Cajal · Madrid", "india": false, "note": "The retina's layers, from rods and cones to the optic nerve, with the direction in which the signal flows.", "open": true}, {"title": "The hippocampus, 1885", "by": "Camillo Golgi · Pavia", "india": false, "note": "From Golgi's silver stain, the method that first made single neurons visible."}, {"title": "L'Homme: the reflex, 1664", "by": "René Descartes · Paris", "india": false, "note": "Fire at the foot tugs a thread to the brain, which moves the body: the first mechanical account of a reflex."}, {"title": "Cerebri anatome, 1664", "by": "Thomas Willis · London", "india": false, "note": "The first detailed atlas of the brain and its nerves, with plates drawn by Christopher Wren.", "open": true}, {"title": "The Pascaline, 1642", "by": "Blaise Pascal · Paris", "india": false, "note": "A mechanical calculator: geared wheels that carry a digit from one wheel to the next.", "open": true}, {"title": "Stepped reckoner, 1673", "by": "Gottfried Wilhelm Leibniz · Hanover", "india": false, "note": "The first calculator that could multiply, by a stepped drum that adds a number again and again.", "open": true}, {"title": "Note G, 1843", "by": "Ada Lovelace · London", "india": false, "note": "The table for computing Bernoulli numbers on Babbage's Analytical Engine: the first published program.", "open": true}, {"title": "The quincunx, 1889", "by": "Francis Galton · London", "india": false, "note": "Shot falling through rows of pins piles up into a bell curve: the normal distribution, made by hand.", "open": true}, {"title": "Triangle arithmétique, 1665", "by": "Blaise Pascal · Paris", "india": false, "note": "Each number the sum of the two above it: the table behind binomial probabilities.", "open": true}];
const title = "Technical Blogs — Arshad Kazi";

// `contents` mirrors the section headings inside each post, so the index says
// what a post actually covers instead of making you open it to find out.
const posts = ([
  {
    title: "Probability Mass Functions, Expectation, and Variance",
    date: "2023-11-15",
    description: "Relearning probability from a machine learning perspective. What PMFs are, how to compute expectation and variance from first principles, and why any of this matters for ML.",
    tags: ["probability", "statistics", "PMF", "machine learning", "fundamentals"],
    slug: "probability-mass-function",
    minutes: 5,
    contents: [
      "What is Probability?",
      "Probability Distribution",
      "Probability Mass Function",
      "Expected Value (Expectation)",
      "Variance",
      "Why does any of this matter for ML?",
    ],
  },
  {
    title: "ROC Curves and AUC: Picking the Right Threshold for Your Model",
    date: "2024-02-01",
    description: "Why accuracy fails on skewed data, how confusion matrices work, and how to use ROC curves and AUC to evaluate and compare probabilistic classifiers.",
    tags: ["machine learning", "evaluation", "ROC", "AUC", "classification"],
    slug: "roc-curve-auc",
    minutes: 5,
    contents: [
      "Why Accuracy Is Not Enough",
      "True Positive, True Negative, False Positive, False Negative",
      "Confusion Matrix",
      "ROC Curve",
      "AUC (Area Under the Curve)",
    ],
  },
  {
    title: "Building a Sign Language Recognition System with CNNs and OpenCV",
    date: "2024-03-10",
    description: "A practical walkthrough of building a real-time ASL alphabet recogniser. Dataset, CNN architecture with the actual math, and live webcam inference using OpenCV.",
    tags: ["computer vision", "CNN", "sign language", "OpenCV", "keras", "deep learning"],
    slug: "sign-language-recognition-using-cnn-and-opencv",
    href: "/sign-language-recognition-using-cnn-and-opencv",
    minutes: 5,
    contents: [
      "Dataset",
      "Build and Train the Model",
      "OpenCV",
    ],
  },
  {
    title: "Vector Database Management Systems: Architecture and Internals",
    date: "2024-01-15",
    description: "A technical overview of how Vector Database Management Systems work, covering vectorization, indexing, hardware tradeoffs, and the core challenges in building systems that search by meaning rather than exact match.",
    tags: ["vector databases", "VDBMS", "embeddings", "similarity search", "machine learning systems"],
    slug: "vector-databases-vdbms",
    minutes: 6,
    contents: [
      "What is a Vector Database?",
      "Why Not a Regular Database?",
      "General Architecture of a VDBMS",
      "Use Cases",
      "Challenges and Limitations",
    ],
  },
  {
    title: "The Visual Cortex as a Computer Vision Architecture: Dorsal and Ventral Streams",
    date: "2026-04-05",
    description: "How the brain's visual cortex uses two parallel streams, feedback loops, and relative perception to process vision. Everything rewritten for engineers who build vision systems.",
    tags: ["computer vision", "neuroscience", "visual cortex", "CNN", "architecture"],
    slug: "cnns-design-flaw-evolution",
    minutes: 15,
    contents: [
      "The Split You Did Not Know Was in Your Design",
      "The Dorsal Stream: Real-Time Spatial Inference",
      "The Ventral Stream: Hierarchical Object Recognition",
      "Implications for Computer Vision Engineering",
    ],
  },
  {
    title: "Temporal and Spatial Attention for 3D Pose Estimation",
    date: "2026-02-22",
    description: "How temporal and spatial attention mechanisms enable accurate 2D-to-3D human pose estimation, with a deep dive into DSTformer.",
    tags: ["pose estimation", "attention", "3D vision", "transformers"],
    slug: "temporal-spatial-attention-3d-pose",
    minutes: 6,
    contents: [
      "The Ill-Posed Problem: Lifting 2D to 3D",
      "Temporal Attention: Understanding Motion Over Time",
      "Spatial Attention: Maintaining Anatomical Consistency",
      "Fusion of Temporal and Spatial Streams",
    ],
  },
]).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

type Item =
  | { kind: 'essay'; date: string; title: string; description: string; href: string; image: string; src: string; minutes: number; words: number; tags: string[]; contents: string[] }
  | { kind: 'notebook'; date: string; title: string; description: string; href: string; image: string; src: string; minutes: number; tags: string[]; nb: (typeof notebooks)[number] };

const items: Item[] = [
  ...posts.map(p => ({
    kind: 'essay' as const, date: p.date, title: p.title, description: p.description,
    href: p.href || `/blog/${p.slug}`, image: img(`/images/blog/${p.slug}.jpg`, 960), src: `/images/blog/${p.slug}.jpg`,
    minutes: essayWords[p.slug] ? Math.max(1, Math.round(essayWords[p.slug] / 230)) : p.minutes, words: essayWords[p.slug] ?? 0, tags: p.tags, contents: p.contents,
  })),
  ...notebooks.map(nb => ({
    kind: 'notebook' as const, date: nb.endDate, title: nb.title, description: nb.description,
    href: `/notebooks/${nb.slug}`, image: img(`/images/blog/notebook-${nb.slug}.jpg`, 960), src: `/images/blog/notebook-${nb.slug}.jpg`,
    minutes: nb.minutes, tags: nb.tags, nb,
  })),
].sort((a, b) => b.date.localeCompare(a.date));

// Topics worth filtering by: the ones that more than one piece shares.
/* A handful of plain topics, as on Thoughts, in place of the raw tags:
   each is the set of tags that mean it, and a piece belongs to every
   topic one of its tags falls under. */
const TOPICS: [string, string[]][] = [
  ['Vision', ['computer vision', '3D vision', 'pose estimation', 'visual cortex', 'OpenCV', 'sign language']],
  ['The brain', ['neuroscience', 'psychology', 'perception', 'visual cortex', 'autism']],
  ['Neural networks', ['deep learning', 'CNN', 'transformers', 'attention', 'LLMs']],
  ['Search & embeddings', ['embeddings', 'vector databases', 'similarity search', 'multimodal']],
  ['Probability & evaluation', ['probability', 'statistics', 'evaluation', 'ROC', 'AUC', 'PMF']],
];
const topicsOf = (tags: string[]) => TOPICS.filter(([, ts]) => ts.some(t => tags.includes(t))).map(([n]) => n);
const topics = TOPICS.map(([n]) => ({ name: n, count: items.filter(it => topicsOf(it.tags).includes(n)).length })).filter(t => t.count > 0);


const fmt = (d: string, o: Intl.DateTimeFormatOptions) => new Date(d + 'T00:00:00').toLocaleDateString('en-US', o);
const short = (d: string) => fmt(d, { month: 'short', day: 'numeric' });
const years = [...new Set(items.map(it => it.date.slice(0, 4)))];

/* The work in four topics, so a page of wide interests reads as four
   clear bodies of work. Each has its own drawings from the history of
   looking, which form beside its name as you reach it. In each, notebooks lead (the one being written first),
   then essays, newest first. */
const keyOf = (it: Item) => it.href.split('/').filter(Boolean).pop()!;
const TOPIC_DEFS = [
  { id: 'vision', intro: 'Recovering structure from projections. An image discards depth, so every estimate of shape, motion and identity is an inference under geometric and statistical constraints.', set: [15, 10, 7, 3, 30, 31, 32], name: 'Vision', line: 'How a machine recovers the world from pixels: geometry, pose and recognition.', keys: ['3d-reconstruction', 'temporal-spatial-attention-3d-pose', 'sign-language-recognition-using-cnn-and-opencv'] },
  { id: 'neuroscience', intro: 'Computation in biological hardware: spiking neurons, hierarchies of receptive fields and dense feedback, doing inference on roughly twenty watts.', set: [13, 14, 20, 17, 18, 33, 34, 35, 36], name: 'Neuroscience', line: 'How the brain sees, and how it feels: the computation behind both.', keys: ['neuroscience', 'cnns-design-flaw-evolution', 'emotion'] },
  { id: 'machine-learning', intro: 'Function approximation at scale. Parameterised models fitted by gradient descent, where the architecture decides what can be represented and the data decides what is learned.', set: [5, 8, 0, 37, 38, 39], name: 'Machine learning', line: 'Transformers, models that read images, and search by meaning, derived from the ground up.', keys: ['modern-nets', 'vlm-search', 'vector-databases-vdbms'] },
  { id: 'foundations', intro: 'Probability, estimation and evaluation: the formal machinery for reasoning under uncertainty, and for deciding whether a model\'s output can be trusted.', set: [1, 4, 6, 11, 16, 22, 27, 28, 29, 40, 41], name: 'Foundations', line: 'The probability and evaluation everything above stands on.', keys: ['probability-mass-function', 'roc-curve-auc'] },
];
const rank = (it: Item) => (it.kind === 'notebook' ? (it.nb.inProgress ? 0 : 1) : 2);
const fields4 = TOPIC_DEFS.map(t => {
  const its = t.keys.map(k => items.find(it => keyOf(it) === k)!).filter(Boolean)
    .sort((a, b) => rank(a) - rank(b) || b.date.localeCompare(a.date));
  const words = its.reduce((n, it) => n + (it.kind === 'essay' ? it.words : it.nb.words), 0);
  return { ...t, items: its, words, notebooks: its.filter(x => x.kind === 'notebook').length, essays: its.filter(x => x.kind === 'essay').length };
});
const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
const k1 = (n: number) => `${(n / 1000).toFixed(1).replace('.0', '')}k`;
const mon = (d: string) => fmt(d, { month: 'short', year: 'numeric' });
---
<Layout title={title} activeNav="/blog" description="Essays and day-by-day notebooks in four topics: vision, neuroscience, machine learning and their foundations. Notes on things I finally understood, not tutorials." ogImage={share("/images/share-blog.jpg")}>
  <SketchPlate sketches={sketches} credits={credits} />
  <div class="bp" id="bp">

    <!-- Opening: the drawing, the name, the four fields. -->
    <section class="open">
      <div class="op-art" aria-hidden="true">
        <div class="plate-slot on" data-t="all" data-set={JSON.stringify(fields4.flatMap(t => t.set))}></div>
        {fields4.map(t => <div class="plate-slot" data-t={t.id} data-set={JSON.stringify(t.set)}></div>)}
      </div>
      <div class="op-text">
        <h1 class="op-title">Technical<br /><span class="op-accent">Blogs</span></h1>
        <p class="op-say">Things I had to understand from the ground up, written down while learning them. Notebooks follow a subject day by day; essays make one argument.</p>
        <nav class="op-index" aria-label="Fields">
          {fields4.map((t, i) => (
            <a href={`#${t.id}`} data-t={t.id}>
              <span class="oi-n">{ROMAN[i]}</span>
              <span class="oi-name">{t.name}</span>
              <span class="oi-c">{t.items.length}</span>
            </a>
          ))}
        </nav>
        <div class="op-find">
          <label class="find"><span class="find-k">Find</span><input type="search" id="find" placeholder="a word, a method, a question" autocomplete="off" enterkeyhint="search" aria-label="Search the blogs" /></label>
          <details class="why">
            <summary>Why I write these</summary>
            <div class="why-body">
              <p>I write these to check whether I actually understand something. If I can explain it from the start, with the reasoning and not just the result, I do. If I can't, the gap shows up on the page.</p>
              <p>I'm mostly self-taught, so I don't always know what I'm missing. Writing is how I find out.</p>
              <p>I move between subjects because that's how my curiosity works, and because an idea often makes more sense once I've seen it somewhere else.</p>
              <p>These are working notes, not tutorials. Some of it will be wrong. Where I'm not sure, I say so.</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- The atlas: each field a plate, its works the figures on it, set
         large and equal across the full width, numbered and captioned. -->
    {fields4.map((t, i) => (
      <section class="plate-sec" id={t.id} data-t={t.id} style={`--n:${t.items.length}`}>
        <header class="pl-head">
          <details class="pl-about">
            <summary class="pl-name" title="Scope of this topic"><h2>{t.name}<span class="pl-plus" aria-hidden="true">+</span></h2></summary>
            <p class="pl-intro">{t.intro}</p>
          </details>
        </header>
        <div class="figs">
          {t.items.map((it, k) => {
            const rows = it.kind === 'essay'
              ? it.contents.map((c, j) => ({ n: String(j + 1).padStart(2, '0'), t: c, href: `${it.href}#section-${j + 1}` }))
              : it.nb.days.map(d => ({ n: String(d.day).padStart(2, '0'), t: d.title, href: d.href, m: d.href ? `${d.minutes} min` : 'soon' }));
            return (
              <figure class={`fig ${it.kind}`} id={keyOf(it)}
                      data-text={[it.title, it.description, t.name, ...it.tags, ...(it.kind === 'essay' ? it.contents : it.nb.days.map(d => d.title))].join(' ').toLowerCase()}>
                <a class="fig-img" href={it.href} tabindex="-1" aria-hidden="true">
                  <img src={it.image} srcset={widths(it.src, [480, 720, 960, 1280, 1600])}
                       sizes="(max-width: 900px) calc(100vw - 2rem), 46vw"
                       data-ink crossorigin="anonymous" alt="" width="1600" height="840" loading="lazy" decoding="async" />
                </a>
                <figcaption class="cap">
                  <p class="cap-k"><span class="cap-n">Fig. {i + 1}.{k + 1}</span>
                    {it.kind === 'essay'
                      ? <Fragment>Essay · {mon(it.date)} · {it.minutes} min</Fragment>
                      : <Fragment>Notebook · {it.nb.days.length} days · {k1(it.nb.words)} words{it.nb.inProgress && <em> · ongoing</em>}</Fragment>}
                  </p>
                  <h3 class="cap-title"><a href={it.href}>{it.title}</a></h3>
                  <p class="cap-desc">{it.description}</p>
                  <ol class={`cap-toc ${it.kind}`}>
                    {rows.map((r: { n: string; t: string; href?: string; m?: string }) => <li class={r.href ? '' : 'later'}>{r.href
                      ? <a href={r.href}><i>{r.n}</i><span class="t">{r.t}{r.m && <span class="m">{r.m}</span>}</span></a>
                      : <span class="a"><i>{r.n}</i><span class="t">{r.t}{r.m && <span class="m">{r.m}</span>}</span></span>}</li>)}
                  </ol>
                  {rows.length > 3 && <button type="button" class="toc-more" aria-expanded="false">+ {rows.length - 3} more {it.kind === 'essay' ? 'sections' : 'days'}</button>}
                </figcaption>
              </figure>
            );
          })}
        </div>
      </section>
    ))}
    <p class="none" id="none" hidden>Nothing written on that yet.</p>
  </div>
</Layout>

<style>
  /* The page takes the whole width of the window, with its own margins. */
  :global(body) { overflow-x: clip; }
  .bp {
    --ease: cubic-bezier(0.22, 0.8, 0.2, 1);
    --side: clamp(1rem, 4.5vw, 5rem);
    box-sizing: border-box;
    /* Full width up to a point, then centred, so a wide screen does not
       leave everything leaning left (the opening stays the full width). */
    width: 100vw;
    max-width: none;
    margin-inline: calc(50% - 50vw);
    padding-inline: var(--side);
  }


  /* ── Opening ── */
  .open {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    min-height: calc(100svh - var(--head-h, 72px) - 3rem);
    padding-bottom: var(--space-lg);
  }

  .op-art {
    grid-column: 2;
    grid-row: 1;
    align-self: stretch;
    position: relative;
    /* As much of the screen as the opening has: its full height, within
       the page's margins. */
    min-height: max(26rem, calc(100svh - var(--head-h, 72px) - 3rem - var(--space-lg)));
  }
  .op-art .plate-slot { display: none; position: absolute; inset: 0; }
  .op-art .plate-slot.on { display: block; }

  .op-text { grid-column: 1; grid-row: 1; position: relative; z-index: 2; }

  .op-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-display);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .op-accent { color: var(--color-accent); }

  .op-say {
    max-width: 38ch;
    margin: clamp(1rem, 3vh, 1.75rem) 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-ui);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* The four topics: an index, one to a line, on one left edge; the
     numeral in its own column, the count trailing the name. */
  .op-index {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: clamp(1.75rem, 5vh, 3rem) 0 0;
  }
  .op-index a {
    display: grid;
    grid-template-columns: 2.6rem auto 1fr;
    align-items: baseline;
    column-gap: 0.55rem;
    color: var(--color-text);
    text-decoration: none;
  }
  .oi-n, .oi-c {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-label);
    color: var(--color-accent);
  }
  .oi-c { color: var(--color-text-muted); }
  .oi-name {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.8vw, 1.9rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    transition: color 300ms ease, transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .op-index a:hover .oi-name, .op-index a:focus-visible .oi-name { color: var(--color-accent); transform: translateX(0.15em); }

  /* One line to close the column: the search across, the note at its end. */
  .op-find {
    display: flex;
    align-items: baseline;
    gap: var(--space-lg);
    max-width: 34rem;
    margin-top: clamp(1.75rem, 5vh, 3rem);
  }
  .find { display: flex; flex: 1; min-width: 0; align-items: baseline; gap: var(--space-3); }
  .find-k, .why summary {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .find input {
    flex: 1;
    min-width: 0;
    padding: 0.2em 0;
    border: 0;
    border-bottom: 1px solid var(--color-border, rgba(0,0,0,0.15));
    background: none;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-ui);
    color: var(--color-text);
    outline: none;
    transition: border-color 300ms ease;
  }
  .find input:focus { border-bottom-color: var(--color-accent); }
  .find input::-webkit-search-cancel-button { display: none; }

  .why { flex: none; }
  .bp .why summary {
    cursor: pointer;
    list-style: none;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    color: var(--color-text-muted);
    transition: color 250ms ease;
  }
  .why summary::-webkit-details-marker { display: none; }
  .bp .why summary:hover, .bp .why[open] summary { color: var(--color-accent); }
  .why-body {
    position: absolute;
    z-index: 6;
    max-width: 34rem;
    margin-top: var(--space-3);
    padding: var(--space-md) 0;
    background: var(--color-bg);
    font-family: var(--font-serif);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }
  .why-body p { margin: 0 0 0.7em; }

  /* ── The atlas ──
     Each field is a plate: its number and name,
     a short note; then its works as figures, equal, sharing the full width.
     Every figure's caption parts sit on the same lines across the plate. */
  /* A new topic begins at a hairline across the page, drawn outward from
     the middle as the topic's name sets itself. */
  .plate-sec, .none { max-width: 1560px; margin-inline: auto; }
  .plate-sec {
    position: relative;
    margin-top: clamp(3.5rem, 9vh, 6rem);
    padding: 0;
    scroll-margin-top: calc(var(--head-h, 72px) + 0.5rem);
  }

  /* The field's heading: an interlude between groups of works, not one of
     them. Centred where the works sit on their grid; the name large but
     quiet, the intro small; there to orient, not to be read each time. */
  .pl-head {
    margin: 0 0 clamp(1.75rem, 4.5vh, 2.75rem);
    text-align: center;
  }
  .pl-k {
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .pl-k span { margin-right: 1.2em; color: var(--color-accent); }
  /* The topic's name set into the divider: the line runs in from both
     edges and breaks around it, drawing outward from the name as the topic
     comes into view. */
  .pl-name {
    display: block;
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--fs-label);
    line-height: 1;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-text);
    white-space: nowrap;
  }
  .pl-name h2 { display: flex; align-items: center; }
  .pl-name h2::before, .pl-name h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-text);
    transition: transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pl-name h2::before { transform-origin: right; margin-right: clamp(1rem, 2.4vw, 2.25rem); }
  .pl-name h2::after { transform-origin: left; margin-left: clamp(1rem, 2.4vw, 2.25rem); }
  :global(.bp.moving) .pl-head:not(.in) .pl-name h2::before,
  :global(.bp.moving) .pl-head:not(.in) .pl-name h2::after { transform: scaleX(0); transition-duration: 0ms; }

  .pl-intro {
    margin: var(--space-3) auto 0;
    max-width: 64ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: balance;
  }


  /* Arriving at a field: the name sets itself letter by letter, each
     rising from below the line a moment after the last, masked at the
     line so nothing fades; the plate line and the note settle after it.
     Plays each time the heading comes into view (the script marks it). */


  /* The topic's intro, folded behind a small control: there when wanted,
     no room taken when not. */
  /* The name is the way into the topic's scope: a small mark beside it in
     the divider, turning to a cross when the note is open. */
  .pl-name { cursor: pointer; list-style: none; }
  .pl-name::-webkit-details-marker { display: none; }
  .pl-name h2 { margin: 0; font: inherit; color: inherit; letter-spacing: inherit; white-space: nowrap; }
  .pl-plus {
    display: inline-block;
    margin-left: 0.6em;
    font-family: var(--font-mono);
    font-size: 1.35em;
    vertical-align: -0.08em;
    color: var(--color-accent);
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pl-name:hover .pl-plus { transform: rotate(90deg); }
  .pl-about[open] .pl-plus { transform: rotate(45deg); }
  .pl-name:focus-visible { outline: none; }
  .pl-name:focus-visible h2 { text-decoration: underline; text-underline-offset: 0.2em; }
  .pl-about .pl-intro { margin-top: var(--space-md); }
  .pl-about[open] .pl-intro { animation: about-open 600ms cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes about-open { from { transform: translateY(-6px); } to { transform: none; } }

  /* One work to a row, every one given the same room: the figure wide on
     the left, its number, title and note beside it; all
     its days or sections underneath, in columns. */
  .figs { display: flex; flex-direction: column; gap: clamp(3.5rem, 11vh, 7rem); }
  .fig {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto auto auto 1fr;
    grid-template-areas: 'img k' 'img title' 'img desc' 'img toc';
    column-gap: clamp(2rem, 4.5vw, 5rem);
    align-items: start;
    margin: 0;
    min-width: 0;
  }
  .cap { display: contents; }
  .fig-img { grid-area: img; align-self: start; }
  .cap-k { grid-area: k; }
  .cap-title { grid-area: title; }
  .cap-desc { grid-area: desc; }
  .cap-toc { grid-area: toc; }

  .fig-img { position: relative; display: block; }
  .fig-img img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1600 / 840;
    object-fit: contain;
    transition: transform 1.1s var(--ease);
  }
  .fig:hover .fig-img img { transform: scale(1.02); }

  .cap-k {
    margin: 0 0 var(--space-md);
    line-height: 1;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .cap-n { margin-right: 1em; color: var(--color-accent); }
  .cap-k em { font-style: normal; color: var(--color-accent); }

  .cap-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: clamp(1.9rem, 2.6vw, 2.8rem);
    max-width: 24ch;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .cap-title a { color: var(--color-accent); text-decoration: none; transition: color 250ms ease; }
  .cap-title a:hover, .cap-title a:focus-visible { color: var(--color-text); }

  .cap-desc {
    margin: var(--space-3) 0 0;
    max-width: 52ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-ui);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  /* Every day of a notebook and every section of an essay, in full: the
     parts are what the work is made of. */
  .cap-toc {
    align-self: start;
    list-style: none;
    margin: clamp(1.25rem, 3vh, 2rem) 0 0;
    padding: 0;
    max-width: 44rem;
  }
  .cap-toc li { break-inside: avoid; }
  .cap-toc a, .cap-toc .a {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) 1.4rem;
    align-items: baseline;
    padding: 0.4rem 0;
    cursor: pointer;
    color: var(--color-text);
    text-decoration: none;
  }
  .cap-toc i {
    font-style: normal;
    font-family: var(--font-serif);
    font-size: var(--fs-body);
    font-variant-numeric: tabular-nums lining-nums;
    line-height: 1.35;
    color: var(--color-accent);
  }
  .cap-toc .t {
    font-family: var(--font-serif);
    color: var(--color-text);
    font-size: var(--fs-body);
    line-height: 1.35;
    text-wrap: pretty;
    transition: color 200ms ease;
  }
  .cap-toc .m {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-label);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .cap-toc .m::before { content: '\00a0\00a0'; }
  /* Each part is a way in: on pointing, it moves toward you and an arrow
     comes up beside it. */
  .cap-toc a::after {
    content: '\2192';
    align-self: baseline;
    justify-self: end;
    font-family: var(--font-serif);
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 250ms ease, transform 400ms var(--ease);
  }
  .cap-toc a:hover::after, .cap-toc a:focus-visible::after { opacity: 1; transform: none; }
  .cap-toc .t { transition: color 200ms ease, transform 400ms var(--ease); }
  .cap-toc a:hover .t, .cap-toc a:focus-visible .t { color: var(--color-accent); transform: translateX(3px); }
  .cap-toc a:hover i { color: var(--color-accent); }
  .cap-toc a:focus-visible { outline: none; }
  .cap-toc a:hover .m { color: var(--color-text-muted); }
  .cap-toc .later { opacity: 0.45; }
  .toc-more { display: none; }

  /* Finding: what does not match steps out; a plate keeps its columns
     to the figures left on it. */
  .fig.miss, .plate-sec.miss { display: none; }
  .bp.searching .pl-about { display: none; }
  .none { padding: var(--space-xl) 0; font-family: var(--font-serif); font-style: italic; color: var(--color-text-muted); }



  /* ── Phones ── */
  @media (max-width: 900px) {
    .open { display: flex; flex-direction: column; align-items: stretch; min-height: 0; padding-top: var(--space-md); }
    .op-art { order: 2; min-height: 0; height: 40svh; margin: var(--space-md) 0; }
    .op-art .plate-slot { inset: 0; }
    .op-text { display: contents; }
    .op-title { order: 1; font-size: clamp(3rem, 15vw, 4.2rem); }
    .op-say { order: 3; margin-top: 0; }
    .op-index { order: 4; margin-top: var(--space-xl); }
    .op-index a { grid-template-columns: 2.2rem auto 1fr; }
    .oi-name { font-size: 1.75rem; }
    .op-find { order: 5; max-width: none; margin-top: var(--space-xl); flex-direction: column; align-items: stretch; gap: var(--space-md); }
    .why-body { left: var(--gutter, 1rem); right: var(--gutter, 1rem); }

    .figs { gap: var(--space-2xl); }
    .fig { display: block; }
    .cap { display: block; }
    .cap-k { margin-top: var(--space-md); }
    .cap-title { font-size: clamp(1.75rem, 8.4vw, 2.15rem); }
    .cap-k { line-height: 1.5; }
    .cap-toc { margin-top: var(--space-md); }
    .cap-toc .t, .cap-toc i { font-size: var(--fs-ui); }
    /* On a phone a work shows its first three parts; the rest on asking. */
    .fig:not(.open) .cap-toc li:nth-child(n + 4) { display: none; }
    .toc-more {
      display: inline-block;
      margin-top: var(--space-3);
      padding: 0.3rem 0;
      border: 0;
      background: none;
      font-family: var(--font-mono);
      font-size: var(--fs-micro);
      letter-spacing: var(--track-caps);
      text-transform: uppercase;
      color: var(--color-accent);
      cursor: pointer;
    }
    .fig.open .toc-more { display: none; }
    .cap-toc a, .cap-toc .a { grid-template-columns: 2.1rem minmax(0, 1fr) 1.1rem; padding: 0.35rem 0; }
    .fig-img { margin-bottom: var(--space-md); }
    .figs { gap: var(--space-2xl); }
  }
</style>

<script is:inline>
(function () {
  var bp = document.getElementById('bp');
  if (!bp) return;
  var plate = document.querySelector('.plate');
  var slots = [].slice.call(bp.querySelectorAll('.op-art .plate-slot'));
  var secs = [].slice.call(bp.querySelectorAll('.plate-sec'));
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var head = function () { return parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--head-h')) || 72; };
  function go(el) { scrollTo({ top: el.getBoundingClientRect().top + scrollY - head() - 8, behavior: reduce ? 'auto' : 'smooth' }); }

  // Pointing at a field in the opening turns the ink to its plates.
  var shown = 'all', dwell = 0;
  function drawing(id) {
    if (id === shown) return;
    shown = id;
    var el = null;
    slots.forEach(function (s) { var on = s.dataset.t === id; s.classList.toggle('on', on); if (on) el = s; });
    if (plate && el) requestAnimationFrame(function () { plate.dispatchEvent(new CustomEvent('plate:slot', { detail: el })); });
  }
  bp.querySelectorAll('.op-index a').forEach(function (a) {
    a.addEventListener('mouseenter', function () { clearTimeout(dwell); dwell = setTimeout(function () { drawing(a.dataset.t); }, 300); });
    a.addEventListener('mouseleave', function () { clearTimeout(dwell); });
    a.addEventListener('focus', function () { drawing(a.dataset.t); });
    // A field chosen in the opening: its plate, clear of the header.
    a.addEventListener('click', function (e) {
      var el = document.getElementById(a.dataset.t); if (!el) return;
      e.preventDefault(); go(el);
      history.replaceState(null, '', '#' + a.dataset.t);
    });
  });

  // Field headings gather as they come into view, and loosen again once
  // they have left it, so they play each time.
  if ('IntersectionObserver' in window && !reduce) {
    bp.classList.add('moving');
    // Set once well into view; reset only when wholly out of it, so the
    // reset is never seen.
    var hin = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('in'); });
    }, { rootMargin: '0px 0px -18% 0px', threshold: 0.3 });
    var hout = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (!e.isIntersecting) e.target.classList.remove('in'); });
    }, { threshold: 0 });
    bp.querySelectorAll('.pl-head').forEach(function (h) { hin.observe(h); hout.observe(h); });
  }

  bp.querySelectorAll('.toc-more').forEach(function (b) {
    b.addEventListener('click', function () { b.closest('.fig').classList.add('open'); b.setAttribute('aria-expanded', 'true'); });
  });

  // Find: across all four plates; what does not match steps out, and each
  // plate shares its width among the figures left on it.
  var q = document.getElementById('find'), none = document.getElementById('none');
  function run() {
    var v = q.value.trim().toLowerCase(), any = false;
    bp.classList.toggle('searching', !!v);
    secs.forEach(function (s) {
      var hit = 0, figs = s.querySelectorAll('.fig');
      figs.forEach(function (f) {
        var m = !v || f.dataset.text.indexOf(v) >= 0;
        f.classList.toggle('miss', !m); if (m) hit++;
      });
      s.classList.toggle('miss', !!v && !hit);
      s.style.setProperty('--n', Math.max(1, v ? hit : figs.length));
      if (hit) any = true;
    });
    none.hidden = !v || any;
  }
  q.addEventListener('input', run);
  q.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { q.value = ''; run(); q.blur(); }
    if (e.key === 'Enter') { var f = bp.querySelector('.plate-sec:not(.miss)'); if (f) { e.preventDefault(); go(f); } }
  });
  addEventListener('keydown', function (e) {
    var t = document.activeElement;
    if (e.key === '/' && t !== q && !/INPUT|TEXTAREA|SELECT/.test(t.tagName) && !t.isContentEditable) { e.preventDefault(); q.focus(); }
  });
  // Coming back with a search still in the box (the browser keeps it).
  if (q.value) run();
})();
</script>
