---
/* Blogs: the essays and the notebooks, on one page.

   One timeline, newest first, under clear year headings. Every piece is the
   same row: its date in the margin, its figure at full width, what it is,
   its title and what it asks.
   The one difference is the honest one: an essay is a single piece, a
   notebook is a run of days, and its row shows the days as a strip you can
   open one by one.

   An essay is one piece, read in one sitting. A notebook is a thread of
   short days on one question, each day its own short read. They share a
   single list, newest first, with every reading time stated. */

import Layout from '../layouts/Layout.astro';
import Mast from '../components/Mast.astro';
import { notebooks } from '../lib/notebooks';

const title = "Technical Blogs — Arshad Kazi";

// `contents` mirrors the section headings inside each post, so the index says
// what a post actually covers instead of making you open it to find out.
const posts = ([
  {
    title: "Probability Mass Functions, Expectation, and Variance",
    date: "2023-11-15",
    description: "Relearning probability from a machine learning perspective. What PMFs are, how to compute expectation and variance from first principles, and why any of this matters for ML.",
    tags: ["probability", "statistics", "PMF", "machine learning", "fundamentals"],
    slug: "probability-mass-function",
    minutes: 5,
    contents: [
      "What is Probability?",
      "Probability Distribution",
      "Probability Mass Function",
      "Expected Value (Expectation)",
      "Variance",
      "Why does any of this matter for ML?",
    ],
  },
  {
    title: "ROC Curves and AUC: Picking the Right Threshold for Your Model",
    date: "2024-02-01",
    description: "Why accuracy fails on skewed data, how confusion matrices work, and how to use ROC curves and AUC to evaluate and compare probabilistic classifiers.",
    tags: ["machine learning", "evaluation", "ROC", "AUC", "classification"],
    slug: "roc-curve-auc",
    minutes: 5,
    contents: [
      "Why Accuracy Is Not Enough",
      "True Positive, True Negative, False Positive, False Negative",
      "Confusion Matrix",
      "ROC Curve",
      "AUC (Area Under the Curve)",
    ],
  },
  {
    title: "Building a Sign Language Recognition System with CNNs and OpenCV",
    date: "2024-03-10",
    description: "A practical walkthrough of building a real-time ASL alphabet recogniser. Dataset, CNN architecture with the actual math, and live webcam inference using OpenCV.",
    tags: ["computer vision", "CNN", "sign language", "OpenCV", "keras", "deep learning"],
    slug: "sign-language-recognition-using-cnn-and-opencv",
    href: "/sign-language-recognition-using-cnn-and-opencv",
    minutes: 5,
    contents: [
      "Dataset",
      "Build and Train the Model",
      "OpenCV",
    ],
  },
  {
    title: "Vector Database Management Systems: Architecture and Internals",
    date: "2024-01-15",
    description: "A technical overview of how Vector Database Management Systems work, covering vectorization, indexing, hardware tradeoffs, and the core challenges in building systems that search by meaning rather than exact match.",
    tags: ["vector databases", "VDBMS", "embeddings", "similarity search", "machine learning systems"],
    slug: "vector-databases-vdbms",
    minutes: 6,
    contents: [
      "What is a Vector Database?",
      "Why Not a Regular Database?",
      "General Architecture of a VDBMS",
      "Use Cases",
      "Challenges and Limitations",
    ],
  },
  {
    title: "The Visual Cortex as a Computer Vision Architecture: Dorsal and Ventral Streams",
    date: "2026-04-05",
    description: "How the brain's visual cortex uses two parallel streams, feedback loops, and relative perception to process vision. Everything rewritten for engineers who build vision systems.",
    tags: ["computer vision", "neuroscience", "visual cortex", "CNN", "architecture"],
    slug: "cnns-design-flaw-evolution",
    minutes: 15,
    contents: [
      "The Split You Did Not Know Was in Your Design",
      "The Dorsal Stream: Real-Time Spatial Inference",
      "The Ventral Stream: Hierarchical Object Recognition",
      "Implications for Computer Vision Engineering",
    ],
  },
  {
    title: "Temporal and Spatial Attention for 3D Pose Estimation",
    date: "2026-02-22",
    description: "How temporal and spatial attention mechanisms enable accurate 2D-to-3D human pose estimation, with a deep dive into DSTformer.",
    tags: ["pose estimation", "attention", "3D vision", "transformers"],
    slug: "temporal-spatial-attention-3d-pose",
    minutes: 6,
    contents: [
      "The Ill-Posed Problem: Lifting 2D to 3D",
      "Temporal Attention: Understanding Motion Over Time",
      "Spatial Attention: Maintaining Anatomical Consistency",
      "Fusion of Temporal and Spatial Streams",
    ],
  },
]).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

type Item =
  | { kind: 'essay'; date: string; title: string; description: string; href: string; image: string; minutes: number; tags: string[]; contents: string[] }
  | { kind: 'notebook'; date: string; title: string; description: string; href: string; image: string; minutes: number; tags: string[]; nb: (typeof notebooks)[number] };

const items: Item[] = [
  ...posts.map(p => ({
    kind: 'essay' as const, date: p.date, title: p.title, description: p.description,
    href: p.href || `/blog/${p.slug}`, image: `/images/blog/${p.slug}.jpg`,
    minutes: p.minutes, tags: p.tags, contents: p.contents,
  })),
  ...notebooks.map(nb => ({
    kind: 'notebook' as const, date: nb.endDate, title: nb.title, description: nb.description,
    href: `/notebooks/${nb.slug}`, image: `/images/blog/notebook-${nb.slug}.jpg`,
    minutes: nb.minutes, tags: nb.tags, nb,
  })),
].sort((a, b) => b.date.localeCompare(a.date));

// Topics worth filtering by: the ones that more than one piece shares.
const tagCount = new Map<string, number>();
items.forEach(it => it.tags.forEach(t => tagCount.set(t, (tagCount.get(t) ?? 0) + 1)));
const topics = [...tagCount].filter(([, n]) => n > 1).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([t]) => t);

const totalMinutes = items.reduce((n, it) => n + it.minutes, 0);
const totalDays = notebooks.reduce((n, nb) => n + nb.days.length, 0);

const fmt = (d: string, o: Intl.DateTimeFormatOptions) => new Date(d + 'T00:00:00').toLocaleDateString('en-US', o);
const short = (d: string) => fmt(d, { month: 'short', day: 'numeric' });
const years = [...new Set(items.map(it => it.date.slice(0, 4)))];

/* The chart above the timeline: every piece in order, oldest on the left,
   each bar as tall as its reading time. An essay is one wide bar; a
   notebook is a run of thin ones, a bar a day. Placed by order, not by
   date, so a week of notes is not crushed into a sliver. */
const CW = 1000, CH = 150, BASE = 128, TOP = 26;
const chrono = [...items].reverse();
const units = chrono.reduce((n, it) => n + (it.kind === 'essay' ? 4 : it.nb.days.length) + 1.6, -1.6);
const unit = CW / units;
const maxMin = Math.max(...chrono.flatMap(it => it.kind === 'essay' ? [it.minutes] : it.nb.days.map(d => d.minutes)));
const yh = (m: number) => Math.max(4, (m / maxMin) * (BASE - TOP));
let cx = 0;
const bars = chrono.map(it => {
  const id = items.indexOf(it);
  const x0 = cx;
  const rects = it.kind === 'essay'
    ? [{ x: cx, w: unit * 4, h: yh(it.minutes) }]
    : it.nb.days.map((d, k) => ({ x: cx + k * unit, w: unit * 0.62, h: yh(d.minutes) }));
  cx += (it.kind === 'essay' ? 4 : it.nb.days.length) * unit + unit * 1.6;
  return { id, it, x0, x1: cx - unit * 1.6, rects };
});
// A year mark wherever the year changes along the run.
const yearMarks = bars.filter((b, i) => i === 0 || b.it.date.slice(0, 4) !== bars[i - 1].it.date.slice(0, 4)).map(b => ({ x: b.x0, y: b.it.date.slice(0, 4) }));
---

<Layout title={title} activeNav="/blog" description="Essays and day-by-day notebooks on computer vision, the brain and machine learning. Notes on things I finally understood, not tutorials." ogImage="/images/share-blog.jpg">
  <div class="blog-page">
    <Mast
      label="Technical Blogs"
      aside={`${posts.length} essays · ${notebooks.length} notebooks`}
      title="Technical"
      accent="Blogs"
      lede="What I have learned about computer vision, the brain and machine learning, written down while I was learning it."
      figures={[
        { k: 'Essays', v: posts.length },
        { k: 'Notebooks', v: notebooks.length },
        { k: 'Days of notes', v: totalDays },
        { k: 'Hours of reading', v: (totalMinutes / 60).toFixed(1) },
      ]}
    />

    <!-- The two kinds, said once, so the timeline needs no more explaining. -->
    <!-- Reading time, piece by piece. A line sweeps across it and names each
         piece as it passes; point at a bar, or at a row below, to hold it. -->
    <figure class="chart" id="chart" aria-label="Reading time of every essay and notebook, oldest to newest">
      <div class="chart-now" aria-live="off">
        <span class="chart-kind" id="chart-kind">&nbsp;</span>
        <a class="chart-title" id="chart-title" href="#">&nbsp;</a>
      </div>
      <svg viewBox={`0 0 ${CW} ${CH}`} preserveAspectRatio="none" class="chart-svg">
        {[0.25, 0.5, 0.75, 1].map(f => <line class="grid" x1="0" x2={CW} y1={BASE - f * (BASE - TOP)} y2={BASE - f * (BASE - TOP)} />)}
        <line class="axis" x1="0" x2={CW} y1={BASE} y2={BASE} />
        {bars.map(b => (
          <g class={`piece ${b.it.kind}`} data-id={b.id} data-x0={b.x0} data-x1={b.x1}
             data-kind={b.it.kind === 'essay' ? `Essay · ${b.it.minutes} min` : `Notebook · ${b.it.nb.days.length} days · ${b.it.minutes} min`}
             data-title={b.it.title} data-href={b.it.href}>
            <rect class="hit" x={b.x0 - 2} y="0" width={b.x1 - b.x0 + 4} height={CH} />
            {b.rects.map(r => <rect class="bar" x={r.x} y={BASE - r.h} width={r.w} height={r.h} />)}
          </g>
        ))}
        <line class="sweep" id="sweep" x1="0" x2="0" y1={TOP - 14} y2={BASE + 6} />
      </svg>
      <div class="chart-years">
        {yearMarks.map(m => <span style={`left:${(m.x / CW * 100).toFixed(2)}%`}>{m.y}</span>)}
        <span class="chart-unit">bar height · minutes to read</span>
      </div>
    </figure>

    <dl class="key">
      <div><dt><span class="mark essay"></span>Essay</dt><dd>A single post.</dd></div>
      <div><dt><span class="mark notebook"><i></i><i></i><i></i><i></i></span>Notebook</dt><dd>Daily notes on one topic, over a week or so.</dd></div>
    </dl>

    <div class="topics">
      <p class="small-label">Topics</p>
      <div class="tag-filters" id="tag-filters">
        {topics.map(tag => <button type="button" class="tag-chip" data-tag={tag}>{tag}</button>)}
      </div>
    </div>

    <div class="timeline" id="post-index">
      {years.map(year => (
        <section class="year" data-year={year}>
          <h2 class="year-head"><span class="year-n">{year}</span><span class="year-rule"></span><span class="year-c">{items.filter(it => it.date.startsWith(year)).length} pieces</span></h2>
          <ol class="rows">
            {items.filter(it => it.date.startsWith(year)).map(it => (
              <li class={`row ${it.kind}`} data-tags={it.tags.join('|')} data-id={items.indexOf(it)}>
                <time class="row-date" datetime={it.date}>{short(it.date)}</time>
                <div class="row-body">
                  <div class="row-fig"><img src={it.image} alt="" width="1600" height="840" loading="lazy" decoding="async" /></div>
                  <p class="meta">
                    <span class="k">{it.kind === 'essay' ? 'Essay' : 'Notebook'}</span>
                    <span>{it.kind === 'essay' ? `${it.minutes} min read` : `${it.nb.days.length} days · ${it.minutes} min in all`}</span>
                  </p>
                  <h3><a href={it.href} class="stretch">{it.title}</a></h3>
                  <p class="desc">{it.description}</p>
                  {it.kind === 'essay' && (
                    <ol class="strip" aria-hidden="true"><li><span class="off one"><span class="d">One sitting</span></span></li></ol>
                  )}
                  {it.kind === 'notebook' && (
                    <ol class="strip" aria-label="Days">
                      {it.nb.days.map(d => (
                        <li>{d.href
                          ? <a href={d.href}><span class="d">Day {d.day}</span><span class="q">{d.title}</span></a>
                          : <span class="off"><span class="d">Day {d.day}</span><span class="q">{d.title}</span></span>}</li>
                      ))}
                    </ol>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    <p class="no-results" id="no-results">Nothing on that topic yet.</p>
  </div>
</Layout>

<style>
  .blog-page {
    display: flex;
    flex-direction: column;
  }

  .small-label,
  .meta {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
  }

  .meta .k {
    color: var(--color-accent);
  }

  /* ── The chart ──────────────────────────────────── */
  .chart {
    margin: 0 0 var(--space-xl);
  }

  .chart-now {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-height: 3.6rem;
    margin-bottom: 0.4rem;
  }

  .chart-kind {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .chart-title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    animation: chart-in 0.45s var(--ease-out);
  }

  .chart-title:hover {
    color: var(--color-accent);
  }

  @keyframes chart-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }

  .chart-svg {
    display: block;
    width: 100%;
    height: 150px;
    overflow: visible;
  }

  .chart .grid {
    stroke: var(--color-border-light);
    stroke-width: 1;
    stroke-dasharray: 2 4;
    vector-effect: non-scaling-stroke;
  }

  .chart .axis {
    stroke: var(--color-text-muted);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .chart .hit {
    fill: transparent;
    cursor: pointer;
  }

  /* The bars rest in a faint ink and light up as the line passes. */
  .chart .bar {
    fill: var(--color-text-muted);
    opacity: 0.35;
    transition: fill 0.5s ease, opacity 0.9s ease;
  }

  .chart .piece.lit .bar {
    fill: var(--color-accent);
    opacity: 1;
    transition: fill 0.15s ease, opacity 0.15s ease;
  }

  .chart .piece.seen .bar {
    opacity: 0.6;
  }

  .chart .sweep {
    stroke: var(--color-accent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .chart-years {
    position: relative;
    height: 1.2rem;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .chart-years span {
    position: absolute;
    top: 0;
  }

  .chart-years .chart-unit {
    right: 0;
    text-transform: uppercase;
    opacity: 0.8;
  }

  /* The row a bar belongs to answers when you point at the bar. */
  .row.hi h3 a {
    color: var(--color-accent);
  }

  .row.hi .row-fig img {
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  @media (max-width: 560px) {
    .chart-svg {
      height: 110px;
    }

    .chart-unit {
      display: none;
    }
  }

  /* ── The key ──────────────────────────────────────── */
  .key {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0 0 var(--space-xl);
  }

  .key > div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-md);
  }

  .key dt {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .key dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  /* An essay is one block; a notebook is a run of days. */
  .mark {
    display: inline-flex;
    gap: 2px;
  }

  .mark.essay {
    width: 22px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 1px;
  }

  .mark.notebook i {
    width: 4px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 1px;
  }

  .topics {
    display: flex;
    align-items: baseline;
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .tag-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.9rem;
  }

  .tag-chip {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    background: none;
    border: none;
    padding: 0.05rem 0;
    color: var(--color-text-secondary);
    cursor: pointer;
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: color 0.2s ease, background-size 0.35s var(--ease-out);
  }

  .tag-chip:hover,
  .tag-chip.active {
    color: var(--color-accent);
    background-size: 100% 1px;
  }

  /* ── The timeline ─────────────────────────────────── */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .year-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin: 0 0 var(--space-sm);
  }

  .year-n {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 200;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-text);
  }

  .year-rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
    align-self: center;
  }

  .year-c {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Every row the same: date, figure, words. */
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .row-date {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-top: 0.15rem;
  }

  .row-fig {
    margin-bottom: var(--space-md);
  }

  .row-fig img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
    box-shadow: 0 0 0 1px var(--color-border-light);
    transition: box-shadow 0.3s ease;
  }

  :global(html.dark) .row-fig img {
    box-shadow: none;
    filter: brightness(0.9);
  }

  .row:hover .row-fig img {
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .row h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0.4rem 0 0.35rem;
  }

  .row h3 a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .row:hover h3 a {
    color: var(--color-accent);
  }

  /* The whole row opens the piece; a notebook's days sit above it. */
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .desc {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 58ch;
  }

  /* The run of days: one cell each, the question shown when you reach it. */
  .strip {
    position: relative;
    z-index: 1;
    list-style: none;
    display: flex;
    gap: 3px;
    padding: 0;
    margin: 0.8rem 0 0;
  }

  .strip li {
    flex: 1;
    min-width: 0;
  }

  .strip a,
  .strip .off {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .strip .d {
    display: block;
    padding-top: 0.4rem;
    border-top: 3px solid var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .strip .off .d {
    border-top-color: var(--color-border);
  }

  .strip .one .d {
    border-top-color: var(--color-accent);
  }

  .strip .q {
    display: none;
  }

  .strip a:hover .d {
    color: var(--color-accent);
  }

  /* The question of the day you point at, said under the strip. */
  .strip li:hover .q {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    padding-top: 0.35rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  .row {
    padding-bottom: calc(var(--space-xl) + 1.4rem);
  }

  .no-results {
    display: none;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-muted);
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .row-date {
      order: -1;
    }

    .key > div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .topics {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .strip .d {
      font-size: 0;
      height: 0;
      padding-top: 0.8rem;
    }

    .row {
      padding-bottom: var(--space-lg);
    }
  }
</style>

<style is:global>
  .row.hidden,
  .year.hidden {
    display: none !important;
  }
</style>

<script is:inline>
/* The chart: a line sweeps across, naming each piece as it passes. Point
   at a bar or a row and it holds there; let go and it carries on. */
(function () {
  var svg = document.querySelector('#chart .chart-svg');
  if (!svg) return;
  var pieces = [].slice.call(svg.querySelectorAll('.piece'));
  var sweep = document.getElementById('sweep');
  var kindEl = document.getElementById('chart-kind'), titleEl = document.getElementById('chart-title');
  var W = 1000, x = 0, held = null, current = null, last = performance.now();
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var rows = {};
  [].slice.call(document.querySelectorAll('.row[data-id]')).forEach(function (r) { rows[r.dataset.id] = r; });

  function show(p) {
    if (p === current) return;
    if (current) { current.classList.remove('lit'); current.classList.add('seen'); if (rows[current.dataset.id]) rows[current.dataset.id].classList.remove('hi'); }
    current = p;
    if (!p) return;
    p.classList.add('lit');
    if (held && rows[p.dataset.id]) rows[p.dataset.id].classList.add('hi');
    kindEl.textContent = p.dataset.kind;
    titleEl.textContent = p.dataset.title;
    titleEl.href = p.dataset.href;
    titleEl.style.animation = 'none'; void titleEl.offsetWidth; titleEl.style.animation = '';
  }

  function at(px) {
    for (var i = 0; i < pieces.length; i++) {
      var p = pieces[i];
      if (px >= +p.dataset.x0 - 6 && px <= +p.dataset.x1 + 6) return p;
    }
    return null;
  }

  function place(px) {
    sweep.setAttribute('x1', px); sweep.setAttribute('x2', px);
  }

  (function frame(now) {
    var dt = Math.min(0.05, (now - last) / 1000); last = now;
    if (!held && !reduce) {
      x += dt * 70;
      if (x > W + 40) { x = -20; pieces.forEach(function (p) { p.classList.remove('seen'); }); }
      place(Math.max(0, Math.min(W, x)));
      var p = at(x);
      if (p) show(p);
    }
    requestAnimationFrame(frame);
  })(last);

  function hold(p) {
    held = p;
    x = (+p.dataset.x0 + +p.dataset.x1) / 2;
    place(x);
    current = null;
    show(p);
  }
  function release() {
    if (held && rows[held.dataset.id]) rows[held.dataset.id].classList.remove('hi');
    held = null;
  }

  pieces.forEach(function (p) {
    p.addEventListener('mouseenter', function () { hold(p); });
    p.addEventListener('mouseleave', release);
    p.addEventListener('click', function () {
      var r = rows[p.dataset.id];
      if (r) r.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    });
  });
  Object.keys(rows).forEach(function (id) {
    var p = svg.querySelector('.piece[data-id="' + id + '"]');
    rows[id].addEventListener('mouseenter', function () { if (p) hold(p); });
    rows[id].addEventListener('mouseleave', release);
  });
  if (reduce) show(pieces[pieces.length - 1]);
})();

(function () {
  var plates = [].slice.call(document.querySelectorAll('#post-index .row'));
  var years = document.querySelectorAll('#post-index .year');
  var chips = [].slice.call(document.querySelectorAll('.tag-chip'));
  var empty = document.getElementById('no-results');
  var tag = null;

  function apply() {
    var shown = 0;
    plates.forEach(function (p) {
      var show = !tag || p.dataset.tags.split('|').indexOf(tag) >= 0;
      p.classList.toggle('hidden', !show);
      if (show) shown++;
    });
    years.forEach(function (y) { y.classList.toggle('hidden', !y.querySelector('.row:not(.hidden)')); });
    empty.style.display = shown ? 'none' : 'block';
  }

  chips.forEach(function (c) {
    c.addEventListener('click', function () {
      tag = tag === c.dataset.tag ? null : c.dataset.tag;
      chips.forEach(function (o) { o.classList.toggle('active', o.dataset.tag === tag); });
      apply();
    });
  });
})();
</script>
