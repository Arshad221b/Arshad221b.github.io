---
/* Blogs: the essays and the notebooks, on one page.

   One timeline, newest first, under clear year headings. Every piece is the
   same row: its date in the margin, its figure at full width, what it is,
   its title and what it asks.
   The one difference is the honest one: an essay is a single piece, a
   notebook is a run of days, and its row lists them quietly, each a link.

   An essay is one piece, read in one sitting. A notebook is a thread of
   short days on one question, each day its own short read. They share a
   single list, newest first, with every reading time stated. */

import Layout from '../layouts/Layout.astro';
import Mast from '../components/Mast.astro';
import { notebooks } from '../lib/notebooks';

const title = "Technical Blogs — Arshad Kazi";

// `contents` mirrors the section headings inside each post, so the index says
// what a post actually covers instead of making you open it to find out.
const posts = ([
  {
    title: "Probability Mass Functions, Expectation, and Variance",
    date: "2023-11-15",
    description: "Relearning probability from a machine learning perspective. What PMFs are, how to compute expectation and variance from first principles, and why any of this matters for ML.",
    tags: ["probability", "statistics", "PMF", "machine learning", "fundamentals"],
    slug: "probability-mass-function",
    minutes: 5,
    contents: [
      "What is Probability?",
      "Probability Distribution",
      "Probability Mass Function",
      "Expected Value (Expectation)",
      "Variance",
      "Why does any of this matter for ML?",
    ],
  },
  {
    title: "ROC Curves and AUC: Picking the Right Threshold for Your Model",
    date: "2024-02-01",
    description: "Why accuracy fails on skewed data, how confusion matrices work, and how to use ROC curves and AUC to evaluate and compare probabilistic classifiers.",
    tags: ["machine learning", "evaluation", "ROC", "AUC", "classification"],
    slug: "roc-curve-auc",
    minutes: 5,
    contents: [
      "Why Accuracy Is Not Enough",
      "True Positive, True Negative, False Positive, False Negative",
      "Confusion Matrix",
      "ROC Curve",
      "AUC (Area Under the Curve)",
    ],
  },
  {
    title: "Building a Sign Language Recognition System with CNNs and OpenCV",
    date: "2024-03-10",
    description: "A practical walkthrough of building a real-time ASL alphabet recogniser. Dataset, CNN architecture with the actual math, and live webcam inference using OpenCV.",
    tags: ["computer vision", "CNN", "sign language", "OpenCV", "keras", "deep learning"],
    slug: "sign-language-recognition-using-cnn-and-opencv",
    href: "/sign-language-recognition-using-cnn-and-opencv",
    minutes: 5,
    contents: [
      "Dataset",
      "Build and Train the Model",
      "OpenCV",
    ],
  },
  {
    title: "Vector Database Management Systems: Architecture and Internals",
    date: "2024-01-15",
    description: "A technical overview of how Vector Database Management Systems work, covering vectorization, indexing, hardware tradeoffs, and the core challenges in building systems that search by meaning rather than exact match.",
    tags: ["vector databases", "VDBMS", "embeddings", "similarity search", "machine learning systems"],
    slug: "vector-databases-vdbms",
    minutes: 6,
    contents: [
      "What is a Vector Database?",
      "Why Not a Regular Database?",
      "General Architecture of a VDBMS",
      "Use Cases",
      "Challenges and Limitations",
    ],
  },
  {
    title: "The Visual Cortex as a Computer Vision Architecture: Dorsal and Ventral Streams",
    date: "2026-04-05",
    description: "How the brain's visual cortex uses two parallel streams, feedback loops, and relative perception to process vision. Everything rewritten for engineers who build vision systems.",
    tags: ["computer vision", "neuroscience", "visual cortex", "CNN", "architecture"],
    slug: "cnns-design-flaw-evolution",
    minutes: 15,
    contents: [
      "The Split You Did Not Know Was in Your Design",
      "The Dorsal Stream: Real-Time Spatial Inference",
      "The Ventral Stream: Hierarchical Object Recognition",
      "Implications for Computer Vision Engineering",
    ],
  },
  {
    title: "Temporal and Spatial Attention for 3D Pose Estimation",
    date: "2026-02-22",
    description: "How temporal and spatial attention mechanisms enable accurate 2D-to-3D human pose estimation, with a deep dive into DSTformer.",
    tags: ["pose estimation", "attention", "3D vision", "transformers"],
    slug: "temporal-spatial-attention-3d-pose",
    minutes: 6,
    contents: [
      "The Ill-Posed Problem: Lifting 2D to 3D",
      "Temporal Attention: Understanding Motion Over Time",
      "Spatial Attention: Maintaining Anatomical Consistency",
      "Fusion of Temporal and Spatial Streams",
    ],
  },
]).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

type Item =
  | { kind: 'essay'; date: string; title: string; description: string; href: string; image: string; minutes: number; tags: string[]; contents: string[] }
  | { kind: 'notebook'; date: string; title: string; description: string; href: string; image: string; minutes: number; tags: string[]; nb: (typeof notebooks)[number] };

const items: Item[] = [
  ...posts.map(p => ({
    kind: 'essay' as const, date: p.date, title: p.title, description: p.description,
    href: p.href || `/blog/${p.slug}`, image: `/images/blog/${p.slug}.jpg`,
    minutes: p.minutes, tags: p.tags, contents: p.contents,
  })),
  ...notebooks.map(nb => ({
    kind: 'notebook' as const, date: nb.endDate, title: nb.title, description: nb.description,
    href: `/notebooks/${nb.slug}`, image: `/images/blog/notebook-${nb.slug}.jpg`,
    minutes: nb.minutes, tags: nb.tags, nb,
  })),
].sort((a, b) => b.date.localeCompare(a.date));

// Topics worth filtering by: the ones that more than one piece shares.
/* A handful of plain topics, as on Thoughts, in place of the raw tags:
   each is the set of tags that mean it, and a piece belongs to every
   topic one of its tags falls under. */
const TOPICS: [string, string[]][] = [
  ['Vision', ['computer vision', '3D vision', 'pose estimation', 'visual cortex', 'OpenCV', 'sign language']],
  ['The brain', ['neuroscience', 'psychology', 'perception', 'visual cortex', 'autism']],
  ['Neural networks', ['deep learning', 'CNN', 'transformers', 'attention', 'LLMs']],
  ['Search & embeddings', ['embeddings', 'vector databases', 'similarity search', 'multimodal']],
  ['Probability & evaluation', ['probability', 'statistics', 'evaluation', 'ROC', 'AUC', 'PMF']],
];
const topicsOf = (tags: string[]) => TOPICS.filter(([, ts]) => ts.some(t => tags.includes(t))).map(([n]) => n);
const topics = TOPICS.map(([n]) => ({ name: n, count: items.filter(it => topicsOf(it.tags).includes(n)).length })).filter(t => t.count > 0);

const totalMinutes = items.reduce((n, it) => n + it.minutes, 0);
const totalDays = notebooks.reduce((n, nb) => n + nb.days.length, 0);

const fmt = (d: string, o: Intl.DateTimeFormatOptions) => new Date(d + 'T00:00:00').toLocaleDateString('en-US', o);
const short = (d: string) => fmt(d, { month: 'short', day: 'numeric' });
const years = [...new Set(items.map(it => it.date.slice(0, 4)))];
---

<Layout title={title} activeNav="/blog" description="Essays and day-by-day notebooks on computer vision, the brain and machine learning. Notes on things I finally understood, not tutorials." ogImage="/images/share-blog.jpg">
  <div class="blog-page free">
    <Mast
      label="Technical Blogs"
      aside={`${posts.length} essays · ${notebooks.length} notebooks`}
      title="Technical"
      accent="Blogs"
      lede="What I have learned about computer vision, the brain and machine learning, written down while I was learning it."
      figures={[
        { k: 'Essays', v: posts.length },
        { k: 'Notebooks', v: notebooks.length },
        { k: 'Days of notes', v: totalDays },
        { k: 'Hours of reading', v: (totalMinutes / 60).toFixed(1) },
      ]}
    >
      <details class="why">
          <summary>Why I write these</summary>
          <div class="why-body">
            <p>Transfer learning works in brains too. The prefrontal cortex builds schema, mental frameworks that compress patterns from one domain and apply them to another. The more domains you feed it, the richer the schema. Convolutions in V1 and convolutions in CNNs are the same idea discovered independently. Attention in the parietal cortex and attention in transformers solve the same resource allocation problem. These are not metaphors. They are convergent solutions.</p>
            <p>Leonardo studied anatomy to paint better and painted to understand anatomy better. Feynman learned to pick locks to understand information theory. Ramanujan found number theory in temple floor patterns. Cross-domain learning is not a distraction from depth. It is how depth actually works.</p>
            <p>The time box is the point. Retrieval under pressure consolidates memory faster than passive review, and the hippocampus encodes better when a session has a clear boundary. You cannot passively read for sixty minutes and pretend you understood it. You have to write what you know, find the gaps, and come back the next day to fill them.</p>
            <p>I am a Leonardo fanboy, not because I think I am smart like him because I am really not, but because the man had no formal education past age 14 and still taught himself anatomy and optics and geology and engineering from whatever books and mentors he could get his hands on, and that is the only way I have ever been able to learn anything either. He kept notebooks his entire life, thousands of pages, anatomy next to fluid dynamics next to machine designs, not organized by subject but by date, and he called himself "discepolo della esperienza" which means disciple of experience, and I think the notebook was never documentation for him, it was the actual thinking tool, the place where looking at something carefully enough turns into understanding it.</p>
          </div>
        </details>
    </Mast>

    <!-- The two kinds, said once, so the timeline needs no more explaining. -->
    <dl class="key">
      <div><dt><span class="mark essay"></span>Essay</dt><dd>A single post.</dd></div>
      <div><dt><span class="mark notebook"><i></i><i></i><i></i></span>Notebook</dt><dd>Daily notes on one topic, over a week or so.</dd></div>
    </dl>

    <!-- The same console as Thoughts: one line to search on, one row of topics. -->
    <div class="console">
      <div class="seek">
        <input type="text" id="search-input" placeholder={`Search ${items.length} essays and notebooks`} autocomplete="off" aria-label="Search the blogs" />
        <span class="seek-key" aria-hidden="true">/</span>
        <button type="button" class="seek-clear" id="seek-clear" aria-label="Clear search">Clear</button>
      </div>

      <p class="console-note" id="results-count"></p>

      <div class="themes">
        <span class="themes-name">Topics</span>
        <div class="theme-strip" id="theme-strip">
          {topics.map(t => (
            <button class="idx" data-tag={t.name} type="button">
              <span class="idx-name">{t.name}</span><span class="idx-n">{t.count}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="timeline" id="post-index">
      {years.map(year => (
        <section class="year" data-year={year}>
          <h2 class="year-head"><span class="year-n">{year}</span><span class="year-rule"></span><span class="year-c">{items.filter(it => it.date.startsWith(year)).length} pieces</span></h2>
          <ol class="rows">
            {items.filter(it => it.date.startsWith(year)).map(it => (
              <li class={`row ${it.kind}`} data-month={it.date.slice(0, 7)} data-tags={topicsOf(it.tags).join('|')}
                  data-text={[it.title, it.description, ...it.tags, ...topicsOf(it.tags), ...(it.kind === 'essay' ? it.contents : it.nb.days.map(d => d.title))].join(' ').toLowerCase()}>
                <time class="row-date" datetime={it.date}><span class="dd">{fmt(it.date, { month: 'short' })}</span><span class="mm">{it.date.slice(0, 4)}</span></time>
                <div class="row-body">
                  <div class="row-fig"><img src={it.image} alt="" width="1600" height="840" loading="lazy" decoding="async" /></div>
                  <p class="meta">
                    <span class="k">{it.kind === 'essay' ? 'Essay' : 'Notebook'}</span>
                    <span>{it.kind === 'essay' ? `${it.minutes} min read` : `${it.nb.days.length} days · ${it.minutes} min in all`}</span>
                  </p>
                  <h3><a href={it.href} class="stretch">{it.title}</a></h3>
                  <p class="desc">{it.description}</p>
                  {/* What it answers: revealed when you reach for the piece. */}
                  <div class="reveal"><ol class="inside">
                    {it.kind === 'essay'
                      ? it.contents.map((c, i) => <li style={`--i:${i}`}><span class="in-row"><span class="in-n">{String(i + 1).padStart(2, '0')}</span><span class="in-t">{c}</span></span></li>)
                      : it.nb.days.map((d, i) => (
                          <li style={`--i:${i}`}>{d.href
                            ? <a href={d.href}><span class="in-n">Day {d.day}</span><span class="in-t">{d.title}</span><span class="in-m">{d.minutes} min</span></a>
                            : <span class="off"><span class="in-n">Day {d.day}</span><span class="in-t">{d.title}</span></span>}</li>
                        ))}
                  </ol></div>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    <p class="no-results" id="no-results">Nothing on that topic yet.</p>
  </div>
</Layout>

<style>
  /* The longer reasoning stays folded until asked for. */
  .why {
    margin-top: var(--space-lg);
  }

  .why summary {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-text-muted);
    border-radius: 999px;
    user-select: none;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .why summary::-webkit-details-marker {
    display: none;
  }

  .why summary::before {
    content: '+';
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1;
    color: var(--color-accent);
  }

  .why[open] summary::before {
    content: '−';
  }

  .why summary:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .why-body {
    padding-top: var(--space-md);
    max-width: 66ch;
    border-left: 1px solid var(--color-border-light);
    padding-left: var(--space-md);
  }

  .why-body p {
    font-size: 1.12rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-md);
  }

  /* ── The console ───────────────────────────────────
     One line to type on and one index of themes. Nothing here is a
     widget: it is a ruled line and a page of set words. */
  .console {
    margin: 0 0 var(--space-2xl);
  }

  .seek {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    border-bottom: 1px solid var(--color-text);
    padding: 0.35rem 0 0.5rem;
    transition: border-color 0.2s ease;
  }

  .seek:focus-within {
    border-color: var(--color-accent);
  }

  #search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    outline: none;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3.4vw, 1.85rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--color-text);
    padding: 0;
  }

  #search-input::placeholder {
    font-style: italic;
    color: var(--color-text-muted);
    opacity: 0.75;
  }

  /* The one control on the right is the slash key while the line is empty
     and the way out of the search once it is not. */
  .seek-key {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 0.05rem 0.4rem;
    user-select: none;
    white-space: nowrap;
  }

  .seek-clear {
    display: none;
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    padding: 0;
    white-space: nowrap;
  }

  .seek-clear:hover {
    color: var(--color-accent);
  }

  .seek.has-value .seek-key {
    display: none;
  }

  .seek.has-value .seek-clear {
    display: block;
  }

  /* Say what is on screen in words. This page is not a dashboard. */
  .console-note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin: var(--space-sm) 0 0;
    min-height: 1.6em;
  }

  /* One strip, on one or two lines, that recounts itself against what is
     on screen. Nothing here is a list of everything that exists. */
  .themes {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .themes-name {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    white-space: nowrap;
    padding-top: 0.1rem;
  }

  .theme-strip {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1.3rem;
  }

  .idx {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 1.04rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    transition: color 0.14s ease, text-decoration-color 0.14s ease;
  }

  /* The figure rides above the word, the way a footnote mark does. It is
     the live count, so it moves while you type. */
  .idx-n {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
    opacity: 0.7;
    transform: translateY(-0.5em);
  }

  .idx:hover,
  .idx:focus-visible {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
    outline: none;
  }

  .idx:hover .idx-n,
  .idx:focus-visible .idx-n {
    color: var(--color-accent);
    opacity: 1;
  }

  .idx.active {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }

  .idx.active .idx-n {
    color: var(--color-accent);
    opacity: 1;
  }

  .idx.gone {
    display: none;
  }

  .idx-more {
    border: none;
    background: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    white-space: nowrap;
    transition: color 0.14s ease;
  }

  .idx-more:hover {
    color: var(--color-accent);
  }

  .idx-more:empty {
    display: none;
  }


  /* The same column as Thoughts and as wide as the essays' figures, centred. */
  .blog-page {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .small-label,
  .meta {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
  }

  .meta .k {
    color: var(--color-accent);
  }

  /* ── The key ──────────────────────────────────────── */
  .key {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0 0 var(--space-xl);
  }

  .key > div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-md);
  }

  .key dt {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .key dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  /* An essay is one block; a notebook is a run of days. */
  /* An essay is one dot; a notebook, a few, like days. */
  .mark {
    display: inline-flex;
    gap: 3px;
  }

  .mark.essay,
  .mark.notebook i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* ── The timeline ─────────────────────────────────── */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .year-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin: 0 0 var(--space-sm);
  }

  .year-n {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 200;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-text);
  }

  .year-rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
    align-self: center;
  }

  .year-c {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Every row the same: date, figure, words. */
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .row-date {
    position: sticky;
    top: 6.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding-top: 0.1rem;
    color: var(--color-text);
  }

  /* The month large and light in the margin, the year small beneath it;
     it rides along with its piece as you read, and lights up as you
     reach for it. */
  /* The rider carries the month; each piece's own label is kept only
     for a ranked search, where order is not by date. */
  .row-date {
    visibility: hidden;
  }

  /* The month marker that rides down the margin (built by the script). */
  :global(.month-rider) {
    position: sticky;
    top: 6.5rem;
    z-index: 2;
    width: 5.5rem;
    height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  :global(.month-rider.on) {
    opacity: 1;
  }

  :global(.month-rider .dd) {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  :global(.month-rider .mm) {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-left: 0.15rem;
  }

  :global(.month-rider.turn .dd),
  :global(.month-rider.turn .mm) {
    animation: month-turn 0.45s cubic-bezier(0.22, 0.8, 0.24, 1);
  }

  @keyframes month-turn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 760px) {
    :global(.month-rider) { display: none; }
  }

  .dd {
    font-family: var(--font-display);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text);
    font-variant-numeric: lining-nums;
    transition: color 0.3s ease, transform 0.4s cubic-bezier(0.34, 1.5, 0.5, 1);
  }

  .mm {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-left: 0.15rem;
  }

  .mm::after {
    content: '';
    display: block;
    width: 14px;
    height: 2px;
    margin-top: 0.45rem;
    border-radius: 2px;
    background: var(--color-accent);
    transform-origin: left;
    transform: scaleX(0.4);
    transition: transform 0.4s cubic-bezier(0.34, 1.5, 0.5, 1);
  }

  .row:hover .dd {
    color: var(--color-accent);
    transform: translateY(-3px);
  }

  .row:hover .mm::after {
    transform: scaleX(1.6);
  }

  .row-fig {
    margin-bottom: var(--space-md);
  }

  .row-fig img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
    box-shadow: 0 0 0 1px var(--color-border-light);
    transition: box-shadow 0.3s ease;
  }

  :global(html.dark) .row-fig img {
    box-shadow: none;
    filter: brightness(0.9);
  }

  .row:hover .row-fig img {
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .row h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0.4rem 0 0.35rem;
  }

  .row h3 a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .row:hover h3 a {
    color: var(--color-accent);
  }

  /* The whole row opens the piece; a notebook's days sit above it. */
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .desc {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 58ch;
  }

  /* What a piece answers, listed quietly under it. */
  /* Set like a note in the margin: a thin accent rule down its left,
     numbers small in the accent, the questions in the reading face. */
  .inside {
    list-style: none;
    max-width: 62ch;
    padding: 0 0 0 1rem;
    margin: 0.9rem 0 0;
    border-left: 1px solid var(--color-accent);
  }

  .inside .in-row,
  .inside .off,
  .inside a {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.22rem 0;
    color: inherit;
    text-decoration: none;
  }

  .in-n {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .in-t {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
  }

  .in-m {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .inside a:hover .in-t {
    color: var(--color-accent);
  }

  .inside .off {
    opacity: 0.5;
  }

  @media (max-width: 560px) {
    .inside .in-row,
    .inside .off,
    .inside a {
      grid-template-columns: 2.6rem minmax(0, 1fr) auto;
    }

    .in-t {
      font-size: 0.95rem;
    }
  }

  /* The list waits folded and opens smoothly when the piece is the one
     you are on: on a pointer, as you reach for it; on a phone, as it
     passes through the middle of the screen. Its lines arrive in turn. */
  .reveal {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s cubic-bezier(0.22, 0.8, 0.24, 1);
  }

  .reveal > .inside {
    min-height: 0;
    overflow: hidden;
    margin-top: 0;
  }

  .reveal {
    margin-top: 0.9rem;
  }

  .reveal .inside li {
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .row.near .reveal {
    grid-template-rows: 1fr;
  }

  .row.near .reveal .inside li {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i, 0) * 45ms + 80ms);
  }

  /* On phones: the same outlined pill as 'Why I write these'. */
  :global(.reveal-toggle) {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.9rem;
    padding: 0.55rem 1rem;
    min-height: 40px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    background: none;
    border: 1px solid var(--color-text-muted);
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  :global(.reveal-peek) {
    position: absolute;
    left: calc(100% + 0.9rem);
    top: 50%;
    max-width: 34ch;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-text-muted);
    opacity: 0;
    transform: translate(-6px, -50%);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  @media (hover: hover) {
    :global(.reveal-toggle):hover :global(.reveal-peek) {
      opacity: 1;
      transform: translate(0, -50%);
    }

    :global(.reveal-toggle):hover {
      color: var(--color-accent);
      border-color: var(--color-accent);
    }
  }

  .row.near :global(.reveal-peek) {
    display: none;
  }

  @media (hover: none), (max-width: 760px) {
    :global(.reveal-peek) {
      display: none;
    }
  }

  .row.near :global(.reveal-toggle) {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  :global(.reveal-toggle)::before {
    content: '+';
    font-size: 0.95rem;
    line-height: 1;
    color: var(--color-accent);
    transition: transform 0.3s ease;
  }

  .row.near :global(.reveal-toggle)::before {
    content: '−';
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal, .reveal .inside li { transition: none !important; }
  }

  .no-results {
    display: none;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-muted);
  }

  /* On a wide screen the figure becomes the ground of its piece: it fills
     the right of the row, full height, and dissolves into the paper toward
     the words, which sit over its fading edge. Reaching for the piece
     brings the figure into focus. */
  @media (min-width: 900px) {
    /* The row is as tall as the taller of its words and its figure: the
       words centred on the left, the figure whole beside them. */
    .row-body {
      display: grid;
      grid-template-columns: min(46%, 38rem) minmax(0, 1fr);
      grid-template-rows: 1fr auto auto auto 1fr auto;
      column-gap: var(--space-2xl);
      padding: var(--space-md) 0;
    }

    .row-body > :not(.row-fig) {
      grid-column: 1;
    }
    .row-body > :nth-child(2) { grid-row: 2; }
    .row-body > :nth-child(3) { grid-row: 3; }
    .row-body > :nth-child(4) { grid-row: 4; }

    .row-body > .row-fig {
      grid-column: 2;
      grid-row: 1 / 6;
      align-self: center;
      margin: 0;
    }

    .row-body > .row-fig img {
      display: block;
      width: 100%;
      height: auto;
      max-height: 34rem;
      object-fit: contain;
      object-position: left center;
      border-radius: 2px;
      box-shadow: none !important;
      mix-blend-mode: multiply;
      opacity: 1;
      transition: opacity 0.6s ease, box-shadow 0.8s ease, transform 1.4s cubic-bezier(0.22, 0.8, 0.24, 1), filter 0.6s ease;
    }

    :global(html.dark) .row-body > .row-fig img {
      mix-blend-mode: normal;
      opacity: 0.85;
    }


    /* What it covers runs beneath both, in two even columns. */
    .row-body > .reveal {
      grid-template-rows: 1fr;
      grid-column: 1 / -1;
      grid-row: 6;
    }

    .row-body > .reveal .inside {
      max-width: none;
      columns: 2;
      column-gap: var(--space-2xl);
      padding-left: 0;
      border-left: 0;
    }

    .row-body > .reveal .inside li {
      break-inside: avoid;
      padding-left: 1rem;
      border-left: 1px solid var(--color-accent);
    }

    .row-body > .reveal .inside li {
      opacity: 1;
      transform: none;
    }

    .row-body > :global(.reveal-toggle) {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    /* On a phone the year headings carry the time; no margin date. */
    .row-date {
      display: none;
    }

    .row-date {
      order: -1;
    }

    .key > div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .topics {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .row {
      padding-bottom: var(--space-lg);
    }
  }
</style>

<style is:global>
  .row.hidden,
  .year.hidden {
    display: none !important;
  }
</style>

<script is:inline>

/* One month marker rides down the margin beside the whole list, and turns
   to the next month as you cross into it, so a month's label stays with
   all of its pieces, not just the first. */
(function () {
  var list = document.getElementById('post-index');
  if (!list || matchMedia('(max-width: 760px)').matches) return;
  var rider = document.createElement('div');
  rider.className = 'month-rider';
  rider.setAttribute('aria-hidden', 'true');
  rider.innerHTML = '<span class="dd"></span><span class="mm"></span>';
  list.parentNode.insertBefore(rider, list);
  var dd = rider.querySelector('.dd'), mm = rider.querySelector('.mm'), shown = '', off = 0;
  var LINE = 140;
  function update() {
    var ranked = list.classList.contains('ranked');
    var rows = [].slice.call(list.querySelectorAll('[data-month]')).filter(function (r) {
      return !r.classList.contains('hidden') && r.offsetParent !== null;
    });
    // Sit level with the first piece (below the year heading) until it is
    // reached, then hold at the top: an offset on the marker's own content,
    // so no margin of the page around it is touched.
    if (rows.length) {
      off = Math.max(0, Math.round(rows[0].getBoundingClientRect().top + 28 - (rider.getBoundingClientRect().top - off)));
      rider.style.transform = 'translateY(' + off + 'px)';
    }
    var cur = null;
    for (var i = 0; i < rows.length; i++) {
      var b = rows[i].getBoundingClientRect();
      if (b.top <= LINE + 40) cur = rows[i];
      if (b.top > LINE + 40) break;
    }
    if (!cur && rows.length && rows[0].getBoundingClientRect().top < innerHeight) cur = rows[0];
    var first = rows.length ? rows[0].getBoundingClientRect().top : Infinity;
    rider.classList.toggle('on', !ranked && !!cur && first < innerHeight * 0.8);
    if (!cur) return;
    var label = cur.querySelector('time');
    var key = cur.dataset.month;
    if (key !== shown) {
      shown = key;
      rider.classList.remove('turn'); void rider.offsetWidth; rider.classList.add('turn');
      dd.textContent = label.querySelector('.dd').textContent;
      mm.textContent = label.querySelector('.mm').textContent;
    }
  }
  var queued = false;
  function queue() { if (!queued) { queued = true; requestAnimationFrame(function () { queued = false; update(); }); } }
  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', queue);
  new MutationObserver(queue).observe(list, { subtree: true, attributes: true, attributeFilter: ['class'], childList: true });
  update();
})();
/* Each list stays closed behind a small pill that opens it when clicked
   or tapped, and closes it again; reaching for the pill gives a glimpse
   of the first line inside. */
(function () {
  document.querySelectorAll('#post-index .row').forEach(function (r) {
    var list = r.querySelector('.reveal');
    if (!list) return;
    var n = list.querySelectorAll('li').length;
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'reveal-toggle';
    b.setAttribute('aria-expanded', 'false');
    b.textContent = n + (r.classList.contains('notebook') ? ' days' : ' sections');
    // A glimpse of what is inside, shown beside the pill as you reach for it.
    var first = list.querySelector('.in-t');
    if (first) {
      var peek = document.createElement('span');
      peek.className = 'reveal-peek';
      peek.textContent = first.textContent;
      b.appendChild(peek);
    }
    b.addEventListener('click', function () {
      var open = r.classList.toggle('near');
      b.setAttribute('aria-expanded', open);
    });
    list.parentNode.insertBefore(b, list);
  });
})();

(function () {
  var plates = [].slice.call(document.querySelectorAll('#post-index .row'));
  var years = document.querySelectorAll('#post-index .year');
  var chips = [].slice.call(document.querySelectorAll('#theme-strip .idx'));
  var empty = document.getElementById('no-results');
  var tag = null, query = [];
  var input = document.getElementById('search-input'), note = document.getElementById('results-count');
  var seek = input.closest('.seek'), clear = document.getElementById('seek-clear');

  // Every word typed must appear somewhere in the piece (a prefix is
  // enough: 'attent' finds attention); a topic narrows it further.
  function apply() {
    var shown = 0;
    plates.forEach(function (p) {
      var topical = !tag || p.dataset.tags.split('|').indexOf(tag) >= 0;
      var found = query.every(function (w) { return p.dataset.text.indexOf(w) >= 0; });
      var show = topical && found;
      p.classList.toggle('hidden', !show);
      if (show) shown++;
    });
    years.forEach(function (y) { y.classList.toggle('hidden', !y.querySelector('.row:not(.hidden)')); });
    var said = [];
    if (query.length) said.push('mentioning “' + input.value.trim() + '”');
    if (tag) said.push('on ' + tag);
    note.textContent = said.length ? shown + ' of ' + plates.length + ' ' + said.join(', ') : '';
    empty.style.display = shown ? 'none' : 'block';
  }

  input.addEventListener('input', function () {
    query = input.value.toLowerCase().split(/[^a-z0-9]+/).filter(function (w) { return w.length > 1; });
    seek.classList.toggle('has-value', input.value.length > 0);
    apply();
  });
  clear.addEventListener('click', function () {
    input.value = ''; query = []; seek.classList.remove('has-value'); apply(); input.focus();
  });

  // '/' jumps to the search, as on Thoughts.
  addEventListener('keydown', function (e) {
    if (e.key === '/' && document.activeElement !== input && !/input|textarea/i.test(document.activeElement.tagName)) {
      e.preventDefault(); input.focus();
    }
  });

  chips.forEach(function (c) {
    c.addEventListener('click', function () {
      tag = tag === c.dataset.tag ? null : c.dataset.tag;
      chips.forEach(function (o) { o.classList.toggle('active', o.dataset.tag === tag); });
      apply();
    });
  });
})();
</script>
