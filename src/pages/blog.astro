---
import Layout from '../layouts/Layout.astro';

const title = "Technical Blogs — Arshad Kazi";

const posts = ([
  {
    title: "Probability Mass Functions, Expectation, and Variance",
    date: "2023-11-15",
    description: "Relearning probability from a machine learning perspective. What PMFs are, how to compute expectation and variance from first principles, and why any of this matters for ML.",
    tags: ["probability", "statistics", "PMF", "machine learning", "fundamentals"],
    slug: "probability-mass-function",
  },
  {
    title: "ROC Curves and AUC: Picking the Right Threshold for Your Model",
    date: "2024-02-01",
    description: "Why accuracy fails on skewed data, how confusion matrices work, and how to use ROC curves and AUC to evaluate and compare probabilistic classifiers.",
    tags: ["machine learning", "evaluation", "ROC", "AUC", "classification"],
    slug: "roc-curve-auc",
  },
  {
    title: "Building a Sign Language Recognition System with CNNs and OpenCV",
    date: "2024-03-10",
    description: "A practical walkthrough of building a real-time ASL alphabet recogniser. Dataset, CNN architecture with the actual math, and live webcam inference using OpenCV.",
    tags: ["computer vision", "CNN", "sign language", "OpenCV", "keras", "deep learning"],
    slug: "sign-language-recognition-using-cnn-and-opencv",
    href: "/sign-language-recognition-using-cnn-and-opencv",
  },
  {
    title: "Vector Database Management Systems: Architecture and Internals",
    date: "2024-01-15",
    description: "A technical overview of how Vector Database Management Systems work, covering vectorization, indexing, hardware tradeoffs, and the core challenges in building systems that search by meaning rather than exact match.",
    tags: ["vector databases", "VDBMS", "embeddings", "similarity search", "machine learning systems"],
    slug: "vector-databases-vdbms",
  },
  {
    title: "The Visual Cortex as a Computer Vision Architecture: Dorsal and Ventral Streams",
    date: "2026-04-05",
    description: "How the brain's visual cortex uses two parallel streams, feedback loops, and relative perception to process vision. Everything rewritten for engineers who build vision systems.",
    tags: ["computer vision", "neuroscience", "visual cortex", "CNN", "architecture"],
    slug: "cnns-design-flaw-evolution",
  },
  {
    title: "Temporal and Spatial Attention for 3D Pose Estimation",
    date: "2026-02-22",
    description: "How temporal and spatial attention mechanisms enable accurate 2D-to-3D human pose estimation, with a deep dive into DSTformer.",
    tags: ["pose estimation", "attention", "3D vision", "transformers"],
    slug: "temporal-spatial-attention-3d-pose",
  },
]).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const allTags = [...new Set(posts.flatMap(p => p.tags))].sort();

// Group posts by year so the index is scannable.
const years = [...new Set(posts.map(p => p.date.slice(0, 4)))];
const grouped = years.map(year => ({
  year,
  items: posts.filter(p => p.date.slice(0, 4) === year),
}));

function shortDate(dateStr: string): string {
  const date = new Date(dateStr + 'T00:00:00');
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}
---

<Layout title={title} activeNav="/blog" description="Technical deep dives on computer vision, 3D understanding, and ML. Notes on things I finally understood, not tutorials.">
  <div class="blog-page">
    <div class="folio-rule">
      <span class="folio-mark">Technical Blogs</span>
      <span class="folio-line"></span>
      <span class="folio-mark">{posts.length} essays</span>
    </div>

    <div class="blog-intro">
      <h1>Technical Blogs</h1>
      <p>
        Deep dives into computer vision, geometry, and 3D understanding. Not tutorials, just my notes on things I finally understood.
      </p>
    </div>

    <div class="filters">
      <div class="search-bar">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="search-input" placeholder="Search posts" autocomplete="off" />
      </div>

      <details class="topics">
        <summary>Browse by topic<span class="topic-count">{allTags.length}</span></summary>
        <div class="tag-filters" id="tag-filters">
          {allTags.map(tag => (
            <button class="tag-chip" data-tag={tag}>{tag}</button>
          ))}
        </div>
      </details>
    </div>

    <p class="results-count" id="results-count"></p>

    <div class="post-index" id="post-index">
      {grouped.map(group => (
        <section class="year-group" data-year={group.year}>
          <h2 class="year-label">{group.year}</h2>
          <ul class="entry-list">
            {group.items.map(post => (
              <li class="entry" data-title={post.title.toLowerCase()} data-description={post.description.toLowerCase()} data-tags={post.tags.join(',')}>
                <a href={post.href || `/blog/${post.slug}`}>
                  <time datetime={post.date}>{shortDate(post.date)}</time>
                  <h3>{post.title}</h3>
                  <p>{post.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p class="no-results" id="no-results">No posts match that search.</p>
  </div>
</Layout>

<style>
  .blog-page {
    display: flex;
    flex-direction: column;
  }

  /* ── Folio rule ────────────────────────────────────── */
  .folio-rule {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .folio-mark {
    font-family: var(--font-serif);
    font-variant: small-caps;
    font-style: normal;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    text-transform: none;

    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .folio-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  /* ── Intro ─────────────────────────────────────────── */
  .blog-intro {
    margin-bottom: var(--space-xl);
  }

  .blog-intro h1 {
    font-size: 2rem;
    margin-bottom: var(--space-sm);
  }

  .blog-intro p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.17rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 54ch;
    margin: 0;
  }

  /* ── Filters ───────────────────────────────────────── */
  .filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .search-bar {
    position: relative;
    max-width: 340px;
  }

  .search-icon {
    position: absolute;
    left: 11px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  #search-input {
    width: 100%;
    padding: 0.5rem 0.75rem 0.5rem 2.1rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  #search-input:focus {
    border-color: var(--color-accent);
  }

  #search-input::placeholder {
    color: var(--color-text-muted);
  }

  /* Topic list stays folded away until asked for. */
  .topics summary {
    font-family: var(--font-serif);
    font-variant: small-caps;
    font-style: normal;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    text-transform: none;

    color: var(--color-text-muted);
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0;
    user-select: none;
  }

  .topics summary::-webkit-details-marker {
    display: none;
  }

  .topics summary::before {
    content: '+';
    font-size: 0.85rem;
    line-height: 1;
    color: var(--color-text-muted);
  }

  .topics[open] summary::before {
    content: '−';
  }

  .topics summary:hover {
    color: var(--color-accent);
  }

  .topic-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  .tag-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    padding-top: var(--space-sm);
  }

  .tag-chip {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 400;
    background: transparent;
    color: var(--color-text-muted);
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    border: 1px solid var(--color-border);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .tag-chip:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .tag-chip.active {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
  }

  /* ── Index ─────────────────────────────────────────── */
  .post-index {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .year-group {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: var(--space-md);
  }

  .year-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    margin: 0;
    padding-top: 0.55rem;
  }

  .entry-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .entry {
    margin: 0;
    border-top: 1px solid var(--color-border-light);
  }

  .entry:first-child {
    border-top: none;
  }

  .entry a {
    display: block;
    padding: var(--space-md) 0;
    text-decoration: none;
    color: inherit;
  }

  .entry a:hover {
    text-decoration: none;
  }

  .entry time {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin-bottom: 0.35rem;
  }

  /* The title is the one thing that should catch the eye. */
  .entry h3 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text);
    margin: 0 0 0.35rem 0;
    transition: color 0.15s ease;
  }

  .entry a:hover h3 {
    color: var(--color-accent);
  }

  .entry p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.12rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 62ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .results-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-md) 0;
  }

  .results-count:empty {
    display: none;
  }

  .no-results {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--color-text-muted);
    padding: var(--space-xl) 0;
    margin: 0;
    display: none;
  }

  @media (max-width: 600px) {
    .year-group {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .year-label {
      padding-top: 0;
    }

    .entry h3 {
      font-size: 1.2rem;
    }
  }
</style>

<style is:global>
  .entry.hidden,
  .year-group.hidden {
    display: none !important;
  }
</style>

<script is:inline>
(function() {
  const input = document.getElementById('search-input');
  const index = document.getElementById('post-index');
  const entries = index.querySelectorAll('.entry');
  const groups = index.querySelectorAll('.year-group');
  const chips = document.querySelectorAll('.tag-chip');
  const counter = document.getElementById('results-count');
  const empty = document.getElementById('no-results');
  let activeTag = null;

  function filter() {
    const q = input.value.toLowerCase().trim();
    let visible = 0;

    entries.forEach(entry => {
      const matchesText = !q
        || entry.dataset.title.includes(q)
        || entry.dataset.description.includes(q)
        || entry.dataset.tags.includes(q);
      const matchesTag = !activeTag || entry.dataset.tags.split(',').includes(activeTag);
      const show = matchesText && matchesTag;
      entry.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    // Drop a year heading entirely when nothing under it survived.
    groups.forEach(group => {
      const anyVisible = group.querySelector('.entry:not(.hidden)');
      group.classList.toggle('hidden', !anyVisible);
    });

    counter.textContent = (q || activeTag)
      ? visible + ' of ' + entries.length + ' posts'
      : '';
    empty.style.display = visible === 0 ? 'block' : 'none';
  }

  input.addEventListener('input', filter);

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const tag = chip.dataset.tag;
      if (activeTag === tag) {
        activeTag = null;
        chip.classList.remove('active');
      } else {
        chips.forEach(c => c.classList.remove('active'));
        activeTag = tag;
        chip.classList.add('active');
      }
      filter();
    });
  });
})();
</script>
