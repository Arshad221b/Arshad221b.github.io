---
/* Blogs: the essays and the notebooks, on one page.

   Set like a journal's contents, in one column, every piece built the same
   way: its figure, what it is and how long it takes, its title and what it
   asks, and then what is inside, numbered (an essay's sections, a
   notebook's days, each day its own link).

   An essay is one piece, read in one sitting. A notebook is a thread of
   short days on one question, each day its own short read. They share a
   single list, newest first, with every reading time stated. */

import Layout from '../layouts/Layout.astro';
import Mast from '../components/Mast.astro';
import { notebooks } from '../lib/notebooks';

const title = "Technical Blogs — Arshad Kazi";

// `contents` mirrors the section headings inside each post, so the index says
// what a post actually covers instead of making you open it to find out.
const posts = ([
  {
    title: "Probability Mass Functions, Expectation, and Variance",
    date: "2023-11-15",
    description: "Relearning probability from a machine learning perspective. What PMFs are, how to compute expectation and variance from first principles, and why any of this matters for ML.",
    tags: ["probability", "statistics", "PMF", "machine learning", "fundamentals"],
    slug: "probability-mass-function",
    minutes: 5,
    contents: [
      "What is Probability?",
      "Probability Distribution",
      "Probability Mass Function",
      "Expected Value (Expectation)",
      "Variance",
      "Why does any of this matter for ML?",
    ],
  },
  {
    title: "ROC Curves and AUC: Picking the Right Threshold for Your Model",
    date: "2024-02-01",
    description: "Why accuracy fails on skewed data, how confusion matrices work, and how to use ROC curves and AUC to evaluate and compare probabilistic classifiers.",
    tags: ["machine learning", "evaluation", "ROC", "AUC", "classification"],
    slug: "roc-curve-auc",
    minutes: 5,
    contents: [
      "Why Accuracy Is Not Enough",
      "True Positive, True Negative, False Positive, False Negative",
      "Confusion Matrix",
      "ROC Curve",
      "AUC (Area Under the Curve)",
    ],
  },
  {
    title: "Building a Sign Language Recognition System with CNNs and OpenCV",
    date: "2024-03-10",
    description: "A practical walkthrough of building a real-time ASL alphabet recogniser. Dataset, CNN architecture with the actual math, and live webcam inference using OpenCV.",
    tags: ["computer vision", "CNN", "sign language", "OpenCV", "keras", "deep learning"],
    slug: "sign-language-recognition-using-cnn-and-opencv",
    href: "/sign-language-recognition-using-cnn-and-opencv",
    minutes: 5,
    contents: [
      "Dataset",
      "Build and Train the Model",
      "OpenCV",
    ],
  },
  {
    title: "Vector Database Management Systems: Architecture and Internals",
    date: "2024-01-15",
    description: "A technical overview of how Vector Database Management Systems work, covering vectorization, indexing, hardware tradeoffs, and the core challenges in building systems that search by meaning rather than exact match.",
    tags: ["vector databases", "VDBMS", "embeddings", "similarity search", "machine learning systems"],
    slug: "vector-databases-vdbms",
    minutes: 6,
    contents: [
      "What is a Vector Database?",
      "Why Not a Regular Database?",
      "General Architecture of a VDBMS",
      "Use Cases",
      "Challenges and Limitations",
    ],
  },
  {
    title: "The Visual Cortex as a Computer Vision Architecture: Dorsal and Ventral Streams",
    date: "2026-04-05",
    description: "How the brain's visual cortex uses two parallel streams, feedback loops, and relative perception to process vision. Everything rewritten for engineers who build vision systems.",
    tags: ["computer vision", "neuroscience", "visual cortex", "CNN", "architecture"],
    slug: "cnns-design-flaw-evolution",
    minutes: 15,
    contents: [
      "The Split You Did Not Know Was in Your Design",
      "The Dorsal Stream: Real-Time Spatial Inference",
      "The Ventral Stream: Hierarchical Object Recognition",
      "Implications for Computer Vision Engineering",
    ],
  },
  {
    title: "Temporal and Spatial Attention for 3D Pose Estimation",
    date: "2026-02-22",
    description: "How temporal and spatial attention mechanisms enable accurate 2D-to-3D human pose estimation, with a deep dive into DSTformer.",
    tags: ["pose estimation", "attention", "3D vision", "transformers"],
    slug: "temporal-spatial-attention-3d-pose",
    minutes: 6,
    contents: [
      "The Ill-Posed Problem: Lifting 2D to 3D",
      "Temporal Attention: Understanding Motion Over Time",
      "Spatial Attention: Maintaining Anatomical Consistency",
      "Fusion of Temporal and Spatial Streams",
    ],
  },
]).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

type Item =
  | { kind: 'essay'; date: string; title: string; description: string; href: string; image: string; minutes: number; tags: string[]; contents: string[] }
  | { kind: 'notebook'; date: string; title: string; description: string; href: string; image: string; minutes: number; tags: string[]; nb: (typeof notebooks)[number] };

const items: Item[] = [
  ...posts.map(p => ({
    kind: 'essay' as const, date: p.date, title: p.title, description: p.description,
    href: p.href || `/blog/${p.slug}`, image: `/images/blog/${p.slug}.jpg`,
    minutes: p.minutes, tags: p.tags, contents: p.contents,
  })),
  ...notebooks.map(nb => ({
    kind: 'notebook' as const, date: nb.endDate, title: nb.title, description: nb.description,
    href: `/notebooks/${nb.slug}`, image: `/images/blog/notebook-${nb.slug}.jpg`,
    minutes: nb.minutes, tags: nb.tags, nb,
  })),
].sort((a, b) => b.date.localeCompare(a.date));

// Topics worth filtering by: the ones that more than one piece shares.
const tagCount = new Map<string, number>();
items.forEach(it => it.tags.forEach(t => tagCount.set(t, (tagCount.get(t) ?? 0) + 1)));
const topics = [...tagCount].filter(([, n]) => n > 1).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([t]) => t);

const totalMinutes = items.reduce((n, it) => n + it.minutes, 0);
const totalDays = notebooks.reduce((n, nb) => n + nb.days.length, 0);

const fmt = (d: string, o: Intl.DateTimeFormatOptions) => new Date(d + 'T00:00:00').toLocaleDateString('en-US', o);
const short = (d: string) => fmt(d, { month: 'short', day: 'numeric' });
---

<Layout title={title} activeNav="/blog" description="Essays and day-by-day notebooks on computer vision, the brain and machine learning. Notes on things I finally understood, not tutorials." ogImage="/images/share-blog.jpg">
  <div class="blog-page">
    <Mast
      label="Technical Blogs"
      aside={`${posts.length} essays · ${notebooks.length} notebooks`}
      title="Technical"
      accent="Blogs"
      lede="What I have learned about computer vision, the brain and machine learning, written down while I was learning it."
      figures={[
        { k: 'Essays', v: posts.length },
        { k: 'Notebooks', v: notebooks.length },
        { k: 'Days of notes', v: totalDays },
        { k: 'Hours of reading', v: (totalMinutes / 60).toFixed(1) },
      ]}
    />

    <div class="shelf-head">
      <p class="small-label">Topics</p>
      <div class="tag-filters" id="tag-filters">
        {topics.map(tag => <button type="button" class="tag-chip" data-tag={tag}>{tag}</button>)}
      </div>
    </div>

    <ul class="plates" id="post-index">
      {items.map(it => (
        <li class={`plate ${it.kind}`} data-tags={it.tags.join('|')}>
          <div class="plate-fig"><img src={it.image} alt="" width="1600" height="840" loading="lazy" decoding="async" /></div>
          <p class="meta">
            <span class="k">{it.kind === 'essay' ? 'Essay' : 'Notebook'}</span>
            <span>{it.kind === 'essay' ? `${it.minutes} min read` : `${it.nb.days.length} days · ${it.minutes} min`}</span>
            <time datetime={it.date}>{fmt(it.date, { month: 'long', year: 'numeric' })}</time>
          </p>
          <h3><a href={it.href} class="stretch">{it.title}</a></h3>
          <p class="desc">{it.description}</p>
          <ol class="inside">
            {it.kind === 'essay'
              ? it.contents.map((c, i) => <li><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="t">{c}</span></li>)
              : it.nb.days.map(d => (
                  <li>{d.href
                    ? <a href={d.href}><span class="n">{String(d.day).padStart(2, '0')}</span><span class="t">{d.title}</span><span class="m">{d.minutes} min</span></a>
                    : <span class="off"><span class="n">{String(d.day).padStart(2, '0')}</span><span class="t">{d.title}</span></span>}</li>
                ))}
          </ol>
        </li>
      ))}
    </ul>

    <p class="no-results" id="no-results">Nothing on that topic yet.</p>
  </div>
</Layout>

<style>
  .blog-page {
    display: flex;
    flex-direction: column;
  }

  .small-label,
  .meta {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
  }

  .meta .k {
    color: var(--color-accent);
  }

  .n {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    padding-top: 0.25rem;
    flex: none;
  }

  .plate-fig img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
    box-shadow: 0 0 0 1px var(--color-border-light);
    transition: box-shadow 0.35s ease;
  }

  :global(html.dark) .plate-fig img {
    box-shadow: none;
    filter: brightness(0.9);
  }

  .plate h3 a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .plate:hover h3 a {
    color: var(--color-accent);
  }

  .desc {
    font-family: var(--font-serif);
    font-size: 1.06rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Everything else ──────────────────────────────── */
  .shelf-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    margin-bottom: var(--space-xl);
  }

  .tag-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.9rem;
  }

  .tag-chip {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    background: none;
    border: none;
    padding: 0.05rem 0;
    color: var(--color-text-secondary);
    cursor: pointer;
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: color 0.2s ease, background-size 0.35s var(--ease-out);
  }

  .tag-chip:hover,
  .tag-chip.active {
    color: var(--color-accent);
    background-size: 100% 1px;
  }

  .plates {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xl);
    padding: 0;
    margin: 0;
  }

  .plate {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .plate-fig {
    margin-bottom: 0.35rem;
    overflow: hidden;
    border-radius: 2px;
  }

  .plate:hover .plate-fig img {
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .plate h3 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.2vw, 2.15rem);
    font-weight: 300;
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* The whole plate is the link; the days sit above it, each its own. */
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .plate .desc {
    max-width: 62ch;
  }

  .plate + .plate {
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  /* What is inside, the same for every piece: numbered rows on hairlines. */
  .inside {
    position: relative;
    z-index: 1;
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    border-top: 1px solid var(--color-border);
  }

  .inside li {
    border-bottom: 1px solid var(--color-border-light);
  }

  .inside li > span,
  .inside a,
  .inside .off {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) auto;
    gap: var(--space-sm);
    align-items: baseline;
    padding: 0.55rem 0;
    color: inherit;
    text-decoration: none;
  }

  .inside .n {
    padding-top: 0;
  }

  .inside .t {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
  }

  .inside .m {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .inside a:hover .t {
    color: var(--color-accent);
  }

  .inside .off {
    opacity: 0.5;
  }

  .no-results {
    display: none;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-muted);
  }

  @media (max-width: 760px) {
    .shelf-head {
      flex-direction: column;
      gap: var(--space-sm);
    }
  }
</style>

<style is:global>
  .plate.hidden {
    display: none !important;
  }
</style>

<script is:inline>
(function () {
  var plates = [].slice.call(document.querySelectorAll('#post-index .plate'));
  var chips = [].slice.call(document.querySelectorAll('.tag-chip'));
  var empty = document.getElementById('no-results');
  var tag = null;

  function apply() {
    var shown = 0;
    plates.forEach(function (p) {
      var show = !tag || p.dataset.tags.split('|').indexOf(tag) >= 0;
      p.classList.toggle('hidden', !show);
      if (show) shown++;
    });
    empty.style.display = shown ? 'none' : 'block';
  }

  chips.forEach(function (c) {
    c.addEventListener('click', function () {
      tag = tag === c.dataset.tag ? null : c.dataset.tag;
      chips.forEach(function (o) { o.classList.toggle('active', o.dataset.tag === tag); });
      apply();
    });
  });
})();
</script>
