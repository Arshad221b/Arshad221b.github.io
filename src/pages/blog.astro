---
import { img, share } from '../lib/media';
import SketchPlate from '../components/SketchPlate.astro';
/* Blogs: the essays and the notebooks, on one page.

   One timeline, newest first, under clear year headings. Every piece is the
   same row: its date in the margin, its figure at full width, what it is,
   its title and what it asks.
   The one difference is the honest one: an essay is a single piece, a
   notebook is a run of days, and its row lists them quietly, each a link.

   An essay is one piece, read in one sitting. A notebook is a thread of
   short days on one question, each day its own short read. They share a
   single list, newest first, with every reading time stated. */

import Layout from '../layouts/Layout.astro';
import { wordsIn } from '../lib/text';

import { notebooks } from '../lib/notebooks';

/* Words in each essay, from its own source: markup, code and maths out. */
const essaySources = import.meta.glob(['./blog/*.astro', './sign-language-recognition-using-cnn-and-opencv.astro'], { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const essayWords: Record<string, number> = Object.fromEntries(Object.entries(essaySources).map(([path, raw]) =>
  [path.split('/').pop()!.replace('.astro', ''), wordsIn(raw)]));
const totalWords = Object.values(essayWords).reduce((a, b) => a + b, 0) + notebooks.reduce((a, nb) => a + nb.words, 0);
const wordsLabel = (n: number) => (n > 0 ? `${n.toLocaleString('en-US')} words · ` : '');

// At the head of the page, in particles of ink: Leonardo's flight, water and
// the measured body, Michelangelo's figures and plan, Palladio's villa and
// Piranesi's impossible space.
const sketches = ['contact/flying', 'blog-bg/ramanujan-master-theorem', 'india/kailasa', 'blog-bg/al-sufi-ursa-major', 'blog-bg/lilavati', 'blog-bg/al-jazari-elephant-clock', 'india/bakhshali', 'contact/vitruvian', 'india/lahore-astrolabe', 'india/taj-site-plan', 'blog-bg/hooke-flea', 'india/aryabhata', 'india/dilwara', 'blog-bg/cajal', 'blog-bg/vesalius', 'blog-bg/galileo-moon', 'blog-bg/kepler', 'blog-bg/darwin-tree', 'blog-bg/haeckel', 'blog-bg/wright', 'blog-bg/tulp', 'india/great-bath', 'india/harappan-weights', 'india/dholavira', 'india/iron-pillar', 'india/chand-baori', 'india/konark-wheel', 'india/jantar-mantar', 'india/misra-yantra', 'india/ujjain-observatory']
  .map(n => img(`/images/${n}.jpg`, 1600));
const credits = [{"title": "Design for a flying machine, c. 1488", "by": "Leonardo da Vinci · Milan", "india": false, "note": "Leonardo's ornithopter: a pilot pumping wings, designed from watching birds.", "open": true}, {"title": "The Master Theorem, c. 1913", "by": "Srinivasa Ramanujan · Madras", "india": true, "note": "A page from Ramanujan's notebooks; the master theorem turns a series into an integral."}, {"title": "Kailasa Temple, c. 760 (drawn 1915)", "by": "Rashtrakuta builders · Ellora", "india": true, "note": "Carved downward from a single hill of basalt: the largest monolithic structure ever cut.", "open": true}, {"title": "Book of Fixed Stars: Ursa Major, 964", "by": "Abd al-Rahman al-Sufi · Isfahan", "india": false, "note": "Ptolemy's star catalogue checked against the sky, with the first recorded sighting of Andromeda.", "open": true}, {"title": "Līlāvatī, c. 1150", "by": "Bhāskara II · Ujjain", "india": true, "note": "Bhāskara's arithmetic, posed as problems to a girl named Līlāvatī; taught across India for centuries."}, {"title": "The Elephant Clock, 1206", "by": "Ismail al-Jazari · Diyarbakır", "india": false, "note": "A water clock driven by a sinking float, marking each half hour with automata.", "open": true}, {"title": "Bakhshali manuscript, c. 3rd–4th century", "by": "Unknown mathematicians · Bakhshali", "india": true, "note": "Birch-bark arithmetic with an early written zero and a square-root method still used today."}, {"title": "Vitruvian Man, c. 1490", "by": "Leonardo da Vinci · Milan", "india": false, "note": "The body inscribed in a circle and a square: Vitruvius's proportions tested by measurement.", "open": true}, {"title": "Astrolabe, 1666", "by": "Jamal al-Din ibn Muqim · Lahore", "india": true, "note": "An analog computer for the sky: star positions, time and latitude, from Lahore's instrument makers."}, {"title": "Taj Mahal, site plan, 1632–53", "by": "Ustad Ahmad Lahauri · Agra", "india": true, "note": "The Taj complex as a grid of squares and axes: Mughal geometry laid out at the scale of a city block.", "open": true}, {"title": "Micrographia: the flea, 1665", "by": "Robert Hooke · London", "india": false, "note": "From the first great book of microscopy: a flea drawn at a size nobody had seen before."}, {"title": "Aryabhata, 476–550", "by": "Statue at IUCAA · Pune", "india": true, "note": "Aryabhata gave π to four decimals and said the Earth turns on its axis, in 499 CE."}, {"title": "Dilwara Temples, ceiling, 11th–13th century", "by": "Jain craftsmen · Mount Abu", "india": true, "note": "A marble ceiling carved into concentric rings of near-transparent lace by Jain craftsmen."}, {"title": "Purkinje cell, 1899", "by": "Santiago Ramón y Cajal · Madrid", "india": false, "note": "Cajal saw that the brain is made of separate cells; his neurons are still the textbook drawings.", "open": true}, {"title": "De humani corporis fabrica, 1543", "by": "Andreas Vesalius · Padua", "india": false, "note": "Anatomy from dissection rather than authority: Vesalius corrected Galen by looking.", "open": true}, {"title": "Sidereus Nuncius: the Moon, 1610", "by": "Galileo Galilei · Padua", "india": false, "note": "Through a telescope he built himself, Galileo saw the Moon has mountains and shadows.", "open": true}, {"title": "Mysterium Cosmographicum, 1596", "by": "Johannes Kepler · Graz", "india": false, "note": "Kepler's attempt to fit the planets' orbits between the five Platonic solids: wrong, and productive.", "open": true}, {"title": "I think: the tree of life, 1837", "by": "Charles Darwin · London", "india": false, "note": "'I think', then a branching tree: Darwin's first sketch of common descent, in a notebook.", "open": true}, {"title": "Kunstformen der Natur: Phaeodaria, 1904", "by": "Ernst Haeckel · Jena", "india": false, "note": "Microscopic plankton drawn by Haeckel, whose plates made biology's symmetries visible.", "open": true}, {"title": "First flight, 17 December 1903", "by": "John T. Daniels · Kitty Hawk", "india": false, "note": "Twelve seconds, 37 metres: the first controlled, powered flight, photographed as it lifted."}, {"title": "The Anatomy Lesson of Dr Tulp, 1632", "by": "Rembrandt van Rijn · Amsterdam", "india": false, "note": "A public dissection in Amsterdam: knowledge as something you open up and show."}, {"title": "Mohenjo-daro, c. 2500 BCE", "by": "Harappan builders · Mohenjo-daro", "india": true, "note": "A planned city on a grid, with standard bricks, covered drains and the Great Bath."}, {"title": "Indus weights, c. 2500 BCE", "by": "Harappan craftsmen · Mohenjo-daro", "india": true, "note": "Polished chert cubes in a binary-then-decimal series: one standard of weight across a civilisation."}, {"title": "Dholavira reservoir, c. 2500 BCE", "by": "Harappan engineers · Dholavira", "india": true, "note": "Stone-cut reservoirs that caught every monsoon, in a city built on the edge of a salt desert."}, {"title": "Iron Pillar, c. 400 CE (photographed 1858)", "by": "Gupta metallurgists · Delhi", "india": true, "note": "Six tonnes of wrought iron that has barely rusted in sixteen centuries."}, {"title": "Chand Baori, 9th century", "by": "Nikumbha builders · Abhaneri", "india": true, "note": "3,500 steps in perfect symmetry, thirteen storeys down to groundwater."}, {"title": "Konark wheel, 13th century", "by": "Eastern Ganga sculptors · Konark", "india": true, "note": "One of 24 stone wheels on the Sun Temple; its spokes cast shadows that tell the time."}, {"title": "Jantar Mantar, 1734", "by": "Sawai Jai Singh II · Jaipur", "india": true, "note": "Instruments the size of buildings, so stone could measure the sky to two seconds of time."}, {"title": "Misra Yantra, 1724", "by": "Sawai Jai Singh II · Delhi", "india": true, "note": "Five instruments in one, reading noon at observatories across the world."}, {"title": "Vedh Shala, 1725", "by": "Sawai Jai Singh II · Ujjain", "india": true, "note": "Built on the meridian Indian astronomers used as their prime meridian for over a thousand years."}];
const title = "Technical Blogs — Arshad Kazi";

// `contents` mirrors the section headings inside each post, so the index says
// what a post actually covers instead of making you open it to find out.
const posts = ([
  {
    title: "Probability Mass Functions, Expectation, and Variance",
    date: "2023-11-15",
    description: "Relearning probability from a machine learning perspective. What PMFs are, how to compute expectation and variance from first principles, and why any of this matters for ML.",
    tags: ["probability", "statistics", "PMF", "machine learning", "fundamentals"],
    slug: "probability-mass-function",
    minutes: 5,
    contents: [
      "What is Probability?",
      "Probability Distribution",
      "Probability Mass Function",
      "Expected Value (Expectation)",
      "Variance",
      "Why does any of this matter for ML?",
    ],
  },
  {
    title: "ROC Curves and AUC: Picking the Right Threshold for Your Model",
    date: "2024-02-01",
    description: "Why accuracy fails on skewed data, how confusion matrices work, and how to use ROC curves and AUC to evaluate and compare probabilistic classifiers.",
    tags: ["machine learning", "evaluation", "ROC", "AUC", "classification"],
    slug: "roc-curve-auc",
    minutes: 5,
    contents: [
      "Why Accuracy Is Not Enough",
      "True Positive, True Negative, False Positive, False Negative",
      "Confusion Matrix",
      "ROC Curve",
      "AUC (Area Under the Curve)",
    ],
  },
  {
    title: "Building a Sign Language Recognition System with CNNs and OpenCV",
    date: "2024-03-10",
    description: "A practical walkthrough of building a real-time ASL alphabet recogniser. Dataset, CNN architecture with the actual math, and live webcam inference using OpenCV.",
    tags: ["computer vision", "CNN", "sign language", "OpenCV", "keras", "deep learning"],
    slug: "sign-language-recognition-using-cnn-and-opencv",
    href: "/sign-language-recognition-using-cnn-and-opencv",
    minutes: 5,
    contents: [
      "Dataset",
      "Build and Train the Model",
      "OpenCV",
    ],
  },
  {
    title: "Vector Database Management Systems: Architecture and Internals",
    date: "2024-01-15",
    description: "A technical overview of how Vector Database Management Systems work, covering vectorization, indexing, hardware tradeoffs, and the core challenges in building systems that search by meaning rather than exact match.",
    tags: ["vector databases", "VDBMS", "embeddings", "similarity search", "machine learning systems"],
    slug: "vector-databases-vdbms",
    minutes: 6,
    contents: [
      "What is a Vector Database?",
      "Why Not a Regular Database?",
      "General Architecture of a VDBMS",
      "Use Cases",
      "Challenges and Limitations",
    ],
  },
  {
    title: "The Visual Cortex as a Computer Vision Architecture: Dorsal and Ventral Streams",
    date: "2026-04-05",
    description: "How the brain's visual cortex uses two parallel streams, feedback loops, and relative perception to process vision. Everything rewritten for engineers who build vision systems.",
    tags: ["computer vision", "neuroscience", "visual cortex", "CNN", "architecture"],
    slug: "cnns-design-flaw-evolution",
    minutes: 15,
    contents: [
      "The Split You Did Not Know Was in Your Design",
      "The Dorsal Stream: Real-Time Spatial Inference",
      "The Ventral Stream: Hierarchical Object Recognition",
      "Implications for Computer Vision Engineering",
    ],
  },
  {
    title: "Temporal and Spatial Attention for 3D Pose Estimation",
    date: "2026-02-22",
    description: "How temporal and spatial attention mechanisms enable accurate 2D-to-3D human pose estimation, with a deep dive into DSTformer.",
    tags: ["pose estimation", "attention", "3D vision", "transformers"],
    slug: "temporal-spatial-attention-3d-pose",
    minutes: 6,
    contents: [
      "The Ill-Posed Problem: Lifting 2D to 3D",
      "Temporal Attention: Understanding Motion Over Time",
      "Spatial Attention: Maintaining Anatomical Consistency",
      "Fusion of Temporal and Spatial Streams",
    ],
  },
]).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

type Item =
  | { kind: 'essay'; date: string; title: string; description: string; href: string; image: string; minutes: number; words: number; tags: string[]; contents: string[] }
  | { kind: 'notebook'; date: string; title: string; description: string; href: string; image: string; minutes: number; tags: string[]; nb: (typeof notebooks)[number] };

const items: Item[] = [
  ...posts.map(p => ({
    kind: 'essay' as const, date: p.date, title: p.title, description: p.description,
    href: p.href || `/blog/${p.slug}`, image: img(`/images/blog/${p.slug}.jpg`, 1200),
    minutes: essayWords[p.slug] ? Math.max(1, Math.round(essayWords[p.slug] / 230)) : p.minutes, words: essayWords[p.slug] ?? 0, tags: p.tags, contents: p.contents,
  })),
  ...notebooks.map(nb => ({
    kind: 'notebook' as const, date: nb.endDate, title: nb.title, description: nb.description,
    href: `/notebooks/${nb.slug}`, image: img(`/images/blog/notebook-${nb.slug}.jpg`, 1200),
    minutes: nb.minutes, tags: nb.tags, nb,
  })),
].sort((a, b) => b.date.localeCompare(a.date));

// Topics worth filtering by: the ones that more than one piece shares.
/* A handful of plain topics, as on Thoughts, in place of the raw tags:
   each is the set of tags that mean it, and a piece belongs to every
   topic one of its tags falls under. */
const TOPICS: [string, string[]][] = [
  ['Vision', ['computer vision', '3D vision', 'pose estimation', 'visual cortex', 'OpenCV', 'sign language']],
  ['The brain', ['neuroscience', 'psychology', 'perception', 'visual cortex', 'autism']],
  ['Neural networks', ['deep learning', 'CNN', 'transformers', 'attention', 'LLMs']],
  ['Search & embeddings', ['embeddings', 'vector databases', 'similarity search', 'multimodal']],
  ['Probability & evaluation', ['probability', 'statistics', 'evaluation', 'ROC', 'AUC', 'PMF']],
];
const topicsOf = (tags: string[]) => TOPICS.filter(([, ts]) => ts.some(t => tags.includes(t))).map(([n]) => n);
const topics = TOPICS.map(([n]) => ({ name: n, count: items.filter(it => topicsOf(it.tags).includes(n)).length })).filter(t => t.count > 0);


const fmt = (d: string, o: Intl.DateTimeFormatOptions) => new Date(d + 'T00:00:00').toLocaleDateString('en-US', o);
const short = (d: string) => fmt(d, { month: 'short', day: 'numeric' });
const years = [...new Set(items.map(it => it.date.slice(0, 4)))];

/* The work in four topics, so a page of wide interests reads as four
   clear bodies of work. Each has its own drawings from the history of
   looking, which form beside its name as you reach it. In each, notebooks lead (the one being written first),
   then essays, newest first. */
const keyOf = (it: Item) => it.href.split('/').filter(Boolean).pop()!;
const TOPIC_DEFS = [
  { id: 'vision', intro: 'How a machine turns pixels into an understanding of a scene: where things are, how they move and what they are. Here that starts with geometry, from cameras and matched points to recovering 3D structure, and continues into learned models that estimate pose and read gestures.', set: [15, 10, 7, 3, 9, 2, 12, 25], name: 'Vision', line: 'How a machine recovers the world from pixels: geometry, pose and recognition.', keys: ['3d-reconstruction', 'temporal-spatial-attention-3d-pose', 'sign-language-recognition-using-cnn-and-opencv'] },
  { id: 'neuroscience', intro: 'How the brain does what those machines attempt. The notebooks follow vision from the retina to recognition through its two cortical streams, then turn to emotion: what it is, why it evolved and how it steers thought. The essay reads the visual cortex as an architecture an engineer could build.', set: [13, 14, 20, 17, 18], name: 'Neuroscience', line: 'How the brain sees, and how it feels: the computation behind both.', keys: ['neuroscience', 'cnns-design-flaw-evolution', 'emotion'] },
  { id: 'machine-learning', intro: 'The models under modern AI, derived rather than used: how text becomes tokens, how attention works and how the transformer is put together; how CLIP binds text and images in one space; and how databases search those embeddings by meaning.', set: [5, 8, 0, 19, 21, 23, 24], name: 'Machine learning', line: 'Transformers, models that read images, and search by meaning, derived from the ground up.', keys: ['modern-nets', 'vlm-search', 'vector-databases-vdbms'] },
  { id: 'foundations', intro: 'The mathematics the rest relies on: random variables, expectation and variance, and how to judge a classifier honestly with ROC curves and AUC instead of accuracy.', set: [1, 4, 6, 11, 16, 22, 26, 27, 28, 29], name: 'Foundations', line: 'The probability and evaluation everything above stands on.', keys: ['probability-mass-function', 'roc-curve-auc'] },
];
const rank = (it: Item) => (it.kind === 'notebook' ? (it.nb.inProgress ? 0 : 1) : 2);
const fields4 = TOPIC_DEFS.map(t => {
  const its = t.keys.map(k => items.find(it => keyOf(it) === k)!).filter(Boolean)
    .sort((a, b) => rank(a) - rank(b) || b.date.localeCompare(a.date));
  const words = its.reduce((n, it) => n + (it.kind === 'essay' ? it.words : it.nb.words), 0);
  return { ...t, items: its, words, notebooks: its.filter(x => x.kind === 'notebook').length, essays: its.filter(x => x.kind === 'essay').length };
});
const k1 = (n: number) => `${(n / 1000).toFixed(1).replace('.0', '')}k`;
const mon = (d: string) => fmt(d, { month: 'short', year: 'numeric' });
---

<Layout title={title} activeNav="/blog" description="Essays and day-by-day notebooks in four topics: vision, neuroscience, machine learning and their foundations. Notes on things I finally understood, not tutorials." ogImage={share("/images/share-blog.jpg")}>
  <SketchPlate sketches={sketches} credits={credits} />
  <div class="blog-page free">
    <div class="shelf-layout">
      <!-- One column, held on screen: the page's name, the four topics
           (choose one; it fills the right), and the line to search on. -->
      <aside class="side" id="side">
        <div class="side-head">
          <h1 class="side-title">Technical Blogs</h1>
          <details class="why">
            <summary>Why I write these</summary>
            <div class="why-body">
            <p>I write these to check whether I actually understand something. If I can explain it from the start, with the reasoning and not just the result, I do. If I can't, the gap shows up on the page.</p>
            <p>I'm mostly self-taught, so I don't always know what I'm missing. Writing is how I find out.</p>
            <p>I move between subjects because that's how my curiosity works, and because an idea often makes more sense once I've seen it somewhere else.</p>
            <p>These are working notes, not tutorials. Some of it will be wrong. Where I'm not sure, I say so.</p>
          </div>
          </details>
        </div>
        <nav class="tabs" id="tabs" role="tablist" aria-label="Topics">
          <span class="tab-marker" aria-hidden="true"></span>
          <button type="button" class="back-topics" id="back-topics">← Topics</button>
          {fields4.map((t, i) => (<Fragment>
            <a href={`#${t.id}`} class="tab" role="tab" data-t={t.id} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={t.id} style={`--o:${i}`}>
              <span class="tab-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="tab-name">{t.name}</span>
              <span class="tab-line">{t.line}</span>
              <span class="tab-c">{[t.notebooks && `${t.notebooks} notebook${t.notebooks > 1 ? 's' : ''}`, t.essays && `${t.essays} essay${t.essays > 1 ? 's' : ''}`].filter(Boolean).join(' · ')}</span>
            </a>
          </Fragment>))}
          <button type="button" class="tab-find" id="tab-find" aria-controls="side-find" aria-expanded="false">Find</button>
        </nav>
        <!-- The chosen topic's drawing forms here, under its name. -->
        <div class="side-art" id="side-art" aria-hidden="true" style="--o:0">
          {fields4.map((t, i) => (
            <div class={`plate-slot${i === 0 ? ' on' : ''}`} data-t={t.id} data-set={JSON.stringify(t.set)}></div>
          ))}
        </div>
        <!-- The chosen topic in a few lines, under its drawing. -->
        <div class="side-intro">
          {fields4.map((t, i) => (
            <p class={`tab-intro${i === 0 ? ' on' : ''}`} data-t={t.id}>{t.intro}</p>
          ))}
        </div>
        <div class="side-find" id="side-find">
          <div class="seek">
            <label class="seek-lead" for="search-input">Find</label>
            <input type="search" id="search-input" placeholder="anything" enterkeyhint="search" autocomplete="off" aria-label="Search the blogs" />
            <span class="seek-key" aria-hidden="true">/</span>
          </div>
          <p class="find-note" id="find-note" aria-live="polite"></p>
        </div>
      </aside>

    <div class="stage">
    <div class="chapters" id="post-index">
      {fields4.map((t, i) => (
        <section class={`chapter ch-${t.id}${i === 0 ? ' active' : ''}`} id={t.id} role="tabpanel" data-i={i} style={`--o:${i}`}>
          <header class="ch-head rv">
            <div class="ch-side">
              <p class="ch-line">{t.intro}</p>
              <dl class="ch-stats">
                {t.notebooks > 0 && <div><dt>Notebooks</dt><dd>{t.notebooks}</dd></div>}
                {t.essays > 0 && <div><dt>Essays</dt><dd>{t.essays}</dd></div>}
                <div><dt>Words</dt><dd>{k1(t.words)}</dd></div>
              </dl>
            </div>
          </header>

          <ol class="pieces">
            {t.items.map(it => (
              <li class={`piece rv ${it.kind}`} id={keyOf(it)}
                  data-text={[it.title, it.description, t.name, ...it.tags, ...(it.kind === 'essay' ? it.contents : it.nb.days.map(d => d.title))].join(' ').toLowerCase()}>
                <a class="p-fig" href={it.href} tabindex="-1" aria-hidden="true">
                  <img src={it.image} data-ink crossorigin="anonymous" alt="" width="1600" height="840" loading="lazy" decoding="async" />
                </a>
                <div class="p-body">
                  <p class="p-meta">
                    <span class="p-kind">{it.kind === 'essay' ? 'Essay' : 'Notebook'}</span>
                    {it.kind === 'notebook' && (
                      <span class="p-days" aria-label={`${it.nb.days.filter(d => d.href).length} days written`}>
                        {it.nb.days.map(d => <i class={d.href ? '' : 'off'}></i>)}{it.nb.inProgress && <i class="next"></i>}
                      </span>
                    )}
                    <span class="p-when">
                      {it.kind === 'essay'
                        ? `${mon(it.date)} · ${it.words ? `${it.words.toLocaleString('en-US')} words · ` : ''}${it.minutes} min`
                        : `${it.nb.inProgress ? 'In progress · ' : ''}${it.nb.days.length} days · ${it.nb.words.toLocaleString('en-US')} words`}
                    </span>
                  </p>
                  <h3 class="p-title"><a href={it.href}>{it.title}</a></h3>
                  <p class="p-desc">{it.description}</p>
                  <button type="button" class="p-more" aria-expanded="false">{it.kind === 'essay' ? `${it.contents.length} sections` : `${it.nb.days.length} days`}</button>
                  <ol class="p-toc">
                    {it.kind === 'essay'
                      ? it.contents.map((c, j) => <li><a href={`${it.href}#section-${j + 1}`}><span class="n">§{j + 1}</span><span class="t">{c}</span></a></li>)
                      : it.nb.days.map(d => <li>{d.href
                          ? <a href={d.href}><span class="n">{String(d.day).padStart(2, '0')}</span><span class="t">{d.title}</span><span class="m">{d.minutes} min</span></a>
                          : <span class="later"><span class="n">{String(d.day).padStart(2, '0')}</span><span class="t">{d.title}</span></span>}</li>)}
                  </ol>
                </div>
              </li>
            ))}
          </ol>
          <a class="next-topic" href={`#${fields4[(i + 1) % fields4.length].id}`}>
            <span class="nt-k">{i + 1 < fields4.length ? 'Next' : 'Back to'}</span>
            <span class="nt-name">{fields4[(i + 1) % fields4.length].name}</span>
            <span class="nt-a" aria-hidden="true">→</span>
          </a>
        </section>
      ))}
    </div>
    <p class="no-results" id="no-results" hidden>Nothing written on that yet.</p>
    </div>
  </div>
</Layout>

<style>
  .blog-page {
    --c: var(--color-accent);
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* The opening is words alone now: the drawing has moved down into the
     topics, so it no longer holds the whole first screen. */
  /* ── The layout: one column held on screen, the topic beside it ── */
  .shelf-layout {
    display: grid;
    grid-template-columns: minmax(16rem, 30%) minmax(0, 1fr);
    column-gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .side {
    position: sticky;
    top: var(--head-h, 4.5rem);
    height: calc(100svh - var(--head-h, 4.5rem));
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    padding: clamp(0.75rem, 3vh, 2.25rem) 0 clamp(1rem, 3.5vh, 2rem);
  }

  /* The drawing's place: what is left of the column, under the topics. */
  .side-art {
    position: relative;
    min-height: 0;
    margin: clamp(1.25rem, 5vh, 3.5rem) 0 clamp(1rem, 4vh, 2.75rem);
  }

  .side-art .plate-slot {
    display: none;
    position: absolute;
    inset: 0;
  }

  .side-art .plate-slot.on {
    display: block;
  }

  .side-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .side-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: clamp(1.25rem, min(1.9vw, 3.2vh), 1.9rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  /* The note opens over the page, so the column keeps its shape. */
  .side-head .why {
    position: relative;
    margin: 0;
  }

  .side-head .why :global(.why-body) {
    position: absolute;
    left: 0;
    top: calc(100% + var(--space-3));
    z-index: 8;
    width: min(56ch, 80vw);
    margin: 0;
    padding: var(--space-5);
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }

  .side-find .seek {
    max-width: 100%;
  }

  @media (min-width: 901px) {
    .side-find :global(.seek-lead),
    .side-find input {
      font-size: var(--fs-ui) !important;
    }
  }

  .side-find .find-note {
    min-height: 1.2em;
    margin-top: var(--space-1);
  }

  /* ── Search ──────────────────────────────────────────── */
  .seek-key {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: var(--lh-ui);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1px var(--space-1-5);
    user-select: none;
  }

  .find-note {
    margin: var(--space-2) 0 0;
    min-height: 1.5em;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-ui);
    color: var(--color-text-muted);
  }

  /* ── The topics: four names, the chosen one in full ink ── */
  .tabs {
    display: flex;
    flex-direction: column;
    gap: clamp(0.1rem, 0.6vh, 0.5rem);
    padding: clamp(1rem, 4.5vh, 3rem) 0 0;
  }

  .tab {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    grid-template-areas: 'n name' '. c';
    row-gap: 2px;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 400ms ease;
  }

  .tab-n {
    grid-area: n;
    padding-top: 0.75em;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-medium);
    letter-spacing: var(--track-label);
    color: var(--c);
    opacity: 0.5;
    transition: opacity 400ms ease;
  }

  .tab-name {
    grid-area: name;
    position: relative;
    justify-self: start;
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: clamp(1.9rem, min(3.3vw, 5.6vh), 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* The chosen one is underlined in the accent, drawn in from the left. */
  .tab-name::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.08em;
    height: 2px;
    border-radius: 2px;
    background: var(--c);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .tab-c {
    grid-area: c;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 400ms ease, transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .tab:hover {
    color: var(--color-text-secondary);
  }

  .tab:hover .tab-name {
    transform: translateX(0.1em);
  }

  .tab[aria-selected='true'] {
    color: var(--color-text);
  }

  .tab[aria-selected='true'] .tab-n {
    opacity: 1;
  }

  .tab[aria-selected='true'] .tab-name::after {
    transform: scaleX(1);
  }

  .tab[aria-selected='true'] .tab-c {
    opacity: 1;
    transform: none;
    color: var(--color-text-muted);
  }

  /* While searching, every topic's matches show together; no topic is chosen. */
  .tabs.searching .tab {
    color: var(--color-text-muted);
  }

  .tabs.searching .tab-name::after {
    transform: scaleX(0);
  }

  .tabs.searching .tab-c {
    opacity: 0;
  }

  .stage {
    min-width: 0;
    padding-top: clamp(0.75rem, 3vh, 2.25rem);
  }

  /* ── The stage: the chosen topic, arriving from the side it was chosen on ── */
  .chapter {
    display: none;
  }

  .chapter.active,
  :global(.chapters.searching) .chapter {
    display: block;
  }

  .chapter.active {
    animation: topic-in 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  @keyframes topic-in {
    from { opacity: 0; transform: translateX(calc(var(--dir, 1) * 36px)); }
    to { opacity: 1; transform: none; }
  }

  /* ── A chapter: its name, and its drawing forming beside it ── */
  .chapter {
    position: relative;
    padding: var(--space-md) 0 var(--space-3xl, 8rem);
    scroll-margin-top: calc(var(--head-h, 4.5rem) + 3.5rem);
  }

  .ch-head {
    padding: 0 0 var(--space-xl);
    max-width: 44rem;
  }




  .ch-line {
    margin: 0 0 var(--space-lg);
    max-width: 38ch;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.1vw, 1.95rem);
    line-height: 1.32;
    letter-spacing: -0.005em;
    color: var(--color-text);
  }


  .ch-stats {
    display: flex;
    gap: var(--space-xl);
    margin: 0;
  }

  .ch-stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
  }

  .ch-stats dt {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .ch-stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    line-height: 1;
    color: var(--color-text);
  }

  /* ── A piece: its plate, and everything it holds ───── */
  .pieces {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .piece {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    gap: var(--space-2xl);
    align-items: start;
    padding: var(--space-2xl) 0;
    scroll-margin-top: calc(var(--head-h, 4.5rem) + 4rem);
  }

  /* Every other piece turns the other way, so the page flows from side to side. */
  .piece:nth-child(even) {
    grid-template-columns: minmax(0, 6fr) minmax(0, 4fr);
  }

  .piece:nth-child(even) .p-fig {
    order: 2;
  }

  .piece[hidden],
  .chapter[hidden] {
    display: none;
  }

  .p-fig {
    display: block;
    isolation: isolate;
    background-color: var(--color-bg);
  }

  .p-fig img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .piece:hover .p-fig img {
    transform: translateY(-4px);
  }

  :global(html.dark) .p-fig img {
    filter: invert(1) hue-rotate(180deg) brightness(0.9);
  }

  .p-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .p-kind {
    color: var(--c);
    font-weight: var(--fw-medium);
  }

  /* A notebook's days, one square each in the topic's colour; the next, open. */
  .p-days {
    display: inline-flex;
    gap: 3px;
  }

  .p-days i {
    width: 8px;
    height: 8px;
    background: var(--c);
  }

  .p-days i.off,
  .p-days i.next {
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--c);
  }

  .p-days i.next {
    opacity: 0.55;
  }

  .p-title {
    margin: var(--space-3) 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: var(--fw-regular);
    line-height: var(--lh-snug);
    letter-spacing: var(--track-snug);
  }

  .notebook .p-title {
    font-size: clamp(1.9rem, 3vw, 2.6rem);
  }

  .p-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 250ms ease;
  }

  .p-title a:hover,
  .piece:hover .p-title a {
    color: var(--c);
  }

  .p-desc {
    margin: 0;
    max-width: 58ch;
    font-family: var(--font-serif);
    font-size: var(--fs-ui);
    line-height: var(--lh-ui);
    color: var(--color-text-secondary);
  }

  /* What is inside: numbered in the topic's colour, every line a link. */
  .p-toc {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    max-width: 60ch;
  }

  .p-toc a,
  .p-toc .later {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-1-5) 0;
    color: var(--color-text);
    text-decoration: none;
  }

  .p-toc .n {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-medium);
    letter-spacing: var(--track-label);
    color: var(--c);
  }

  .p-toc .t {
    font-family: var(--font-serif);
    font-size: var(--fs-ui);
    line-height: var(--lh-snug);
    transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1), color 200ms ease;
  }

  .p-toc .m {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-label);
    color: var(--color-text-muted);
  }

  .p-toc a:hover .t {
    color: var(--c);
    transform: translateX(4px);
  }

  .p-toc .later {
    opacity: 0.45;
  }

  /* Arriving: each heading and piece rises into place once. */
  :global(.chapters.live) .rv {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 1s cubic-bezier(0.2, 0.7, 0.2, 1), transform 1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  :global(.chapters.live) .rv.in {
    opacity: 1;
    transform: none;
  }

  /* The drawing's place never moves, so the drawing never lands off it. */
  :global(.chapters.live) .ch-head.rv {
    transform: none;
  }

  .no-results {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-muted);
    padding: var(--space-xl) 0;
  }



  /* ── Choosing a topic (wide screens): unmistakable, and smooth ── */
  @media (min-width: 901px) {
    .tabs {
      position: relative;
      padding-left: 1.4rem;
    }

    /* The accent marker glides to the chosen topic. */
    .tab-marker {
      position: absolute;
      left: 0;
      top: 0;
      width: 3px;
      height: var(--mh, 0px);
      border-radius: 3px;
      background: var(--c);
      transform: translateY(var(--my, 0px));
      transition: transform 650ms cubic-bezier(0.2, 0.8, 0.2, 1), height 650ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .tab {
      padding: 0.1em 0;
      align-items: baseline;
    }

    .tab-n {
      padding-top: 0;
    }

    /* The others step back: smaller and quieter, so the chosen one leads. */
    .tab-name {
      font-size: clamp(1.45rem, min(2.4vw, 4vh), 2.65rem);
      transition: font-size 550ms cubic-bezier(0.2, 0.8, 0.2, 1), color 400ms ease, transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .tab[aria-selected='true'] .tab-name {
      font-size: clamp(1.9rem, min(3.3vw, 5.6vh), 3.75rem);
    }

    .tab[aria-selected='true'] .tab-name::after {
      transform: scaleX(0);
    }

    /* The chosen one's counts open under it; the others' stay closed. */
    .tab-c {
      max-height: 0;
      overflow: hidden;
      transition: max-height 500ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 400ms ease;
    }

    .tab[aria-selected='true'] .tab-c {
      max-height: 2em;
      margin-top: 2px;
    }

    .tabs.searching .tab-name {
      font-size: clamp(1.45rem, min(2.4vw, 4vh), 2.65rem);
    }

    .tabs.searching .tab-marker {
      opacity: 0;
    }
  }

  .tab:focus-visible {
    outline: 2px solid var(--c);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 900px) {
    .tab-marker { display: none; }
  }

  .tab-find {
    display: none;
  }

  .back-topics,
  .p-more,
  .tab-line {
    display: none;
  }

  /* ── Phones: an overview of the four, and each topic a view of its own ── */
  @media (max-width: 900px) {
    .shelf-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .side,
    .tabs,
    .stage,
    :global(.chapters) {
      display: contents;
    }

    /* The header: the page's name, why under it as a quiet line, and one
       compact line to search on. */
    .side-head {
      order: 1;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      padding-top: var(--space-xl);
    }

    .side-title {
      font-size: clamp(2.4rem, 11vw, 3.2rem);
      line-height: 0.95;
    }

    .side-head .why :global(summary) {
      padding: 0;
      border: 0;
      background: none;
      min-height: 0;
      font-family: var(--font-serif);
      font-style: italic;
      font-size: var(--fs-ui);
      letter-spacing: 0;
      text-transform: none;
      color: var(--color-text-muted);
      text-decoration: underline 1px;
      text-decoration-color: var(--color-border);
      text-underline-offset: 0.3em;
    }

    .side-head .why :global(summary::before) {
      display: none;
    }

    .side-head .why :global(.why-body) {
      left: auto;
      right: 0;
      width: min(56ch, calc(100vw - 2rem));
    }

    .side-find {
      order: 3;
      margin: var(--space-lg) 0 var(--space-sm);
    }

    .side-find .seek {
      flex-wrap: nowrap;
      align-items: baseline;
      gap: var(--space-3);
      padding: var(--space-2) 0;
    }

    .side-find :global(.seek-lead) {
      flex-basis: auto;
      font-family: var(--font-mono);
      font-size: var(--fs-micro);
      font-weight: var(--fw-regular);
      letter-spacing: var(--track-caps);
      text-transform: uppercase;
      color: var(--color-accent);
    }

    .side-find input {
      font-family: var(--font-serif) !important;
      font-size: var(--fs-ui) !important;
      font-weight: var(--fw-regular) !important;
      line-height: var(--lh-ui) !important;
      -webkit-appearance: none;
      appearance: none;
    }

    .side-find .seek-key {
      display: none;
    }

    .tab-find,
    .tab-marker,
    .scroll-cue {
      display: none;
    }

    /* The overview: each topic a row to tap, with what it is about. */
    .tab {
      order: calc(10 + 4 * var(--o));
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      align-items: baseline;
      row-gap: var(--space-1);
      padding: var(--space-5) 0;
    }

    .tab + .tab-intro + .tab {
      border: 0;
    }

    .tab-n {
      padding-top: 0;
    }

    .tab-name {
      font-size: clamp(2.1rem, 9.5vw, 2.9rem);
      color: var(--color-text);
    }

    .tab-name::after {
      display: none;
    }

    .tab-line {
      display: block;
      grid-column: 2;
      font-family: var(--font-serif);
      font-style: italic;
      font-size: var(--fs-ui);
      line-height: var(--lh-ui);
      color: var(--color-text-secondary);
    }

    .tab-c {
      grid-column: 2;
      opacity: 1;
      transform: none;
      max-height: none;
      color: var(--color-text-muted);
    }

    .chapter {
      order: calc(12 + 4 * var(--o));
    }

    /* The drawing belongs to the overview: under the page's name, above
       the topics; a topic's own view is words only. */
    .side-art {
      order: 2;
      height: 36vh;
      margin: var(--space-md) 0 0;
    }

    .shelf-layout:global(.reading) .side-art {
      display: none;
    }

    .no-results {
      order: 100;
    }

    /* A topic open: a view of its own. Back to the four at the top; its
       name; its drawing; its intro; its pieces; then the next topic. */
    .shelf-layout:global(.reading) .side-head,
    .shelf-layout:global(.reading) .side-find,
    .shelf-layout:global(.reading) .tab:not([aria-selected='true']) {
      display: none;
    }

    .shelf-layout:global(.reading) .back-topics {
      order: 3;
      display: inline-flex;
      justify-self: start;
      margin-top: var(--space-lg);
      padding: var(--space-1) 0;
      border: 0;
      background: none;
      cursor: pointer;
      font-family: var(--font-mono);
      font-size: var(--fs-micro);
      letter-spacing: var(--track-caps);
      text-transform: uppercase;
      color: var(--color-text-muted);
    }

    .shelf-layout:global(.reading) .tab[aria-selected='true'] {
      padding-top: var(--space-3);
    }

    .shelf-layout:global(.reading) .tab[aria-selected='true'] .tab-line {
      display: none;
    }

    .ch-head {
      padding-bottom: var(--space-md);
    }

    .ch-line {
      font-size: clamp(1.15rem, 4.8vw, 1.35rem);
      margin-bottom: var(--space-md);
    }

    /* Pieces as compact cards: what they hold folds away behind a word. */
    .piece {
      gap: var(--space-3);
      padding: var(--space-lg) 0;
    }

    .p-title {
      font-size: clamp(1.45rem, 6.4vw, 1.85rem) !important;
      margin: var(--space-2) 0;
    }

    .p-desc {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .p-toc {
      display: none;
    }

    .piece:global(.open) .p-toc {
      display: block;
    }

    .p-more {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      margin-top: var(--space-3);
      padding: var(--space-1) 0;
      border: 0;
      background: none;
      cursor: pointer;
      font-family: var(--font-mono);
      font-size: var(--fs-micro);
      letter-spacing: var(--track-caps);
      text-transform: uppercase;
      color: var(--color-accent);
    }

    .p-more::after {
      content: '▾';
      transition: transform 300ms ease;
    }

    .piece:global(.open) .p-more::after {
      transform: rotate(180deg);
    }

    /* The next topic, at the end of this one. */
    .next-topic {
      display: inline-flex;
      align-items: baseline;
      gap: var(--space-3);
      margin: var(--space-xl) 0 var(--space-2xl);
      color: var(--color-text);
      text-decoration: none;
    }

    .nt-k {
      font-family: var(--font-mono);
      font-size: var(--fs-micro);
      letter-spacing: var(--track-caps);
      text-transform: uppercase;
      color: var(--color-accent);
    }

    .nt-name {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 8vw, 2.4rem);
      line-height: 1;
    }

    .nt-a {
      color: var(--color-accent);
    }
  }


  /* ── Narrower screens ──────────────────────────────── */
  @media (max-width: 900px) {

    .piece:nth-child(even) {
      grid-template-columns: minmax(0, 1fr);
    }

    .piece:nth-child(even) .p-fig {
      order: 0;
    }

    .piece {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
    }

    .p-fig {
      max-width: 34rem;
    }
  }

  @media (max-width: 759px) {
    .ch-stats {
      gap: var(--space-lg);
    }

    .piece {
      padding: var(--space-xl) 0;
    }

    .p-toc a,
    .p-toc .later {
      grid-template-columns: 2.2rem minmax(0, 1fr);
    }

    .p-toc .m {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p-fig img, .p-toc .t, .tab::after { transition: none; }
    .chapter.active { animation: none; }
  }
  /* ── Wide screens: a free first screen ───────────────
     The topics on the left, the chosen one's intro unfolding under its
     name; its drawing large on the right, out to the screen's edge; the
     pieces below, the full width. */
  .tab-intro,
  .next-topic {
    display: none;
  }

  @media (min-width: 901px) {
    .shelf-layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-areas: 'head art' 'list art' 'intro art' 'find art' 'stage stage';
      grid-template-rows: auto auto auto minmax(0, 1fr) auto;
      column-gap: clamp(2rem, 4vw, 4rem);
    }

    .side {
      display: contents;
    }

    .side-head {
      grid-area: head;
      padding-top: clamp(1rem, 4vh, 3rem);
    }

    .tabs {
      grid-area: list;
      align-self: start;
      padding-block: clamp(1.25rem, 5vh, 3rem) var(--space-md);
    }

    .side-find {
      grid-area: find;
      align-self: end;
      max-width: 30rem;
      padding: var(--space-md) 0 var(--space-sm);
    }

    /* The drawing: the opening's, large, out to the edge of the screen; it
       stays with the opening and does not follow the reading. */
    .side-art {
      grid-area: art;
      align-self: start;
      height: min(68svh, 48rem);
      margin: 0 calc(-1 * var(--gutter, 2rem)) 0 0;
    }

    .stage {
      grid-area: stage;
      padding-top: 0;
      min-width: 0;
    }

    /* The first piece starts close under the opening, so it is seen. */

    /* The first piece starts close under the first screen, so it is seen. */
    .chapter .piece:first-child {
      padding-top: var(--space-sm);
    }

    /* The intro is under the topic's name now, not over its pieces. */
    .ch-head {
      display: none;
    }

    .side-intro {
      grid-area: intro;
      align-self: start;
      max-width: 44ch;
      margin: 0 0 0 1.4rem;
    }

    .tab-intro.on {
      display: block;
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(1.05rem, 1.3vw, 1.3rem);
      line-height: 1.45;
      color: var(--color-text-secondary);
      animation: intro-in 650ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    @keyframes intro-in {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: none; }
    }

    /* At the end of a topic, the way on to the next. */
    .next-topic {
      display: inline-flex;
      align-items: baseline;
      gap: var(--space-4);
      margin: var(--space-2xl) 0 0;
      color: var(--color-text);
      text-decoration: none;
    }

    .nt-k {
      font-family: var(--font-mono);
      font-size: var(--fs-micro);
      letter-spacing: var(--track-caps);
      text-transform: uppercase;
      color: var(--color-accent);
    }

    .nt-name {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3.5rem);
      line-height: 1;
      letter-spacing: -0.02em;
      transition: color 300ms ease;
    }

    .nt-a {
      font-family: var(--font-serif);
      font-size: 1.6rem;
      color: var(--color-accent);
      transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .next-topic:hover .nt-name {
      color: var(--color-accent);
    }

    .next-topic:hover .nt-a {
      transform: translateX(6px);
    }
  }
  .piece:global(.found) .p-title a {
    color: var(--color-accent);
  }

</style>

<script is:inline>
/* One topic at a time. A tab (or a link to #topic) chooses it: it slides in
   from the side it was chosen on, the address follows, and the ink pours
   into its drawing. Search looks across all four at once. */
(function () {
  var stage = document.getElementById('post-index'), bar = document.getElementById('tabs');
  if (!stage || !bar) return;
  var tabs = [].slice.call(bar.querySelectorAll('.tab'));
  var chs = [].slice.call(stage.querySelectorAll('.chapter'));
  var plate = document.querySelector('.plate');
  var layout = document.querySelector('.shelf-layout');
  var phoneQ = matchMedia('(max-width: 900px)');
  var current = 0;
  // On a wide screen, while the page is at its top, a cue that the topic's
  // pieces are below; it goes as soon as you scroll.
  var cueEl = document.getElementById('scroll-cue');
  function cue() {
    if (!cueEl) return;
    var t = tabs[current], show = !phoneQ.matches && current >= 0 && scrollY < 40 && !stage.classList.contains('searching');
    if (t) cueEl.querySelector('.sc-t').textContent = t.querySelector('.tab-c').textContent + ' below';
    cueEl.classList.toggle('show', show);
  }
  if (cueEl) cueEl.addEventListener('click', function () {
    var head = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--head-h')) || 72;
    scrollTo({ top: stage.getBoundingClientRect().top + scrollY - head - 16, behavior: 'smooth' });
  });
  addEventListener('scroll', function () { if (cueEl) cueEl.classList.toggle('show', !phoneQ.matches && current >= 0 && scrollY < 40 && !stage.classList.contains('searching')); }, { passive: true });

  function select(i, how) {
    how = how || {};
    if (i < 0 || i >= chs.length) i = 0;
    var was = current;
    var dir = current < 0 || i >= current ? 1 : -1;
    chs.forEach(function (c, k) { c.classList.toggle('active', k === i); });
    chs[i].style.setProperty('--dir', how.initial ? 0 : dir);
    tabs.forEach(function (t, k) { t.setAttribute('aria-selected', String(k === i)); });
    var slot = null;
    document.querySelectorAll('.side-art .plate-slot').forEach(function (el) { var on = el.dataset.t === chs[i].id; el.classList.toggle('on', on); if (on) slot = el; });
    var art = document.getElementById('side-art'); if (art) art.style.setProperty('--o', i);
    if (layout) layout.classList.toggle('reading', phoneQ.matches);
    document.querySelectorAll('.tab-intro').forEach(function (p) { p.classList.toggle('on', p.dataset.t === chs[i].id); });
    current = i;
    mark();
    cue();
    if (bar.scrollWidth > bar.clientWidth) bar.scrollTo({ left: tabs[i].offsetLeft - 16, behavior: how.initial ? 'auto' : 'smooth' });
    if (how.initial) return;
    if (phoneQ.matches && was < 0) history.pushState(null, '', '#' + chs[i].id);
    else history.replaceState(null, '', '#' + chs[i].id);
    if (plate && slot) plate.dispatchEvent(new CustomEvent('plate:slot', { detail: slot }));
    // Keep the tabs where they are: if the page was scrolled into the old
    // topic, bring the new one's start up under them.
    var head = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--head-h')) || 72;
    // On a phone the opened topic's name comes up to the top; on a wide
    // screen, the topic's start, if the page was scrolled into the old one.
    var phone = matchMedia('(max-width: 900px)').matches;
    var stageTop = stage.getBoundingClientRect().top + scrollY;
    var top = 0;
    if (phone || scrollY > stageTop - innerHeight * 0.6 || how.jump) scrollTo({ top: top, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  }

  // The marker sits beside the chosen topic, and moves when the layout does.
  var marker = bar.querySelector('.tab-marker');
  function mark() {
    if (!marker || current < 0) return;
    var t = tabs[current];
    marker.style.setProperty('--my', t.offsetTop + 'px');
    marker.style.setProperty('--mh', t.offsetHeight + 'px');
  }
  if (window.ResizeObserver) new ResizeObserver(mark).observe(bar);
  if (document.fonts) document.fonts.ready.then(mark);

  tabs.forEach(function (t, i) {
    t.addEventListener('click', function (e) {
      e.preventDefault(); clearSearch();
      if (phoneQ.matches && i === current) { closeAll(); scrollTo({ top: t.getBoundingClientRect().top + scrollY - (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--head-h')) || 72), behavior: 'smooth' }); return; }
      select(i);
    });
  });
  // A topic chosen in the opening: chosen in the tabs, and brought up under them.
  document.querySelectorAll('.op-topic').forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault(); clearSearch();
      var i = chs.findIndex(function (c) { return c.id === a.dataset.t; });
      select(i, { jump: true });
    });
  });
  // Arrow keys move between tabs, as tabs should.
  bar.addEventListener('keydown', function (e) {
    var k = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
    if (!k) return;
    e.preventDefault(); var n = (current + k + tabs.length) % tabs.length; select(n); tabs[n].focus();
  });
  // A link straight to a topic, or to a piece inside one.
  function fromHash() {
    var h = location.hash.slice(1); if (!h) return -1;
    var el = document.getElementById(h); if (!el) return -1;
    var c = el.closest('.chapter'); return c ? chs.indexOf(c) : -1;
  }
  // On a phone the page opens on the four names, none open, unless a link
  // asked for one; tapping the open one closes it again.
  var lastOpen = 0;
  function closeAll() {
    if (current >= 0) lastOpen = current;
    if (layout) layout.classList.remove('reading');
    chs.forEach(function (c) { c.classList.remove('active'); });
    tabs.forEach(function (t) { t.setAttribute('aria-selected', 'false'); });
    current = -1;
    var shown = document.querySelector('.side-art .plate-slot.on');
    if (plate && shown) requestAnimationFrame(function () { plate.dispatchEvent(new CustomEvent('plate:slot', { detail: shown })); });
    if (plate) plate.dispatchEvent(new Event('scroll'));
    history.replaceState(null, '', location.pathname + location.search);
  }
  var start = fromHash();
  if (start < 0 && phoneQ.matches) closeAll(); else select(start >= 0 ? start : 0, { initial: true });

  // Crossing between a phone's width and a wide screen: a wide screen
  // always has a topic chosen, drawn in full; a phone shows the open topic
  // as its own view, or the four.
  function settle() {
    if (!phoneQ.matches) {
      if (current < 0) select(lastOpen, { initial: true });
      if (layout) layout.classList.remove('reading');
      mark();
      var slot = document.querySelector('.side-art .plate-slot.on');
      if (plate && slot) requestAnimationFrame(function () { plate.dispatchEvent(new CustomEvent('plate:slot', { detail: slot })); });
    } else if (layout) {
      layout.classList.toggle('reading', current >= 0);
    }
  }
  if (phoneQ.addEventListener) phoneQ.addEventListener('change', settle); else if (phoneQ.addListener) phoneQ.addListener(settle);
  function fromAddress() {
    var i = fromHash();
    if (i >= 0 && i !== current) select(i);
    else if (i < 0 && phoneQ.matches && current >= 0) { closeAll(); scrollTo(0, 0); }
  }
  addEventListener('hashchange', fromAddress);
  addEventListener('popstate', fromAddress);
  var back = document.getElementById('back-topics');
  if (back) back.addEventListener('click', function () { closeAll(); scrollTo(0, 0); });
  // On a phone a piece's days or sections open under it.
  stage.querySelectorAll('.p-more').forEach(function (b) {
    b.addEventListener('click', function () { var p = b.closest('.piece'); var o = p.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
  });

  // On a phone, Find opens the search under the topics, and closes it.
  var findBtn = document.getElementById('tab-find'), findBox = document.getElementById('side-find');
  if (findBtn && findBox) findBtn.addEventListener('click', function () {
    var open = !findBox.classList.contains('open');
    findBox.classList.toggle('open', open); findBtn.setAttribute('aria-expanded', String(open));
    if (open) document.getElementById('search-input').focus(); else clearSearch();
  });


  // Find: every word typed must appear in the piece (a prefix is enough).
  var input = document.getElementById('search-input'), note = document.getElementById('find-note'), none = document.getElementById('no-results');
  var pieces = [].slice.call(stage.querySelectorAll('.piece'));
  function run() {
    var ws = input.value.toLowerCase().split(/[^a-z0-9]+/).filter(function (w) { return w.length > 1; }), shown = 0, on = ws.length > 0;
    stage.classList.toggle('searching', on); bar.classList.toggle('searching', on);
    pieces.forEach(function (p) { var ok = !on || ws.every(function (w) { return p.dataset.text.indexOf(w) >= 0; }); p.hidden = !ok; if (ok) shown++; });
    chs.forEach(function (c) { c.hidden = on && !c.querySelector('.piece:not([hidden])'); });
    note.textContent = on ? shown + ' of ' + pieces.length + ' mention \u201c' + input.value.trim() + '\u201d' : '';
    none.hidden = !on || shown > 0;
  }
  function clearSearch() { if (input && input.value) { input.value = ''; run(); } }
  if (input) {
    input.addEventListener('input', run);
    addEventListener('keydown', function (e) {
      if (e.key === '/' && document.activeElement !== input && !/input|textarea/i.test(document.activeElement.tagName)) { e.preventDefault(); input.focus(); }
      if (e.key === 'Escape' && document.activeElement === input) clearSearch();
    });
  }
})();

/* Arriving: headings and pieces rise into place once, as they come into view. */
(function () {
  var root = document.getElementById('post-index');
  if (!root || !window.IntersectionObserver || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  root.classList.add('live');
  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { rootMargin: '0px 0px -8% 0px', threshold: 0.1 });
  root.querySelectorAll('.rv').forEach(function (el) { io.observe(el); });
})();
</script>


