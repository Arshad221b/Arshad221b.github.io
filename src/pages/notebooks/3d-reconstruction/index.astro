---
/* 3D Reconstruction: the notebook's front page, on the shared layout.
   Everything is read from the day data except the syllabus below, which
   lists what each stage involves; a topic gets a day once it's written. */
import NotebookFront from '../../../components/NotebookFront.astro';
import type { IndexEntry } from '../../../components/NotebookFront.astro';
import { experiment, days, STAGES } from '../../../data/3d-reconstruction-days';
import type { Block } from '../../../data/3d-reconstruction-days';
import { notebooks } from '../../../lib/notebooks';

const base = '/notebooks/3d-reconstruction';

// What each stage takes in and gives back.
const STAGE_IO = [
  "photos → keypoints",
  "keypoints → matches",
  "matches → relative pose",
  "poses + matches → 3D points",
  "more photos → all cameras",
  "rough model → refined model",
  "refined model → surfaces",
];

// What each stage involves. A topic with a day has been written up there.
const SYLLABUS: { topic: string; day?: number; step?: number }[][] = [
  [
    { topic: "Gaussian scale space and DoG", day: 1, step: 1 },
    { topic: "Extrema across space and scale", day: 1, step: 2 },
    { topic: "Sub-pixel localisation", day: 1, step: 3 },
    { topic: "Edge rejection with the Hessian", day: 1, step: 4 },
    { topic: "Orientation assignment", day: 1, step: 5 },
    { topic: "The SIFT descriptor", day: 1, step: 6 },
    { topic: "Harris corners and the structure tensor" },
    { topic: "Binary features: ORB" },
    { topic: "Learned features: SuperPoint" },
  ],
  [
    { topic: "Nearest neighbours and the ratio test", day: 1, step: 7 },
    { topic: "RANSAC", day: 1, step: 7 },
    { topic: "Approximate search: k-d trees, FLANN" },
    { topic: "Learned matching: SuperGlue, LightGlue" },
  ],
  [
    { topic: "The pinhole camera and intrinsics K", day: 2, step: 3 },
    { topic: "Epipolar geometry", day: 2, step: 5 },
    { topic: "Essential matrix", day: 2, step: 7 },
    { topic: "Epipolar lines: the point-to-line test", day: 2, step: 8 },
    { topic: "Fundamental matrix", day: 2, step: 9 },
    { topic: "The 8-point algorithm", day: 3, step: 3 },
    { topic: "The 5-point algorithm" },
    { topic: "Homographies and degenerate scenes", day: 3, step: 6 },
    { topic: "Recovering R and t from E", day: 3, step: 9 },
  ],
  [
    { topic: "Linear triangulation (DLT)", day: 3, step: 13 },
    { topic: "The midpoint method", day: 3, step: 12 },
    { topic: "Reprojection error", day: 3, step: 14 },
    { topic: "Points in front of both cameras", day: 3, step: 10 },
  ],
  [
    { topic: "Building tracks across many views" },
    { topic: "Incremental SfM" },
    { topic: "Registering new cameras: PnP" },
    { topic: "Global SfM" },
  ],
  [
    { topic: "Reprojection error as the objective" },
    { topic: "Levenberg–Marquardt" },
    { topic: "Sparsity and the Schur complement" },
    { topic: "Robust losses" },
  ],
  [
    { topic: "Plane-sweep stereo" },
    { topic: "PatchMatch multi-view stereo" },
    { topic: "Depth-map fusion" },
    { topic: "Meshing: Poisson reconstruction" },
  ],
];

const minutesOf = Object.fromEntries(
  (notebooks.find(n => n.slug === '3d-reconstruction')?.days ?? []).map(d => [d.day, d.minutes]),
);
const tangents = (blocks: Block[] = []): string[] =>
  blocks.flatMap(b => (b.kind === 'tangent' ? [b.title, ...tangents(b.blocks)] : []));
const written = days.filter(d => d.steps.length > 0);

const frontDays = written.map(d => {
  const parts: string[] = [];
  for (const st of d.steps) if (parts[parts.length - 1] !== st.act) parts.push(st.act);
  return { day: d.day, date: d.date, title: d.curiosityTitle, minutes: minutesOf[d.day] ?? 0, href: `${base}/day-${d.day}`, parts, stages: d.stages };
});

const index: IndexEntry[] = written.flatMap(d => [
  ...tangents(d.intro).map(t => ({ term: t, kind: 'tangent' as const, day: d.day, href: `${base}/day-${d.day}` })),
  ...d.steps.flatMap(st => [
    { term: st.title, kind: 'step' as const, day: d.day, href: `${base}/day-${d.day}#step-${st.n}` },
    ...tangents(st.blocks).map(t => ({ term: t, kind: 'tangent' as const, day: d.day, href: `${base}/day-${d.day}#step-${st.n}` })),
  ]),
]);

const formulas = written.flatMap(d => d.steps.flatMap(st =>
  st.blocks.filter(b => b.kind === 'eq').map(b => ({
    tex: (b as { tex: string }).tex,
    label: `${d.day}.${st.n} · ${st.title}`,
    href: `${base}/day-${d.day}#step-${st.n}`,
  })),
));
---

<NotebookFront
  title={experiment.title}
  description={experiment.description}
  status={experiment.status === 'active' ? 'active' : 'complete'}
  startDate={experiment.startDate}
  lede="How do overlapping photos become a 3D model with geometry alone? Working through the classical pipeline one stage at a time: features, matching, two-view geometry, triangulation, structure from motion, bundle adjustment, dense reconstruction."
  days={frontDays}
  stages={STAGES.map((name, i) => ({ name, io: STAGE_IO[i] }))}
  syllabus={SYLLABUS.map(g => g.map(t => ({ topic: t.topic, href: t.day ? `${base}/day-${t.day}${t.step ? `#step-${t.step}` : ''}` : undefined })))}
  formulas={formulas}
  index={index}
  open={written.flatMap(d => d.questions.map(q => ({ q, day: d.day, href: `${base}/day-${d.day}` })))}
/>
