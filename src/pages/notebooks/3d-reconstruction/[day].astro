---
import { img } from '../../../lib/media';
import Layout from '../../../layouts/Layout.astro';
import { days, STAGES } from '../../../data/3d-reconstruction-days';
import Blocks from '../../../components/recon/Blocks.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return days
    .filter(d => d.bullets.length > 0)
    .map(d => ({ params: { day: `day-${d.day}` }, props: { dayData: d } }));
};

const { dayData: day } = Astro.props;

const title = `Day ${day.day}: ${day.curiosityTitle} — 3D Reconstruction — Arshad Kazi`;

function formatDate(dateStr: string): string {
  const date = new Date(dateStr + 'T00:00:00');
  return date.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
}

const activeDays = days.filter(d => d.bullets.length > 0);
const currentIndex = activeDays.findIndex(d => d.day === day.day);
const prevDay = currentIndex > 0 ? activeDays[currentIndex - 1] : null;
const nextDay = currentIndex < activeDays.length - 1 ? activeDays[currentIndex + 1] : null;

// Steps grouped by act, in the order they were worked out.
const acts: { name: string; steps: typeof day.steps }[] = [];
for (const st of day.steps) {
  const last = acts[acts.length - 1];
  if (last && last.name === st.act) last.steps.push(st);
  else acts.push({ name: st.act, steps: [st] });
}
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
---

<Layout title={title} activeNav="/blog" description={`Day ${day.day}: ${day.curiosityTitle}`}>
  <div class="experiment-page recon">
    <a href="/notebooks/3d-reconstruction" class="back-link">&larr; All Days</a>

    <header class="r-head">
      <p class="r-kicker">Day {day.day} · {formatDate(day.date)}</p>
      <h1 class="r-title">{day.curiosityTitle}</h1>
      <p class="r-summary">{day.summary}</p>
    </header>

    {day.intro && <div class="r-intro"><Blocks blocks={day.intro} /></div>}

    <ol class="r-track" aria-label="Where this day sits in the reconstruction pipeline">
      {STAGES.map((s, i) => (
        <li class:list={{ on: day.stages.includes(i) }}><span>{i + 1}</span>{s}</li>
      ))}
    </ol>


    <nav class="r-toc" aria-label="Contents">
      {acts.map((a, i) => (
        <div class="r-toc-act">
          <p class="r-toc-h">{roman[i]} · {a.name}</p>
          <ol>
            {a.steps.map(st => <li><a href={`#step-${st.n}`}><span>{st.n}</span>{st.title}</a></li>)}
          </ol>
        </div>
      ))}
    </nav>

    <div class="day-entry">
      {acts.map((a, i) => (
        <section class="r-act">
          <h2 class="r-act-h"><span>Part {roman[i]}</span>{a.name}</h2>
          {a.steps.map(st => (
            <article class="r-step" id={`step-${st.n}`}>
              <header class="r-step-head">
                <span class="r-step-n">{st.n}</span>
                <div>
                  <h3 class="r-step-t">{st.title}</h3>
                  {st.subtitle && <p class="r-step-sub">{st.subtitle}</p>}
                </div>
              </header>
              <Blocks blocks={st.blocks} />
            </article>
          ))}
        </section>
      ))}

      {day.questions.length > 0 && (
        <section class="r-act">
          <h2 class="r-act-h"><span>Next</span>Open questions</h2>
          <p class="r-label">Not answered yet</p>
          <ol class="r-qs">{day.questions.map(q => <li set:html={q} />)}</ol>
        </section>
      )}
    </div>

    <nav class="day-nav">
      {prevDay ? (
        <a href={`/notebooks/3d-reconstruction/day-${prevDay.day}`} class="day-nav-link prev">
          <span class="day-nav-arrow">&larr;</span>
          <span class="day-nav-label">Day {prevDay.day}</span>
        </a>
      ) : <span />}
      {nextDay ? (
        <a href={`/notebooks/3d-reconstruction/day-${nextDay.day}`} class="day-nav-link next">
          <span class="day-nav-label">Day {nextDay.day}</span>
          <span class="day-nav-arrow">&rarr;</span>
        </a>
      ) : <span />}
    </nav>
  </div>
</Layout>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
<script is:inline>
  document.addEventListener("DOMContentLoaded", function() {
    renderMathInElement(document.querySelector(".recon"), {
      delimiters: [
        { left: "$$", right: "$$", display: true },
        { left: "$", right: "$", display: false }
      ],
      throwOnError: false
    });
    // Typesetting and fitting the maths changes heights after the browser
    // has jumped to a #step, so land there again once things settle,
    // unless the reader has already started scrolling.
    var target = location.hash && document.getElementById(location.hash.slice(1));
    if (target) {
      var moved = false;
      ['wheel', 'touchstart', 'keydown'].forEach(function (t) { addEventListener(t, function () { moved = true; }, { once: true, passive: true }); });
      var land = function () { if (!moved) target.scrollIntoView({ block: 'start' }); };
      requestAnimationFrame(land);
      setTimeout(land, 300);
      if (document.fonts) document.fonts.ready.then(land);
    }
  });
</script>

<style>
  .day-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .day-nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    font-family: var(--font-mono);
    letter-spacing: var(--track-caps);
    font-size: var(--fs-label);
    text-transform: uppercase;
    font-weight: var(--fw-bold);
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }

  .day-nav-link:hover {
    color: var(--color-text);
  }

  .day-nav-arrow {
    font-size: var(--fs-ui);
  }

  .day-nav-label {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
  }

  /* diagrams */
  .diagram-wrap {
    margin: var(--space-4) 0 var(--space-2);
    overflow-x: auto;
  }

  :global(.flow-h) {
    display: flex;
    align-items: flex-start;
    gap: var(--space-1-5);
    flex-wrap: wrap;
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  :global(.d-node) {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    padding: var(--space-1-5) var(--space-2);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    color: var(--color-text);
    text-align: center;
    line-height: var(--lh-snug);
    white-space: nowrap;
  }

  :global(.d-arrow) {
    font-size: var(--fs-ui);
    color: var(--color-text-muted);
    align-self: center;
    padding: 0 var(--space-0-5);
  }

  :global(.d-col) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  :global(.d-sub) {
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    color: var(--color-text-muted);
    text-align: center;
  }

  /* transformer architecture diagram */
  :global(.arch-diagram) {
    display: flex;
    gap: 0;
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    justify-content: center;
    position: relative;
  }

  :global(.arch-connector) {
    display: flex;
    align-items: center;
    padding: 0 var(--space-2);
    padding-top: calc(var(--space-18) + var(--space-14));
  }

  :global(.arch-connector svg) {
    display: block;
  }

  :global(.arch-col) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    min-width: 140px;
  }

  :global(.arch-label) {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    margin-bottom: var(--space-1);
  }

  :global(.arch-block) {
    border: 1.5px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: var(--space-1-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    width: 100%;
  }

  :global(.arch-row) {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-align: center;
    background: var(--color-bg);
    color: var(--color-text);
    white-space: nowrap;
  }

  :global(.arch-row.hl) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  :global(.arch-io) {
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    color: var(--color-text-secondary);
    text-align: center;
  }

  :global(.arch-io.top) {
    font-weight: var(--fw-bold);
    color: var(--color-text);
  }

  :global(.arch-cross) {
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    color: var(--color-text-muted);
    font-style: italic;
  }

  :global(.arch-arrow) {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    text-align: center;
    line-height: var(--lh-none);
  }

  :global(.arch-row-arrow) {
    font-size: var(--fs-label);
    color: var(--color-text-muted);
    text-align: center;
    padding: 1px 0;
    line-height: var(--lh-none);
  }

  /* norm comparison diagram */
  :global(.norm-diagram) {
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  :global(.norm-grid) {
    display: grid;
    grid-template-columns: auto repeat(4, 1fr);
    gap: var(--space-0-5);
    margin-bottom: var(--space-4);
  }

  :global(.norm-label-corner) {
    width: 2.5rem;
  }

  :global(.norm-col-header) {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    color: var(--color-text-muted);
    text-align: center;
    padding: var(--space-1) var(--space-1);
  }

  :global(.norm-row-label) {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    padding-right: var(--space-2);
  }

  :global(.norm-cell) {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    padding: var(--space-1-5) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-align: center;
    background: var(--color-bg);
    color: var(--color-text);
  }

  :global(.norm-annotations) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
    margin-bottom: var(--space-4);
  }

  :global(.norm-ann-row),
  :global(.norm-ann-col) {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--color-text-secondary);
  }

  :global(.norm-arrow-right),
  :global(.norm-arrow-down) {
    color: var(--color-accent);
    font-weight: var(--fw-bold);
  }

  :global(.norm-summary) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--color-text-secondary);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }
</style>


<style is:global>
  /* ── Head ── */
  .recon .r-head { margin: var(--space-6) 0 var(--space-6); }
  .recon .r-kicker,
  .recon .r-label,
  .recon .r-toc-h,
  .recon .r-act-h span,
  .recon .r-question .r-q-label {
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    color: var(--color-text-muted);
  }
  .recon .r-title {
    margin: var(--space-2) 0 var(--space-4);
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--fs-h1);
    line-height: var(--lh-tight);
    color: var(--color-text);
  }
  .recon .r-summary {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-lead);
    line-height: var(--lh-ui);
    color: var(--color-text-secondary);
    max-width: 40em;
  }

  /* ── Pipeline track ── */
  .recon .r-track {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--fs-label);
  }
  .recon .r-track li {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
  }
  .recon .r-track li span { opacity: 0.6; }
  .recon .r-track li.on {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-surface);
  }

  /* ── Contents ── */
  .recon .r-toc {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .recon .r-toc-h { margin: 0 0 var(--space-1); color: var(--color-accent); }
  .recon .r-toc ol { margin: 0; padding: 0; list-style: none; }
  .recon .r-toc a {
    display: flex;
    gap: var(--space-2);
    padding: 2px 0;
    font-size: var(--fs-ui);
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .recon .r-toc a:hover { color: var(--color-accent); }
  .recon .r-toc a span { color: var(--color-text-muted); min-width: 1.2em; }

  /* ── Parts and steps ── */
  .recon .r-act { margin-top: var(--space-8); }
  .recon .r-act-h {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0 0 var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--fs-h2);
    line-height: var(--lh-tight);
    color: var(--color-text);
  }
  .recon .r-act-h span { color: var(--color-accent); }
  /* The contents list already closes with a rule. */
  .recon .r-act:first-child .r-act-h { border-top: none; padding-top: 0; }
  .recon .r-step { margin: var(--space-6) 0 var(--space-8); scroll-margin-top: 5rem; }
  .recon .r-step-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .recon .r-step-n {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-none);
    color: var(--color-accent);
  }
  .recon .r-step-t {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--fs-h3);
    line-height: var(--lh-snug);
    color: var(--color-text);
  }
  .recon .r-step-sub {
    margin: var(--space-1) 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-muted);
  }

  /* ── Blocks ── */
  .recon .r-notes { margin: var(--space-4) 0; }
  .recon .r-notes ul { margin: 0; padding-left: var(--space-5); }
  .recon .r-notes li { margin-bottom: var(--space-2); line-height: var(--lh-body); }
  .recon .r-label { margin: 0 0 var(--space-2); }

  .recon .r-eq { margin: var(--space-4) 0; text-align: center; }
  .recon .r-tag {
    display: inline-block;
    padding: 0 var(--space-1-5);
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    color: var(--color-accent);
  }

  .recon .r-table-wrap { margin: var(--space-4) 0; }
  .recon .r-table-wrap table { margin: 0 auto; border-collapse: collapse; font-family: var(--font-sans); font-size: var(--fs-small); }
  .recon .r-table-wrap th,
  .recon .r-table-wrap td { padding: var(--space-1-5) var(--space-4); border-bottom: 1px solid var(--color-border); text-align: center; }
  .recon .r-table-wrap th { color: var(--color-text-muted); }

  .recon .r-question {
    margin: var(--space-6) 0 var(--space-4);
    padding-left: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-snug);
    color: var(--color-text);
  }
  .recon .r-question .r-q-label { display: block; margin-bottom: var(--space-1); color: var(--color-accent); }

  /* Maths at the size of the text around it, like blog posts.
     KaTeX's default 1.21em makes inline formulas shout. */
  .recon .katex { font-size: 1em; }
  .recon .katex-display .katex { font-size: 1.1em; }
  .recon .katex-display { overflow-x: auto; overflow-y: hidden; }

  /* ── Figures ── */
  .recon .r-fig {
    margin: var(--space-6) 0;
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .recon .r-fig svg { display: block; width: 100%; height: auto; }
  /* Phones: SVG text scales with the drawing, so a 600-wide figure in a
     310px column has 6px labels. Keep a floor and let the figure scroll. */
  @media (max-width: 640px) {
    .recon .r-fig { padding: var(--space-3) var(--space-2); overflow-x: auto; overscroll-behavior-x: contain; }
    .recon .r-fig svg { min-width: 520px; }
  }
  .recon .r-fig figcaption {
    margin-top: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    text-align: center;
  }
  .recon .r-fig .layer { fill: var(--color-tag-bg); stroke: var(--color-border); }
  .recon .r-fig .nbr path { fill: var(--color-accent); fill-opacity: 0.25; stroke: var(--color-accent); }
  .recon .r-fig .centre { fill: var(--color-accent); }
  .recon .r-fig .axis { stroke: var(--color-accent); stroke-dasharray: 3 3; }
  .recon .r-fig .patch { fill: var(--color-tag-bg); stroke: var(--color-border); }
  .recon .r-fig .dark { fill: var(--color-text-muted); fill-opacity: 0.55; }
  .recon .r-fig .arrow-line { stroke: var(--color-accent); stroke-width: 2; stroke-dasharray: 4 4; }
  .recon .r-fig .fine path { stroke: var(--color-border); stroke-width: 0.6; fill: none; }
  .recon .r-fig .coarse path { stroke: var(--color-text-muted); stroke-width: 1.4; fill: none; }
  .recon .r-fig .vanes path { stroke: var(--color-accent); stroke-width: 2; stroke-linecap: round; fill: none; }
  .recon .r-fig text { fill: var(--color-text-secondary); font-family: var(--font-mono); }
  .recon .r-fig .fig-label { font-size: 13px; }
  .recon .r-fig .fig-big { font-size: 22px; fill: var(--color-text); }
  .recon .r-fig .mid { text-anchor: middle; }
  .recon .r-fig .accent { fill: var(--color-accent); }
  .recon .r-fig .sig { fill: none; stroke: var(--color-text); stroke-width: 1.6; }
  .recon .r-fig .lap { fill: none; stroke: var(--color-accent); stroke-width: 1.8; }
  .recon .r-fig .zero { stroke: var(--color-border); stroke-dasharray: 4 4; }
  .recon .r-fig .ink { stroke: var(--color-text); stroke-width: 1.6; fill: none; }
  .recon .r-fig .ray { stroke: var(--color-accent); stroke-width: 1.8; }
  .recon .r-fig .faint { stroke: var(--color-text-muted); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .recon .r-fig .soft { fill: var(--color-accent); fill-opacity: 0.12; stroke: var(--color-accent); stroke-opacity: 0.4; }
  .recon .r-fig .pt { fill: var(--color-text); }
  .recon .r-fig .hollow { fill: var(--color-surface); stroke: var(--color-text-muted); stroke-width: 1.6; }
  .recon .r-fig .lineq { stroke: var(--color-accent); stroke-width: 2; }

  /* ── Tangents ── */
  .recon .r-tangent {
    margin: var(--space-6) 0;
    border: 1px dashed var(--color-accent);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
