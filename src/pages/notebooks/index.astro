---
import Layout from '../../layouts/Layout.astro';
import { days as neuroscienceDays } from '../../data/neuroscience-days';
import { days as emotionDays } from '../../data/emotion-days';
import { days as modernNetsDays } from '../../data/modern-nets-days';
import { days as vlmSearchDays } from '../../data/vlm-search-days';
import { entries as slamEntries, months as slamMonths } from '../../data/slam-entries';


const title = "Notebooks — Arshad Kazi";

const longRunning = [
  {
    title: "SLAM from Scratch",
    slug: "slam",
    duration: "6 months",
    commitment: "whenever it happens",
    status: "active" as const,
    startDate: "2026-05-13",
    description: "Building a full SLAM pipeline from scratch. Camera models, feature extraction, matching, motion estimation, mapping, loop closure, graph optimization. Theory and code, no shortcuts.",
    tags: ["computer vision", "robotics", "geometry"],
    entryCount: slamEntries.length,
    months: slamMonths,
    entries: slamEntries,
  },
];

function getEntriesForMonth(entries: typeof slamEntries, month: string) {
  return entries.filter(e => e.date.startsWith(month));
}

function formatMonthShort(monthStr: string): string {
  const date = new Date(monthStr + '-01T00:00:00');
  return date.toLocaleDateString('en-US', { month: 'short' });
}

const experiments = [
  {
    title: "Overview of Modern Nets",
    slug: "modern-nets",
    totalDays: 7,
    completedDays: 7,
    commitment: "1 hr / day",
    status: "completed" as const,
    startDate: "2026-04-27",
    endDate: "2026-05-05",
    description: "Revisiting transformers, tokenizers, attention, and the GPT family. Intuitive understanding for interviews and curiosity.",
    conclusion: "Everything builds on the same transformer attention mechanism. From BPE tokenization to multi-head attention to the full GPT family. The ecosystem on top (RAG, LangChain, agents) is plumbing to make it useful. Still want to go deeper on RoPE, SwiGLU, the chain of thought paper, and diffusion models.",
    tags: ["deep learning", "transformers", "LLMs"],
  },
  {
    title: "Search Images with Words",
    slug: "vlm-search",
    totalDays: 4,
    completedDays: 4,
    commitment: "1 hr / day, weekdays",
    status: "completed" as const,
    startDate: "2026-03-30",
    endDate: "2026-04-04",
    description: "From neuroscience to CLIP to building a working on-device search prototype. How do VLMs bind words to pixels?",
    conclusion: "Went from the CLIP paper to a working implementation from scratch. Two encoders, one shared embedding space, contrastive loss. The key insight is that aligning text and image representations lets you do zero-shot classification and text-to-image search without task-specific training.",
    tags: ["computer vision", "machine learning", "multimodal"],
  },
  {
    title: "Understanding Emotion",
    slug: "emotion",
    totalDays: 7,
    completedDays: 7,
    commitment: "1 hr / day",
    status: "completed" as const,
    startDate: "2026-03-28",
    endDate: "2026-04-09",
    description: "What are emotions, really? The neuroscience of feeling, and why an autistic brain might process them differently.",
    conclusion: "Nobody agrees on what emotions are, but evolution built them for a reason. Basic emotions are universal biology. Higher cognitive emotions like guilt are trust signals. Happiness comes from relationships, not money. Emotions actively distort memory, attention, and judgement. Empathy is not mirroring, it is feeling what others feel. The people we need are those who can manage it.",
    tags: ["neuroscience", "psychology", "autism"],
  },
  {
    title: "Understanding the Visual Cortex",
    slug: "neuroscience",
    totalDays: 7,
    completedDays: 7,
    commitment: "1 hr / day",
    status: "completed" as const,
    startDate: "2026-03-21",
    endDate: "2026-03-27",
    description: "How does the brain process what the eye sees? Tracing the path from retina through two parallel streams, the mechanisms at each stage, and the computations behind perception.",
    conclusion: "The brain doesn't see the world as it is. It builds a model of what the world should be, and checks it against incoming data. The whole journey, from photon hitting the retina to a fully contextualised, emotionally-tagged memory, takes roughly 150 milliseconds.",
    tags: ["neuroscience", "perception", "visual cortex"],
  },
];

function formatDate(dateStr: string): string {
  const date = new Date(dateStr + 'T00:00:00');
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<Layout title={title} activeNav="/notebooks" description="Time-boxed deep dives into topics I'm curious about. Pick a question, spend a week on it, write what I learn." ogImage="/images/og-notebooks.jpg">
  <div class="codex">
    <div class="folio-rule">
      <span class="folio-mark">The Notebooks</span>
      <span class="folio-line"></span>
      <span class="folio-mark">{longRunning.length + experiments.length} volumes</span>
    </div>

    <header class="lede">
      <h1>Notebooks</h1>
      <p>One question, one week, one hour a day. I write down what I learn while I learn it.</p>

      <details class="why">
        <summary>Why I work this way</summary>
        <div class="why-body">
          <p>Transfer learning works in brains too. The prefrontal cortex builds schema, mental frameworks that compress patterns from one domain and apply them to another. The more domains you feed it, the richer the schema. Convolutions in V1 and convolutions in CNNs are the same idea discovered independently. Attention in the parietal cortex and attention in transformers solve the same resource allocation problem. These are not metaphors. They are convergent solutions.</p>
          <p>Leonardo studied anatomy to paint better and painted to understand anatomy better. Feynman learned to pick locks to understand information theory. Ramanujan found number theory in temple floor patterns. Cross-domain learning is not a distraction from depth. It is how depth actually works.</p>
          <p>The time box is the point. Retrieval under pressure consolidates memory faster than passive review, and the hippocampus encodes better when a session has a clear boundary. You cannot passively read for sixty minutes and pretend you understood it. You have to write what you know, find the gaps, and come back the next day to fill them.</p>
          <p>I am a Leonardo fanboy, not because I think I am smart like him because I am really not, but because the man had no formal education past age 14 and still taught himself anatomy and optics and geology and engineering from whatever books and mentors he could get his hands on, and that is the only way I have ever been able to learn anything either. He kept notebooks his entire life, thousands of pages, anatomy next to fluid dynamics next to machine designs, not organized by subject but by date, and he called himself "discepolo della esperienza" which means disciple of experience, and I think the notebook was never documentation for him, it was the actual thinking tool, the place where looking at something carefully enough turns into understanding it.</p>
        </div>
      </details>
    </header>

    <!-- ── Open ──────────────────────────────────────── -->
    <div class="ledger-head">
      <span class="ledger-title">Open</span>
      <span class="ledger-rule"></span>
    </div>

    <div class="ledger">
      {longRunning.map((proj, i) => (
        <a href={`/notebooks/${proj.slug}`} class="volume open">
          <span class="vol-num">{String(i + 1).padStart(2, '0')}</span>
          <div class="vol-main">
            <h2>{proj.title}</h2>
            <p>{proj.description}</p>
          </div>
          <div class="vol-meta">
            <span class="meta-figure">{proj.entryCount}</span>
            <span class="meta-unit">{proj.entryCount === 1 ? 'entry' : 'entries'}</span>
            <span class="meta-date">from {formatDate(proj.startDate)}</span>
          </div>
        </a>
      ))}

      {experiments.filter(e => e.status === 'active').map((exp, i) => (
        <a href={`/notebooks/${exp.slug}`} class="volume open">
          <span class="vol-num">{String(longRunning.length + i + 1).padStart(2, '0')}</span>
          <div class="vol-main">
            <h2>{exp.title}</h2>
            <p>{exp.description}</p>
            <div class="tally">
              {Array.from({length: exp.totalDays}).map((_, d) => (
                <span class={`tick ${d < exp.completedDays ? 'struck' : ''}`}></span>
              ))}
            </div>
          </div>
          <div class="vol-meta">
            <span class="meta-figure">{exp.completedDays}<span class="of">/{exp.totalDays}</span></span>
            <span class="meta-unit">days</span>
            <span class="meta-date">from {formatDate(exp.startDate)}</span>
          </div>
        </a>
      ))}
    </div>

    <!-- ── Closed ────────────────────────────────────── -->
    <div class="ledger-head">
      <span class="ledger-title">Closed</span>
      <span class="ledger-rule"></span>
    </div>

    <div class="ledger">
      {experiments.filter(e => e.status === 'completed').map((exp, i) => {
        const days = exp.slug === 'neuroscience' ? neuroscienceDays : exp.slug === 'emotion' ? emotionDays : exp.slug === 'modern-nets' ? modernNetsDays : exp.slug === 'vlm-search' ? vlmSearchDays : [];
        const activeDays = days.filter(d => d.curiosityTitle);
        return (
        <div class="volume-wrap">
          <a href={`/notebooks/${exp.slug}`} class="volume">
            <span class="vol-num">{String(longRunning.length + experiments.filter(e => e.status === 'active').length + i + 1).padStart(2, '0')}</span>
            <div class="vol-main">
              <h2>{exp.title}</h2>
              <p>{exp.description}</p>
            </div>
            <div class="vol-meta">
              <span class="meta-figure">{exp.totalDays}</span>
              <span class="meta-unit">days</span>
              <span class="meta-date">{formatDate(exp.endDate)}</span>
            </div>
          </a>

          {activeDays.length > 0 && (
            <details class="contents">
              <summary>Contents<span class="sum-count">{activeDays.length}</span></summary>
              <ol class="questions">
                {activeDays.map(d => (
                  <li>
                    <span class="q-day">{String(d.day).padStart(2, '0')}</span>
                    <span class="q-text">{d.curiosityTitle}</span>
                  </li>
                ))}
              </ol>
            </details>
          )}
        </div>
      );})}
    </div>
  </div>
</Layout>

<style>
  .codex {
    display: flex;
    flex-direction: column;
  }

  /* ── Folio rule ────────────────────────────────────── */
  .folio-rule {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .folio-mark {
    font-family: var(--font-serif);
    font-variant: small-caps;
    font-style: normal;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    text-transform: none;

    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .folio-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  /* ── Lede ──────────────────────────────────────────── */
  .lede {
    margin-bottom: var(--space-2xl);
  }

  .lede h1 {
    font-size: 2rem;
    margin-bottom: var(--space-sm);
  }

  .lede > p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 52ch;
    margin: 0 0 var(--space-md);
  }

  /* The long rationale stays folded until asked for. */
  .why summary,
  .contents summary {
    font-family: var(--font-serif);
    font-variant: small-caps;
    font-style: normal;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    text-transform: none;

    color: var(--color-text-muted);
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0;
    user-select: none;
  }

  .why summary::-webkit-details-marker,
  .contents summary::-webkit-details-marker {
    display: none;
  }

  .why summary::before,
  .contents summary::before {
    content: '+';
    font-size: 0.85rem;
    line-height: 1;
  }

  .why[open] summary::before,
  .contents[open] summary::before {
    content: '−';
  }

  .why summary:hover,
  .contents summary:hover {
    color: var(--color-accent);
  }

  .why-body {
    padding-top: var(--space-md);
    max-width: 66ch;
  }

  .why-body p {
    font-size: 1.12rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-md);
  }

  .why-body p:last-child {
    margin-bottom: 0;
  }

  /* ── Ledger ────────────────────────────────────────── */
  .ledger-head {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xs);
  }

  .ledger-title {
    font-family: var(--font-serif);
    font-variant: small-caps;
    font-style: normal;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    text-transform: none;

    color: var(--color-text);
  }

  .ledger-rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .ledger {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-2xl);
  }

  .volume-wrap {
    border-bottom: 1px solid var(--color-border-light);
  }

  .volume-wrap:last-child {
    border-bottom: none;
  }

  /* One aligned row per volume: number, entry, figures. */
  .volume {
    display: grid;
    grid-template-columns: 2.4rem 1fr 6.5rem;
    gap: var(--space-md);
    align-items: baseline;
    padding: var(--space-md) 0;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--color-border-light);
  }

  .volume-wrap .volume {
    border-bottom: none;
    padding-bottom: var(--space-sm);
  }

  .ledger > .volume:last-child {
    border-bottom: none;
  }

  .volume:hover {
    text-decoration: none;
  }

  .vol-num {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    opacity: 0.6;
    transition: color 0.15s ease, opacity 0.15s ease;
  }

  .volume.open .vol-num {
    color: var(--color-accent);
    opacity: 0.9;
  }

  .volume:hover .vol-num {
    color: var(--color-accent);
    opacity: 1;
  }

  .vol-main h2 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text);
    margin: 0 0 0.25rem;
    transition: color 0.15s ease;
  }

  .volume:hover .vol-main h2 {
    color: var(--color-accent);
  }

  .vol-main p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 54ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Figures column, right aligned like a ledger ───── */
  .vol-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1px;
    text-align: right;
  }

  .meta-figure {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    line-height: 1.1;
    color: var(--color-text-secondary);
  }

  .meta-figure .of {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .meta-unit {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .meta-date {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    color: var(--color-text-muted);
    opacity: 0.7;
    margin-top: 0.3rem;
    white-space: nowrap;
  }

  /* ── Tally marks ───────────────────────────────────── */
  .tally {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    margin-top: var(--space-sm);
  }

  .tick {
    width: 2px;
    height: 13px;
    background: var(--color-border);
  }

  .tick.struck {
    background: var(--color-accent);
  }

  /* ── Contents disclosure ───────────────────────────── */
  .contents {
    padding: 0 0 var(--space-md) calc(2.4rem + var(--space-md));
  }

  .sum-count {
    font-size: 0.6rem;
    opacity: 0.65;
  }

  .questions {
    list-style: none;
    padding: var(--space-sm) 0 0;
    margin: 0;
  }

  .questions li {
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
    padding: 0.12rem 0;
    margin: 0;
  }

  .q-day {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-accent);
    opacity: 0.8;
  }

  .q-text {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  @media (max-width: 640px) {
    .volume {
      grid-template-columns: 1.9rem 1fr;
      gap: var(--space-sm) var(--space-md);
    }

    .vol-meta {
      grid-column: 2;
      flex-direction: row;
      align-items: baseline;
      gap: 0.4rem;
      text-align: left;
    }

    .meta-figure {
      font-size: 0.85rem;
    }

    .meta-date {
      margin-top: 0;
    }

    .vol-main h2 {
      font-size: 1.2rem;
    }

    .contents {
      padding-left: calc(1.9rem + var(--space-md));
    }
  }
</style>
