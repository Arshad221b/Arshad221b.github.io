---
import Layout from '../../layouts/Layout.astro';
import { days as neuroscienceDays } from '../../data/neuroscience-days';
import { days as emotionDays } from '../../data/emotion-days';
import { days as modernNetsDays } from '../../data/modern-nets-days';
import { days as vlmSearchDays } from '../../data/vlm-search-days';
import { entries as slamEntries } from '../../data/slam-entries';


const title = "Notebooks — Arshad Kazi";

const longRunning = [
  {
    title: "SLAM from Scratch",
    slug: "slam",
    duration: "6 months",
    commitment: "whenever it happens",
    status: "active" as const,
    startDate: "2026-05-13",
    description: "Building a full SLAM pipeline from scratch. Camera models, feature extraction, matching, motion estimation, mapping, loop closure, graph optimization. Theory and code, no shortcuts.",
    tags: ["computer vision", "robotics", "geometry"],
    scope: [
      "Camera models",
      "Feature extraction",
      "Matching",
      "Motion estimation",
      "Mapping",
      "Loop closure",
      "Graph optimization",
    ],
    entryCount: slamEntries.length,
  },
];

const experiments = [
  {
    title: "Overview of Modern Nets",
    slug: "modern-nets",
    totalDays: 7,
    completedDays: 7,
    commitment: "1 hr / day",
    status: "completed" as const,
    startDate: "2026-04-27",
    endDate: "2026-05-05",
    description: "Revisiting transformers, tokenizers, attention, and the GPT family. Intuitive understanding for interviews and curiosity.",
    conclusion: "Everything builds on the same transformer attention mechanism. From BPE tokenization to multi-head attention to the full GPT family. The ecosystem on top (RAG, LangChain, agents) is plumbing to make it useful. Still want to go deeper on RoPE, SwiGLU, the chain of thought paper, and diffusion models.",
    tags: ["deep learning", "transformers", "LLMs"],
  },
  {
    title: "Search Images with Words",
    slug: "vlm-search",
    totalDays: 4,
    completedDays: 4,
    commitment: "1 hr / day, weekdays",
    status: "completed" as const,
    startDate: "2026-03-30",
    endDate: "2026-04-04",
    description: "From neuroscience to CLIP to building a working on-device search prototype. How do VLMs bind words to pixels?",
    conclusion: "Went from the CLIP paper to a working implementation from scratch. Two encoders, one shared embedding space, contrastive loss. The key insight is that aligning text and image representations lets you do zero-shot classification and text-to-image search without task-specific training.",
    tags: ["computer vision", "machine learning", "multimodal"],
  },
  {
    title: "Understanding Emotion",
    slug: "emotion",
    totalDays: 7,
    completedDays: 7,
    commitment: "1 hr / day",
    status: "completed" as const,
    startDate: "2026-03-28",
    endDate: "2026-04-09",
    description: "What are emotions, really? The neuroscience of feeling, and why an autistic brain might process them differently.",
    conclusion: "Nobody agrees on what emotions are, but evolution built them for a reason. Basic emotions are universal biology. Higher cognitive emotions like guilt are trust signals. Happiness comes from relationships, not money. Emotions actively distort memory, attention, and judgement. Empathy is not mirroring, it is feeling what others feel. The people we need are those who can manage it.",
    tags: ["neuroscience", "psychology", "autism"],
  },
  {
    title: "Understanding the Visual Cortex",
    slug: "neuroscience",
    totalDays: 7,
    completedDays: 7,
    commitment: "1 hr / day",
    status: "completed" as const,
    startDate: "2026-03-21",
    endDate: "2026-03-27",
    description: "How does the brain process what the eye sees? Tracing the path from retina through two parallel streams, the mechanisms at each stage, and the computations behind perception.",
    conclusion: "The brain doesn't see the world as it is. It builds a model of what the world should be, and checks it against incoming data. The whole journey, from photon hitting the retina to a fully contextualised, emotionally-tagged memory, takes roughly 150 milliseconds.",
    tags: ["neuroscience", "perception", "visual cortex"],
  },
];

function formatDate(dateStr: string): string {
  const date = new Date(dateStr + 'T00:00:00');
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

// Everything below is counted from the actual day data, so the figures on this
// page can never drift from what is written inside the notebooks.
type AnyDay = {
  day: number;
  curiosityTitle?: string;
  summary?: string;
  bullets?: string[];
  sections?: { title: string; bullets?: string[] }[];
};

const dayData: Record<string, AnyDay[]> = {
  neuroscience: neuroscienceDays,
  emotion: emotionDays,
  'modern-nets': modernNetsDays,
  'vlm-search': vlmSearchDays,
};

function countNotes(days: AnyDay[]): number {
  return days.reduce((total, d) => {
    const own = d.bullets?.length ?? 0;
    const inSections = (d.sections ?? []).reduce((n, s) => n + (s.bullets?.length ?? 0), 0);
    return total + own + inSections;
  }, 0);
}

function countSections(days: AnyDay[]): number {
  return days.reduce((total, d) => total + (d.sections?.length ?? 0), 0);
}

const stats = Object.fromEntries(
  Object.entries(dayData).map(([slug, days]) => {
    const written = days.filter(d => d.curiosityTitle);
    return [slug, {
      questions: written.map(d => ({
        day: d.day,
        title: d.curiosityTitle as string,
        // Day pages only get built when there is something written on them.
        hasPage: (d.bullets?.length ?? 0) > 0,
      })),
      notes: countNotes(days),
      sections: countSections(days),
    }];
  })
);

const totalDays = experiments.reduce((n, e) => n + e.completedDays, 0);
const totalNotes = Object.values(stats).reduce((n, s) => n + s.notes, 0);
const totalQuestions = Object.values(stats).reduce((n, s) => n + s.questions.length, 0);
---

<Layout title={title} activeNav="/notebooks" description="Time-boxed deep dives into topics I'm curious about. Pick a question, spend a week on it, write what I learn." ogImage="/images/og-notebooks.jpg">
  <div class="codex">
    <div class="folio-rule">
      <span class="folio-mark">The Notebooks</span>
      <span class="folio-line"></span>
      <span class="folio-mark">{longRunning.length + experiments.length} volumes</span>
    </div>

    <header class="lede">
      <h1>Notebooks</h1>
      <p>One question, one week, one hour a day. I write down what I learn while I learn it.</p>

      <details class="why">
        <summary>Why I work this way</summary>
        <div class="why-body">
          <p>Transfer learning works in brains too. The prefrontal cortex builds schema, mental frameworks that compress patterns from one domain and apply them to another. The more domains you feed it, the richer the schema. Convolutions in V1 and convolutions in CNNs are the same idea discovered independently. Attention in the parietal cortex and attention in transformers solve the same resource allocation problem. These are not metaphors. They are convergent solutions.</p>
          <p>Leonardo studied anatomy to paint better and painted to understand anatomy better. Feynman learned to pick locks to understand information theory. Ramanujan found number theory in temple floor patterns. Cross-domain learning is not a distraction from depth. It is how depth actually works.</p>
          <p>The time box is the point. Retrieval under pressure consolidates memory faster than passive review, and the hippocampus encodes better when a session has a clear boundary. You cannot passively read for sixty minutes and pretend you understood it. You have to write what you know, find the gaps, and come back the next day to fill them.</p>
          <p>I am a Leonardo fanboy, not because I think I am smart like him because I am really not, but because the man had no formal education past age 14 and still taught himself anatomy and optics and geology and engineering from whatever books and mentors he could get his hands on, and that is the only way I have ever been able to learn anything either. He kept notebooks his entire life, thousands of pages, anatomy next to fluid dynamics next to machine designs, not organized by subject but by date, and he called himself "discepolo della esperienza" which means disciple of experience, and I think the notebook was never documentation for him, it was the actual thinking tool, the place where looking at something carefully enough turns into understanding it.</p>
        </div>
      </details>
    </header>

    <!-- What is actually inside, in figures. -->
    <dl class="figures">
      <div>
        <dt>Days written</dt>
        <dd>{totalDays}</dd>
      </div>
      <div>
        <dt>Questions chased</dt>
        <dd>{totalQuestions}</dd>
      </div>
      <div>
        <dt>Notes taken</dt>
        <dd>{totalNotes}</dd>
      </div>
      <div>
        <dt>Volumes</dt>
        <dd>{longRunning.length + experiments.length}</dd>
      </div>
    </dl>

    <!-- ── Open ──────────────────────────────────────── -->
    <div class="ledger-head">
      <span class="ledger-title">Open</span>
      <span class="ledger-rule"></span>
    </div>

    <div class="ledger">
      {longRunning.map((proj, i) => (
        <div class="volume-wrap">
          <a href={`/notebooks/${proj.slug}`} class="volume open">
            <span class="vol-num">{String(i + 1).padStart(2, '0')}</span>
            <div class="vol-main">
              <h2>{proj.title}</h2>
              <p>{proj.description}</p>
            </div>
            <div class="vol-meta">
              <span class="meta-figure">{proj.entryCount}</span>
              <span class="meta-unit">{proj.entryCount === 1 ? 'entry' : 'entries'}</span>
              <span class="meta-date">from {formatDate(proj.startDate)}</span>
            </div>
          </a>

          <div class="vol-body">
            <p class="body-label">The pipeline, stage by stage</p>
            <ol class="stages">
              {proj.scope.map((stage, s) => (
                <li>
                  <span class="q-day">{String(s + 1).padStart(2, '0')}</span>
                  <span class="q-text">{stage}</span>
                </li>
              ))}
            </ol>
            <p class="running-note">Running over {proj.duration}, {proj.commitment}. Entries land here as each stage gets built.</p>
            <ul class="tags">
              {proj.tags.map(tag => <li>{tag}</li>)}
            </ul>
          </div>
        </div>
      ))}

      {experiments.filter(e => e.status === 'active').map((exp, i) => (
        <a href={`/notebooks/${exp.slug}`} class="volume open">
          <span class="vol-num">{String(longRunning.length + i + 1).padStart(2, '0')}</span>
          <div class="vol-main">
            <h2>{exp.title}</h2>
            <p>{exp.description}</p>
            <div class="tally">
              {Array.from({length: exp.totalDays}).map((_, d) => (
                <span class={`tick ${d < exp.completedDays ? 'struck' : ''}`}></span>
              ))}
            </div>
          </div>
          <div class="vol-meta">
            <span class="meta-figure">{exp.completedDays}<span class="of">/{exp.totalDays}</span></span>
            <span class="meta-unit">days</span>
            <span class="meta-date">from {formatDate(exp.startDate)}</span>
          </div>
        </a>
      ))}
    </div>

    <!-- ── Closed ────────────────────────────────────── -->
    <div class="ledger-head">
      <span class="ledger-title">Closed</span>
      <span class="ledger-rule"></span>
    </div>

    <div class="ledger">
      {experiments.filter(e => e.status === 'completed').map((exp, i) => {
        const stat = stats[exp.slug];
        return (
        <div class="volume-wrap">
          <a href={`/notebooks/${exp.slug}`} class="volume">
            <span class="vol-num">{String(longRunning.length + experiments.filter(e => e.status === 'active').length + i + 1).padStart(2, '0')}</span>
            <div class="vol-main">
              <h2>{exp.title}</h2>
              <p>{exp.description}</p>
            </div>
            <div class="vol-meta">
              <span class="meta-figure">{exp.totalDays}</span>
              <span class="meta-unit">days</span>
              <span class="meta-date">{formatDate(exp.endDate)}</span>
            </div>
          </a>

          <div class="vol-body">
            {stat && stat.questions.length > 0 && (
              <>
                <p class="body-label">What I asked, day by day</p>
                <ol class="questions">
                  {stat.questions.map(q => (
                    <li>
                      {q.hasPage ? (
                        <a href={`/notebooks/${exp.slug}/day-${q.day}`}>
                          <span class="q-day">{String(q.day).padStart(2, '0')}</span>
                          <span class="q-text">{q.title}</span>
                        </a>
                      ) : (
                        <span class="q-row">
                          <span class="q-day">{String(q.day).padStart(2, '0')}</span>
                          <span class="q-text">{q.title}</span>
                        </span>
                      )}
                    </li>
                  ))}
                </ol>
              </>
            )}

            <blockquote class="verdict">
              <p class="body-label">Where it landed</p>
              <p>{exp.conclusion}</p>
            </blockquote>

            <div class="vol-foot">
              <ul class="tags">
                {exp.tags.map(tag => <li>{tag}</li>)}
              </ul>
              {stat && (
                <span class="counts">
                  {stat.notes} notes{stat.sections > 0 ? `, ${stat.sections} sections` : ''}, {exp.commitment}
                </span>
              )}
            </div>
          </div>
        </div>
      );})}
    </div>
  </div>
</Layout>

<style>
  .codex {
    display: flex;
    flex-direction: column;
  }

  /* ── Folio rule ────────────────────────────────────── */
  .folio-rule {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .folio-mark {
    font-family: var(--font-serif);
    font-variant: small-caps;
    font-style: normal;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    text-transform: none;

    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .folio-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  /* ── Lede ──────────────────────────────────────────── */
  .lede {
    margin-bottom: var(--space-2xl);
  }

  .lede h1 {
    font-size: 2rem;
    margin-bottom: var(--space-sm);
  }

  .lede > p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 52ch;
    margin: 0 0 var(--space-md);
  }

  /* The long rationale stays folded until asked for. */
  .why summary {
    font-family: var(--font-serif);
    font-variant: small-caps;
    font-style: normal;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    text-transform: none;

    color: var(--color-text-muted);
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0;
    user-select: none;
  }

  .why summary::-webkit-details-marker {
    display: none;
  }

  .why summary::before {
    content: '+';
    font-size: 0.85rem;
    line-height: 1;
  }

  .why[open] summary::before {
    content: '−';
  }

  .why summary:hover {
    color: var(--color-accent);
  }

  .why-body {
    padding-top: var(--space-md);
    max-width: 66ch;
  }

  .why-body p {
    font-size: 1.12rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-md);
  }

  .why-body p:last-child {
    margin-bottom: 0;
  }

  /* ── Figures band ──────────────────────────────────── */
  .figures {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-md) 0;
    margin: 0 0 var(--space-2xl);
  }

  .figures div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
  }

  .figures dt {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .figures dd {
    font-family: var(--font-serif);
    font-size: 1.9rem;
    line-height: 1;
    color: var(--color-text);
    margin: 0;
  }

  /* ── Ledger ────────────────────────────────────────── */
  .ledger-head {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xs);
  }

  .ledger-title {
    font-family: var(--font-serif);
    font-variant: small-caps;
    font-style: normal;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    text-transform: none;

    color: var(--color-text);
  }

  .ledger-rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .ledger {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-2xl);
  }

  .volume-wrap {
    border-bottom: 1px solid var(--color-border-light);
  }

  .volume-wrap:last-child {
    border-bottom: none;
  }

  /* One aligned row per volume: number, entry, figures. */
  .volume {
    display: grid;
    grid-template-columns: 2.4rem 1fr 6.5rem;
    gap: var(--space-md);
    align-items: baseline;
    padding: var(--space-md) 0;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--color-border-light);
  }

  .volume-wrap .volume {
    border-bottom: none;
    padding-bottom: var(--space-sm);
  }

  .ledger > .volume:last-child {
    border-bottom: none;
  }

  .volume:hover {
    text-decoration: none;
  }

  .vol-num {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    opacity: 0.6;
    transition: color 0.15s ease, opacity 0.15s ease;
  }

  .volume.open .vol-num {
    color: var(--color-accent);
    opacity: 0.9;
  }

  .volume:hover .vol-num {
    color: var(--color-accent);
    opacity: 1;
  }

  .vol-main h2 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text);
    margin: 0 0 0.25rem;
    transition: color 0.15s ease;
  }

  .volume:hover .vol-main h2 {
    color: var(--color-accent);
  }

  .vol-main p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 54ch;
  }

  /* ── Figures column, right aligned like a ledger ───── */
  .vol-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1px;
    text-align: right;
  }

  .meta-figure {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    line-height: 1.1;
    color: var(--color-text-secondary);
  }

  .meta-figure .of {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .meta-unit {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .meta-date {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    color: var(--color-text-muted);
    opacity: 0.7;
    margin-top: 0.3rem;
    white-space: nowrap;
  }

  /* ── Tally marks ───────────────────────────────────── */
  .tally {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    margin-top: var(--space-sm);
  }

  .tick {
    width: 2px;
    height: 13px;
    background: var(--color-border);
  }

  .tick.struck {
    background: var(--color-accent);
  }

  /* ── Volume body: the contents, out in the open ────── */
  .vol-body {
    padding: 0 0 var(--space-lg) calc(2.4rem + var(--space-md));
  }

  .body-label {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-xs);
  }

  .questions,
  .stages {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-md);
  }

  .questions li,
  .stages li {
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border-light);
  }

  .questions li:first-child,
  .stages li:first-child {
    border-top: none;
  }

  .questions a,
  .q-row,
  .stages li {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    padding: 0.4rem 0;
    text-decoration: none;
    color: inherit;
  }

  .questions a:hover {
    text-decoration: none;
  }

  .questions a:hover .q-text {
    color: var(--color-accent);
  }

  .q-day {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-accent);
    opacity: 0.8;
    flex-shrink: 0;
  }

  .q-text {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
    transition: color 0.15s ease;
  }

  /* ── Conclusion ────────────────────────────────────── */
  .verdict {
    border-left: 2px solid var(--color-border);
    padding: 0 0 0 var(--space-md);
    margin: 0 0 var(--space-md);
  }

  .verdict p:last-child {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 66ch;
    margin: 0;
  }

  .running-note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-md);
    max-width: 60ch;
  }

  /* ── Foot: tags and counts ─────────────────────────── */
  .vol-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    padding: 0;
    margin: 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 0.15rem 0.45rem;
    margin: 0;
  }

  .counts {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-text-muted);
    opacity: 0.75;
  }

  @media (max-width: 640px) {
    .volume {
      grid-template-columns: 1.9rem 1fr;
      gap: var(--space-sm) var(--space-md);
    }

    .vol-meta {
      grid-column: 2;
      flex-direction: row;
      align-items: baseline;
      gap: 0.4rem;
      text-align: left;
    }

    .meta-figure {
      font-size: 0.85rem;
    }

    .meta-date {
      margin-top: 0;
    }

    .vol-main h2 {
      font-size: 1.2rem;
    }

    .vol-body {
      padding-left: calc(1.9rem + var(--space-md));
    }

    .figures {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-sm) var(--space-md);
    }

