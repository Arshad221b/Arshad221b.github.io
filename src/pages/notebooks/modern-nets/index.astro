---
import NotebookFront from '../../../components/NotebookFront.astro';
import { experiment, days } from '../../../data/modern-nets-days';
import { notebooks } from '../../../lib/notebooks';

const base = '/notebooks/modern-nets';

// The strands this notebook runs along, and which days cover each.
const STAGES = [
  {
    "name": "Tokenization",
    "io": "text → tokens"
  },
  {
    "name": "Embeddings and position",
    "io": "tokens → vectors"
  },
  {
    "name": "Attention",
    "io": "vectors → context"
  },
  {
    "name": "Architecture",
    "io": "blocks, residuals, norms"
  },
  {
    "name": "Training objectives",
    "io": "what the model learns from"
  },
  {
    "name": "Model families",
    "io": "BERT, GPT, LLaMA, Mistral"
  },
  {
    "name": "Tooling",
    "io": "RAG, agents, orchestration"
  }
];
const nb = notebooks.find(n => n.slug === 'modern-nets')!;
const written = nb.days.filter(d => d.href);
const SYLLABUS: { topic: string; day?: number }[][] = [
  [{"topic": "BPE (Byte Pair Encoding)", "day": 1}],
  [{"topic": "Positional embedding", "day": 1}, {"topic": "Input embeddings and what I need to understand", "day": 1}, {"topic": "RoPE"}],
  [{"topic": "The dot product and why it matters", "day": 2}, {"topic": "Encoder mask: padding mask", "day": 3}, {"topic": "Decoder masking: causal mask", "day": 3}],
  [{"topic": "Transformer architecture (full diagram)", "day": 4}, {"topic": "Feedforward network", "day": 5}, {"topic": "Residual connections", "day": 5}, {"topic": "Layer norm vs batch norm", "day": 5}, {"topic": "SwiGLU"}],
  [{"topic": "Pretraining", "day": 5}, {"topic": "GPT 1 to 3 and Chinchilla", "day": 5}],
  [{"topic": "BERT vs GPT", "day": 3}, {"topic": "What LLaMA did", "day": 6}, {"topic": "What Mistral did differently", "day": 6}, {"topic": "Reasoning models", "day": 6}, {"topic": "Multimodals and image generation", "day": 6}, {"topic": "The chain-of-thought paper"}, {"topic": "Diffusion models"}],
  [{"topic": "RAG (Retrieval-Augmented Generation)", "day": 7}, {"topic": "Vector databases", "day": 7}, {"topic": "Modern RAG improvements", "day": 7}, {"topic": "LangChain", "day": 7}, {"topic": "LangGraph", "day": 7}, {"topic": "Function calling and agents", "day": 7}, {"topic": "MCP (Model Context Protocol)", "day": 7}],
];
// A day covers every strand it wrote a topic in.
const DAY_STAGES: Record<number, number[]> = {};
SYLLABUS.forEach((g, i) => g.forEach(t => { if (t.day) (DAY_STAGES[t.day] ??= []).includes(i) || DAY_STAGES[t.day].push(i); }));
const dateOf = Object.fromEntries(days.map(d => [d.day, d.date]));
const sectionsOf = Object.fromEntries(days.map(d => [d.day, (d as { sections?: { title: string }[] }).sections ?? []]));

const frontDays = written.map(d => ({ day: d.day, date: dateOf[d.day], title: d.title, minutes: d.minutes, href: d.href!, stages: DAY_STAGES[d.day] ?? [] }));
const index = written.flatMap(d => [
  { term: d.title, kind: 'step' as const, day: d.day, href: d.href! },
  ...sectionsOf[d.day].map(sec => ({ term: sec.title, kind: 'step' as const, day: d.day, href: d.href! })),
]);
---

<NotebookFront
  title={experiment.title}
  description="Revisiting transformers, tokenizers, attention, and the GPT family. Intuitive understanding for interviews and curiosity."
  status={experiment.status === 'active' ? 'active' : 'complete'}
  startDate={experiment.startDate}
  lede="I'd used transformers but couldn't explain the architecture end to end without stumbling. A revision pass, piece by piece: tokenizers, positional encoding, attention, BERT vs GPT, and the GPT family."
  days={frontDays}
  stages={STAGES}
  syllabus={SYLLABUS.map(g => g.map(t => ({ topic: t.topic, href: t.day ? `${base}/day-${t.day}` : undefined })))}
  index={index}
>
</NotebookFront>

