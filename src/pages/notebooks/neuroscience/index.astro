---
import NotebookFront from '../../../components/NotebookFront.astro';
import { experiment, days } from '../../../data/neuroscience-days';
import { notebooks } from '../../../lib/notebooks';

const base = '/notebooks/neuroscience';

// The strands this notebook runs along, and which days cover each.
const STAGES = [
  {
    "name": "Retina and LGN",
    "io": "light → signals"
  },
  {
    "name": "Edges in V1",
    "io": "signals → edges"
  },
  {
    "name": "Context",
    "io": "neighbours shape responses"
  },
  {
    "name": "Two streams",
    "io": "where vs what"
  },
  {
    "name": "Depth",
    "io": "two eyes → distance"
  },
  {
    "name": "Recognition",
    "io": "seeing → knowing"
  },
  {
    "name": "The whole system",
    "io": "how it all connects"
  }
];
const nb = notebooks.find(n => n.slug === 'neuroscience')!;
const written = nb.days.filter(d => d.href);
const SYLLABUS: { topic: string; day?: number }[][] = [
  [{"topic": "How the brain begins processing vision", "day": 1}],
  [{"topic": "V1 — First Step of Intermediate Visual Processing", "day": 3}, {"topic": "Three Signals That Resolve Visual Ambiguity", "day": 3}, {"topic": "Evolution of Edge Detection Across Species", "day": 3}, {"topic": "The Brain Only Responds to Edges", "day": 5}],
  [{"topic": "Contextual Modulation", "day": 4}, {"topic": "Inhibitory Surround — End-Stopping", "day": 4}, {"topic": "Moving Stimuli & Saccades", "day": 4}, {"topic": "Classical vs Non-Classical Receptive Fields", "day": 5}, {"topic": "Horizontal Connections & Feedback", "day": 5}, {"topic": "Colour & Brightness Are Not Fixed", "day": 5}],
  [{"topic": "Dorsal Stream — \"Where / How\"", "day": 2}, {"topic": "Ventral Stream — \"What\"", "day": 2}, {"topic": "Dorsal Stream — Complete Architecture", "day": 7}, {"topic": "Ventral Stream — Complete Architecture", "day": 7}],
  [{"topic": "Three Types of Depth Neurons", "day": 5}, {"topic": "The Occlusion Problem — Amodal Completion", "day": 5}, {"topic": "Kanizsa Triangles — Seeing Edges That Don't Exist", "day": 5}, {"topic": "Global Correspondence Problem — V1 to V2", "day": 5}, {"topic": "Disparity Capture — Depth Propagates Across Surfaces", "day": 5}, {"topic": "Da Vinci Stereopsis", "day": 5}, {"topic": "Monocular Cues — Depth With One Eye", "day": 5}, {"topic": "Border Ownership — Image Segmentation in V2", "day": 5}],
  [{"topic": "The High-Level Visual Pipeline", "day": 6}, {"topic": "V4 — Shape, Colour Constancy & the Beginning of Invariance", "day": 6}, {"topic": "Posterior IT — Complete Object Representation (Perception)", "day": 6}, {"topic": "IT Cortical Columns — The Architecture of Object Knowledge", "day": 6}, {"topic": "Population Coding — How IT Actually Recognises Objects", "day": 6}, {"topic": "Damage to Posterior IT — Apperceptive Agnosia", "day": 6}, {"topic": "Anterior IT — Where Percepts Connect to Meaning", "day": 6}, {"topic": "Prosopagnosia — The Face Case", "day": 6}, {"topic": "Category-Specific Agnosias", "day": 6}, {"topic": "Amygdala & Hippocampus — Vision Becomes Cognition", "day": 6}],
  [{"topic": "Perceptual Learning", "day": 5}, {"topic": "Pop-Out & Visual Search", "day": 5}, {"topic": "Attention — The Final Gate", "day": 5}, {"topic": "Reflections — What the Brain Teaches Us About Computer Vision", "day": 7}],
];
// A day covers every strand it wrote a topic in.
const DAY_STAGES: Record<number, number[]> = {};
SYLLABUS.forEach((g, i) => g.forEach(t => { if (t.day) (DAY_STAGES[t.day] ??= []).includes(i) || DAY_STAGES[t.day].push(i); }));
const dateOf = Object.fromEntries(days.map(d => [d.day, d.date]));
const sectionsOf = Object.fromEntries(days.map(d => [d.day, (d as { sections?: { title: string }[] }).sections ?? []]));

const frontDays = written.map(d => ({ day: d.day, date: dateOf[d.day], title: d.title, minutes: d.minutes, href: d.href!, stages: DAY_STAGES[d.day] ?? [] }));
const index = written.flatMap(d => [
  { term: d.title, kind: 'step' as const, day: d.day, href: d.href! },
  ...sectionsOf[d.day].map(sec => ({ term: sec.title, kind: 'step' as const, day: d.day, href: d.href! })),
]);
---

<NotebookFront
  title={experiment.title}
  description="Curiosity-driven daily study of neuroscience. 7-day tiny experiment."
  status={experiment.status === 'active' ? 'active' : 'complete'}
  startDate={experiment.startDate}
  lede="After Ramachandran's Phantoms in the Brain, I wanted to know how the brain turns light on the retina into what we see. The visual pathway from eye to cortex, the part of the brain closest to my work in computer vision."
  days={frontDays}
  stages={STAGES}
  syllabus={SYLLABUS.map(g => g.map(t => ({ topic: t.topic, href: t.day ? `${base}/day-${t.day}` : undefined })))}
  index={index}
>
  <Fragment slot="conclusion">
    <div class="experiment-conclusion">
      <h2>So, how does the brain process what the eye sees?</h2>
      <p>
        It splits the work into two parallel streams, right from the retina. The <strong>dorsal stream</strong> is fast and memoryless: it tracks motion, builds spatial maps, and guides your hands and eyes in real-time. It never "sees" objects. The <strong>ventral stream</strong> is slow and hierarchical: it detects edges, assembles contours, extracts shapes, builds object representations, and connects them to meaning and memory.
      </p>
      <p>
        At every stage, the brain uses relative perception (never absolute), fills in gaps it can't see, predicts what should come next, and resolves ambiguity through context. Perception is not passive recording. It is active construction. The brain doesn't see the world as it is. It builds a model of what the world <em>should</em> be, and checks it against incoming data. When the model is good enough, that's what you perceive.
      </p>
      <p>
        The whole journey, from photon hitting the retina to a fully contextualised, emotionally-tagged memory, takes roughly 150 milliseconds.
      </p>
    </div>
  </Fragment>
</NotebookFront>

