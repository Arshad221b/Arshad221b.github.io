---
import NotebookFront from '../../../components/NotebookFront.astro';
import { experiment, days } from '../../../data/vlm-search-days';
import { notebooks } from '../../../lib/notebooks';

const base = '/notebooks/vlm-search';

// The strands this notebook runs along, and which days cover each.
const STAGES = [
  {
    "name": "Words in the brain",
    "io": "how pixels become words"
  },
  {
    "name": "Two encoders",
    "io": "an image encoder and a text encoder"
  },
  {
    "name": "Contrastive learning",
    "io": "pull matches together, push others apart"
  },
  {
    "name": "Shared embedding space",
    "io": "one space for both"
  },
  {
    "name": "Zero-shot classification",
    "io": "labels as text prompts"
  },
  {
    "name": "Text-to-image search",
    "io": "query by sentence"
  },
  {
    "name": "On device",
    "io": "search on a phone"
  }
];
const nb = notebooks.find(n => n.slug === 'vlm-search')!;
const written = nb.days.filter(d => d.href);
const SYLLABUS: { topic: string; day?: number }[][] = [
  [{"topic": "How the brain ties what we see to words"}],
  [{"topic": "How CLIP works", "day": 1}, {"topic": "How CLIP actually works", "day": 3}],
  [{"topic": "How the contrastive loss works", "day": 2}, {"topic": "Two losses, one average", "day": 2}, {"topic": "Building CLIP on Flickr30k", "day": 4}, {"topic": "Training results", "day": 4}],
  [{"topic": "The key insight of the paper", "day": 3}],
  [{"topic": "Zero-shot image classification pipeline", "day": 4}, {"topic": "Hypernetworks and on-the-fly representations", "day": 4}],
  [{"topic": "Ranking images by a text query"}],
  [{"topic": "Running the encoders on a phone"}],
];
// A day covers every strand it wrote a topic in.
const DAY_STAGES: Record<number, number[]> = {};
SYLLABUS.forEach((g, i) => g.forEach(t => { if (t.day) (DAY_STAGES[t.day] ??= []).includes(i) || DAY_STAGES[t.day].push(i); }));
const dateOf = Object.fromEntries(days.map(d => [d.day, d.date]));
const sectionsOf = Object.fromEntries(days.map(d => [d.day, (d as { sections?: { title: string }[] }).sections ?? []]));

const frontDays = written.map(d => ({ day: d.day, date: dateOf[d.day], title: d.title, minutes: d.minutes, href: d.href!, stages: DAY_STAGES[d.day] ?? [] }));
const index = written.flatMap(d => [
  { term: d.title, kind: 'step' as const, day: d.day, href: d.href! },
  ...sectionsOf[d.day].map(sec => ({ term: sec.title, kind: 'step' as const, day: d.day, href: d.href! })),
]);
---

<NotebookFront
  title={experiment.title}
  description="From neuroscience to CLIP to a working text-to-image search prototype. 7-day tiny experiment."
  status={experiment.status === 'active' ? 'active' : 'complete'}
  startDate={experiment.startDate}
  lede="How do pixels become a word, in the brain and in a vision-language model? From the neuroscience of naming what we see, to CLIP, to a working on-device text-to-image search prototype."
  days={frontDays}
  stages={STAGES}
  syllabus={SYLLABUS.map(g => g.map(t => ({ topic: t.topic, href: t.day ? `${base}/day-${t.day}` : undefined })))}
  index={index}
>
</NotebookFront>

<style>
  .intro-setup {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    border-left: none;
    background: var(--color-bg);
  }

  .intro-setup p {
    font-size: var(--fs-ui);
    line-height: var(--lh-body);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  .setup-questions h4 {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: var(--track-normal);
    margin-bottom: var(--space-2);
  }

  .setup-questions ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .setup-questions li {
    font-family: var(--font-serif);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--color-text-secondary);
    padding: var(--space-1-5) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .setup-questions li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
</style>
