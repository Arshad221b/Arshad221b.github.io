  }

  .ro-label,
  .ro-line,
  .ro-ev {
    animation: rise 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .ro-line { animation-delay: 0.04s; }
  .ro-ev { animation-delay: 0.08s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(7px); }
