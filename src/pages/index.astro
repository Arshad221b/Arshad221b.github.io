---
import Layout from '../layouts/Layout.astro';

const title = "Arshad Kazi";

const elsewhere = [
  { label: "GitHub", href: "https://github.com/Arshad221b" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/arshad221b/" },
  { label: "Substack", href: "https://substack.com/@arshadkazi" },
  { label: "Medium", href: "https://medium.com/@arshad_221b" },
  { label: "Email", href: "mailto:arshadkaziblog@gmail.com" },
];
---

<Layout title={title} activeNav="/" description="Arshad Kazi. Computer vision engineer. Notebooks, technical writing and personal essays." ogImage="/images/og-about.jpg">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Arshad Kazi",
    "url": "https://arshad-kazi.com",
    "image": "https://arshad-kazi.com/images/profile.jpg",
    "jobTitle": "CV/ML Engineer",
    "description": "Computer vision engineer. Notebooks, technical writing and personal essays.",
    "sameAs": [
      "https://github.com/Arshad221b",
      "https://www.linkedin.com/in/arshad221b/",
      "https://medium.com/@arshad_221b",
      "https://substack.com/@arshadkazi"
    ]
  })} />

  <div class="about">
    <div class="folio-rule">
      <span class="folio-mark">About</span>
      <span class="folio-line"></span>
    </div>

    <div class="grid">
      <figure class="plate">
        <div class="plate-frame">
          <img src="/images/profile.jpg" alt="Arshad Kazi" width="640" height="800" draggable="false" oncontextmenu="return false" />
          <span class="plate-guard" aria-hidden="true"></span>
        </div>
      </figure>

      <div class="text">
        <h1>Arshad Kazi</h1>

        <p>I work in computer vision, mostly 3D at the moment: reconstruction, pose, representation. I build things to understand how they work, not just to make them work.</p>

        <p><a href="/notebooks">Notebooks</a> while I am learning something. <a href="/blog">Longer pieces</a> once I can explain it. <a href="/thoughts">Essays</a> for everything that is not engineering.</p>

        <p class="elsewhere">
          {elsewhere.map((l, i) => (
            <>
              {i > 0 && <span class="sep">·</span>}
              <a href={l.href} target={l.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener">{l.label}</a>
            </>
          ))}
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .about {
    max-width: 760px;
    margin: 0 auto;
    /* Short page, so it sits as a composition in the middle of the screen
       rather than clinging to the top with a void underneath. */
    min-height: min(62vh, 520px);
    display: flex;
    flex-direction: column;
  }

  /* ── Folio rule, as on the other pages ─────────────── */
  .folio-rule {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: auto;
  }

  .folio-mark {
    font-family: var(--font-serif);
    font-variant: small-caps;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .folio-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  /* ── The composition ───────────────────────────────── */
  /* One centred column at every width, so the page reads the same on a
     phone as on a desktop and neither has a stranded half. */
  .grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-lg);
    padding: var(--space-2xl) 0;
    margin-bottom: auto;
  }

  .plate {
    margin: 0;
    width: min(176px, 46%);
  }

  /* Registration ticks at two corners, like a printed plate. */
  .plate-frame {
    position: relative;
    padding: 8px;
    border: 1px solid var(--color-border);
  }

  .plate-frame::before,
  .plate-frame::after {
    content: '';
    position: absolute;
    width: 10px;
    height: 10px;
    border: 1px solid var(--color-accent);
    opacity: 0.6;
  }

  .plate-frame::before {
    top: -1px;
    left: -1px;
    border-right: none;
    border-bottom: none;
  }

  .plate-frame::after {
    bottom: -1px;
    right: -1px;
    border-left: none;
    border-top: none;
  }

  .plate-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) sepia(0.44) contrast(1.06) brightness(1.02);
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .plate-guard {
    position: absolute;
    inset: 0;
    display: block;
    -webkit-touch-callout: none;
    user-select: none;
    -webkit-user-select: none;
  }

  h1 {
    font-size: clamp(2rem, 3.4vw, 2.6rem);
    line-height: 1.1;
    margin: 0 0 var(--space-md);
  }

  .text {
    max-width: 48ch;
  }

  .text p {
    font-size: clamp(1.06rem, 1.3vw, 1.18rem);
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-md);
  }

  .text p:last-child {
    margin-bottom: 0;
  }

  .text a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent-soft);
  }

  .text a:hover {
    border-bottom-color: var(--color-accent);
  }

  /* ── Elsewhere ─────────────────────────────────────── */
  .elsewhere {
    margin-top: var(--space-lg) !important;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border-light);
  }

  .elsewhere a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    border-bottom-color: transparent;
  }

  .elsewhere a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .sep {
    color: var(--color-text-muted);
    opacity: 0.45;
    margin: 0 0.5rem;
  }

  @media (max-width: 720px) {
    .about {
      min-height: 0;
    }
  }

  /* On a phone the plate carries the screen. A thumbnail with empty space
     beside it is what made this look unfinished. */
  @media (max-width: 620px) {
    /* Centred on a phone: the plate sits square in the column and the text
       hangs off its middle, which reads as composed rather than stranded. */
    .grid {
      gap: var(--space-lg);
      padding: var(--space-lg) 0 var(--space-md);
    }

    .plate {
      width: min(190px, 52%);
    }

    h1 {
      font-size: 2.1rem;
      margin-bottom: var(--space-md);
    }

    .text p {
      font-size: 1.14rem;
      line-height: 1.8;
    }

    .elsewhere {
      margin-top: var(--space-xl) !important;
    }

    .text {
      max-width: 34ch;
    }

    .elsewhere a {
      font-size: 0.78rem;
    }
  }
</style>
