    transform: rotate(-200deg);
  }

  .replay::after {
    content: '';
    position: absolute;
    inset: -6px;
  }

  .field-cap {
    right: calc(var(--gutter) + 50px) !important;
  }

  @media (max-width: 700px) {
    .replay {
      top: 0.9rem;
      bottom: auto;
    }
  }

  /* ── The stage ─────────────────────────────────────────── */
  .intro-stage {
    position: fixed;
    inset: 0;
    max-width: none !important;
    margin: 0 !important;
    z-index: 300;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.6rem;
    pointer-events: none;
