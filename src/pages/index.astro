---
/* The home page.

   The centre of it is a figure, not a photograph: every essay on the site
   as a point in space, placed by the same model that powers search on the
   Thoughts page, laid out along the three directions in which the essays
   differ most from one another. Points that sit together
   share ideas. The fine dust around them is decoration, drawn densest where
   the essays are, the way a reconstruction fills in around its keypoints. */

import Layout from '../layouts/Layout.astro';
import { posts as essays } from '../lib/thoughts-data';
import { proseOf } from '../lib/text';
import { buildThoughtModel } from '../lib/thought-model';
import { notebooks } from '../lib/notebooks';

/* The map holds everything written here: the essays, the technical blogs
   and the notebooks, fitted together so each sits by what it is about. */
const blogSources = import.meta.glob(['./blog/*.astro', './sign-language-recognition-using-cnn-and-opencv.astro'], {
  query: '?raw', import: 'default', eager: true,
}) as Record<string, string>;
const attr = (raw: string, k: string) => (raw.match(new RegExp(`\\b${k}="([^"]*)"`))?.[1] ?? '').trim();
const blogs = Object.entries(blogSources).map(([path, raw]) => {
  const slug = path.split('/').pop()!.replace('.astro', '');
  return {
    slug, title: attr(raw, 'title'), date: attr(raw, 'date'), description: attr(raw, 'description'),
    text: proseOf(raw), href: path.includes('/blog/') ? `/blog/${slug}` : `/${slug}`,
  };
}).filter(b => b.title && b.date);
const posts = [
  ...essays.map(p => ({ title: p.title, date: p.date, href: `/thoughts/${p.slug}`, kind: 'Essay' })),
  ...blogs.map(b => ({ title: b.title, date: b.date, href: b.href, kind: 'Blog' })),
  ...notebooks.map(n => ({ title: n.title, date: n.endDate, href: `/notebooks/${n.slug}`, kind: 'Notebook' })),
];
const model = buildThoughtModel([
  ...essays.map(p => ({ slug: p.slug, title: p.title, description: [p.description, ...p.tags].join(' '), text: p.text })),
  ...blogs.map(b => ({ slug: b.slug, title: b.title, description: b.description, text: b.text })),
  ...notebooks.map(n => ({ slug: `notebook-${n.slug}`, title: n.title, description: [n.description, ...n.tags].join(' '),
    text: [n.conclusion, ...n.days.map(d => d.title)].join('. ') })),
]);

const title = "Arshad Kazi";

/* Positions are the first three principal components of the essays'
   latent vectors: the three directions along which what I write about
   varies most. Power iteration with deflation; the matrix is tiny. */
const vecs = model.docVectors;
const dims = vecs[0]?.length ?? 0;
const mean = Array.from({ length: dims }, (_, j) => vecs.reduce((s, v) => s + v[j], 0) / vecs.length);
const centred = vecs.map(v => v.map((x, j) => x - mean[j]));
const cov = Array.from({ length: dims }, (_, a) =>
  Array.from({ length: dims }, (_, b) => centred.reduce((s, v) => s + v[a] * v[b], 0)));
const components: number[][] = [];
for (let c = 0; c < 3; c++) {
  let w = Array.from({ length: dims }, (_, j) => Math.sin(j * 1.7 + c * 3.1) + 1.3);
  for (let it = 0; it < 200; it++) {
    let next = cov.map(row => row.reduce((s, x, j) => s + x * w[j], 0));
    for (const prev of components) {
      const d = next.reduce((s, x, j) => s + x * prev[j], 0);
      next = next.map((x, j) => x - d * prev[j]);
    }
    const n = Math.hypot(...next) || 1;
    w = next.map(x => x / n);
  }
  components.push(w);
}
const coord = (c: number) => centred.map(v => v.reduce((s, x, j) => s + x * components[c][j], 0));
const xs = coord(0), ys = coord(1), zs = coord(2);

/* Each axis is centred and scaled by its spread, not by its extremes: one
   essay far from the rest would otherwise squash every other point into a
   line. Anything beyond the edge is pulled back onto it. */
const span = (a: number[]) => {
  const mean = a.reduce((s, v) => s + v, 0) / a.length;
  const sd = Math.sqrt(a.reduce((s, v) => s + (v - mean) ** 2, 0) / a.length) || 1;
  return (v: number) => Math.max(-1.1, Math.min(1.1, (v - mean) / (1.8 * sd)));
};
const nx = span(xs), ny = span(ys), nz = span(zs);

const field = {
  points: posts.map((p, i) => ({
    x: +nx(xs[i]).toFixed(3),
    y: +ny(ys[i]).toFixed(3),
    z: +(nz(zs[i]) * 0.7).toFixed(3),
    title: p.title,
    href: p.href,
    kind: p.kind,
    year: p.date.slice(0, 4),
  })),
  edges: model.edges.map(e => [e.a, e.b]),
};

/* "This is the journey of" ... and then one word after another, each with
   its own type and its own way of arriving and leaving. The order is the
   journey itself: it starts in wonder and rushes in with enthusiasm,
   meets its own imperfection, owns it with honesty, makes peace with it
   in acceptance, looks ahead in hope, and then waits, with patience. What
   is left after all of that is curiosity, which the journey is named for:
   patience's wait is the pause before the name. */
const virtues = [
  { text: 'wonder', tail: '', cls: 'wonder' },
  { text: 'enthusiasm', tail: '!!', cls: 'enthusiasm' },
  { text: 'imperfection', tail: '', cls: 'imperfection' },
  { text: 'honesty', tail: '.', cls: 'honesty' },
  { text: 'acceptance', tail: '', cls: 'acceptance' },
  { text: 'hope', tail: '', cls: 'hope' },
  { text: 'patience', tail: '...', cls: 'patience' },
].map(v => {
  const letters = [...v.text].map((c, j) => ({
    c, j, tail: false,
    // Fixed scatter for the letters acceptance gathers in, so it is the
    // same on every visit.
    y: (((j * 37) % 11) - 5) * 0.11,
    r: (((j * 53) % 13) - 6) * 3.2,
    face: j % 5,
  }));
  [...v.tail].forEach((c, k) => letters.push({ c, j: v.text.length + k, tail: true, y: 0, r: 0, face: 0 }));
  return { ...v, letters };
});

const chars = (t: string) => [...t].map(c => (c === ' ' ? ' ' : c));

const links = [
  { label: 'GitHub', href: 'https://github.com/Arshad221b' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/arshad221b/' },
  { label: 'Substack', href: 'https://substack.com/@arshadkazi' },
  { label: 'Email', href: 'mailto:arshadkaziblog@gmail.com' },
];

---

<Layout title={title} activeNav="/" description="Arshad Kazi. Notebooks, technical writing and personal essays." ogImage="/images/share-about.jpg">
  <script is:inline slot="head">
    /* The intro plays once. After that it waits sixty days before it will
       welcome the same browser back, and it never plays for anyone who has
       asked for less motion, or for crawlers and automated browsers, which
       should see the finished page. Decided here, before the first paint,
       so the page never flashes in and then hides itself.
       It plays only if the browser can remember that it has: the visit is
       written down first and read back, so a private window that refuses
       storage, or throws it away, sees the finished page rather than the
       intro on every load. */
    (function () {
      try {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (navigator.webdriver) return;
        if (/bot|crawl|spider|slurp|lighthouse|headless|chrome-lighthouse|pagespeed|prerender|preview/i.test(navigator.userAgent)) return;
        var now = Date.now();
        var last = +localStorage.getItem('intro-seen') || 0;
        if (now - last > 60 * 864e5) {
          localStorage.setItem('intro-seen', String(now));
          if (localStorage.getItem('intro-seen') === String(now)) {
            document.documentElement.classList.add('intro');
          }
        }
      } catch (e) {}
    })();
  </script>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Arshad Kazi",
    "url": "https://arshad-kazi.com",
    "image": "https://arshad-kazi.com/images/profile.jpg",
    "jobTitle": "Engineer in computer vision",
    "description": "Notebooks, technical writing and personal essays.",
    "sameAs": [
      "https://github.com/Arshad221b",
      "https://www.linkedin.com/in/arshad221b/",
      "https://medium.com/@arshad_221b",
      "https://substack.com/@arshadkazi"
    ]
  })} />

  <div class="home wide">
    <section class="hero">
      <figure class="field" id="field">
        <canvas id="field-canvas" aria-label={`A rotating map of ${posts.length} essays, blogs and notebooks, placed by meaning`}></canvas>
        <a class="field-tip" id="field-tip" href="#" hidden>
          <span class="field-tip-year label"></span>
          <span class="field-tip-title"></span>
        </a>
      </figure>

      <div class="hero-text">
        <span class="portrait">
          <img src="/images/profile.jpg" alt="Arshad Kazi" width="640" height="800" draggable="false" oncontextmenu="return false" />
          <span class="portrait-guard" aria-hidden="true"></span>
        </span>
        <h1><span class="w"><span>Arshad</span></span> <span class="w"><em>Kazi</em></span></h1>
        <p class="hero-role">Engineer in computer vision; I also write essays.</p>
        <p class="hero-links">
          {links.map(l => {
            const mail = l.href.startsWith('mailto');
            return (
              <a href={l.href} target={mail ? undefined : '_blank'} rel="noopener">
                <span class="hl-text">{l.label}</span><span class="hl-arrow" aria-hidden="true">{mail ? '→' : '↗'}</span>
              </a>
            );
          })}
        </p>
      </div>

      <button class="replay" id="replay" type="button" aria-label="Replay intro">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3"/><path d="M4.2 3.8v3.4h3.4"/></svg>
      </button>

      <p class="field-cap label" aria-hidden="true"><span class="sig">&#9679;</span>&nbsp; {posts.length} pieces, placed by meaning <span class="field-cap-hint">&middot; drag to turn</span></p>
    </section>
  </div>


  <script is:inline type="application/json" id="field-data" set:html={JSON.stringify(field)} />

  <!-- The stage for the opening: the mark alone, before anything else. -->
  <div class="intro-stage" id="intro-stage" aria-hidden="true">
    <canvas class="ink-ripples" aria-hidden="true"></canvas>
    <svg class="intro-mark" viewBox="22 2 56 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path class="ink" d="M50 52 C46 40 60 36 56 26 C52 16 40 20 44 30 C47 37 58 32 60 22 C62 12 54 6 48 8" stroke-width="3.4"/>
      <g class="vessel">
        <path class="pot" d="M39.2 94 C29.6 94 28.4 79.6 36.8 72.4 C40.4 69.4 41.6 67.6 41.6 64 L58.4 64 C58.4 67.6 59.6 69.4 63.2 72.4 C71.6 79.6 70.4 94 60.8 94 Z" stroke-width="3"/>
        <path d="M42.8 64 L42.8 59.2 L57.2 59.2 L57.2 64 Z" fill="currentColor" stroke-width="1.5"/>
        <path d="M33.2 82 C40.4 78.4 59.6 78.4 66.8 82" stroke-width="1.6"/>
        <g fill="currentColor" stroke="none"><ellipse cx="38.0" cy="88" rx="1.5" ry="2.4"/><ellipse cx="42.8" cy="88" rx="1.5" ry="2.4"/><ellipse cx="47.6" cy="88" rx="1.5" ry="2.4"/><ellipse cx="52.4" cy="88" rx="1.5" ry="2.4"/><ellipse cx="57.2" cy="88" rx="1.5" ry="2.4"/><ellipse cx="62.0" cy="88" rx="1.5" ry="2.4"/></g>
      </g>
    </svg>
    <!-- What is written. The opening line is set once and stays; the
         slot after it holds the word of the moment. -->
    <div class="ink-page">
      <p class="ink-line" id="ink-line">
        <span class="ink-lead">{chars('This is the journey of ').map(c => <span class="l">{c}</span>)}</span>
        <span class="ink-slot" id="ink-slot">
          {virtues.map(w => (
            <span class={`vw vw-${w.cls}`}>
              {w.letters.map(l => (
                <span
                  class:list={['l', l.tail ? 'tail' : `f${l.face}`, w.cls === 'imperfection' && l.j === 5 && 'odd']}
                  style={`--y:${l.y.toFixed(2)}em;--r:${l.r.toFixed(1)}deg`}
                >{l.c}</span>
              ))}
            </span>
          ))}
        </span>
      </p>
      <p class="ink-name-line" id="ink-name-line" aria-hidden="true">
        <span class="ink-pre">This is the</span>
        <span class="ink-name" id="ink-name"><span class="nm">Journey of <em>Curiosity</em></span><svg class="ink-flourish" viewBox="0 0 300 30" preserveAspectRatio="none" aria-hidden="true"><path d="M4 22 C 70 30, 130 6, 196 13 S 276 24, 296 6" /></svg></span>
      </p>
    </div>
    <button class="intro-skip" id="intro-skip" type="button">Skip <span aria-hidden="true">&rarr;</span></button>
  </div>
</Layout>

<script is:inline>
  /* ── The field ─────────────────────────────────────────────
     A small perspective renderer on a 2D canvas. No library: the scene is
     a few hundred points, a handful of lines and five camera frustums. */
  (function () {
    var fig = document.getElementById('field');
    var canvas = document.getElementById('field-canvas');
    var tip = document.getElementById('field-tip');
    if (!canvas || !fig) return;
    var data = JSON.parse(document.getElementById('field-data').textContent);
    var ctx = canvas.getContext('2d');
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Seeded, so the dust is the same shape on every visit.
    var seed = 7;
    function rand() {
      seed = (seed * 16807) % 2147483647;
      return (seed - 1) / 2147483646;
    }
    function gauss() {
      return Math.sqrt(-2 * Math.log(rand() + 1e-9)) * Math.cos(2 * Math.PI * rand());
    }

    var pts = data.points;
    var dust = [];
    pts.forEach(function (p) {
      for (var k = 0; k < 34; k++) {
        dust.push([p.x + gauss() * 0.16, p.y + gauss() * 0.16, p.z + gauss() * 0.16]);
      }
    });
    for (var k = 0; k < 260; k++) {
      // A loose shell around everything, the sparse edge of a scan.
      var u = rand() * 2 - 1, t = rand() * Math.PI * 2, r = 1.15 + rand() * 0.35;
      var s = Math.sqrt(1 - u * u);
      dust.push([r * s * Math.cos(t), r * u * 0.7, r * s * Math.sin(t)]);
    }

    // Five cameras around the scene, all looking at the middle of it.
    var cams = [];
    var camR = innerWidth < 600 ? 1.3 : 1.75;
    for (var c = 0; c < 5; c++) {
      var a = (c / 5) * Math.PI * 2 + 0.4;
      cams.push({ x: Math.cos(a) * camR, y: -0.35 + (c % 2) * 0.5, z: Math.sin(a) * camR });
    }

    var W = 0, H = 0, dpr = 1;
    function resize() {
      var rect = canvas.getBoundingClientRect();
      dpr = Math.min(devicePixelRatio || 1, 2);
      W = rect.width; H = rect.height;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    var yaw = 0.6, pitch = -0.18, vel = reduce ? 0 : 0.0016;
    var dragging = false, downX = 0, downY = 0, lastX = 0, lastY = 0, hover = -1;

    function project(x, y, z) {
      // Rotate about Y, then X, then a pinhole camera at distance 3.4.
      var cy = Math.cos(yaw), sy = Math.sin(yaw);
      var x1 = x * cy - z * sy, z1 = x * sy + z * cy;
      var cp = Math.cos(pitch), sp = Math.sin(pitch);
      var y1 = y * cp - z1 * sp, z2 = y * sp + z1 * cp;
      var d = 3.4 + z2;
      var f = Math.min(W, H) * (W < 600 ? 1.1 : 1.25);
      var cx0 = W > 900 ? W * 0.62 : W / 2, cy0 = W > 900 ? H * 0.42 : H * 0.36;
      return { x: cx0 + (x1 * f) / d, y: cy0 + (y1 * f) / d, depth: z2, s: 3.4 / d };
    }

    function colors() {
      var cs = getComputedStyle(document.documentElement);
      return {
        ink: cs.getPropertyValue('--color-text').trim(),
        muted: cs.getPropertyValue('--color-text-muted').trim(),
        accent: cs.getPropertyValue('--color-accent').trim(),
      };
    }
    var col = colors();

    /* During the intro the field assembles itself: essays appear one at a
       time, the threads between them draw, then the dust and the cameras
       fade in, like a reconstruction converging. Outside the intro every
       progress value is simply 1. */
    var introStart = document.documentElement.classList.contains('intro') ? Infinity : null;
    window.fieldHold = function () { introStart = Infinity; };
    window.fieldIntro = function () { introStart = performance.now(); };
    window.fieldDone = function () { introStart = null; };
    function prog(delay, dur) {
      if (introStart === null) return 1;
      var t = (performance.now() - introStart - delay) / dur;
      t = t < 0 ? 0 : t > 1 ? 1 : t;
      return 1 - Math.pow(1 - t, 3);
    }
    new MutationObserver(function () { col = colors(); if (reduce) projected = draw(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    function draw() {
      ctx.clearRect(0, 0, W, H);

      // Dust: smaller and fainter the further it is, like depth of field.
      ctx.fillStyle = col.ink;
      var dustP = prog(1000, 2000);
      for (var i = 0; dustP > 0 && i < dust.length; i++) {
        var q = project(dust[i][0], dust[i][1], dust[i][2]);
        ctx.globalAlpha = Math.max(0.05, 0.42 - q.depth * 0.18) * 0.75 * dustP;
        var r = 0.55 + q.s * 0.45;
        ctx.fillRect(q.x - r / 2, q.y - r / 2, r, r);
      }

      // Cameras as wire frustums.
      ctx.strokeStyle = col.muted;
      ctx.lineWidth = 0.8;
      var camP = prog(1800, 1500);
      cams.forEach(function (cm) {
        if (camP <= 0) return;
        var o = project(cm.x, cm.y, cm.z);
        // Four corners of a small image plane, a third of the way in.
        var dx = -cm.x, dy = -cm.y, dz = -cm.z;
        var len = Math.hypot(dx, dy, dz);
        dx /= len; dy /= len; dz /= len;
        var cx = cm.x + dx * 0.32, cyy = cm.y + dy * 0.32, cz = cm.z + dz * 0.32;
        var rx = -dz, rz = dx; var rl = Math.hypot(rx, rz) || 1; rx /= rl; rz /= rl;
        var w = 0.13, h = 0.09;
        var corners = [[-1, -1], [1, -1], [1, 1], [-1, 1]].map(function (k) {
          return project(cx + rx * w * k[0], cyy + h * k[1], cz + rz * w * k[0]);
        });
        ctx.globalAlpha = Math.max(0.12, 0.5 - o.depth * 0.2) * camP;
        ctx.beginPath();
        corners.forEach(function (p) { ctx.moveTo(o.x, o.y); ctx.lineTo(p.x, p.y); });
        ctx.moveTo(corners[0].x, corners[0].y);
        for (var j = 1; j <= 4; j++) ctx.lineTo(corners[j % 4].x, corners[j % 4].y);
        ctx.stroke();
      });

      // The essays and the threads between nearest neighbours.
      var P = pts.map(function (p) { return project(p.x, p.y, p.z); });
      ctx.strokeStyle = col.accent;
      ctx.lineWidth = 0.7;
      data.edges.forEach(function (e, k) {
        var a = P[e[0]], b = P[e[1]];
        var ep = prog(650 + k * 30, 950);
        if (ep <= 0) return;
        var lit = hover === e[0] || hover === e[1];
        ctx.globalAlpha = lit ? 0.9 : 0.22;
        ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(a.x + (b.x - a.x) * ep, a.y + (b.y - a.y) * ep); ctx.stroke();
      });

      var order = P.map(function (p, i) { return i; }).sort(function (a, b) { return P[b].depth - P[a].depth; });
      order.forEach(function (i) {
        var p = P[i];
        var pp = prog(i * 75, 900);
        if (pp <= 0) return;
        var on = i === hover;
        var r = (on ? 5.5 : 3.2) * p.s * pp;
        ctx.globalAlpha = (on ? 1 : Math.max(0.35, 1 - p.depth * 0.35)) * pp;
        ctx.fillStyle = col.accent;
        ctx.beginPath(); ctx.arc(p.x, p.y, r, 0, Math.PI * 2); ctx.fill();
        // A keypoint marker: a ring with a gap, as a detector draws it. In
        // the intro it closes in on its point, like a detection locking on.
        ctx.strokeStyle = col.accent;
        ctx.lineWidth = on ? 1.2 : 0.8;
        ctx.beginPath(); ctx.arc(p.x, p.y, r + (on ? 7 : 4.5) * p.s + (1 - pp) * 16, 0.25, Math.PI * 2 - 0.25); ctx.stroke();
        if (on) {
          ctx.globalAlpha = 0.6;
          ctx.beginPath();
          ctx.moveTo(p.x - 22, p.y); ctx.lineTo(p.x - 10, p.y);
          ctx.moveTo(p.x + 10, p.y); ctx.lineTo(p.x + 22, p.y);
          ctx.moveTo(p.x, p.y - 22); ctx.lineTo(p.x, p.y - 10);
          ctx.moveTo(p.x, p.y + 10); ctx.lineTo(p.x, p.y + 22);
          ctx.stroke();
        }
      });
      ctx.globalAlpha = 1;
      return P;
    }

    var projected = [];
    var visible = true;
    function frame() {
      // While the theme swaps, the field holds still, so the reveal has the
      // frame to itself.
      if (!document.documentElement.classList.contains('theme-swap')) {
        if (!dragging && hover < 0) yaw += vel;
        projected = draw();
        if (hover >= 0) placeTip();
      }
      if (visible && !reduce) requestAnimationFrame(frame);
    }

    function placeTip() {
      var p = projected[hover];
      if (!p) return;
      var left = Math.min(Math.max(p.x + 18, 8), W - 240);
      tip.style.transform = 'translate(' + left + 'px,' + (p.y - 14) + 'px)';
    }

    function pick(mx, my) {
      var best = -1, bd = 22 * 22;
      projected.forEach(function (p, i) {
        var d = (p.x - mx) * (p.x - mx) + (p.y - my) * (p.y - my);
        if (d < bd) { bd = d; best = i; }
      });
      return best;
    }

    function setHover(i) {
      if (i === hover) return;
      hover = i;
      if (i < 0) { tip.hidden = true; canvas.style.cursor = dragging ? 'grabbing' : 'grab'; }
      else {
        tip.hidden = false;
        tip.href = pts[i].href;
        tip.querySelector('.field-tip-title').textContent = pts[i].title;
        tip.querySelector('.field-tip-year').textContent = pts[i].kind + ' · ' + pts[i].year;
        canvas.style.cursor = 'pointer';
        placeTip();
      }
      if (reduce) projected = draw();
    }

    canvas.addEventListener('pointerdown', function (e) {
      dragging = true;
      downX = lastX = e.clientX; downY = lastY = e.clientY;
      canvas.setPointerCapture(e.pointerId);
      fig.classList.add('touched');
    });
    canvas.addEventListener('pointermove', function (e) {
      var rect = canvas.getBoundingClientRect();
      if (dragging) {
        var dx = e.clientX - lastX, dy = e.clientY - lastY;
        lastX = e.clientX; lastY = e.clientY;
        yaw += dx * 0.008;
        pitch = Math.max(-1, Math.min(1, pitch + dy * 0.006));
        if (Math.abs(dx) > 1) vel = (reduce ? 0 : Math.sign(dx) * 0.0016);
        if (reduce) projected = draw();
      }
      setHover(pick(e.clientX - rect.left, e.clientY - rect.top));
    });
    function release(e) {
      var moved = Math.hypot(e.clientX - downX, e.clientY - downY);
      dragging = false;
      if (e.type === 'pointerup' && moved < 5) {
        var rect = canvas.getBoundingClientRect();
        var i = pick(e.clientX - rect.left, e.clientY - rect.top);
        if (i >= 0) location.href = pts[i].href;
      }
    }
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);
    canvas.addEventListener('pointerleave', function (e) {
      if (!dragging && !(e.relatedTarget && tip.contains(e.relatedTarget))) setHover(-1);
    });
    tip.addEventListener('pointerleave', function (e) {
      if (e.relatedTarget !== canvas) setHover(-1);
    });

    // Only spend frames while the figure is on screen.
    new IntersectionObserver(function (entries) {
      var was = visible;
      visible = entries[0].isIntersecting;
      if (visible && !was && !reduce) requestAnimationFrame(frame);
    }).observe(fig);

    resize();
    addEventListener('resize', function () { resize(); projected = draw(); });
    projected = draw();
    if (!reduce) requestAnimationFrame(frame);
  })();
</script>

<script is:inline>
  /* ── The intro ─────────────────────────────────────────────────
     Act one, the mark alone: the pot settles and its ink rises.
     Act two, it swoops into its place in the header, and the name of the
     site writes itself in behind it. Act three, the field assembles, the
     portrait is set down, the name rises, and the links arrive last.
     Each act is a class on <html>; the styles below do the moving. */
  (function () {
    var html = document.documentElement;
    var stage = document.getElementById('intro-stage');
    var smark = stage && stage.querySelector('.intro-mark');
    var hmark = document.querySelector('.brand-mark');
    var replay = document.getElementById('replay');
    if (!stage || !smark || !hmark) return;
    var timers = [];
    var later = function (ms, fn) { timers.push(setTimeout(fn, ms * TEMPO)); };
    var ACTS = ['intro-run', 'landed', 'r1', 'r2', 'r3'];

    // The header's own ink restarts already drawn, so the hand-off from
    // the stage mark is seamless.
    function settleHeaderInk() {
      var ink = hmark.querySelector('.ink');
      if (!ink) return;
      ink.style.animation = 'none';
      void ink.getBoundingClientRect();
      ink.style.animation = '';
      ink.style.animationDelay = '-1.3s';
    }

    /* ── The words ───────────────────────────────────────────────
       The opening line is set once and stays alive; the word after it
       changes, each one arriving and leaving in its own manner, until the
       last, curiosity, which the journey is named for. Each run gets a
       token; skipping or replaying bumps it, and anything still waiting
       from an old run quietly stops. */
    var inkLine = document.getElementById('ink-line');
    var inkSlot = document.getElementById('ink-slot');
    var brand = document.querySelector('.brand-name');
    var nameLine = document.getElementById('ink-name-line');
    var inkName = document.getElementById('ink-name');
    var pre = nameLine.querySelector('.ink-pre');
    var inkCurl = smark.querySelector('.ink');
    var token = 0;
    var narrow = matchMedia('(max-width: 600px)');
    var all = function (root, sel) { return [].slice.call(root.querySelectorAll(sel)); };
    var lead = all(inkLine, '.ink-lead .l');

    /* The opening line's motion, and the pot's. "journey" (letters 12 to
       18) carries a slow wave, and the whole line a fainter one; every word
       sets a mood, and everything eases toward it, so nothing jumps:
       amp, speed, sway  the wave in "journey" (em, rate, deg)
       line, lift        the whole line's wave and its height (em)
       spread            the letters drawing apart from the middle (em)
       drift, jitter     the line swaying side to side, and its letters
                         falling out of step with the baseline (em)
       bob, lean, curl   the pot's rise and fall (px), its lean and the
                         sway of its curl of ink (deg)
       rock, stretch     the pot rocking (deg), the curl reaching up */
    var MOOD_KEYS = ['amp', 'speed', 'sway', 'line', 'lift', 'spread', 'drift', 'jitter',
                     'bob', 'lean', 'curl', 'rock', 'stretch'];
    var moods = {
      calm:         { amp: 0.06, speed: 1.7, sway: 0, line: 0.02, bob: 1.5, curl: 3 },
      wonder:       { amp: 0.13, speed: 1.2, sway: 1.2, line: 0.03, spread: 0.012, drift: 0.03, bob: 3, curl: 9, rock: 3, stretch: 0.08 },
      enthusiasm:   { amp: 0.07, speed: 2.6, sway: 0, line: 0.025, bob: 2, curl: 7, stretch: 0.05 },
      patience:     { amp: 0.05, speed: 0.6, sway: 0, line: 0.045, lift: 0.02, spread: 0.006, bob: 3.5, curl: 6, rock: 1.5 },
      imperfection: { amp: 0.06, speed: 1.7, sway: 0, line: 0.015, jitter: 0.035, bob: 1, lean: -4, curl: 4 },
      honesty:      { amp: 0, speed: 1.7, sway: 0, spread: -0.004 },
      acceptance:   { amp: 0.06, speed: 1.4, sway: 0, line: 0.02, drift: 0.015, bob: 1.5, lean: 3, curl: 4, rock: 2 },
      hope:         { amp: 0.1, speed: 0.9, sway: 0.5, line: 0.035, lift: -0.05, spread: 0.005, bob: 4, curl: 8, stretch: 0.14 },
      curiosity:    { amp: 0.08, speed: 1.1, sway: 0.6, line: 0.02, curl: 5 },
      still:        { amp: 0, speed: 1.1, sway: 0 },
    };
    var lean = lead.map(function (l, i) { return (i * 37 % 17) - 8; });
    var jit = lead.map(function (l, i) { return ((i * 53) % 11 - 5) / 5; });
    var motion;

    function setMood(name) {
      if (!motion) return;
      motion.goal = moods[name] || moods.calm;
      motion.tiltGoal = lead.map(function (l, i) {
        return name === 'imperfection' && i === 12 ? -10 : name === 'acceptance' ? lean[i] : 0;
      });
      if (name === 'enthusiasm') motion.hopAt = motion.clock + 0.2;
    }

    // A rise and fall over 0..1 that starts and ends at rest.
    function bump(x) {
      return x > 0 && x < 1 ? Math.pow(Math.sin(Math.PI * x), 2) : 0;
    }

    function straighten() {
      if (motion) motion.tiltGoal = lead.map(function () { return 0; });
    }

    function move(t) {
      motion = { amp: 0, speed: 1.7, sway: 0, line: 0, lift: 0, spread: 0, drift: 0, jitter: 0,
                 bob: 0, lean: 0, curl: 0, rock: 0, stretch: 0,
                 goal: moods.calm, phase: 0, clock: 0, hopAt: -9, landAt: -9, pot: true,
                 tilt: lead.map(function () { return 0; }), tiltGoal: lead.map(function () { return 0; }) };
      var prev = performance.now();
      (function frame(ts) {
        if (t !== token) {
          lead.forEach(function (l) { l.style.translate = l.style.rotate = ''; });
          smark.style.translate = smark.style.rotate = inkCurl.style.rotate = inkCurl.style.scale = '';
          return;
        }
        var dt = Math.min(0.05, (ts - prev) / 1000);
        prev = ts;
        var m = motion, k = 1 - Math.exp(-dt * 1.6), kt = 1 - Math.exp(-dt * 5);
        MOOD_KEYS.forEach(function (key) { m[key] += ((m.goal[key] || 0) - m[key]) * k; });
        m.phase += dt * m.speed;
        m.clock += dt;
        lead.forEach(function (l, i) {
          var y = 0, r = 0;
          if (i >= 12 && i < 19) {
            var a = m.phase - (i - 12) * 0.5;
            y = -m.amp * (0.5 + 0.5 * Math.sin(a));
            r = m.sway * Math.sin(a + 1.2);
          }
          // One breath for the line and the pot: it starts in the middle of
          // the line, beneath the pot, and spreads out to either end.
          y += m.lift - m.line * (0.5 + 0.5 * Math.sin(m.phase * 0.8 - Math.abs(i - 11) * 0.3));
          var h = (m.clock - m.hopAt - i * 0.026) / 0.7;
          if (h > 0 && h < 1) y -= 0.22 * Math.sin(Math.PI * h) * (1 - h * 0.4);
          // As each word lands, a small lift runs along the line toward it.
          var g = (m.clock - m.landAt - i * 0.022) / 0.6;
          y -= 0.05 * bump(g);
          y += m.jitter * jit[i];
          m.tilt[i] += (m.tiltGoal[i] - m.tilt[i]) * kt;
          l.style.translate = (m.spread * (i - 11) + m.drift * Math.sin(m.phase * 0.5)).toFixed(4) + 'em ' + y.toFixed(4) + 'em';
          l.style.rotate = (r + m.tilt[i]).toFixed(3) + 'deg';
        });
        // The pot breathes with the line, hops with enthusiasm, gives a small
        // nod as each word lands, and its curl of ink sways in the air.
        if (m.pot) {
          // In time with the middle of the line (letter 11) beneath it: the
          // same breath, the hop as it passes, the nod as the lift does.
          var py = -m.bob * (0.5 + 0.5 * Math.sin(m.phase * 0.8));
          var ph = (m.clock - m.hopAt - 11 * 0.026) / 0.7;
          if (ph > 0 && ph < 1) py -= 7 * Math.sin(Math.PI * ph) * (1 - ph * 0.4);
          py -= 3 * bump(ph - 1.05);
          var nod = bump((m.clock - m.landAt - 11 * 0.022) / 0.6);
          py += 2 * nod;
          smark.style.translate = '0 ' + py.toFixed(2) + 'px';
          smark.style.rotate = (m.lean + m.rock * Math.sin(m.phase * 0.6) + 2.5 * nod).toFixed(2) + 'deg';
          // The curl follows a beat behind the pot, as ink would.
          inkCurl.style.rotate = (m.curl * Math.sin(m.phase * 0.8 - 0.9) - 4 * nod).toFixed(2) + 'deg';
          inkCurl.style.scale = '1 ' + (1 + m.stretch * (0.5 + 0.5 * Math.sin(m.phase * 0.8 - 0.9))).toFixed(4);
        }
        requestAnimationFrame(frame);
      })(prev);
    }

    // Every pause and stagger is scaled by the tempo. Patience alone is
    // never hurried, and the name keeps a slower one of its own.
    var TEMPO = 0.66, PATIENCE_TEMPO = 0.85, NAME_TEMPO = 0.76, tempo = TEMPO;

    // The styles' own animations keep the same tempo.
    function quicken(e) {
      e.target.getAnimations().forEach(function (a) {
        if (a.playbackRate === 1 && (a instanceof CSSAnimation || a instanceof CSSTransition)) a.playbackRate = 1 / tempo;
      });
    }
    stage.addEventListener('animationstart', quicken);
    stage.addEventListener('transitionrun', quicken);

    function wait(ms, t) {
      return new Promise(function (res, rej) {
        timers.push(setTimeout(function () { t === token ? res() : rej('stale'); }, ms * tempo));
      });
    }

    // One letter after another; resolves when the last has had its turn.
    function each(list, gap, fn, t) {
      list.forEach(function (l, i) {
        timers.push(setTimeout(function () { if (t === token) fn(l, i); }, i * gap * tempo));
      });
      return wait(Math.max(0, list.length - 1) * gap, t);
    }

    function inOrder(list, how) {
      list = list.slice();
      if (how === 'middle') {
        var mid = (list.length - 1) / 2;
        return list.map(function (l, i) { return [l, Math.abs(i - mid)]; })
          .sort(function (a, b) { return a[1] - b[1]; })
          .map(function (p) { return p[0]; });
      }
      if (how === 'scatter') {
        return list.map(function (l, i) { return [l, (i * 7 + 3) % list.length]; })
          .sort(function (a, b) { return a[1] - b[1]; })
          .map(function (p) { return p[0]; });
      }
      return list;
    }

    var add = function (c) { return function (l) { l.classList.add(c); }; };

    // How each word comes and goes. Times in ms.
    // Between two words there is one breath, the same every time: the last
    // word is entirely gone, and the next begins after BREATH. Wonder, the
    // first, follows the opening line with a little more; patience takes a
    // longer pause, because waiting is what it is.
    var BREATH = 50;
    var ways = {
      wonder:       { before: 400, gap: 80, order: 'middle', settle: 700, hold: 1700, outGap: 50, out: 1100 },
      enthusiasm:   { before: BREATH, gap: 55, tailAfter: 240, tailGap: 170, hold: 1500, outGap: 30, out: 550 },
      patience:     { before: 250, gap: 170, tailAfter: 450, tailGap: 420, hold: 1400, outGap: 0, out: 1000 },
      imperfection: { before: BREATH, gap: 70, settle: 600, hold: 1400, outGap: 40, out: 850 },
      honesty:      { before: BREATH, gap: 110, typed: true, tailAfter: 250, tailGap: 0, hold: 1400, outGap: 55, out: 0 },
      acceptance:   { before: BREATH, gap: 65, order: 'scatter', settle: 500, hold: 1700, outGap: 30, out: 650 },
      hope:         { before: BREATH, gap: 150, settle: 800, hold: 1600, outGap: 70, out: 1100 },
    };

    // Every word sits on the line's baseline, whatever its type: when it
    // is shown, measure where its baseline falls and lift or drop it to
    // the line's.
    function probe(el) {
      var p = document.createElement('span');
      p.className = 'bl';
      el.appendChild(p);
      var y = p.getBoundingClientRect().top;
      p.remove();
      return y;
    }

    function seat(w) {
      w.style.bottom = '';
      w.classList.add('on');
      var off = probe(w) - probe(inkSlot);
      if (Math.abs(off) > 0.5) w.style.bottom = off.toFixed(1) + 'px';
    }

    function cursorOn(w, l) {
      all(w, '.cur').forEach(function (c) { c.classList.remove('cur'); });
      if (l) l.classList.add('cur');
    }

    async function word(w, t) {
      var name = w.className.match(/vw-(\w+)/)[1];
      var how = ways[name];
      tempo = name === 'patience' ? PATIENCE_TEMPO : TEMPO;
      var L = all(w, '.l:not(.tail)'), T = all(w, '.tail');
      setMood(name);
      await wait(how.before, t);
      seat(w);

      await each(inOrder(L, how.order), how.gap, function (l) {
        l.classList.add('in');
        if (how.typed) cursorOn(w, l);
      }, t);
      if (T.length) {
        await wait(how.tailAfter, t);
        await each(T, how.tailGap, function (l) {
          l.classList.add('in');
          if (how.typed) cursorOn(w, l);
        }, t);
      }
      if (how.settle) await wait(how.settle, t);
      w.classList.add('written');
      if (motion) motion.landAt = motion.clock;
      straighten();
      await wait(how.hold, t);

      if (how.typed) {
        // Deleted the way it was typed, one key at a time from the end.
        var typed = L.concat(T).reverse();
        await each(typed, how.outGap, function (l, i) {
          l.classList.remove('in');
          cursorOn(w, typed[i + 1]);
        }, t);
      } else {
        // Patience is the last word: the whole line goes with it, at once.
        if (name === 'patience') lead.slice(0, 22).forEach(add('gone'));
        await each(inOrder(all(w, '.l.in'), how.order), how.outGap, add('go'), t);
        // The next word waits until this one is entirely gone.
        await wait(how.out, t);
      }
      tempo = TEMPO;
      setMood('calm');
      w.classList.remove('on', 'written');
      all(w, '.l').forEach(function (l) { l.classList.remove('in', 'go', 'cur'); });
    }

    function resetInk() {
      all(stage, '.ink-page .l').forEach(function (l) { l.classList.remove('in', 'go', 'cur', 'set'); });
      all(inkSlot, '.vw').forEach(function (w) { w.classList.remove('on', 'written', 'writing'); });
      inkLine.className = 'ink-line';
      lead.forEach(function (l) { l.classList.remove('gone'); });
      nameLine.classList.remove('on');
      pre.classList.remove('leave');
      pre.style.transition = pre.style.transform = '';
      inkName.classList.remove('shine', 'fly');
      inkName.style.visibility = inkName.style.transformOrigin = '';
      inkName.getAnimations().forEach(function (a) { if (!(a instanceof CSSAnimation)) a.cancel(); });
      all(inkName, '.nm').forEach(function (n) { n.classList.remove('writing', 'written'); });
      pre.classList.remove('shown');
      rings.length = 0;
      rippleCanvas.style.transition = rippleCanvas.style.opacity = '';
      inkCurl.getAnimations().forEach(function (a) { if (!(a instanceof CSSAnimation)) a.cancel(); });
      inkCurl.style.strokeDasharray = '';
      brand.style.clipPath = brand.style.opacity = brand.style.transition = '';
      smark.classList.remove('drink');
    }

    // The slot is as wide as a typical word, so the sentence sits in the
    // middle; a longer word runs on to the right, never off the screen.
    // Either way the opening line keeps still.
    function measureSlot() {
      all(inkSlot, '.vw').forEach(function (w) { w.style.bottom = ''; });
      if (narrow.matches) return;
      var widths = all(inkSlot, '.vw').map(function (w) {
        w.classList.add('on', 'written');
        var width = w.getBoundingClientRect().width;
        w.classList.remove('on', 'written');
        return width;
      });
      var opening = inkLine.querySelector('.ink-lead').getBoundingClientRect().width;
      var avg = widths.reduce(function (a, b) { return a + b; }, 0) / widths.length;
      var widest = Math.max.apply(null, widths);
      var room = opening + 2 * widest + 48 - innerWidth;
      inkSlot.style.width = Math.ceil(Math.min(widest, Math.max(avg, room))) + 'px';
    }

    async function play(t) {
      tempo = TEMPO;
      resetInk();
      measureSlot();
      var words = all(inkSlot, '.vw');

      // "This is the journey of", once, and then it never quite sits still.
      await wait(1400, t);
      move(t);
      await each(lead, 55, add('in'), t);
      await wait(700, t);
      lead.forEach(add('set'));
      await wait(700, t);

      for (var i = 0; i < words.length; i++) await word(words[i], t);

      // And last, the name, revealed once, at its own slower tempo. Patience
      // has just made the wait, so the line lets go at once, leaving only
      // the pot on an empty page, and the name follows on its breath.
      tempo = NAME_TEMPO;
      setMood('still');
      smark.classList.add('drink');
      // The old line went with patience, so the name follows at once.
      await wait(200, t);

      // Then "This is the", and the name written beneath it in one slow
      // stroke, while the pot's ink is drawn out of it into the pen. The
      // ink is wet: echoes of the pot's own outline open out of it as it
      // gives up its ink, and echoes of the letters lift off the stroke as
      // the pen lays them down.
      var stroke = inkName.querySelector('.nm');
      var em = inkName.querySelector('em');
      var curl = inkCurl.getTotalLength();
      nameLine.classList.add('on');
      pre.classList.add('shown');
      await wait(500, t);

      inkCurl.style.strokeDasharray = curl;
      stroke.classList.add('writing');
      inkCurl.animate([{ strokeDashoffset: 0 }, { strokeDashoffset: curl }], {
        duration: 3500 * tempo, easing: 'cubic-bezier(0.4, 0.05, 0.3, 1)', fill: 'forwards'
      });
      [0, 900, 1800].forEach(function (d) {
        timers.push(setTimeout(potEcho, d * tempo));
      });
      followPen(stroke, em, t);
      await wait(3500, t);
      stroke.classList.replace('writing', 'written');

      // It is underlined, the whole name gives off one echo of itself,
      // and the pot fills again.
      inkName.classList.add('shine');
      textEcho(em, null, 0.05, 0.6);
      inkCurl.animate([{ strokeDashoffset: curl }, { strokeDashoffset: 0 }], {
        duration: 1600 * tempo, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', fill: 'forwards'
      });
      timers.push(setTimeout(potEcho, 1500 * tempo));
      await wait(1500, t);

      // Then it flies home, and lands as the header's name with the mark.
      pre.classList.add('leave');
      inkName.classList.add('fly');
      await wait(200, t);
      fly(inkName);
      swoop();
    }

    /* Echoes of wet ink. Each ripple has the shape of what made it, the
       pot's outline or the letters' own, and opens outward from it,
       growing a little and fading to nothing. Drawn on a canvas beneath
       the words: a soft band with a fine line at its crest. */
    var rippleCanvas = stage.querySelector('.ink-ripples');
    var rctx = rippleCanvas.getContext('2d');
    var rings = [], rippling = false;
    var POT_SHAPE = new Path2D(
      'M39.2 94 C29.6 94 28.4 79.6 36.8 72.4 C40.4 69.4 41.6 67.6 41.6 64 L58.4 64 C58.4 67.6 59.6 69.4 63.2 72.4 C71.6 79.6 70.4 94 60.8 94 Z ' +
      'M42.8 64 L42.8 59.2 L57.2 59.2 L57.2 64 Z');

    function echo(cx, cy, grow, strength, paint) {
      for (var i = 0; i < 2; i++) {
        rings.push({
          cx: cx, cy: cy, grow: grow * (1 - i * 0.4), paint: paint,
          t0: performance.now() + i * 150 * tempo,
          life: (1200 + i * 150) * tempo,
          a: strength * (1 - i * 0.45)
        });
      }
      if (!rippling) { rippling = true; requestAnimationFrame(drawRipples); }
    }

    // The pot's own outline, opening out of it.
    function potEcho() {
      var m = smark.getBoundingClientRect(), u = m.width / 56;
      var cx = m.left + (50 - 22) * u, cy = m.top + (79 - 2) * u;
      echo(cx, cy, 0.55, 0.8, function (c, lw) {
        c.translate(m.left, m.top);
        c.scale(u, u);
        c.translate(-22, -2);
        c.lineWidth = lw / u;
        c.stroke(POT_SHAPE);
      });
    }

    // The letters' own outline, set exactly over the words (their font,
    // their baseline), optionally only the part between x0 and x1.
    function textEcho(el, part, grow, strength) {
      var b = el.getBoundingClientRect(), cs = getComputedStyle(el);
      var probe = document.createElement('span');
      probe.className = 'bl';
      el.appendChild(probe);
      var base = probe.getBoundingClientRect().top;
      probe.remove();
      var x = b.left + parseFloat(cs.paddingLeft);
      var font = cs.fontStyle + ' ' + cs.fontWeight + ' ' + cs.fontSize + ' ' + cs.fontFamily;
      var text = el.textContent.replace(/\s+/g, ' ').trim();
      var cx = part ? (part[0] + part[1]) / 2 : b.left + b.width / 2;
      echo(cx, base - parseFloat(cs.fontSize) * 0.3, grow, strength, function (c, lw) {
        if (part) {
          c.beginPath();
          c.rect(part[0], b.top - b.height, part[1] - part[0], b.height * 3);
          c.clip();
        }
        c.font = font;
        c.textBaseline = 'alphabetic';
        c.lineWidth = lw;
        c.strokeText(text, x, base);
      });
    }

    function drawRipples(now) {
      var dpr = Math.min(devicePixelRatio || 1, 2);
      var W = innerWidth, H = innerHeight;
      if (rippleCanvas.width !== Math.round(W * dpr) || rippleCanvas.height !== Math.round(H * dpr)) {
        rippleCanvas.width = Math.round(W * dpr);
        rippleCanvas.height = Math.round(H * dpr);
      }
      rctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      rctx.clearRect(0, 0, W, H);
      rctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--color-accent').trim();
      rctx.lineJoin = 'round';
      rings = rings.filter(function (g) { return now - g.t0 < g.life; });
      rings.forEach(function (g) {
        var k = (now - g.t0) / g.life;
        if (k < 0) return;
        var e = 1 - Math.pow(1 - k, 3);
        var sc = 1 + g.grow * e;
        var fade = Math.pow(1 - k, 1.6) * g.a;
        [[fade * 0.22, (1.5 + 4 * e) / sc], [fade * 0.75, 1 / sc]].forEach(function (pass) {
          rctx.save();
          rctx.globalAlpha = pass[0];
          rctx.translate(g.cx, g.cy);
          rctx.scale(sc, sc);
          rctx.translate(-g.cx, -g.cy);
          g.paint(rctx, pass[1]);
