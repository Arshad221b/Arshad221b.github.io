    z-index: 2;
    display: grid;
    place-items: center;
    width: min(94vw, 60rem);
  }

  .ink-line {
    grid-area: 1 / 1;
    margin: 0;
    display: flex;
    align-items: baseline;
    justify-content: center;
    white-space: nowrap;
    font-family: var(--font-display);
    color: var(--color-text);
    transition: transform 1.8s cubic-bezier(0.65, 0, 0.35, 1), opacity 1.2s ease, filter 1.2s ease, translate 1.2s ease;
  }

