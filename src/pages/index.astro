  /* ── What is written ───────────────────────────────────────
     The opening line is set once and stays alive; the word after it
     changes, each one arriving and leaving in its own manner. The script
     says when; these say how. */
  .ink-page {
    display: grid;
    place-items: center;
    width: min(94vw, 60rem);
    min-height: 7rem;
