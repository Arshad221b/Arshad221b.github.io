    height: 1px;
    background: var(--color-border);
  }

  /* ── Opening ───────────────────────────────────────── */
  .opening {
    display: grid;
    grid-template-columns: 1fr 186px;
    gap: var(--space-2xl);
    align-items: start;
    margin-bottom: var(--space-xl);
  }

  /* ── The plate ─────────────────────────────────────── */
  .plate {
    margin: 0;
  }

  /* Registration ticks at the corners, like a printed plate. */
  .plate-frame {
    position: relative;
    padding: 7px;
    border: 1px solid var(--color-border);
  }

  .plate-frame::before,
  .plate-frame::after {
