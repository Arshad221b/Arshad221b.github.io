    width: 10px;
    height: 10px;
    border: 1px solid var(--color-accent);
    opacity: 0.6;
  }

  .plate-frame::before {
    top: -1px;
    left: -1px;
    border-right: none;
    border-bottom: none;
  }

  .plate-frame::after {
    bottom: -1px;
    right: -1px;
    border-left: none;
    border-top: none;
  }

  .plate-frame img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* Same ink as the drawing below it, not a snapshot pasted on top. */
    filter: grayscale(1) sepia(0.46) contrast(1.08) brightness(1.02);
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-user-drag: none;
