    transform: translateX(-50%);
  }

  .field svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ties line {
    stroke: var(--color-border);
    stroke-width: 0.8;
    transition: stroke 0.25s ease, stroke-opacity 0.25s ease;
  }

  .sparks circle {
    fill: var(--color-accent);
  }

  /* The names settle up into place as the field draws itself. */
  .facet {
    transition: opacity 0.3s ease;
  }

  .facet {
    cursor: pointer;
