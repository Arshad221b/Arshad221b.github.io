---
import Layout from '../layouts/Layout.astro';

const title = "Arshad Kazi";

const correspondence = [
  { label: "GitHub", href: "https://github.com/Arshad221b" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/arshad221b/" },
  { label: "Substack", href: "https://substack.com/@arshadkazi" },
  { label: "Medium", href: "https://medium.com/@arshad_221b" },
  { label: "Email", href: "mailto:arshadkaziblog@gmail.com" },
];

const vitals = [
  { term: "Trained as", detail: "Engineer. Everything after that, self-taught" },
  { term: "Works on", detail: "3D vision, geometry, representation learning" },
  { term: "Builds", detail: "Models from scratch. Training dynamics, not wrappers" },
  { term: "Reads", detail: "Neuroscience, psychology, philosophy" },
  { term: "Writes", detail: "Notebooks while learning, thoughts when they arrive" },
  { term: "Also into", detail: "Colour, food, film, music, language" },
  { term: "Wired", detail: "Autistic. Intense when interested, restless otherwise" },
  { term: "Method", detail: "Build it, break it, look again" },
  { term: "Constant", detail: "More questions than answers" },
];
---

<Layout title={title} activeNav="/" description="Arshad Kazi — CV/ML engineer building things to understand how they work. Computer vision, 3D geometry, representation learning." ogImage="/images/profile.png">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Arshad Kazi",
    "url": "https://arshad-kazi.com",
    "image": "https://arshad-kazi.com/images/profile.png",
    "jobTitle": "CV/ML Engineer",
    "description": "CV/ML engineer building things to understand how they work. Computer vision, 3D geometry, representation learning.",
    "sameAs": [
      "https://github.com/Arshad221b",
      "https://www.linkedin.com/in/arshad221b/",
      "https://medium.com/@arshad_221b",
      "https://substack.com/@arshadkazi"
    ]
  })} />

  <div class="folio">
    <div class="folio-rule">
      <span class="folio-mark">Folio&nbsp;I</span>
      <span class="folio-line"></span>
      <span class="folio-mark">Recto</span>
    </div>

    <div class="folio-body">
      <!-- Margin column: the plate and its annotations -->
      <aside class="margin">
        <figure class="plate">
          <div class="plate-frame">
            <img src="/images/profile.png" alt="Arshad Kazi" draggable="false" oncontextmenu="return false" />
            <span class="plate-guard" aria-hidden="true"></span>
          </div>
          <figcaption>
            <span class="fig-num">Fig. 1</span>
            <span class="fig-desc">The author, from life</span>
          </figcaption>
        </figure>

        <dl class="vitals">
          {vitals.map(v => (
            <div class="vital">
              <dt>{v.term}</dt>
              <dd>{v.detail}</dd>
            </div>
          ))}
        </dl>

        <div class="correspondence">
          <span class="margin-label">Correspondence</span>
          <ol>
            {correspondence.map(c => (
              <li>
                <a href={c.href} target={c.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener">{c.label}</a>
              </li>
            ))}
          </ol>
        </div>
      </aside>

      <!-- Main column: the letter itself -->
      <article class="letter">
        <h1>Arshad Kazi</h1>
        <p class="standfirst">exploring &ldquo;brain&rdquo;</p>

        <p class="salutation">If you're reading this, you probably ended up here by accident.</p>

        <div class="prose">
          <p>I am a trained engineer working around machine learning. I build things mostly to understand how they work, not just to make them work. Most of my work involves implementing models from scratch and working through training dynamics rather than relying on prebuilt abstractions (<a href="https://github.com/Arshad221b">see my work on GitHub</a>).</p>
          <p>I am not a researcher and not a conventional developer, even though I spend a lot of time building. I tend to follow problems that require some level of reasoning, and I usually end up exploring them by building, breaking, and figuring out what is actually going on.</p>
          <p>My primary interest is computer vision, especially problems involving structure, geometry, and representation. Things that can be tested, visualized, and taken apart: 3D reconstruction, pose estimation, representation learning. Some of this lives in my <a href="/notebooks">notebooks</a>.</p>
          <p>I am intense when I am interested, atheist, and a chronic overthinker. Anxious, often unsatisfied, hard to relax. I jump between ideas, go deep into one, drop it halfway, and return later with a better understanding.</p>
          <p>I have millions of interests, thousands of questions, and billions of problems I want to resolve. I think about color theory, neuroscience, food, film, music, language, and whatever else pulls me in on a given week. I write some of it down in my <a href="/thoughts">thoughts</a>. Most of it stays in my head. I will stay strong though.</p>
          <p>I am still trying to understand where I stand and what I am trying to do in the long run. This is where I dump things I am working through. Not optimized, not curated, and not meant for social media.</p>
          <p>Still trying to get found. Maybe that and finding myself are the same search. IDK.</p>
        </div>

        <p class="closing">
          Yours truly,
          <span class="signature">Arshad</span>
        </p>

      </article>
    </div>

    <p class="site-note">* This site is managed by AI, but the content written here is purely human.</p>
  </div>
</Layout>

<style>
  .folio {
    max-width: 760px;
    margin: 0 auto;
  }

  /* ── Folio rule across the top of the page ─────────── */
  .folio-rule {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .folio-mark {
    font-family: var(--font-serif);
    font-variant: small-caps;
    font-style: normal;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    text-transform: none;

    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .folio-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .folio-body {
    display: grid;
    grid-template-columns: 208px 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  /* ── Margin column ─────────────────────────────────── */
  .margin {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .plate {
    margin: 0;
  }

  /* Registration ticks at the corners, like a printed plate. */
  .plate-frame {
    position: relative;
    padding: 7px;
    border: 1px solid var(--color-border);
  }

  .plate-frame::before,
  .plate-frame::after {
    content: '';
    position: absolute;
    width: 9px;
    height: 9px;
    border: 1px solid var(--color-accent);
    opacity: 0.55;
  }

  .plate-frame::before {
    top: -1px;
    left: -1px;
    border-right: none;
    border-bottom: none;
  }

  .plate-frame::after {
    bottom: -1px;
    right: -1px;
    border-left: none;
    border-top: none;
  }

  .plate-frame img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* Push the photo toward a sepia study rather than a snapshot. */
    filter: grayscale(1) sepia(0.42) contrast(1.06) brightness(1.02);
    /* Not selectable, not draggable, no long-press save sheet. */
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* Sits over the photo so a press lands here, never on the image. */
  .plate-guard {
    position: absolute;
    inset: 0;
    display: block;
    -webkit-touch-callout: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .plate figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--space-sm);
  }

  .fig-num {
    font-family: var(--font-serif);
    font-variant: small-caps;
    font-style: normal;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    text-transform: none;

    color: var(--color-accent);
  }

  .fig-desc {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.0rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .vitals {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border-light);
  }

  .vital dt {
    font-family: var(--font-serif);
    font-variant: small-caps;
    font-style: normal;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    text-transform: none;

    color: var(--color-text-muted);
    margin-bottom: 1px;
  }

  .vital dd {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .margin-label {
    display: block;
    font-family: var(--font-serif);
    font-variant: small-caps;
    font-style: normal;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    text-transform: none;

    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .correspondence {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border-light);
  }

  .correspondence ol {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: corr;
  }

  .correspondence li {
    counter-increment: corr;
    margin-bottom: 0.28rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .correspondence li::before {
    content: counter(corr, upper-roman) '.';
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-text-muted);
    min-width: 1.6em;
    text-align: right;
  }

  .correspondence a {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .correspondence a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
    text-decoration: none;
  }

  /* ── The letter ────────────────────────────────────── */
  .letter h1 {
    font-size: 2.1rem;
    margin: -0.15em 0 0.1em;
  }

  .standfirst {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.22rem;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-lg);
  }

  .salutation {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.26rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border-light);
  }

  /* Marginal paragraph numerals, the way notes get indexed. */
  .prose {
    counter-reset: para;
  }

  .prose p {
    position: relative;
    font-size: 1.17rem;
    line-height: 1.85;
    color: var(--color-text-secondary);
    margin: 0 0 1.3em;
  }

  .prose p::before {
    counter-increment: para;
    content: counter(para);
    position: absolute;
    left: -2.4rem;
    top: 0.45em;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-text-muted);
    opacity: 0.55;
  }

  .prose a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent-soft);
  }

  .prose a:hover {
    border-bottom-color: var(--color-accent);
    text-decoration: none;
  }

  .closing {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-muted);
    margin: var(--space-lg) 0 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border-light);
  }

  .signature {
    display: block;
    font-style: normal;
    font-size: 1.5rem;
    color: var(--color-text);
    margin-top: 0.2em;
  }

  .site-note {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    opacity: 0.7;
    margin: var(--space-2xl) 0 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border-light);
  }

  @media (max-width: 700px) {
    /* Flatten both columns into one reading order: who, then the plate,
       then the index of vitals, then the letter, with the links last. */
    .folio-body {
      display: grid;
      grid-template-columns: 1fr;
      row-gap: var(--space-lg);
    }

    .margin,
    .letter {
      display: contents;
    }

    .letter h1 { order: 1; margin: 0; font-size: 1.75rem; }
    .standfirst { order: 2; margin: 0; }
    .plate { order: 3; }
    .vitals { order: 4; border-top: none; padding-top: 0; }
    .salutation { order: 5; margin: 0; padding-bottom: var(--space-md); }
    .prose { order: 6; }
    .closing { order: 7; margin: 0; }
    .correspondence { order: 8; }

    .plate-frame {
      max-width: 196px;
    }

    /* Two up, so the index fills the width instead of running down a
       narrow strip beside the plate. */
    .vitals {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-lg);
      row-gap: var(--space-md);
    }

    .prose p::before {
      display: none;
    }

    .site-note {
      margin-top: var(--space-xl);
    }
  }

  @media (max-width: 400px) {
    .vitals {
      grid-template-columns: 1fr;
      row-gap: var(--space-sm);
    }
  }

</style>
