---
import Layout from '../layouts/Layout.astro';

const title = "Arshad Kazi";

const correspondence = [
  { label: "GitHub", href: "https://github.com/Arshad221b" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/arshad221b/" },
  { label: "Substack", href: "https://substack.com/@arshadkazi" },
  { label: "Medium", href: "https://medium.com/@arshad_221b" },
  { label: "Email", href: "mailto:arshadkaziblog@gmail.com" },
];

/* Thirty two facets, none of them the container for the others. Every one
   carries the evidence for itself, because a claim about yourself is worth
   nothing without somewhere it actually shows. Placed by hand rather than
   by a layout solver, so nothing sits at a centre. */
const facets = [
  {
    id: "engineer", label: "engineer", x: 170, y: 108,
    line: "I build things to find out how they work, not to make them work. Most of it is written from scratch, because I do not trust anything I have not taken apart.",
    ev: [{ t: "the notebooks", h: "/notebooks" }, { t: "the code", h: "https://github.com/Arshad221b" }],
  },
  {
    id: "cv", label: "computer vision", x: 300, y: 196,
    line: "Structure, geometry, and how a machine gets from flat pixels to a world with depth in it. 3D reconstruction, pose, representation. It is the closest thing I have to a discipline, and it pays for the rest of this.",
    ev: [{ t: "the technical blogs", h: "/blog" }, { t: "Attention for 3D pose", h: "/blog/temporal-spatial-attention-3d-pose" }, { t: "SLAM from scratch", h: "/notebooks/slam" }],
  },
  {
    id: "visual", label: "visual thinker", x: 404, y: 66,
    line: "I think in pictures. Language is a translation layer on top of that, and it is slow, which is why I would rather write to you than talk to you.",
    ev: [{ t: "Story of a kid with a different brain", h: "/thoughts/autism-story-of-a-kid-with-a-different-brain" }],
  },
  {
    id: "curious", label: "curious", x: 730, y: 92,
    line: "One question, one hour a day, for about a week. Then the next question. It is the only way anything has ever stayed in my head.",
    ev: [{ t: "the notebooks", h: "/notebooks" }, { t: "Becoming a self-learning ninja", h: "/thoughts/becoming-self-learning-ninja" }],
  },
  {
    id: "moves", label: "moves to think", x: 980, y: 176,
    line: "When a thought will not resolve, I go and move until it does. The body sorts out things the head has been failing at all week.",
    ev: [{ t: "A philosophy of exercise", h: "/thoughts/a-philosophy-of-exercise-which-transforms-body-and-soul" }],
  },
  {
    id: "reader", label: "reader", x: 800, y: 252,
    line: "Grandin, Price, Murakami, Kalanithi. I read to borrow other people's eyes for a while, especially the ones who see nothing like I do.",
    ev: [{ t: "Reading Murakami", h: "/thoughts/what-i-learned-from-reading-haruki-murakami" }, { t: "When Breath Becomes Air", h: "/thoughts/when-breath-becomes-air" }],
  },
  {
    id: "autistic", label: "autistic", x: 432, y: 222,
    line: "Diagnosed in my late twenties. It explained about twenty years of being called clever and lazy in the same breath by the same people.",
    ev: [{ t: "Never learning to ask for help", h: "/thoughts/why-high-functioning-autistic" }, { t: "For Indian parents and students", h: "/thoughts/autism-things-indian-parentsstudents-need-to-know" }],
  },
  {
    id: "writer", label: "writer", x: 148, y: 262,
    line: "I do not know what I think until I have written it down and read it back. That is the whole reason any of this exists.",
    ev: [{ t: "the thoughts", h: "/thoughts" }, { t: "Why should I write about me", h: "/thoughts/why-should-i-write" }],
  },
  {
    id: "smalltown", label: "from a small town", x: 300, y: 382,
    line: "Less than a tenth of India lives in the metros. I came from the rest of it. I left, the way you are supposed to, and it takes far longer to finish leaving than anybody tells you.",
    ev: [{ t: "Before relocating", h: "/thoughts/why-you-should-think-really-hard-before-relocating-for-studyjob" }, { t: "Choosing a college", h: "/thoughts/heres-how-to-choose-a-good-college-after-12th-jeeneet" }],
  },
  {
    id: "arts", label: "film and music", x: 950, y: 352,
    line: "Why does a minor key sound sad in every culture that has one? I have been chasing that for two years and I still cannot answer it.",
    ev: [{ t: "Good and bad music", h: "/thoughts/whats-the-difference-between-good-bad-music" }, { t: "Drive My Car", h: "/thoughts/drive-my-car-a-movie-about-love-and-disconnect" }],
  },
  {
    id: "lonely", label: "often alone", x: 770, y: 476,
    line: "The thing I understand least, which is exactly why it is the thing I keep writing about.",
    ev: [{ t: "A silent Diwali", h: "/thoughts/a-silent-diwali-dealing-with-loneliness-during-festivals" }, { t: "Living just to never feel lonely", h: "/thoughts/living-to-never-feel-lonely" }],
  },
  {
    id: "son", label: "son", x: 296, y: 500,
    line: "My mother taught chemistry in the same school for thirty two years. I sat in one of those classes. She retired this year and it ended an era for both of us.",
    ev: [{ t: "A mother and a retired chemistry teacher", h: "/thoughts/my-mother-after-thirty-two-years" }, { t: "Life's strains", h: "/thoughts/lifes-strains-pursuit-of-purpose-and-varicose" }],
  },
  {
    id: "atheist", label: "atheist", x: 110, y: 436,
    line: "An atheist in a Muslim household. Eid is still sheer khurma and my mother in the kitchen, and that has never needed me to believe anything.",
    ev: [{ t: "Eid, Sheer Khurma", h: "/thoughts/eid-sheer-khurma" }, { t: "Belief, as an atheist", h: "/thoughts/my-curious-look-on-belief-as-an-atheist" }],
  },
  {
    id: "anxious", label: "anxious", x: 540, y: 320,
    line: "Anxious, hard to relax, unsatisfied more often than not. A stone age nervous system running in a world it was never issued for.",
    ev: [{ t: "Stone-age minds in a digital world", h: "/thoughts/stone-age-minds-in-a-digital-world-stress-anxiety" }, { t: "Thinking positive after trauma", h: "/thoughts/why-is-it-hard-to-think-positive-when-you-are-traumatized" }],
  },
  {
    id: "inlove", label: "in love, often", x: 520, y: 670,
    line: "You can love several people at once without meaning to, and without any of it cancelling out. Writing it down is the only way I have found to survive knowing that.",
    ev: [{ t: "Women I Love(d)", h: "/thoughts/women-i-loved" }, { t: "Loving multiple people", h: "/thoughts/you-actually-love-multiple-people-without-even-realising-it" }],
  },
  {
    id: "introvert", label: "introvert", x: 810, y: 440,
    line: "I am bad at being visible and worse at performing it. At one point I wrote an actual letter to the extroverted internet about it.",
    ev: [{ t: "Letter from an introvert", h: "/thoughts/a-letter-to-the-social-media-world-from-an-introvert" }, { t: "Personal pictures on LinkedIn", h: "/thoughts/is-it-okay-to-post-personal-pictures-on-linkedin" }],
  },
  {
    id: "doubter", label: "career doubter", x: 1010, y: 560,
    line: "Financial security is the carrot they dangle in front of you after college. I took the break and asked what exactly the money was for.",
    ev: [{ t: "Career break", h: "/thoughts/career-break-do-you-really-know-why-you-are-making-money" }, { t: "The conformity trap", h: "/thoughts/indian-corporate-culture-gen-z-a-conformity-trap" }],
  },
  {
    id: "housebuilder", label: "built a house", x: 260, y: 670,
    line: "Seven months went into building a house for my parents, and somewhere in the middle of it the house got larger than the reason for it.",
    ev: [{ t: "I didn't decide to build this", h: "/thoughts/i-didnt-decide-to-build-this-yet-i-did" }],
  },
  {
    id: "existential", label: "asks why he exists", x: 975, y: 496,
    line: "Why should I exist, and why should I keep going. I have been carrying both of those for years and most of what I write circles them.",
    ev: [{ t: "The moral reason not to die", h: "/thoughts/the-moral-reason-not-to-die" }, { t: "Where YOU really exist", h: "/thoughts/where-you-really-exist" }],
  },
  {
    id: "selftaught", label: "self-taught", x: 690, y: 200,
    line: "Leonardo had no schooling past fourteen and taught himself anatomy and optics from whatever books and mentors he could get hold of. It is the only method that has ever worked on me.",
    ev: [{ t: "Becoming a self-learning ninja", h: "/thoughts/becoming-self-learning-ninja" }, { t: "the notebooks", h: "/notebooks" }],
  },
  {
    id: "observer", label: "observer", x: 150, y: 320,
    line: "I watch people from a distance and take notes. My neighbour across the road taught me more about addiction than any book did.",
    ev: [{ t: "Through my window", h: "/thoughts/through-my-window-my-neighbor-and-his-alcoholism" }, { t: "A nine year old's curiosity", h: "/thoughts/9-year-old-kids-curiosity-and-exploration-with-truth" }],
  },
  {
    id: "impatient", label: "impatient", x: 330, y: 320,
    line: "Telling me to have patience is like telling a bird not to fly. I am working on it slowly, which is the joke.",
    ev: [{ t: "Building patience takes patience", h: "/thoughts/building-patience-takes-patience" }],
  },
  {
    id: "food", label: "food", x: 560, y: 560,
    line: "Sheer khurma once a year, and a running question about why sugar has that particular grip on all of us.",
    ev: [{ t: "Eid, Sheer Khurma", h: "/thoughts/eid-sheer-khurma" }, { t: "Understanding Emotion", h: "/notebooks/emotion" }],
  },
  {
    id: "perfectionist", label: "perfectionist", x: 800, y: 700,
    line: "Perfectionism has levels, and the useful part is finding out you can move between them. Nobody told me that until well into my twenties.",
    ev: [{ t: "Five levels of perfectionism", h: "/thoughts/five-levels-of-perfectionism-from-pressure-to-purpose" }],
  },
  {
    id: "planner", label: "plans every year", x: 210, y: 810,
    line: "At the end of every year I open the notebook and write down what the next one is for. Not things to own. Mostly things I want to stop being.",
    ev: [{ t: "Dismantling the mountain", h: "/thoughts/dismantling-the-mountain-setting-goals-for-new-year" }],
  },
  {
    id: "advocate", label: "advocate", x: 430, y: 580,
    line: "Most Indian schools have no idea what a learning disability looks like. I write the explainers I needed at fifteen and nobody had written yet.",
    ev: [{ t: "Things Indian parents need to know", h: "/thoughts/autism-things-indian-parentsstudents-need-to-know" }, { t: "Five common questions", h: "/thoughts/autism-for-indians-5-common-questions" }],
  },
  {
    id: "endures", label: "endures", x: 1010, y: 700,
    line: "Endurance was never a virtue I picked. It is what is left over when the alternatives run out, and it turns out to be enough.",
    ev: [{ t: "Life of endurance", h: "/thoughts/life-of-endurance" }, { t: "Learning to fight alone", h: "/thoughts/a-clarity-you-get-when-you-learn-to-fight-alone" }],
  },
  {
    id: "stopthinking", label: "tries to stop thinking", x: 640, y: 830,
    line: "More thought, faster and sharper, was supposed to make me wiser. Some days the answer is to stop entirely and just breathe.",
    ev: [{ t: "Non-thoughts and mindlessness", h: "/thoughts/non-thoughts-mindlessness" }, { t: "Just to breathe", h: "/thoughts/once-in-a-while-we-should-livejust-to-breathe" }],
  },
  {
    id: "library", label: "library kid", x: 140, y: 570,
    line: "A century old library in southern Maharashtra raised about half of me. I still measure other rooms against that one.",
    ev: [{ t: "A book heaven I cherished", h: "/thoughts/library-a-book-heaven-i-cherished" }],
  },
  {
    id: "unstylish", label: "unstylish", x: 900, y: 830,
    line: "Trends decide most of what people wear and do. Opting out is cheaper, quieter, and a good deal more fun.",
    ev: [{ t: "Why being unstylish can be fun", h: "/thoughts/why-being-unstylish-can-be-fun" }],
  },
  {
    id: "wonder", label: "prefers wonder to hope", x: 350, y: 730,
    line: "Hope needs the world to cooperate with you. Wonder does not, which makes it the more reliable of the two.",
    ev: [{ t: "Wonder beats hope", h: "/thoughts/why-being-wonderful-beats-being-hopeful" }],
  },
  {
    id: "ai", label: "watches AI closely", x: 1010, y: 300,
    line: "I think AI is turning into something like quantum physics. A field where the questions get stranger the closer you look at them.",
    ev: [{ t: "AI's growing complexity", h: "/thoughts/ais-growing-complexity-the-next-era-of-human-curiosity" }],
  },
];

/* Placed by intent, then relaxed so no two names sit on top of each other.
   Each one is sprung back toward where it was put, so the arrangement is
   still mine and not a solver's idea of a nice graph. */
const box = (l: string) => l.length * 10.5 + 34;
const LABEL_H = 46;
const rel = facets.map(f => ({ x: f.x, y: f.y, x0: f.x, y0: f.y, w: box(f.label) }));

for (let pass = 0; pass < 600; pass++) {
  for (let i = 0; i < rel.length; i++) {
    for (let j = i + 1; j < rel.length; j++) {
      const A = rel[i], B = rel[j];
      const overX = (A.w + B.w) / 2 - Math.abs(A.x - B.x);
      const overY = LABEL_H - Math.abs(A.y - B.y);
      if (overX > 0 && overY > 0) {
        if (overX / (A.w + B.w) < overY / LABEL_H) {
          const s = Math.min(overX, 7) / 2 * (A.x <= B.x ? -1 : 1);
          A.x += s; B.x -= s;
        } else {
          const s = Math.min(overY, 7) / 2 * (A.y <= B.y ? -1 : 1);
          A.y += s; B.y -= s;
        }
      }
    }
  }
  for (const r of rel) {
    r.x += (r.x0 - r.x) * 0.018;
    r.y += (r.y0 - r.y) * 0.018;
    r.x = Math.max(104, Math.min(996, r.x));
    r.y = Math.max(74, Math.min(846, r.y));
  }
}
facets.forEach((f, i) => { f.x = Math.round(rel[i].x); f.y = Math.round(rel[i].y); });

// Where one part of a person is plainly tied to another.
const ties: [string, string][] = [
  ["cv", "engineer"],
  ["cv", "visual"],
  ["cv", "curious"],
  ["cv", "ai"],
  ["cv", "selftaught"],
  ["engineer", "curious"],
  ["engineer", "visual"],
  ["visual", "autistic"],
  ["autistic", "writer"],
  ["autistic", "lonely"],
  ["autistic", "smalltown"],
  ["writer", "lonely"],
  ["writer", "reader"],
  ["writer", "atheist"],
  ["writer", "son"],
  ["reader", "curious"],
  ["curious", "moves"],
  ["moves", "lonely"],
  ["arts", "reader"],
  ["arts", "curious"],
  ["son", "atheist"],
  ["son", "smalltown"],
  ["lonely", "son"],
  ["anxious", "autistic"],
  ["anxious", "lonely"],
  ["anxious", "impatient"],
  ["anxious", "existential"],
  ["inlove", "writer"],
  ["inlove", "lonely"],
  ["inlove", "arts"],
  ["introvert", "lonely"],
  ["introvert", "writer"],
  ["introvert", "autistic"],
  ["doubter", "engineer"],
  ["doubter", "smalltown"],
  ["doubter", "existential"],
  ["housebuilder", "son"],
  ["housebuilder", "engineer"],
  ["existential", "atheist"],
  ["existential", "reader"],
  ["selftaught", "curious"],
  ["selftaught", "engineer"],
  ["selftaught", "reader"],
  ["observer", "writer"],
  ["observer", "visual"],
  ["observer", "smalltown"],
  ["impatient", "engineer"],
  ["impatient", "curious"],
  ["food", "son"],
  ["food", "atheist"],
  ["food", "curious"],
  ["perfectionist", "anxious"],
  ["perfectionist", "autistic"],
  ["perfectionist", "impatient"],
  ["planner", "writer"],
  ["planner", "curious"],
  ["planner", "selftaught"],
  ["advocate", "autistic"],
  ["advocate", "smalltown"],
  ["advocate", "writer"],
  ["endures", "anxious"],
  ["endures", "lonely"],
  ["endures", "existential"],
  ["stopthinking", "anxious"],
  ["stopthinking", "moves"],
  ["stopthinking", "existential"],
  ["library", "reader"],
  ["library", "smalltown"],
  ["library", "curious"],
  ["unstylish", "introvert"],
  ["unstylish", "doubter"],
  ["wonder", "curious"],
  ["wonder", "existential"],
  ["wonder", "atheist"],
  ["ai", "engineer"],
  ["ai", "curious"],
  ["ai", "doubter"],
];

const idx = Object.fromEntries(facets.map((f, i) => [f.id, i]));
const edges = ties.map(([a, b]) => ({
  a: idx[a], b: idx[b],
  x1: facets[idx[a]].x, y1: facets[idx[a]].y,
  x2: facets[idx[b]].x, y2: facets[idx[b]].y,
}));

/* A phone is not a small desktop, and it has no pointer to hover with.
   On a narrow screen the drawing is still the interface, but it is operated
   by tapping rather than pointing: cells are spaced for a thumb, names stay
   out of the way until you touch something, and the words arrive from the
   bottom of the screen where your hand already is. */
const TALL_W = 800, TALL_H = 1180;
const wideXs = facets.map(f => f.x), wideYs = facets.map(f => f.y);
const minX = Math.min(...wideXs), minY = Math.min(...wideYs);
const spanX = Math.max(...wideXs) - minX;
const spanY = Math.max(...wideYs) - minY;

const tall = facets.map(f => ({
  x: 70 + ((f.x - minX) / spanX) * (TALL_W - 140),
  y: 70 + ((f.y - minY) / spanY) * (TALL_H - 140),
}));
tall.forEach(t => { t.x0 = t.x; t.y0 = t.y; });

const MIN_GAP = 92;   // a thumb needs room, so cells sit further apart
for (let pass = 0; pass < 700; pass++) {
  for (let i = 0; i < tall.length; i++) {
    for (let j = i + 1; j < tall.length; j++) {
      const A = tall[i], B = tall[j];
      let vx = A.x - B.x, vy = A.y - B.y;
      let d = Math.hypot(vx, vy);
      if (d < 0.01) { vx = 1; vy = 0; d = 0.01; }
      if (d < MIN_GAP) {
        const push = (MIN_GAP - d) / 2;
        A.x += (vx / d) * push; A.y += (vy / d) * push;
        B.x -= (vx / d) * push; B.y -= (vy / d) * push;
      }
    }
  }
  for (const t of tall) {
    t.x += (t.x0 - t.x) * 0.03;
    t.y += (t.y0 - t.y) * 0.03;
    t.x = Math.max(60, Math.min(TALL_W - 60, t.x));
    t.y = Math.max(60, Math.min(TALL_H - 60, t.y));
  }
}

const tallLayout = {
  w: TALL_W, h: TALL_H,
  // Room on every side for a name to sit beside its cell without leaving
  // the box, so nothing is clipped and nothing pushes the page sideways.
  vb: (-96) + ' ' + (-30) + ' ' + (TALL_W + 192) + ' ' + (TALL_H + 60),
  pos: tall.map(t => ({ x: Math.round(t.x), y: Math.round(t.y) })),
};
const wideLayout = {
  w: 1100, h: 900,
  vb: '0 0 1100 900',
  pos: facets.map(f => ({ x: f.x, y: f.y })),
};

const anchorFor = (x: number) => (x < 220 ? 'start' : x > 780 ? 'end' : 'middle');
---

<Layout title={title} activeNav="/" description="Arshad Kazi. Computer vision engineer, writer, reader, son, autistic, curious. A personal site about all of it rather than any one of them." ogImage="/images/profile.png">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Arshad Kazi",
    "url": "https://arshad-kazi.com",
    "image": "https://arshad-kazi.com/images/profile.png",
    "jobTitle": "CV/ML Engineer",
    "description": "CV/ML engineer building things to understand how they work. Computer vision, 3D geometry, representation learning.",
    "sameAs": [
      "https://github.com/Arshad221b",
      "https://www.linkedin.com/in/arshad221b/",
      "https://medium.com/@arshad_221b",
      "https://substack.com/@arshadkazi"
    ]
  })} />

  <div class="self">
    <div class="folio-rule">
      <span class="folio-mark">Arshad Kazi</span>
      <span class="folio-line"></span>
      <span class="folio-mark">All of it at once</span>
    </div>

    <header class="opening">
      <div class="opening-text">
        <h1>I have never been<br />one thing.</h1>
        <p>Every part below is load bearing, and none of them is the heading the others live under. Touch one and it will show you where it turns up.</p>
      </div>

      <figure class="plate">
        <div class="plate-frame">
          <img src="/images/profile.png" alt="Arshad Kazi" draggable="false" oncontextmenu="return false" />
          <span class="plate-guard" aria-hidden="true"></span>
        </div>
        <figcaption>
          <span class="fig-num">Fig. 1</span>
          <span class="fig-desc">All of the above, in one body</span>
        </figcaption>
      </figure>
    </header>

    <figure class="field">
      <svg viewBox="0 0 1100 900" id="self-svg" role="img" aria-label="The parts of one person and how they connect">
        <g id="self-field">
          <g class="ties">
            {edges.map(e => (
              <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} data-a={e.a} data-b={e.b} />
            ))}
          </g>

          <g class="facets">
            {facets.map((f, i) => (
              <g class="facet" data-i={i} tabindex="0" role="button" aria-label={f.label}>
                <circle class="hit" cx={f.x} cy={f.y} r="34" />
                <circle class="pip" cx={f.x} cy={f.y} r="4" />
                <text class="name" x={f.x} y={f.y - 16} text-anchor={anchorFor(f.x)}>{f.label}</text>
              </g>
            ))}
          </g>
        </g>
      </svg>
    </figure>

    <!-- Whatever you are pointing at explains itself here. -->
    <section class="readout" id="readout" aria-live="polite">
      <p class="ro-empty" id="ro-empty"></p>
      <div class="ro-body" id="ro-body" hidden>
        <p class="ro-label" id="ro-label"></p>
        <p class="ro-line" id="ro-line"></p>
        <p class="ro-ev" id="ro-ev"></p>
      </div>
    </section>

    <section class="correspondence">
      <p class="rubric">Correspondence</p>
      <ol>
        {correspondence.map(c => (
          <li>
            <a href={c.href} target={c.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener">{c.label}</a>
          </li>
        ))}
      </ol>
    </section>

    <p class="colophon">* This site is managed by AI, but the content written here is purely human.</p>
  </div>
</Layout>

<script is:inline define:vars={{ facets, wideLayout, tallLayout }}>
(function () {
  const svg = document.getElementById('self-svg');
  if (!svg) return;

  const field = document.getElementById('self-field');
  const groups = Array.from(svg.querySelectorAll('.facet'));
  const lines = Array.from(svg.querySelectorAll('.ties line'));
  const pips = groups.map(g => g.querySelector('.pip'));
  const hits = groups.map(g => g.querySelector('.hit'));
  const names = groups.map(g => g.querySelector('.name'));

  const empty = document.getElementById('ro-empty');
  const body = document.getElementById('ro-body');
  const elLabel = document.getElementById('ro-label');
  const elLine = document.getElementById('ro-line');
  const elEv = document.getElementById('ro-ev');

  const neighbours = facets.map(() => []);
  lines.forEach(l => {
    const a = Number(l.dataset.a), b = Number(l.dataset.b);
    neighbours[a].push(b);
    neighbours[b].push(a);
  });

  const narrow = window.matchMedia('(max-width: 760px)');
  let layout = narrow.matches ? tallLayout : wideLayout;
  let labelOff = layout === tallLayout ? 30 : 16;

  // Put every element where the chosen arrangement says, viewBox included.
  function placeStatic(L) {
    svg.setAttribute('viewBox', L.vb);
    // ~44px of reach once the portrait canvas is scaled to a phone.
    const reach = L === tallLayout ? 46 : 34;
    hits.forEach(h => h.setAttribute('r', reach));
    for (let i = 0; i < groups.length; i++) {
      const q = L.pos[i];
      pips[i].setAttribute('cx', q.x); pips[i].setAttribute('cy', q.y);
      hits[i].setAttribute('cx', q.x); hits[i].setAttribute('cy', q.y);
      names[i].setAttribute('x', q.x); names[i].setAttribute('y', q.y - labelOff);
      names[i].setAttribute('text-anchor',
        q.x < L.w * 0.24 ? 'start' : q.x > L.w * 0.76 ? 'end' : 'middle');
    }
    for (let k = 0; k < lines.length; k++) {
      const l = lines[k], A = L.pos[Number(l.dataset.a)], B = L.pos[Number(l.dataset.b)];
      l.setAttribute('x1', A.x); l.setAttribute('y1', A.y);
      l.setAttribute('x2', B.x); l.setAttribute('y2', B.y);
    }
  }
  placeStatic(layout);

  let held = -1;
  const draw = lines.map(() => null);   // per tie: how far the light has run
  let intro = 0;                        // one time reveal on first sight

  function show(i) {
    held = i;
    const f = facets[i];
    svg.classList.add('lit');
    const kin = neighbours[i];
    groups.forEach((g, k) => {
      g.classList.toggle('on', k === i);
      g.classList.toggle('kin', kin.indexOf(k) !== -1);
    });
    lines.forEach((l, k) => {
      const a = Number(l.dataset.a), b = Number(l.dataset.b);
      const lit = a === i || b === i;
      l.classList.toggle('on', lit);
      // Draw outward from the part you are holding, never inward.
      draw[k] = lit ? { t: 0, from: a === i ? 1 : -1 } : null;
    });
    elLabel.textContent = f.label;
    elLine.textContent = f.line;
    elEv.innerHTML = f.ev.map(function (e) {
      const ext = e.h.indexOf('http') === 0 ? ' target="_blank" rel="noopener"' : '';
      return '<a href="' + e.h + '"' + ext + '>' + e.t + '</a>';
    }).join('<span class="sep">·</span>');
    empty.hidden = true;
    body.hidden = false;

    // Restart the rise so every facet arrives, rather than only the first.
    [elLabel, elLine, elEv].forEach(function (el) {
      el.style.animation = 'none';
      void el.offsetWidth;
      el.style.animation = '';
    });
  }

  function clear() {
    held = -1;
    for (let k = 0; k < draw.length; k++) draw[k] = null;
    svg.classList.remove('lit');
    groups.forEach(g => g.classList.remove('on', 'kin'));
    lines.forEach(l => l.classList.remove('on'));
  }

  groups.forEach((g, i) => {
    g.addEventListener('mouseenter', () => show(i));
    g.addEventListener('focus', () => show(i));
    g.addEventListener('click', () => show(i));
  });
  svg.addEventListener('mouseleave', function () { if (!narrow.matches) clear(); });

  /* Touch. The drawing stays the interface: tap a cell and it names itself
     along with whatever it is tied to, and the words come up from the
     bottom edge rather than sitting a screenful away. */
  /* Touch. No overlay and nothing to dismiss: the drawing names what you
     touched, and the words appear directly underneath it in the page, where
     they were always going to be. Touching another cell just replaces them. */
  groups.forEach((g, i) => {
    g.addEventListener('touchstart', function (e) {
      show(i);
      if (narrow.matches) e.stopPropagation();
    }, { passive: true });
  });


  /* Tactility. Every part is sprung to where it sits and damped past
     critical, so it moves when you reach for it and then stops dead.
     What you are holding draws its own relations in a little closer. */
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const restatic = e => { layout = e.matches ? tallLayout : wideLayout; labelOff = layout === tallLayout ? 26 : 16; placeStatic(layout); };
    narrow.addEventListener ? narrow.addEventListener('change', restatic) : narrow.addListener(restatic);
    return;
  }

  const HOME = 40, DRAG = 26, PULL = 300;
  const clamp = v => (v < 0 ? 0 : v > 1 ? 1 : v);
  const ease = t => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  const sparkLayer = document.createElementNS('http://www.w3.org/2000/svg', 'g');
  sparkLayer.setAttribute('class', 'sparks');
  const cid = Array.prototype.slice.call(svg.attributes)
    .filter(a => a.name.indexOf('data-astro-cid-') === 0)[0];
  if (cid) sparkLayer.setAttribute(cid.name, '');
  field.appendChild(sparkLayer);

  function makeSpark() {
    const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    c.setAttribute('r', '2.6');
    c.setAttribute('opacity', '0');
    if (cid) c.setAttribute(cid.name, '');
    sparkLayer.appendChild(c);
    return c;
  }
  const travellers = []; travellers.spare = [];
  let spark = 1.2;

  // The demonstration picks whichever facet is tied to the most others,
  // because that is the one that shows the most when it lights up.
  let demoDone = false, demoState = 0, demoClock = 0;
  let demoPick = 0;
  for (let i = 1; i < neighbours.length; i++) {
    if (neighbours[i].length > neighbours[demoPick].length) demoPick = i;
  }
  const nodes = layout.pos.map(q => ({ x0: q.x, y0: q.y, x: q.x, y: q.y, vx: 0, vy: 0 }));

  // Turning the phone, or dragging a desktop window narrow, re-homes every
  // facet and lets the springs carry it to the new arrangement.
  function adopt(L) {
    layout = L;
    labelOff = L === tallLayout ? 30 : 16;
    hits.forEach(h => h.setAttribute('r', L === tallLayout ? 46 : 34));
    svg.setAttribute('viewBox', L.vb);
    for (let i = 0; i < nodes.length; i++) {
      nodes[i].x0 = L.pos[i].x;
      nodes[i].y0 = L.pos[i].y;
      names[i].setAttribute('text-anchor',
        L.pos[i].x < L.w * 0.24 ? 'start' : L.pos[i].x > L.w * 0.76 ? 'end' : 'middle');
    }
  }
  const onWidth = e => adopt(e.matches ? tallLayout : wideLayout);
  narrow.addEventListener ? narrow.addEventListener('change', onWidth) : narrow.addListener(onWidth);
  let clock = 0, last = performance.now(), onScreen = true;

  if (window.IntersectionObserver) {
    new IntersectionObserver(e => { onScreen = e[0].isIntersecting; }, { rootMargin: '140px' }).observe(svg);
  }

  function frame(now) {
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;

    if (!document.hidden && onScreen) {
      clock += dt;

      // One uniform breath about the centre. Nothing shifts relative to
      // anything else, so it cannot shimmer.
      const cyc = (clock % 7) / 7;
      let fill;
      if (cyc < 0.34) fill = 0.5 - 0.5 * Math.cos(Math.PI * (cyc / 0.34));
      else if (cyc < 0.46) fill = 1;
      else if (cyc < 0.86) fill = 0.5 + 0.5 * Math.cos(Math.PI * ((cyc - 0.46) / 0.4));
      else fill = 0;
      const cx = layout.w / 2, cy = layout.h / 2;
      field.setAttribute('transform', 'translate(' + cx + ',' + cy + ') scale(' +
        (1 + fill * 0.012).toFixed(5) + ') translate(' + (-cx) + ',' + (-cy) + ')');

      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        let fx = (n.x0 - n.x) * HOME - n.vx * DRAG;
        let fy = (n.y0 - n.y) * HOME - n.vy * DRAG;

        if (held >= 0 && held !== i && neighbours[held].indexOf(i) !== -1) {
          const h = nodes[held];
          const vx = h.x - n.x, vy = h.y - n.y;
          const d = Math.hypot(vx, vy) || 1;
          fx += (vx / d) * PULL;
          fy += (vy / d) * PULL;
        }

        n.vx += fx * dt; n.vy += fy * dt;
        n.x += n.vx * dt; n.y += n.vy * dt;

        const x = n.x.toFixed(2), y = n.y.toFixed(2);
        pips[i].setAttribute('cx', x); pips[i].setAttribute('cy', y);
        hits[i].setAttribute('cx', x); hits[i].setAttribute('cy', y);
        names[i].setAttribute('x', x);
        names[i].setAttribute('y', (n.y - labelOff).toFixed(2));
      }

      // The whole field draws itself in once, ties first, names after.
      if (intro < 1) intro = Math.min(1, intro + dt / 1.9);

      for (let k = 0; k < lines.length; k++) {
        const l = lines[k], A = nodes[Number(l.dataset.a)], B = nodes[Number(l.dataset.b)];
        l.setAttribute('x1', A.x.toFixed(2)); l.setAttribute('y1', A.y.toFixed(2));
        l.setAttribute('x2', B.x.toFixed(2)); l.setAttribute('y2', B.y.toFixed(2));

        const len = Math.hypot(B.x - A.x, B.y - A.y);
        const d = draw[k];

        if (intro < 1) {
          // Staggered so the drawing spreads outward instead of appearing at once.
          const seed = (k * 0.037) % 0.42;
          const p = ease(clamp((intro - seed) / 0.5));
          l.setAttribute('stroke-dasharray', len.toFixed(1));
          l.setAttribute('stroke-dashoffset', (len * (1 - p)).toFixed(1));
        } else if (d) {
          d.t = Math.min(1, d.t + dt / 0.36);
          const p = ease(d.t);
          l.setAttribute('stroke-dasharray', len.toFixed(1));
          l.setAttribute('stroke-dashoffset', (len * (1 - p) * d.from).toFixed(1));
        } else {
          l.removeAttribute('stroke-dasharray');
          l.removeAttribute('stroke-dashoffset');
        }
      }

      // Names fade up after the lines that reach them.
      if (intro < 1) {
        for (let i = 0; i < groups.length; i++) {
          const seed = 0.3 + (i % 7) * 0.045;
          groups[i].style.opacity = clamp((intro - seed) / 0.42).toFixed(3);
        }
      } else if (groups[0].style.opacity !== '') {
        groups.forEach(g => { g.style.opacity = ''; });
      }

      /* Nobody knows a drawing is interactive by looking at it. So once,
         a moment after it finishes drawing itself, the page reaches out and
         touches its own most connected part, holds it long enough to read,
         and lets go. Any real interaction cancels it. */
      if (!demoDone && intro >= 1) {
        if (held >= 0 && demoState === 0) { demoDone = true; }
        else {
          demoClock += dt;
          if (demoState === 0 && demoClock > 0.9) { demoState = 1; show(demoPick); }
          else if (demoState === 1 && demoClock > 3.4) {
            demoState = 2; demoDone = true;
            // The words stay where the demonstration left them. Nothing on
            // this page tells you what to do; it just shows you once.
            clear();
          }
        }
      }

      // A quiet signal crossing one connection now and then, so the thing
      // reads as thinking rather than sitting still.
      if (held < 0 && intro >= 1) {
        spark -= dt;
        if (spark <= 0 && lines.length) {
          spark = 1.5 + Math.random() * 2.6;
          const k = Math.floor(Math.random() * lines.length);
          const l = lines[k];
          const A = nodes[Number(l.dataset.a)], B = nodes[Number(l.dataset.b)];
          travellers.push({ ax: A, bx: B, t: 0, dur: 0.7 + Math.random() * 0.5,
            el: travellers.spare.pop() || makeSpark() });
        }
      }

      for (let i = travellers.length - 1; i >= 0; i--) {
        const tr = travellers[i];
        tr.t += dt / tr.dur;
        if (tr.t >= 1) {
          tr.el.setAttribute('opacity', '0');
          travellers.spare.push(tr.el);
          travellers.splice(i, 1);
          continue;
        }
        const p = tr.t;
        tr.el.setAttribute('cx', (tr.ax.x + (tr.bx.x - tr.ax.x) * p).toFixed(1));
        tr.el.setAttribute('cy', (tr.ax.y + (tr.bx.y - tr.ax.y) * p).toFixed(1));
        tr.el.setAttribute('opacity', (Math.sin(p * Math.PI) * 0.75).toFixed(3));
      }
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();
</script>

<style>
  .self {
