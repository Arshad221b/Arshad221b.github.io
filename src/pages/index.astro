  .hl-text {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0% 1px no-repeat;
    padding-bottom: 2px;
    transition: background-size 0.4s var(--ease-out);
  }

  .hl-arrow {
    font-size: 0.68rem;
    color: var(--color-accent);
    transition: transform 0.4s var(--ease-out);
  }

  .hero-links a:hover {
    color: var(--color-text);
