---
/* The home page.

   The centre of it is a figure, not a photograph: every essay on the site
   as a point in space, placed by the same model that powers search on the
   Thoughts page, laid out along the three directions in which the essays
   differ most from one another. Points that sit together
   share ideas. The fine dust around them is decoration, drawn densest where
   the essays are, the way a reconstruction fills in around its keypoints. */

import Layout from '../layouts/Layout.astro';
import { posts, model } from '../lib/thoughts-data';

const title = "Arshad Kazi";

/* Positions are the first three principal components of the essays'
   latent vectors: the three directions along which what I write about
   varies most. Power iteration with deflation; the matrix is tiny. */
const vecs = model.docVectors;
const dims = vecs[0]?.length ?? 0;
const mean = Array.from({ length: dims }, (_, j) => vecs.reduce((s, v) => s + v[j], 0) / vecs.length);
const centred = vecs.map(v => v.map((x, j) => x - mean[j]));
const cov = Array.from({ length: dims }, (_, a) =>
  Array.from({ length: dims }, (_, b) => centred.reduce((s, v) => s + v[a] * v[b], 0)));
const components: number[][] = [];
for (let c = 0; c < 3; c++) {
  let w = Array.from({ length: dims }, (_, j) => Math.sin(j * 1.7 + c * 3.1) + 1.3);
  for (let it = 0; it < 200; it++) {
    let next = cov.map(row => row.reduce((s, x, j) => s + x * w[j], 0));
    for (const prev of components) {
      const d = next.reduce((s, x, j) => s + x * prev[j], 0);
      next = next.map((x, j) => x - d * prev[j]);
    }
    const n = Math.hypot(...next) || 1;
    w = next.map(x => x / n);
  }
  components.push(w);
}
const coord = (c: number) => centred.map(v => v.reduce((s, x, j) => s + x * components[c][j], 0));
const xs = coord(0), ys = coord(1), zs = coord(2);

/* Each axis is centred and scaled by its spread, not by its extremes: one
   essay far from the rest would otherwise squash every other point into a
   line. Anything beyond the edge is pulled back onto it. */
const span = (a: number[]) => {
  const mean = a.reduce((s, v) => s + v, 0) / a.length;
  const sd = Math.sqrt(a.reduce((s, v) => s + (v - mean) ** 2, 0) / a.length) || 1;
  return (v: number) => Math.max(-1.1, Math.min(1.1, (v - mean) / (1.8 * sd)));
};
const nx = span(xs), ny = span(ys), nz = span(zs);

const field = {
  points: posts.map((p, i) => ({
    x: +nx(xs[i]).toFixed(3),
    y: +ny(ys[i]).toFixed(3),
    z: +(nz(zs[i]) * 0.7).toFixed(3),
    title: p.title,
    href: `/thoughts/${p.slug}`,
    year: p.date.slice(0, 4),
  })),
  edges: model.edges.map(e => [e.a, e.b]),
};

/* "This is the journey of" ... and then one word after another, each with
   its own type and its own way of arriving and leaving. The order is the
   journey itself: it starts in wonder and rushes in with enthusiasm, needs
   patience when it slows, meets its own imperfection, owns it with
   honesty, and makes peace with it in acceptance. What is left after all
   of that is curiosity, which the journey is named for. */
const virtues = [
  { text: 'wonder', tail: '', cls: 'wonder' },
  { text: 'enthusiasm', tail: '!!', cls: 'enthusiasm' },
  { text: 'patience', tail: '...', cls: 'patience' },
  { text: 'imperfection', tail: '', cls: 'imperfection' },
  { text: 'honesty', tail: '.', cls: 'honesty' },
  { text: 'acceptance', tail: '', cls: 'acceptance' },
  { text: 'curiosity', tail: '?', cls: 'curiosity' },
].map(v => {
  const letters = [...v.text].map((c, j) => ({
    c, j, tail: false,
    // Fixed scatter for the letters acceptance gathers in, so it is the
    // same on every visit.
    y: (((j * 37) % 11) - 5) * 0.11,
    r: (((j * 53) % 13) - 6) * 3.2,
    face: j % 5,
  }));
  [...v.tail].forEach((c, k) => letters.push({ c, j: v.text.length + k, tail: true, y: 0, r: 0, face: 0 }));
  return { ...v, letters };
});

const chars = (t: string) => [...t].map(c => (c === ' ' ? ' ' : c));

const links = [
  { label: 'GitHub', href: 'https://github.com/Arshad221b' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/arshad221b/' },
  { label: 'Substack', href: 'https://substack.com/@arshadkazi' },
  { label: 'Email', href: 'mailto:arshadkaziblog@gmail.com' },
];

---

<Layout title={title} activeNav="/" description="Arshad Kazi. Notebooks, technical writing and personal essays." ogImage="/images/og-about.jpg">
  <script is:inline slot="head">
    /* The intro plays once. After that it waits two weeks before it will
       welcome the same browser back, and it never plays for anyone who has
       asked for less motion. Decided here, before the first paint, so the
       page never flashes in and then hides itself. */
    (function () {
      try {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var last = +localStorage.getItem('intro-seen') || 0;
        if (Date.now() - last > 14 * 864e5) {
          document.documentElement.classList.add('intro');
          localStorage.setItem('intro-seen', String(Date.now()));
        }
      } catch (e) {}
    })();
  </script>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Arshad Kazi",
    "url": "https://arshad-kazi.com",
    "image": "https://arshad-kazi.com/images/profile.jpg",
    "jobTitle": "CV/ML Engineer",
    "description": "Notebooks, technical writing and personal essays.",
    "sameAs": [
      "https://github.com/Arshad221b",
      "https://www.linkedin.com/in/arshad221b/",
      "https://medium.com/@arshad_221b",
      "https://substack.com/@arshadkazi"
    ]
  })} />

  <div class="home wide">
    <section class="hero">
      <figure class="field" id="field">
        <canvas id="field-canvas" aria-label={`A rotating map of ${posts.length} essays, placed by meaning`}></canvas>
        <a class="field-tip" id="field-tip" href="#" hidden>
          <span class="field-tip-year label"></span>
          <span class="field-tip-title"></span>
        </a>
      </figure>

      <div class="hero-text">
        <span class="portrait">
          <img src="/images/profile.jpg" alt="Arshad Kazi" width="640" height="800" draggable="false" oncontextmenu="return false" />
          <span class="portrait-guard" aria-hidden="true"></span>
        </span>
        <h1><span class="w"><span>Arshad</span></span> <span class="w"><em>Kazi</em></span></h1>
        <p class="hero-links">
          {links.map(l => {
            const mail = l.href.startsWith('mailto');
            return (
              <a href={l.href} target={mail ? undefined : '_blank'} rel="noopener">
                <span class="hl-text">{l.label}</span><span class="hl-arrow" aria-hidden="true">{mail ? '→' : '↗'}</span>
              </a>
            );
          })}
        </p>
      </div>

      <button class="replay" id="replay" type="button" aria-label="Replay intro">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3"/><path d="M4.2 3.8v3.4h3.4"/></svg>
      </button>

      <p class="field-cap label" aria-hidden="true"><span class="sig">&#9679;</span>&nbsp; {posts.length} essays, placed by meaning <span class="field-cap-hint">&middot; drag to turn</span></p>
    </section>
  </div>


  <script is:inline type="application/json" id="field-data" set:html={JSON.stringify(field)} />

  <!-- The stage for the opening: the mark alone, before anything else. -->
  <div class="intro-stage" id="intro-stage" aria-hidden="true">
    <svg class="intro-mark" viewBox="22 2 56 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path class="ink" d="M50 52 C46 40 60 36 56 26 C52 16 40 20 44 30 C47 37 58 32 60 22 C62 12 54 6 48 8" stroke-width="3.4"/>
      <g class="vessel">
        <path class="pot" d="M39.2 94 C29.6 94 28.4 79.6 36.8 72.4 C40.4 69.4 41.6 67.6 41.6 64 L58.4 64 C58.4 67.6 59.6 69.4 63.2 72.4 C71.6 79.6 70.4 94 60.8 94 Z" stroke-width="3"/>
        <path d="M42.8 64 L42.8 59.2 L57.2 59.2 L57.2 64 Z" fill="currentColor" stroke-width="1.5"/>
        <path d="M33.2 82 C40.4 78.4 59.6 78.4 66.8 82" stroke-width="1.6"/>
        <g fill="currentColor" stroke="none"><ellipse cx="38.0" cy="88" rx="1.5" ry="2.4"/><ellipse cx="42.8" cy="88" rx="1.5" ry="2.4"/><ellipse cx="47.6" cy="88" rx="1.5" ry="2.4"/><ellipse cx="52.4" cy="88" rx="1.5" ry="2.4"/><ellipse cx="57.2" cy="88" rx="1.5" ry="2.4"/><ellipse cx="62.0" cy="88" rx="1.5" ry="2.4"/></g>
      </g>
    </svg>
    <!-- What is written. The opening line is set once and stays; the
         slot after it holds the word of the moment. -->
    <div class="ink-page">
      <p class="ink-line" id="ink-line">
        <span class="ink-lead">{chars('This is the journey of ').map(c => <span class="l">{c}</span>)}</span>
        <span class="ink-slot" id="ink-slot">
          {virtues.map(w => (
            <span class={`vw vw-${w.cls}`}>
              {w.letters.map(l => (
                <span
                  class:list={['l', l.tail ? 'tail' : `f${l.face}`, w.cls === 'imperfection' && l.j === 5 && 'odd']}
                  style={`--y:${l.y.toFixed(2)}em;--r:${l.r.toFixed(1)}deg`}
                >{l.c}</span>
              ))}
            </span>
          ))}
        </span>
      </p>
      <p class="ink-final" id="ink-final">
        {chars('You are ').map(c => <span class="l">{c}</span>)}<em>{chars('welcome').map(c => <span class="l">{c}</span>)}</em>{chars(' here').map(c => <span class="l">{c}</span>)}<span class="l dot">.</span>
      </p>
    </div>
    <button class="intro-skip" id="intro-skip" type="button">Skip <span aria-hidden="true">&rarr;</span></button>
  </div>
</Layout>

<script is:inline>
  /* ── The field ─────────────────────────────────────────────
     A small perspective renderer on a 2D canvas. No library: the scene is
     a few hundred points, a handful of lines and five camera frustums. */
  (function () {
    var fig = document.getElementById('field');
    var canvas = document.getElementById('field-canvas');
    var tip = document.getElementById('field-tip');
    if (!canvas || !fig) return;
    var data = JSON.parse(document.getElementById('field-data').textContent);
    var ctx = canvas.getContext('2d');
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Seeded, so the dust is the same shape on every visit.
    var seed = 7;
    function rand() {
      seed = (seed * 16807) % 2147483647;
      return (seed - 1) / 2147483646;
    }
    function gauss() {
      return Math.sqrt(-2 * Math.log(rand() + 1e-9)) * Math.cos(2 * Math.PI * rand());
    }

    var pts = data.points;
    var dust = [];
    pts.forEach(function (p) {
      for (var k = 0; k < 34; k++) {
        dust.push([p.x + gauss() * 0.16, p.y + gauss() * 0.16, p.z + gauss() * 0.16]);
      }
    });
    for (var k = 0; k < 260; k++) {
      // A loose shell around everything, the sparse edge of a scan.
      var u = rand() * 2 - 1, t = rand() * Math.PI * 2, r = 1.15 + rand() * 0.35;
      var s = Math.sqrt(1 - u * u);
      dust.push([r * s * Math.cos(t), r * u * 0.7, r * s * Math.sin(t)]);
    }

    // Five cameras around the scene, all looking at the middle of it.
    var cams = [];
    var camR = innerWidth < 600 ? 1.3 : 1.75;
    for (var c = 0; c < 5; c++) {
      var a = (c / 5) * Math.PI * 2 + 0.4;
      cams.push({ x: Math.cos(a) * camR, y: -0.35 + (c % 2) * 0.5, z: Math.sin(a) * camR });
    }

    var W = 0, H = 0, dpr = 1;
    function resize() {
      var rect = canvas.getBoundingClientRect();
      dpr = Math.min(devicePixelRatio || 1, 2);
      W = rect.width; H = rect.height;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    var yaw = 0.6, pitch = -0.18, vel = reduce ? 0 : 0.0016;
    var dragging = false, downX = 0, downY = 0, lastX = 0, lastY = 0, hover = -1;

    function project(x, y, z) {
      // Rotate about Y, then X, then a pinhole camera at distance 3.4.
      var cy = Math.cos(yaw), sy = Math.sin(yaw);
      var x1 = x * cy - z * sy, z1 = x * sy + z * cy;
      var cp = Math.cos(pitch), sp = Math.sin(pitch);
      var y1 = y * cp - z1 * sp, z2 = y * sp + z1 * cp;
      var d = 3.4 + z2;
      var f = Math.min(W, H) * (W < 600 ? 1.1 : 1.25);
      var cx0 = W > 900 ? W * 0.62 : W / 2, cy0 = W > 900 ? H * 0.42 : H * 0.36;
      return { x: cx0 + (x1 * f) / d, y: cy0 + (y1 * f) / d, depth: z2, s: 3.4 / d };
    }

    function colors() {
      var cs = getComputedStyle(document.documentElement);
      return {
        ink: cs.getPropertyValue('--color-text').trim(),
        muted: cs.getPropertyValue('--color-text-muted').trim(),
        accent: cs.getPropertyValue('--color-accent').trim(),
      };
    }
    var col = colors();

    /* During the intro the field assembles itself: essays appear one at a
       time, the threads between them draw, then the dust and the cameras
       fade in, like a reconstruction converging. Outside the intro every
       progress value is simply 1. */
    var introStart = document.documentElement.classList.contains('intro') ? Infinity : null;
    window.fieldHold = function () { introStart = Infinity; };
    window.fieldIntro = function () { introStart = performance.now(); };
    window.fieldDone = function () { introStart = null; };
    function prog(delay, dur) {
      if (introStart === null) return 1;
      var t = (performance.now() - introStart - delay) / dur;
      t = t < 0 ? 0 : t > 1 ? 1 : t;
      return 1 - Math.pow(1 - t, 3);
    }
    new MutationObserver(function () { col = colors(); if (reduce) projected = draw(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    function draw() {
      ctx.clearRect(0, 0, W, H);

      // Dust: smaller and fainter the further it is, like depth of field.
      ctx.fillStyle = col.ink;
      var dustP = prog(1000, 2000);
      for (var i = 0; dustP > 0 && i < dust.length; i++) {
        var q = project(dust[i][0], dust[i][1], dust[i][2]);
        ctx.globalAlpha = Math.max(0.05, 0.42 - q.depth * 0.18) * 0.75 * dustP;
        var r = 0.55 + q.s * 0.45;
        ctx.fillRect(q.x - r / 2, q.y - r / 2, r, r);
      }

      // Cameras as wire frustums.
      ctx.strokeStyle = col.muted;
      ctx.lineWidth = 0.8;
      var camP = prog(1800, 1500);
      cams.forEach(function (cm) {
        if (camP <= 0) return;
        var o = project(cm.x, cm.y, cm.z);
        // Four corners of a small image plane, a third of the way in.
        var dx = -cm.x, dy = -cm.y, dz = -cm.z;
        var len = Math.hypot(dx, dy, dz);
        dx /= len; dy /= len; dz /= len;
        var cx = cm.x + dx * 0.32, cyy = cm.y + dy * 0.32, cz = cm.z + dz * 0.32;
        var rx = -dz, rz = dx; var rl = Math.hypot(rx, rz) || 1; rx /= rl; rz /= rl;
        var w = 0.13, h = 0.09;
        var corners = [[-1, -1], [1, -1], [1, 1], [-1, 1]].map(function (k) {
          return project(cx + rx * w * k[0], cyy + h * k[1], cz + rz * w * k[0]);
        });
        ctx.globalAlpha = Math.max(0.12, 0.5 - o.depth * 0.2) * camP;
        ctx.beginPath();
        corners.forEach(function (p) { ctx.moveTo(o.x, o.y); ctx.lineTo(p.x, p.y); });
        ctx.moveTo(corners[0].x, corners[0].y);
        for (var j = 1; j <= 4; j++) ctx.lineTo(corners[j % 4].x, corners[j % 4].y);
        ctx.stroke();
      });

      // The essays and the threads between nearest neighbours.
      var P = pts.map(function (p) { return project(p.x, p.y, p.z); });
      ctx.strokeStyle = col.accent;
      ctx.lineWidth = 0.7;
      data.edges.forEach(function (e, k) {
        var a = P[e[0]], b = P[e[1]];
        var ep = prog(650 + k * 30, 950);
        if (ep <= 0) return;
        var lit = hover === e[0] || hover === e[1];
        ctx.globalAlpha = lit ? 0.9 : 0.22;
        ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(a.x + (b.x - a.x) * ep, a.y + (b.y - a.y) * ep); ctx.stroke();
      });

      var order = P.map(function (p, i) { return i; }).sort(function (a, b) { return P[b].depth - P[a].depth; });
      order.forEach(function (i) {
        var p = P[i];
        var pp = prog(i * 75, 900);
        if (pp <= 0) return;
        var on = i === hover;
        var r = (on ? 5.5 : 3.2) * p.s * pp;
        ctx.globalAlpha = (on ? 1 : Math.max(0.35, 1 - p.depth * 0.35)) * pp;
        ctx.fillStyle = col.accent;
        ctx.beginPath(); ctx.arc(p.x, p.y, r, 0, Math.PI * 2); ctx.fill();
        // A keypoint marker: a ring with a gap, as a detector draws it. In
        // the intro it closes in on its point, like a detection locking on.
        ctx.strokeStyle = col.accent;
        ctx.lineWidth = on ? 1.2 : 0.8;
        ctx.beginPath(); ctx.arc(p.x, p.y, r + (on ? 7 : 4.5) * p.s + (1 - pp) * 16, 0.25, Math.PI * 2 - 0.25); ctx.stroke();
        if (on) {
          ctx.globalAlpha = 0.6;
          ctx.beginPath();
          ctx.moveTo(p.x - 22, p.y); ctx.lineTo(p.x - 10, p.y);
          ctx.moveTo(p.x + 10, p.y); ctx.lineTo(p.x + 22, p.y);
          ctx.moveTo(p.x, p.y - 22); ctx.lineTo(p.x, p.y - 10);
          ctx.moveTo(p.x, p.y + 10); ctx.lineTo(p.x, p.y + 22);
          ctx.stroke();
        }
      });
      ctx.globalAlpha = 1;
      return P;
    }

    var projected = [];
    var visible = true;
    function frame() {
      if (!dragging && hover < 0) yaw += vel;
      projected = draw();
      if (hover >= 0) placeTip();
      if (visible && !reduce) requestAnimationFrame(frame);
    }

    function placeTip() {
      var p = projected[hover];
      if (!p) return;
      var left = Math.min(Math.max(p.x + 18, 8), W - 240);
      tip.style.transform = 'translate(' + left + 'px,' + (p.y - 14) + 'px)';
    }

    function pick(mx, my) {
      var best = -1, bd = 22 * 22;
      projected.forEach(function (p, i) {
        var d = (p.x - mx) * (p.x - mx) + (p.y - my) * (p.y - my);
        if (d < bd) { bd = d; best = i; }
      });
      return best;
    }

    function setHover(i) {
      if (i === hover) return;
      hover = i;
      if (i < 0) { tip.hidden = true; canvas.style.cursor = dragging ? 'grabbing' : 'grab'; }
      else {
        tip.hidden = false;
        tip.href = pts[i].href;
        tip.querySelector('.field-tip-title').textContent = pts[i].title;
        tip.querySelector('.field-tip-year').textContent = 'Essay · ' + pts[i].year;
        canvas.style.cursor = 'pointer';
        placeTip();
      }
      if (reduce) projected = draw();
    }

    canvas.addEventListener('pointerdown', function (e) {
      dragging = true;
      downX = lastX = e.clientX; downY = lastY = e.clientY;
      canvas.setPointerCapture(e.pointerId);
      fig.classList.add('touched');
    });
    canvas.addEventListener('pointermove', function (e) {
      var rect = canvas.getBoundingClientRect();
      if (dragging) {
        var dx = e.clientX - lastX, dy = e.clientY - lastY;
        lastX = e.clientX; lastY = e.clientY;
        yaw += dx * 0.008;
        pitch = Math.max(-1, Math.min(1, pitch + dy * 0.006));
        if (Math.abs(dx) > 1) vel = (reduce ? 0 : Math.sign(dx) * 0.0016);
        if (reduce) projected = draw();
      }
      setHover(pick(e.clientX - rect.left, e.clientY - rect.top));
    });
    function release(e) {
      var moved = Math.hypot(e.clientX - downX, e.clientY - downY);
      dragging = false;
      if (e.type === 'pointerup' && moved < 5) {
        var rect = canvas.getBoundingClientRect();
        var i = pick(e.clientX - rect.left, e.clientY - rect.top);
        if (i >= 0) location.href = pts[i].href;
      }
    }
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);
    canvas.addEventListener('pointerleave', function (e) {
      if (!dragging && !(e.relatedTarget && tip.contains(e.relatedTarget))) setHover(-1);
    });
    tip.addEventListener('pointerleave', function (e) {
      if (e.relatedTarget !== canvas) setHover(-1);
    });

    // Only spend frames while the figure is on screen.
    new IntersectionObserver(function (entries) {
      var was = visible;
      visible = entries[0].isIntersecting;
      if (visible && !was && !reduce) requestAnimationFrame(frame);
    }).observe(fig);

    resize();
    addEventListener('resize', function () { resize(); projected = draw(); });
    projected = draw();
    if (!reduce) requestAnimationFrame(frame);
  })();
</script>

<script is:inline>
  /* ── The intro ─────────────────────────────────────────────────
     Act one, the mark alone: the pot settles and its ink rises.
     Act two, it swoops into its place in the header, and the name of the
     site writes itself in behind it. Act three, the field assembles, the
     portrait is set down, the name rises, and the links arrive last.
     Each act is a class on <html>; the styles below do the moving. */
  (function () {
    var html = document.documentElement;
    var stage = document.getElementById('intro-stage');
    var smark = stage && stage.querySelector('.intro-mark');
    var hmark = document.querySelector('.brand-mark');
    var replay = document.getElementById('replay');
    if (!stage || !smark || !hmark) return;
    var timers = [];
    var later = function (ms, fn) { timers.push(setTimeout(fn, ms)); };
    var ACTS = ['intro-run', 'landed', 'r1', 'r2', 'r3'];

    // The header's own ink restarts already drawn, so the hand-off from
    // the stage mark is seamless.
    function settleHeaderInk() {
      var ink = hmark.querySelector('.ink');
      if (!ink) return;
      ink.style.animation = 'none';
      void ink.getBoundingClientRect();
      ink.style.animation = '';
      ink.style.animationDelay = '-1.3s';
    }

    /* ── The words ───────────────────────────────────────────────
       The opening line is set once and stays alive; the word after it
       changes, each one arriving and leaving in its own manner, until the
       last, curiosity, which the journey is named for. Each run gets a
       token; skipping or replaying bumps it, and anything still waiting
       from an old run quietly stops. */
    var inkLine = document.getElementById('ink-line');
    var inkSlot = document.getElementById('ink-slot');
    var inkFinal = document.getElementById('ink-final');
    var token = 0;
    var narrow = matchMedia('(max-width: 600px)');
    var all = function (root, sel) { return [].slice.call(root.querySelectorAll(sel)); };
    var lead = all(inkLine, '.ink-lead .l');

    /* The opening line's motion. "journey" (letters 12 to 18) carries a
       slow wave; every word sets a mood, and the wave's height, speed and
       sway, and each letter's tilt, ease toward it, so nothing jumps. */
    var moods = {
      calm:         { amp: 0.06, speed: 1.7, sway: 0 },
      wonder:       { amp: 0.13, speed: 1.2, sway: 1.2 },
      enthusiasm:   { amp: 0.07, speed: 2.6, sway: 0 },
      patience:     { amp: 0.05, speed: 0.6, sway: 0 },
      imperfection: { amp: 0.06, speed: 1.7, sway: 0 },
      honesty:      { amp: 0, speed: 1.7, sway: 0 },
      acceptance:   { amp: 0.06, speed: 1.4, sway: 0 },
      curiosity:    { amp: 0.08, speed: 1.1, sway: 0.6 },
    };
    var lean = lead.map(function (l, i) { return (i * 37 % 17) - 8; });
    var motion;

    function setMood(name) {
      if (!motion) return;
      motion.goal = moods[name] || moods.calm;
      motion.tiltGoal = lead.map(function (l, i) {
        return name === 'imperfection' && i === 12 ? -10 : name === 'acceptance' ? lean[i] : 0;
      });
      if (name === 'enthusiasm') motion.hopAt = motion.clock + 0.2;
    }

    function straighten() {
      if (motion) motion.tiltGoal = lead.map(function () { return 0; });
    }

    function move(t) {
      motion = { amp: 0, speed: 1.7, sway: 0, goal: moods.calm, phase: 0, clock: 0, hopAt: -9,
                 tilt: lead.map(function () { return 0; }), tiltGoal: lead.map(function () { return 0; }) };
      var prev = performance.now();
      (function frame(ts) {
        if (t !== token) {
          lead.forEach(function (l) { l.style.translate = l.style.rotate = ''; });
          return;
        }
        var dt = Math.min(0.05, (ts - prev) / 1000);
        prev = ts;
        var m = motion, k = 1 - Math.exp(-dt * 1.6), kt = 1 - Math.exp(-dt * 5);
        m.amp += (m.goal.amp - m.amp) * k;
        m.speed += (m.goal.speed - m.speed) * k;
        m.sway += (m.goal.sway - m.sway) * k;
        m.phase += dt * m.speed;
        m.clock += dt;
        lead.forEach(function (l, i) {
          var y = 0, r = 0;
          if (i >= 12 && i < 19) {
            var a = m.phase - (i - 12) * 0.5;
            y = -m.amp * (0.5 + 0.5 * Math.sin(a));
            r = m.sway * Math.sin(a + 1.2);
          }
          var h = (m.clock - m.hopAt - i * 0.026) / 0.7;
          if (h > 0 && h < 1) y -= 0.22 * Math.sin(Math.PI * h) * (1 - h * 0.4);
          m.tilt[i] += (m.tiltGoal[i] - m.tilt[i]) * kt;
          l.style.translate = '0 ' + y.toFixed(4) + 'em';
          l.style.rotate = (r + m.tilt[i]).toFixed(3) + 'deg';
        });
        requestAnimationFrame(frame);
      })(prev);
    }

    function wait(ms, t) {
      return new Promise(function (res, rej) {
        timers.push(setTimeout(function () { t === token ? res() : rej('stale'); }, ms));
      });
    }

    // One letter after another; resolves when the last has had its turn.
    function each(list, gap, fn, t) {
      list.forEach(function (l, i) {
        timers.push(setTimeout(function () { if (t === token) fn(l, i); }, i * gap));
      });
      return wait(Math.max(0, list.length - 1) * gap, t);
    }

    function inOrder(list, how) {
      list = list.slice();
      if (how === 'middle') {
        var mid = (list.length - 1) / 2;
        return list.map(function (l, i) { return [l, Math.abs(i - mid)]; })
          .sort(function (a, b) { return a[1] - b[1]; })
          .map(function (p) { return p[0]; });
      }
      if (how === 'scatter') {
        return list.map(function (l, i) { return [l, (i * 7 + 3) % list.length]; })
          .sort(function (a, b) { return a[1] - b[1]; })
          .map(function (p) { return p[0]; });
      }
      return list;
    }

    var add = function (c) { return function (l) { l.classList.add(c); }; };

    // How each word comes and goes. Times in ms.
    // "before" is the silence a word is given before it arrives: wonder
    // takes a breath, enthusiasm cannot wait, patience makes you wait,
    // honesty comes straight out. The next word starts while the last is
    // still leaving, so there is no dead air between them.
    var ways = {
      wonder:       { before: 450, gap: 130, order: 'middle', settle: 1300, hold: 2000, outGap: 50, out: 1100 },
      enthusiasm:   { before: 60, gap: 40, tailAfter: 180, tailGap: 130, hold: 1200, outGap: 25, out: 450 },
      patience:     { before: 1100, gap: 210, tailAfter: 700, tailGap: 650, hold: 1900, outGap: 0, out: 1600 },
      imperfection: { before: 300, gap: 70, settle: 700, hold: 1600, outGap: 40, out: 850 },
      honesty:      { before: 150, gap: 110, typed: true, tailAfter: 250, tailGap: 0, hold: 1700, outGap: 55, out: 0 },
      acceptance:   { before: 500, gap: 65, order: 'scatter', settle: 600, hold: 2000, outGap: 30, out: 650 },
    };

    function cursorOn(w, l) {
      all(w, '.cur').forEach(function (c) { c.classList.remove('cur'); });
      if (l) l.classList.add('cur');
    }

    async function word(w, t) {
      var name = w.className.match(/vw-(\w+)/)[1];
      var how = ways[name];
      var L = all(w, '.l:not(.tail)'), T = all(w, '.tail');
      setMood(name);
      await wait(how.before, t);
      w.classList.add('on');

      await each(inOrder(L, how.order), how.gap, function (l) {
        l.classList.add('in');
        if (how.typed) cursorOn(w, l);
      }, t);
      if (T.length) {
        await wait(how.tailAfter, t);
        await each(T, how.tailGap, function (l) {
          l.classList.add('in');
          if (how.typed) cursorOn(w, l);
        }, t);
      }
      if (how.settle) await wait(how.settle, t);
      w.classList.add('written');
      straighten();
      await wait(how.hold, t);

      if (how.typed) {
        // Deleted the way it was typed, one key at a time from the end.
        var typed = L.concat(T).reverse();
        await each(typed, how.outGap, function (l, i) {
          l.classList.remove('in');
          cursorOn(w, typed[i + 1]);
        }, t);
      } else {
        await each(inOrder(all(w, '.l.in'), how.order), how.outGap, add('go'), t);
        await wait(how.out * 0.6, t);
      }
      // Hand over now; the last of this word clears itself shortly after.
      setMood('calm');
      timers.push(setTimeout(function () {
        if (t !== token) return;
        w.classList.remove('on', 'written');
        all(w, '.l').forEach(function (l) { l.classList.remove('in', 'go', 'cur'); });
      }, how.out * 0.4 + 50));
    }

    function resetInk() {
      all(stage, '.ink-page .l').forEach(function (l) { l.classList.remove('in', 'go', 'cur', 'set'); });
      all(inkSlot, '.vw').forEach(function (w) { w.classList.remove('on', 'written', 'writing'); });
      inkLine.className = 'ink-line';
      inkLine.style.transform = '';
      inkFinal.className = 'ink-final';
      smark.classList.remove('drink');
    }

    // The slot is as wide as a typical word, so the sentence sits in the
    // middle; a longer word runs on to the right, never off the screen.
    // Either way the opening line keeps still.
    function measureSlot() {
      if (narrow.matches) return;
      var widths = all(inkSlot, '.vw').map(function (w) {
        w.classList.add('on', 'written');
        var width = w.getBoundingClientRect().width;
        w.classList.remove('on', 'written');
        return width;
      });
      var opening = inkLine.querySelector('.ink-lead').getBoundingClientRect().width;
      var avg = widths.reduce(function (a, b) { return a + b; }, 0) / widths.length;
      var widest = Math.max.apply(null, widths);
      var room = opening + 2 * widest + 48 - innerWidth;
      inkSlot.style.width = Math.ceil(Math.min(widest, Math.max(avg, room))) + 'px';
    }

    async function play(t) {
      resetInk();
      measureSlot();
      var words = all(inkSlot, '.vw');
      var last = words.pop();

      // "This is the journey of", once, and then it never quite sits still.
      await wait(2300, t);
      move(t);
      await each(lead, 55, add('in'), t);
      await wait(1100, t);
      lead.forEach(add('set'));
      await wait(700, t);

      for (var i = 0; i < words.length; i++) await word(words[i], t);

      // curiosity, last: what is left once the rest has been accepted. It
      // is written in one stroke, and asked.
      var C = all(last, '.l:not(.tail)'), q = last.querySelector('.tail');
      last.classList.add('on');
      setMood('curiosity');
      await wait(500, t);
      C.forEach(add('in'));
      last.classList.add('writing');
      await wait(3000, t);
      q.classList.add('in');
      await wait(2600, t);
      inkLine.classList.add('leave');
      await wait(1400, t);

      // And the welcome, in one motion.
      await each(all(inkFinal, '.l'), 40, add('in'), t);
      await wait(3200, t);
      inkFinal.classList.add('leave');
      smark.classList.add('drink');
      await wait(900, t);
      swoop();
    }

    function finish() {
      html.classList.remove('intro');
      ACTS.forEach(function (c) { html.classList.remove(c); });
      stage.hidden = true;
    }

    function swoop() {
      var a = smark.getBoundingClientRect(), b = hmark.getBoundingClientRect();
      var dx = (b.left + b.width / 2) - (a.left + a.width / 2);
      var dy = (b.top + b.height / 2) - (a.top + a.height / 2);
      var k = b.height / a.height;
      var flight = smark.animate([
        { transform: 'translate(0, 0) scale(1)' },
        { transform: 'translate(' + dx + 'px, ' + dy + 'px) scale(' + k + ')' }
      ], { duration: 1400, easing: 'cubic-bezier(0.76, 0, 0.18, 1)', fill: 'forwards' });
      flight.onfinish = function () {
        settleHeaderInk();
        html.classList.add('landed');
        // The mark is now the header's; the stage stays up only for Skip.
        smark.style.visibility = 'hidden';
        flight.cancel();
      };
      later(950, function () { html.classList.add('r1'); });
      later(1300, function () { if (window.fieldIntro) window.fieldIntro(); });
      later(2500, function () { html.classList.add('r2'); });
      later(3600, function () { html.classList.add('r3'); });
      later(6600, finish);
    }

    // Straight to the finished page, from wherever the intro had got to.
    function skip() {
      if (!html.classList.contains('intro')) return;
      timers.forEach(clearTimeout);
      timers = [];
      token++;
      smark.getAnimations().forEach(function (a) { a.cancel(); });
      if (window.fieldDone) window.fieldDone();
      settleHeaderInk();
      finish();
    }
    var skipBtn = document.getElementById('intro-skip');
    if (skipBtn) skipBtn.addEventListener('click', skip);
    addEventListener('keydown', function (e) { if (e.key === 'Escape') skip(); });

    function run() {
      timers.forEach(clearTimeout);
      timers = [];
      token++;
      ACTS.forEach(function (c) { html.classList.remove(c); });
      smark.getAnimations().forEach(function (a) { a.cancel(); });
      html.classList.add('intro');
      if (window.fieldHold) window.fieldHold();
      scrollTo(0, 0);
      stage.hidden = false;
      smark.style.visibility = '';
      void stage.getBoundingClientRect();
      html.classList.add('intro-run');
      play(token).catch(function () {});
    }

    if (html.classList.contains('intro')) {
      // Fonts first, so the name is written in its own hand, not a stand-in.
      var go = function () { requestAnimationFrame(run); };
      if (document.fonts && document.fonts.ready) Promise.race([document.fonts.ready, new Promise(function (r) { setTimeout(r, 1200); })]).then(go);
      else go();
    } else {
      stage.hidden = true;
    }

    if (replay) replay.addEventListener('click', function () {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      run();
    });
  })();
</script>

<style>
  .home {
    max-width: none;
  }

  /* One screen and nothing else: the field fills it, the name sits in
     the lower left corner of the frame. */
  /* Exactly one screen: the visible viewport (dvh follows the phone's
     address bar as it shows and hides) less the header, whose real height
     the layout measures into --head-h. */
  :global(body:has(.home) main) {
    padding-top: 0;
    padding-bottom: 0;
  }

  .hero {
    position: relative;
    height: calc(100vh - var(--head-h, 4rem));
    height: calc(100dvh - var(--head-h, 4rem));
    min-height: 420px;
    margin: 0 calc(var(--gutter) * -1);
  }

  .field {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .field canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: pan-y;
    /* The field fades out toward the edges instead of being cut off by
       the screen, as if seen through a lens. */
    -webkit-mask-image: radial-gradient(ellipse 82% 90% at 60% 45%, #000 64%, transparent 100%);
    mask-image: radial-gradient(ellipse 82% 90% at 60% 45%, #000 64%, transparent 100%);
  }

  .hero-text {
    position: absolute;
    left: var(--gutter);
    bottom: var(--space-xl);
    z-index: 2;
    pointer-events: none;
  }

  .hero-text a {
    pointer-events: auto;
  }

  /* A small print of the author, pinned above the name: greyscale like
     the rest of the sheet until you look at it. */
  .portrait {
    position: relative;
    display: block;
    width: clamp(104px, 10vw, 140px);
    aspect-ratio: 4 / 5;
    margin: 0 0 var(--space-xl) 0.3rem;
